// Bank transfer exercising the FULL contract surface from VERIFICATION-SPEC.md —
// VALID scenario: real functions implement the uow by attaching with
// `uow (Name[.phase])`, every claim matches what the members do, and the
// transactional surface compiles end to end:
//
// - Function-level catch suffix: `transferMoney` handles its own errors
//   (ContractViolation from the check-mode requires, BalanceModifyException
//   from the domain throw), so callers need no `try` and no `throws`.
// - Bare `rollback;` restores the whole-object entry snapshots of every
//   parameter — the uow runs or it does not run (spec §10).
// - `commit;` ends the transaction: everything after it (the notification,
//   the commit print) runs in the after-commit window, outside the retry
//   window — an explicit `after_commit { ... }` block would be equivalent.
// - The uow declaration is a pure spec; `atomic:` alone implies the writes
//   claim, and `strategy: database` discharges atomicity.
//
// - Struct parameters of uow members are passed BY REFERENCE (spec §5.1):
//   the member mutates the caller's objects, so a committed transfer is
//   visible after the call — alice ends at 750 and bob at 290. Arguments
//   must be `mut` variables.
// - `old(field)` is valid in member code, not only in ensure clauses: it
//   reads an entry snapshot, including after `commit;` (the commit line
//   prints the entry balance, 1000).
//
// Run: .\cmake-build-debug-visual-studio\djinn.exe -r .\demos\bank-uow\
// Expected: compiles clean under --verify (trace logs obligations and
// members), prints the transfer + commit + notification lines, exit code 0.

import std::types;
import std::sys;

namespace bank;

struct Account {
    i32 balance;
    invariant this.balance >= 0 in mode prove
}

impl Account {
    i32 withdraw(i32 amount)
        require(amount > 0)
        require(this.balance >= amount)
        ensure(return == old(this.balance) - amount)
        writes(self.balance)
        reads(self.balance)
    {
        this.balance = this.balance - amount;
        return this.balance;
    }

    i32 deposit(i32 amount)
        require(amount > 0)
        ensure(return == old(this.balance) + amount)
        writes(self.balance)
        reads(self.balance)
    {
        this.balance = this.balance + amount;
        return this.balance;
    }
}

i32 notify_transfer(i32 amount)
    effects(external_io)
{
    printf("[email]   transfer of %d confirmed\n", amount);
    return 0;
}

// The spec: claims only — no body, no generated code. Sections inside a uow
// always use `key: value` (the parenthesized form is for signatures only).
uow Transfer {
    require(amount > 0)

    reads: from.balance, to.balance
    writes: from.balance, to.balance

    access: exclusive from, exclusive to
    atomic: from.balance, to.balance
    ordering: Account.id ascending
    isolation: snapshot
    retry: allowed
    strategy: database
    effects: external_io
}

// Transaction member: writes exactly the declared atomic set, restores every
// parameter's CALLER object on failure, and commits — the notification and
// the commit print run only when the transaction commits. `old(from.balance)`
// reads the entry snapshot (1000) even after `commit;`.
void transferMoney(Account from, Account to, i32 amount)
    uow (Transfer)
{
    from.withdraw(amount);
    to.deposit(amount);
    commit;

    notify_transfer(amount);
    printf("[commit]   transferred %d: from = %d, to = %d\n", amount, old(from.balance), to.balance);
} catch (ContractViolation violation) {
    rollback;
    printf("[rollback] contract violated, balances restored\n");
}

i32 main() {
    Account mut alice = { 1000 };
    Account mut bob = { 40 };

    printf("== bank uow: valid scenario ==\n");
    printf("start: alice = %d, bob = %d\n", alice.balance, bob.balance);

    transferMoney(alice, bob, 250);

    printf("end:   alice = %d, bob = %d\n", alice.balance, bob.balance);
    return 0;
}
