// Bank transfer exercising the FULL contract surface from VERIFICATION-SPEC.md —
// INVALID scenario: the program carries the two bugs from the spec's worked
// example, and the verifier rejects it at compile time.
//
// Expected: compilation FAILS with two hard errors and exit code 1:
//
//   E-CONTRACT-011 (9502) — `transferMoney` (transaction body member) also
//     writes `ledger.balance` through `ledger.audit`, but the uow's claims
//     (writes ∪ atomic) do not list it; the error points at the audit call
//     with a note naming the offending member.
//
//   E-CONTRACT-042 (9503) — `retry(allowed)` makes the uow retryable, but
//     `notify_transfer` (external_io — a non-idempotent effect that would run
//     twice on retry) is called BEFORE the commit point, inside the
//     transaction window. Resolution offered: move it after `commit;` (or
//     into an `after_commit { ... }` block), or set `retry(disabled)`.
//
// Everything else holds on purpose: the member handles ContractViolation in
// its catch suffix, the bare `rollback;` covers every declared atomic path,
// and the reads claim covers every field the members touch.

import std::types;
import std::sys;

namespace bank;

struct Account {
    i32 balance;
    invariant this.balance >= 0 in mode prove
}

impl Account {
    i32 withdraw(i32 amount)
        require(amount > 0)
        require(this.balance >= amount)
        ensure(return == this.balance - amount)
        writes(self.balance)
        reads(self.balance)
    {
        this.balance = this.balance - amount;
        return this.balance;
    }

    i32 deposit(i32 amount)
        require(amount > 0)
        ensure(return == this.balance + amount)
        writes(self.balance)
        reads(self.balance)
    {
        this.balance = this.balance + amount;
        return this.balance;
    }
}

struct Ledger {
    i32 balance;
}

impl Ledger {
    i32 audit(i32 amount)
        require(amount > 0)
        writes(self.balance)
        reads(self.balance)
    {
        this.balance = this.balance + 1;
        return this.balance;
    }
}

i32 notify_transfer(i32 amount)
    effects(external_io)
{
    printf("[email]   transfer of %d confirmed\n", amount);
    return 0;
}

uow Transfer {
    require(amount > 0)

    reads: from.balance, to.balance
    writes: from.balance, to.balance // BUG (spec example): ledger.balance missing

    access: exclusive from, exclusive to
    atomic: from.balance, to.balance, ledger.balance
    ordering: Account.id ascending
    isolation: snapshot
    retry: allowed
    strategy: database
    effects: external_io
}

// BUG: the audit write is not in the claims, and the notification call runs
// inside the transaction window although the uow is retryable.
void transferMoney(Account from, Account to, Ledger ledger, i32 amount)
    uow (Transfer)
{
    from.withdraw(amount);
    to.deposit(amount);
    ledger.audit(amount);
    notify_transfer(amount);
    commit;
} catch (ContractViolation violation) {
    rollback;
    printf("[rollback] contract violated, balances restored\n");
} catch (Exception error) {
    rollback;
    printf("[rollback] transfer aborted, balances untouched\n");
}

i32 main() {
    return 0;
}
