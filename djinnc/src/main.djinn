namespace djinnc;

i32 main() {
    Options* options = Options.parse();
    if (!options.ok) {
        Options.usage();
        return 2;
    }

    i8* source = Files.read_all(options.input);
    if (source == null) {
        printf("djinnc: cannot read '%s'\n", options.input);
        return 1;
    }

    Diagnostics* diagnostics = Diagnostics.create(options.input);
    Lexer* lexer = Lexer.create(source, strlen(source), diagnostics);
    PtrVec* tokens = lexer.tokenize();
    if (diagnostics.failed()) {
        return 1;
    }
    if (options.emit_tokens) {
        Dump.tokens(tokens);
        return 0;
    }

    Parser* parser = Parser.create(tokens, diagnostics);
    Node* program = parser.parse_program();
    if (diagnostics.failed()) {
        return 1;
    }
    if (options.emit_ast) {
        Dump.node(program, 0);
        return 0;
    }

    CodeGen* gen = CodeGen.create(diagnostics, options.input);
    if (!gen.generate(program)) {
        return 1;
    }

    ByteBuf* ir_path = ByteBuf.create();
    ir_path.append(options.output);
    ir_path.append(".ll");
    if (!gen.write_ir(ir_path.cstr())) {
        return 1;
    }
    if (options.emit_ir || options.no_link) {
        return 0;
    }

    i32 status = Linker.link(options, ir_path.cstr());
    if (status != 0) {
        printf("djinnc: linking failed (exit %d)\n", status);
        return 1;
    }
    return 0;
}
