namespace djinnc;

i32 main() {
    i32 status = run_compiler();
    CodeGenerator.release();
    Ast.destroy();
    Memory.release();
    return status;
}

unsafe i32 run_compiler() {
    Options* options = Options.parse();
    if (options.show_version) {
        printf("djinnc (self-hosted) 0.1
");
        return 0;
    }
    if (!options.ok) {
        Options.usage();
        return 2;
    }

    Diagnostics.set_json(options.diagnostics_json);
    Target.init(options.target);
    Target.set_debug(options.debug);
    ObjectWriter.set_target(options.cpu, options.features);

    if (options.inspect_path != null) {
        return Library.inspect(options.inspect_path, null);
    }

    if (options.self_test) {
        return SelfTest.run();
    }

    PerformanceMonitor* monitor = PerformanceMonitor.create("djinnc", options.stats);
    PointerList* inputs = options.inputs;
    inputs.sort_strings();
    logger_info(Log.get(), "djinnc: compiling %d file(s) to '%s'", inputs.length, options.output);
    PointerList* diagnostics_list = PointerList.create();
    mut i64 total_bytes = 0;
    for (mut i32 i = 0; i < inputs.length; i = i + 1) {
        ptr<i8> path = (ptr<i8>)inputs.get(i);
        ptr<i8> source = Files.read_all(path);
        if (source == null) {
            logger_error(Log.get(), "djinnc: cannot read '%s'", path);
            return 1;
        }
        i32 length = strlen(source);
        Sources.add(path, source, (u32)length);
        diagnostics_list.push((ptr)Diagnostics.create(path));
        total_bytes = total_bytes + length;
    }
    PointerList* core_files = CoreLibrary.files(options);
    if (core_files == null || core_files.length == 0) {
        return 1;
    }
    PointerList* dependencies = options.dependencies;
    for (mut i32 i = 0; i < core_files.length; i = i + 1) {
        ptr<i8> core_path = (ptr<i8>)core_files.get(i);
        ptr<i8> core = Files.read_all(core_path);
        if (core == null) {
            logger_error(Log.get(), "djinnc: cannot read the core library file '%s'", core_path);
            return 1;
        }
        dependencies.push((ptr)core_path);
        i32 core_length = strlen(core);
        Sources.add(core_path, core, (u32)core_length);
        diagnostics_list.push((ptr)Diagnostics.create(core_path));
        total_bytes = total_bytes + core_length;
    }
    i32 source_count = inputs.length + core_files.length;

    if (options.library_view) {
        options.library = true;
    }
    if (options.library && !options.output_set) {
        options.output = "a.djlib";
    }
    PointerList* libraries = options.libraries;
    for (mut i32 i = 0; i < libraries.length; i = i + 1) {
        if (Library.load(options, (ptr<i8>)libraries.get(i), diagnostics_list) < 0) {
            return 1;
        }
    }
    i32 total_sources = Sources.count();
    for (mut i32 i = source_count; i < total_sources; i = i + 1) {
        SourceFile* library_file = Sources.get(i);
        total_bytes = total_bytes + (i64)library_file.length;
    }

    monitor.lap("read");
    TokenList* tokens = TokenList.create((i32)(total_bytes / 3) + 64);
    for (mut i32 i = 0; i < total_sources; i = i + 1) {
        SourceFile* file = Sources.get(i);
        Diagnostics* file_diagnostics = (Diagnostics*)diagnostics_list.get(i);
        Lexer* lexer = Lexer.create(file, tokens, file_diagnostics);
        lexer.tokenize();
        if (file_diagnostics.failed()) {
            return 1;
        }
    }
    monitor.lap("lex");
    logger_info(Log.get(), "djinnc: lexed %d tokens", tokens.length);
    if (options.emit_tokens) {
        Dump.tokens(tokens);
        return 0;
    }

    U32Map* type_names = U32Map.create(Memory.arena(), 256);
    for (mut i32 i = 0; i < total_sources; i = i + 1) {
        Parser.collect_type_names(tokens, Sources.get(i), type_names);
    }

    Ast.init(tokens.length * 2 + 64);
    Diagnostics* diagnostics = (Diagnostics*)diagnostics_list.get(0);
    Node* program = Node.create_list(NodeKind::PROGRAM, 0);
    for (mut i32 step = 0; step < total_sources; step = step + 1) {
        mut i32 i = step + source_count;
        if (i >= total_sources) {
            i = step - (total_sources - source_count);
        }
        SourceFile* file = Sources.get(i);
        Diagnostics* file_diagnostics = (Diagnostics*)diagnostics_list.get(i);
        Parser* parser = Parser.create(tokens, file, file_diagnostics, type_names);
        Node* unit = parser.parse_program();
        if (file_diagnostics.failed()) {
            return 1;
        }
        for (mut i32 c = 0; c < unit.count(); c = c + 1) {
            program.add(unit.child(c));
        }
    }
    if (options.stats) {
        Arena* arena = Memory.arena();
        printf("files: %d\n", inputs.length);
        printf("tokens: %d (%d bytes)\n", tokens.length, tokens.length * 9);
        printf("ast: %d nodes (%d bytes)\n", Ast.node_count(), Ast.node_count() * (i32)sizeof(Node));
        printf("arena: %d bytes allocated, %d bytes reserved\n", (i32)arena.total_allocated, (i32)arena.total_reserved);
    }
    monitor.lap("parse");
    logger_info(Log.get(), "djinnc: parsed %d ast nodes", Ast.node_count());
    if (options.emit_ast) {
        Dump.program(program, options.dependencies);
        return 0;
    }

    CodeGenerator* gen = CodeGenerator.create(diagnostics, options.input);
    gen.reflect_mode = options.reflect_mode;
    SymbolTable* inspect_symbols = gen.symbols;
    inspect_symbols.generate_disabled = options.no_generate;
    gen.library_mode = options.library;
    gen.keep_frames = options.run;
    if (options.debug) {
        gen.enable_debug((ptr<i8>)inputs.get(0), options.optimize, options.emit_asm || options.emit_ir);
    }
    if (options.check_only) {
        if (!gen.check(program)) {
            return 1;
        }
        monitor.lap("check");
        monitor.finish();
        return 0;
    }
    if (!gen.generate(program)) {
        return 1;
    }
    monitor.lap("codegen");
    logger_info(Log.get(), "djinnc: generated and verified LLVM module");

    if (options.library) {
        gen.exclude_dependencies(options.dependencies, true);
        ByteBuffer* library_object = ByteBuffer.create();
        library_object.append(options.output);
        library_object.append(".obj");
        if (!gen.write_object(library_object.cstr(), options.opt_level)) {
            return 1;
        }
        ptr<i8> library_path = options.output;
        if (options.library_view) {
            ByteBuffer* view_path = ByteBuffer.create();
            view_path.append(options.output);
            view_path.append(".djlib");
            options.output = view_path.cstr();
        }
        bool written = Library.write(options, library_object.cstr());
        remove(library_object.cstr());
        monitor.finish();
        if (!written) {
            return 1;
        }
        if (options.library_view) {
            i32 status = Library.inspect(options.output, library_path);
            remove(options.output);
            return status;
        }
        logger_info(Log.get(), "djinnc: wrote library '%s'", options.output);
        return 0;
    }

    if (options.run) {
        monitor.finish();
        return Jit.run(gen, options);
    }

    if (options.emit_asm || options.emit_ir) {
        gen.exclude_dependencies(options.dependencies, options.show_async);
    }

    if (options.emit_asm && !options.emit_ir) {
        if (!gen.write_assembly(options.output, options.opt_level, true)) {
            return 1;
        }
        monitor.finish();
        return 0;
    }

    if (options.emit_ir && !gen.optimize_ir(options.opt_level, true)) {
        return 1;
    }
    bool ir_only = options.emit_ir || options.no_link;
    if (ir_only || options.keep_ir) {
        ByteBuffer* ir_path = ByteBuffer.create();
        ir_path.append(options.output);
        ir_path.append(".ll");
        if (!gen.write_ir(ir_path.cstr())) {
            return 1;
        }
    }
    monitor.lap("write-ir");
    if (ir_only) {
        Library.cleanup();
        monitor.finish();
        return 0;
    }

    ByteBuffer* object_path = ByteBuffer.create();
    object_path.append(options.output);
    object_path.append(".obj");
    if (!gen.write_object(object_path.cstr(), options.opt_level)) {
        return 1;
    }

    monitor.lap("object");
    logger_info(Log.get(), "djinnc: wrote object '%s'", object_path.cstr());
    if (!Target.is_native()) {
        logger_info(Log.get(), "djinnc: '%s' is not the host target, so the object was not linked", Target.triple());
        monitor.finish();
        return 0;
    }

    logger_info(Log.get(), "djinnc: linking '%s'", options.output);
    i32 status = Linker.link(options, object_path.cstr());
    Library.cleanup();
    monitor.lap("link");
    if (status != 0) {
        logger_error(Log.get(), "djinnc: linking failed (exit %d)", status);
        return 1;
    }
    logger_info(Log.get(), "djinnc: done '%s'", options.output);
    monitor.finish();
    return 0;
}
