namespace djinnc;

struct ProjectList {
    const i32 NONE = 0;
    const i32 LIBS = 1;
    const i32 SOURCES = 2;
}

struct Project {
    public static unsafe bool is_source_file(ptr<i8> path) {
        i32 length = strlen(path);
        return length > 6 && Strings.equals(path + length - 6, 6, ".djinn");
    }

    public static bool apply(Options* options, ptr<i8> directory) {
        ByteBuffer* manifest_path = ByteBuffer.create();
        manifest_path.append(directory);
        manifest_path.append("/djinn.proj");
        ptr<i8> manifest = Files.read_all(manifest_path.cstr());
        if (manifest == null) {
            logger_error(Log.get(), "djinnc: cannot read '%s'", manifest_path.cstr());
            return false;
        }
        Project.read_manifest(options, manifest, directory);

        ByteBuffer* source_root = ByteBuffer.create();
        source_root.append(directory);
        source_root.append("/src");
        ptr<i8> listing = __djinn_list_files(source_root.cstr(), ".djinn");
        if (listing == null) {
            logger_error(Log.get(), "djinnc: cannot list '%s'", source_root.cstr());
            return false;
        }
        Project.add_listed_files(options, listing);
        return options.inputs.length > 0;
    }

    static unsafe void add_listed_files(Options* options, ptr<i8> listing) {
        i32 length = strlen(listing);
        PointerList* inputs = options.inputs;
        mut i32 start = 0;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || listing[i] == 10) {
                if (i > start) {
                    inputs.push((ptr)Strings.duplicate(listing + start, i - start));
                }
                start = i + 1;
            }
        }
        options.input = (ptr<i8>)inputs.get(0);
    }

    static unsafe void read_manifest(Options* options, ptr<i8> manifest, ptr<i8> directory) {
        i32 length = strlen(manifest);
        mut ptr<i8> output_file = (ptr<i8>)0;
        mut ptr<i8> output_directory = (ptr<i8>)0;
        mut i32 start = 0;
        mut i32 open_list = ProjectList.NONE;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || manifest[i] == 10) {
                i32 first = Project.skip_blanks(manifest, start, i);
                if (open_list != ProjectList.NONE) {
                    open_list = Project.read_items(options, manifest, first, i, open_list, directory);
                } else if (Strings.starts_with(manifest, first, i, "libs:")) {
                    options.use_std = false;
                    open_list = Project.read_items(options, manifest, first + 5, i, ProjectList.LIBS, directory);
                } else if (Strings.starts_with(manifest, first, i, "sources:")) {
                    open_list = Project.read_items(options, manifest, first + 8, i, ProjectList.SOURCES, directory);
                } else if (Strings.starts_with(manifest, first, i, "library-mode:")) {
                    options.library = Strings.same(Project.read_value(manifest, first + 13, i), "true");
                } else if (Strings.starts_with(manifest, first, i, "reflection-mode:")) {
                    if (Strings.same(Project.read_value(manifest, first + 16, i), "all")) {
                        options.reflect_mode = ReflectionMode.ALL;
                    }
                } else if (Strings.starts_with(manifest, first, i, "generate:")) {
                    options.no_generate = Strings.same(Project.read_value(manifest, first + 9, i), "false");
                } else if (Strings.starts_with(manifest, first, i, "file:")) {
                    output_file = Project.read_value(manifest, first + 5, i);
                } else if (Strings.starts_with(manifest, first, i, "directory:")) {
                    output_directory = Project.read_value(manifest, first + 10, i);
                } else if (first < i && (manifest[first] == 39 || manifest[first] == 34)) {
                    ByteBuffer* link_args = options.link_args;
                    ptr<i8> value = Project.read_value(manifest, first, i);
                    i32 value_length = strlen(value);
                    link_args.append(" \"");
                    if (options.use_lld && Linker.is_windows() && Strings.starts_with(value, 0, value_length, "-L")) {
                        link_args.append("/libpath:");
                        link_args.append(value + 2);
                    } else if (options.use_lld && Linker.is_windows() && Strings.starts_with(value, 0, value_length, "-l")) {
                        link_args.append(value + 2);
                        link_args.append(".lib");
                    } else {
                        link_args.append(value);
                    }
                    link_args.append("\"");
                }
                start = i + 1;
            }
        }

        if (!options.output_set && output_file != null) {
            ByteBuffer* output = ByteBuffer.create();
            if (output_directory != null) {
                output.append(output_directory);
                output.append_char(47);
            }
            output.append(output_file);
            options.output = output.cstr();
        }
    }

    static unsafe i32 read_items(Options* options, ptr<i8> text, i32 from, i32 to, i32 list, ptr<i8> directory) {
        mut i32 position = from;
        while (position < to) {
            i32 c = (i32)text[position];
            if (c == 93) {
                return ProjectList.NONE;
            }
            position = position + 1;
            if (c == 39 || c == 34) {
                i32 item = position;
                while (position < to && (i32)text[position] != c) {
                    position = position + 1;
                }
                Project.add_item(options, Strings.duplicate(text + item, position - item), list, directory);
                position = position + 1;
            }
        }
        return list;
    }

    static unsafe void add_item(Options* options, ptr<i8> item, i32 list, ptr<i8> directory) {
        if (list == ProjectList.LIBS && Strings.same(item, "std")) {
            options.use_std = true;
            return;
        }
        ByteBuffer* path = ByteBuffer.create();
        if (list == ProjectList.LIBS) {
            path.append(options.library_dir);
            path.append("/");
            path.append(item);
            path.append(".djlib");
            PointerList* libraries = options.libraries;
            libraries.push((ptr)path.cstr());
            return;
        }
        path.append(directory);
        path.append("/");
        path.append(item);
        PointerList* inputs = options.inputs;
        inputs.push((ptr)path.cstr());
    }

    static unsafe i32 skip_blanks(ptr<i8> text, i32 from, i32 to) {
        mut i32 position = from;
        while (position < to && (text[position] == 32 || text[position] == 9)) {
            position = position + 1;
        }
        return position;
    }

    static unsafe ptr<i8> read_value(ptr<i8> text, i32 from, i32 to) {
        mut i32 start = Project.skip_blanks(text, from, to);
        mut i32 end = to;
        while (end > start && (text[end - 1] == 13 || text[end - 1] == 32 || text[end - 1] == 44)) {
            end = end - 1;
        }
        if (end - start >= 2 && (text[start] == 39 || text[start] == 34) && text[end - 1] == text[start]) {
            start = start + 1;
            end = end - 1;
        }
        return Strings.duplicate(text + start, end - start);
    }
}
