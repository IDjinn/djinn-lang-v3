namespace djinnc;

struct Linker {
    public static bool is_windows() {
        return getenv("OS") != null;
    }

    static i32 link_ld_lld(Options* options, ptr<i8> object_path) {
        ptr<i8> lld = Process.env_or("DJINN_LD_LLD", "ld.lld");
        ptr<i8> crt = Process.env_or("DJINN_CRT_DIR", "/usr/lib/x86_64-linux-gnu");
        ptr<i8> loader = Process.env_or("DJINN_DYNAMIC_LINKER", "/lib64/ld-linux-x86-64.so.2");

        ByteBuffer* command = ByteBuffer.create();
        command.append("\"");
        command.append(lld);
        command.append("\" -dynamic-linker \"");
        command.append(loader);
        command.append("\" \"");
        command.append(crt);
        command.append("/crt1.o\" \"");
        command.append(crt);
        command.append("/crti.o\" \"");
        command.append(object_path);
        command.append("\" \"");
        command.append(options.runtime_lib);
        command.append("\" -L\"");
        command.append(crt);
        command.append("\" -L/usr/lib -L/lib/x86_64-linux-gnu -lc -lm \"");
        command.append(crt);
        command.append("/crtn.o\"");
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" -o \"");
        command.append(options.output);
        command.append("\"");

        return Process.run(command.cstr());
    }

    static i32 link_lld(Options* options, ptr<i8> object_path) {
        if (options.runtime_lib == null) {
            logger_error(Log.get(), "djinnc: --lld needs --runtime-lib");
            return 1;
        }
        if (!Linker.is_windows()) {
            return Linker.link_ld_lld(options, object_path);
        }
        ptr<i8> lld = Process.env_or("DJINN_LLD_LINK", "lld-link");

        ByteBuffer* command = ByteBuffer.create();
        command.append("\"");
        command.append("\"");
        command.append(lld);
        command.append("\" \"");
        command.append(object_path);
        command.append("\" \"");
        command.append(options.runtime_lib);
        command.append("\" /subsystem:console /defaultlib:msvcrt /defaultlib:legacy_stdio_definitions /debug");
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" \"/out:");
        command.append(options.output);
        command.append("\"\"");

        return Process.run(command.cstr());
    }

    static void append_runtime_sources(ByteBuffer* command, ptr<i8> runtime_dir) {
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/djinn_runtime.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/scheduler.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/io_file.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/io_socket.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/diagnostics.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/threads.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/console.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/filesystem.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/process.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/logger.c\"");
    }

    public static i32 link(Options* options, ptr<i8> object_path) {
        if (options.use_lld) {
            return Linker.link_lld(options, object_path);
        }
        ptr<i8> clang = Process.env_or("DJINN_CLANG", "clang");

        ByteBuffer* command = ByteBuffer.create();
        if (Linker.is_windows()) {
            command.append("\"");
        }
        command.append("\"");
        command.append(clang);
        command.append("\" \"");
        command.append(object_path);
        command.append("\"");
        if (options.runtime_lib != null) {
            command.append(" \"");
            command.append(options.runtime_lib);
            command.append("\"");
        } else {
            Linker.append_runtime_sources(command, options.runtime_dir);
            command.append(" -O2");
        }
        if (options.debug || Linker.is_windows()) {
            command.append(" -g");
        }
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" -fuse-ld=lld -o \"");
        command.append(options.output);
        command.append("\"");
        if (Linker.is_windows()) {
            command.append("\"");
        }

        return Process.run(command.cstr());
    }
}
