namespace djinnc;

struct CoreLibrary {
    public static unsafe PointerList* files(Options* options) {
        ByteBuffer* directory = ByteBuffer.create();
        directory.append(options.runtime_dir);
        directory.append("/core");
        ptr<i8> listing = __djinn_list_files(directory.cstr(), ".djinn");
        if (listing == null) {
            logger_error(Log.get(), "djinnc: cannot list the core library '%s' (see --runtime-dir)", directory.cstr());
            return (PointerList*)0;
        }
        PointerList* paths = PointerList.create();
        i32 length = strlen(listing);
        mut i32 start = 0;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || listing[i] == 10) {
                if (i > start) {
                    paths.push((ptr)Strings.duplicate(listing + start, i - start));
                }
                start = i + 1;
            }
        }
        paths.sort_strings();
        return paths;
    }

    public static unsafe bool contains(ptr<i8> path) {
        i32 length = strlen(path);
        for (mut i32 i = 0; i + 6 <= length; i = i + 1) {
            bool opens = path[i] == 47 || path[i] == 92;
            bool closes = path[i + 5] == 47 || path[i + 5] == 92;
            if (opens && closes && Strings.equals(path + i + 1, 4, "core")) {
                return true;
            }
        }
        return false;
    }
}
