namespace djinnc;

struct Jit {
    static bool check(ptr error, ptr<i8> what) {
        if (error == null) {
            return true;
        }
        ptr<i8> message = LLVMGetErrorMessage(error);
        logger_error(Log.get(), "djinnc: jit: %s: %s", what, message);
        LLVMDisposeErrorMessage(message);
        return false;
    }

    public static unsafe i32 run(CodeGenerator* gen, Options* options) {
        if (!Target.is_native()) {
            logger_error(Log.get(), "djinnc: --run needs the host target, but the target is '%s'", Target.triple());
            return 1;
        }
        if (options.runtime_lib == null) {
            logger_error(Log.get(), "djinnc: --run needs --runtime-lib <lib> with the precompiled runtime");
            return 1;
        }
        if (!Target.initialize_backend()) {
            return 1;
        }

        ptr<i8> pipeline = ObjectWriter.pipeline(options.opt_level, false, true);
        if (!ObjectWriter.run_passes(gen.module, null, pipeline)) {
            return 1;
        }

        __djinn_link_debug_support();
        ptr jit = (ptr)0;
        if (!Jit.check(LLVMOrcCreateLLJIT(&jit, null), "cannot create the JIT")) {
            return 1;
        }
        ptr dylib = LLVMOrcLLJITGetMainJITDylib(jit);

        ptr runtime = (ptr)0;
        if (!Jit.check(LLVMOrcCreateStaticLibrarySearchGeneratorForPath(&runtime, LLVMOrcLLJITGetObjLinkingLayer(jit), options.runtime_lib), "cannot load the runtime library")) {
            return 1;
        }
        LLVMOrcJITDylibAddGenerator(dylib, runtime);

        if (Linker.is_windows()) {
            ptr crt = (ptr)0;
            if (!Jit.check(LLVMOrcCreateDynamicLibrarySearchGeneratorForPath(&crt, "ucrtbase.dll", LLVMOrcLLJITGetGlobalPrefix(jit), null, null), "cannot load the C runtime")) {
                return 1;
            }
            LLVMOrcJITDylibAddGenerator(dylib, crt);
        }

        ptr process = (ptr)0;
        if (!Jit.check(LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(&process, LLVMOrcLLJITGetGlobalPrefix(jit), null, null), "cannot expose the process symbols")) {
            return 1;
        }
        LLVMOrcJITDylibAddGenerator(dylib, process);

        LLVMSetDataLayout(gen.module, LLVMOrcLLJITGetDataLayoutStr(jit));
        if (Linker.is_windows()) {
            ptr legacy_write = LLVMGetNamedFunction(gen.module, "write");
            if (legacy_write != null) {
                LLVMSetValueName2(legacy_write, "_write", 6);
            }
        }
        gen.release_builders();
        gen.module_taken = 1;
        ptr shared_context = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(gen.context);
        ptr shared_module = LLVMOrcCreateNewThreadSafeModule(gen.module, shared_context);
        LLVMOrcDisposeThreadSafeContext(shared_context);
        if (!Jit.check(LLVMOrcLLJITAddLLVMIRModule(jit, dylib, shared_module), "cannot add the module")) {
            return 1;
        }

        u64 entry = 0;
        if (!Jit.check(LLVMOrcLLJITLookup(jit, &entry, "main"), "cannot find 'main'")) {
            return 1;
        }
        logger_info(Log.get(), "djinnc: running 'main' in process");
        fflush(null);
        return __djinn_call_entry((ptr)entry);
    }
}
