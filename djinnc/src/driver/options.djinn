namespace djinnc;

struct Options {
    i8* input;
    PointerList* inputs;
    i8* output;
    i8* runtime_dir;
    i8* runtime_lib;
    ByteBuffer* link_args;
    bool keep_ir;
    bool use_lld;
    bool optimize;
    bool emit_tokens;
    bool emit_ast;
    bool emit_ir;
    bool self_test;
    bool stats;
    bool no_link;
    bool output_set;
    bool ok;

    public static Options* parse() {
        Options* options = (Options*)Memory.zalloc(sizeof(Options));
        options.output = "a.out";
        options.runtime_dir = "runtime";
        options.ok = true;
        options.inputs = PointerList.create();
        options.link_args = ByteBuffer.create();

        i32 count = Process.argc();
        mut i32 i = 1;
        while (i < count) {
            i8* argument = Process.argv_or(i, "");
            if (Strings.same(argument, "--emit-tokens")) {
                options.emit_tokens = true;
            } else if (Strings.same(argument, "--emit-ast")) {
                options.emit_ast = true;
            } else if (Strings.same(argument, "--emit-ir")) {
                options.emit_ir = true;
            } else if (Strings.same(argument, "--keep-ir")) {
                options.keep_ir = true;
            } else if (Strings.same(argument, "--lld")) {
                options.use_lld = true;
            } else if (Strings.same(argument, "-O2")) {
                options.optimize = true;
            } else if (Strings.same(argument, "--stats")) {
                options.stats = true;
            } else if (Strings.same(argument, "--selftest")) {
                options.self_test = true;
            } else if (Strings.same(argument, "--no-link")) {
                options.no_link = true;
            } else if (Strings.same(argument, "-o") || Strings.same(argument, "--runtime-dir") || Strings.same(argument, "--runtime-lib") || Strings.same(argument, "--link-arg")) {
                i = i + 1;
                if (i >= count) {
                    logger_error(Log.get(), "djinnc: missing value for %s", argument);
                    options.ok = false;
                    return options;
                }
                i8* value = Process.argv_or(i, "");
                if (Strings.same(argument, "-o")) {
                    options.output = value;
                    options.output_set = true;
                } else if (Strings.same(argument, "--link-arg")) {
                    ByteBuffer* link_args = options.link_args;
                    link_args.append(" \"");
                    link_args.append(value);
                    link_args.append("\"");
                } else if (Strings.same(argument, "--runtime-lib")) {
                    options.runtime_lib = value;
                } else {
                    options.runtime_dir = value;
                }
            } else if (Strings.starts_with(argument, 0, strlen(argument), "-")) {
                logger_error(Log.get(), "djinnc: unknown option '%s'", argument);
                options.ok = false;
                return options;
            } else {
                options.input = argument;
                PointerList* inputs = options.inputs;
                inputs.push((void*)argument);
            }
            i = i + 1;
        }

        PointerList* positional = options.inputs;
        if (positional.length == 1 && !Project.is_source_file(options.input)) {
            i8* directory = options.input;
            positional.truncate(0);
            options.input = null;
            if (!Project.apply(options, directory)) {
                options.ok = false;
                return options;
            }
        }

        if (options.input == null && !options.self_test) {
            options.ok = false;
        }
        return options;
    }

    public static void usage() {
        logger_error(Log.get(), "usage: djinnc <input.djinn>...|<project dir> [-o <output>] [--runtime-dir <dir>] [--runtime-lib <lib>] [--link-arg <arg>]... [--no-link]");
        logger_error(Log.get(), "              [--emit-tokens] [--emit-ast] [--emit-ir] [--keep-ir] [--lld] [-O2] [--stats] [--selftest]");
        logger_error(Log.get(), "environment: DJINN_CLANG overrides the clang executable, DJINN_LLD_LINK the lld-link executable");
    }
}
