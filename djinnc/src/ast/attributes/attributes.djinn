namespace djinnc;

unsafe static mut ptr attribute_uses = null;
unsafe static mut ptr declared_attributes = null;

struct Attributes {
    public static unsafe PointerList* all() {
        if (attribute_uses == null) {
            attribute_uses = (ptr)PointerList.create();
        }
        return (PointerList*)attribute_uses;
    }

    public static void record(AttributeUse* use) {
        PointerList* uses = Attributes.all();
        uses.push((ptr)use);
    }

    public static unsafe bool has(Node* target, ptr<i8> name) {
        PointerList* uses = Attributes.all();
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target == target && Strings.same(use.name, name)) {
                return true;
            }
        }
        return false;
    }

    public static unsafe PointerList* declared() {
        if (declared_attributes == null) {
            declared_attributes = (ptr)PointerList.create();
        }
        return (PointerList*)declared_attributes;
    }

    public static void declare(ptr<i8> name) {
        PointerList* names = Attributes.declared();
        if (!names.contains_string(name)) {
            names.push((ptr)name);
        }
    }

    public static unsafe void copy_tree(Node* from, Node* to) {
        PointerList* uses = Attributes.all();
        i32 existing = uses.length;
        for (mut i32 i = 0; i < existing; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target != from) {
                continue;
            }
            AttributeUse* copy = (AttributeUse*)Memory.zalloc(sizeof(AttributeUse));
            copy.target = to;
            copy.name = use.name;
            copy.target_kind = use.target_kind;
            copy.int_arg = use.int_arg;
            copy.text_arg = use.text_arg;
            copy.payload = use.payload;
            copy.payload_type = use.payload_type;
            copy.line = use.line;
            copy.column = use.column;
            Attributes.record(copy);
        }
        bool has_members = from.kind() == NodeKind::IMPL_DECL || from.kind() == NodeKind::FUNCTION;
        if (has_members && to.count() == from.count()) {
            for (mut i32 c = 0; c < from.count(); c = c + 1) {
                Attributes.copy_tree(from.child(c), to.child(c));
            }
        }
    }

    public static unsafe PointerList* of(Node* target) {
        PointerList* found = PointerList.create();
        PointerList* uses = Attributes.all();
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target == target) {
                found.push((ptr)use);
            }
        }
        return found;
    }

    static bool named(ptr<i8> name, ptr<i8> literal) {
        return Strings.equals(name, (i32)strlen(name), literal);
    }

    public static i32 allowed_targets(ptr<i8> name) {
        i32 callable = AttributeTarget.FUNCTION | AttributeTarget.METHOD;
        if (Attributes.named(name, "ForceInline") || Attributes.named(name, "NoInline") || Attributes.named(name, "NoReturn")
            || Attributes.named(name, "Hot") || Attributes.named(name, "Cold") || Attributes.named(name, "NoSync")
            || Attributes.named(name, "NoUnwind") || Attributes.named(name, "WillReturn") || Attributes.named(name, "NoRecurse")
            || Attributes.named(name, "InlineHint") || Attributes.named(name, "OptSize") || Attributes.named(name, "MinSize")
            || Attributes.named(name, "NoFree") || Attributes.named(name, "NoMerge") || Attributes.named(name, "Speculatable")
            || Attributes.named(name, "Pure") || Attributes.named(name, "Const")
            || Attributes.named(name, "Llvm")) {
            return callable;
        }
        if (Attributes.named(name, "Align")) {
            return AttributeTarget.STRUCT | AttributeTarget.FIELD | AttributeTarget.PARAMETER | callable;
        }
        if (Attributes.named(name, "Volatile")) {
            return AttributeTarget.FIELD | AttributeTarget.VARIABLE;
        }
        if (Attributes.named(name, "ReadOnly")) {
            return AttributeTarget.FIELD | AttributeTarget.PARAMETER;
        }
        if (Attributes.named(name, "Restrict") || Attributes.named(name, "NoCapture") || Attributes.named(name, "WriteOnly")) {
            return AttributeTarget.PARAMETER;
        }
        if (Attributes.named(name, "NonNull")) {
            return AttributeTarget.PARAMETER | AttributeTarget.RETURN_VALUE | callable;
        }
        if (Attributes.named(name, "Location")) {
            return AttributeTarget.PARAMETER | AttributeTarget.FIELD | AttributeTarget.VARIABLE;
        }
        if (Attributes.named(name, "attribute") || Attributes.named(name, "intrinsic")) {
            return AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "no_mangle") || Attributes.named(name, "sync")) {
            return callable | AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "NoMangle")) {
            return callable | AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "Reflect")) {
            return AttributeTarget.STRUCT | AttributeTarget.INTERFACE;
        }
        if (Attributes.named(name, "Deprecated")) {
            return AttributeTarget.ALL;
        }
        if (Attributes.declared().contains_string(name)) {
            return AttributeTarget.ALL;
        }
        return 0;
    }

    public static ptr<i8> llvm_name(ptr<i8> name) {
        if (Attributes.named(name, "ForceInline")) { return "alwaysinline"; }
        if (Attributes.named(name, "NoInline")) { return "noinline"; }
        if (Attributes.named(name, "NoReturn")) { return "noreturn"; }
        if (Attributes.named(name, "Hot")) { return "hot"; }
        if (Attributes.named(name, "Cold")) { return "cold"; }
        if (Attributes.named(name, "NoSync")) { return "nosync"; }
        if (Attributes.named(name, "NoUnwind")) { return "nounwind"; }
        if (Attributes.named(name, "WillReturn")) { return "willreturn"; }
        if (Attributes.named(name, "NoRecurse")) { return "norecurse"; }
        if (Attributes.named(name, "InlineHint")) { return "inlinehint"; }
        if (Attributes.named(name, "OptSize")) { return "optsize"; }
        if (Attributes.named(name, "MinSize")) { return "minsize"; }
        if (Attributes.named(name, "NoFree")) { return "nofree"; }
        if (Attributes.named(name, "NoMerge")) { return "nomerge"; }
        if (Attributes.named(name, "Speculatable")) { return "speculatable"; }
        return null;
    }

    public static ptr<i8> parameter_llvm_name(ptr<i8> name) {
        if (Attributes.named(name, "ReadOnly")) { return "readonly"; }
        if (Attributes.named(name, "WriteOnly")) { return "writeonly"; }
        if (Attributes.named(name, "Restrict")) { return "noalias"; }
        if (Attributes.named(name, "NonNull")) { return "nonnull"; }
        if (Attributes.named(name, "NoCapture")) { return "captures"; }
        if (Attributes.named(name, "Align")) { return "align"; }
        return null;
    }

    public static ptr<i8> target_name(i32 target_kind) {
        if (target_kind == AttributeTarget.FUNCTION) { return "function"; }
        if (target_kind == AttributeTarget.METHOD) { return "method"; }
        if (target_kind == AttributeTarget.STRUCT) { return "struct"; }
        if (target_kind == AttributeTarget.INTERFACE) { return "interface"; }
        if (target_kind == AttributeTarget.FIELD) { return "field"; }
        if (target_kind == AttributeTarget.PARAMETER) { return "parameter"; }
        if (target_kind == AttributeTarget.RETURN_VALUE) { return "return value"; }
        if (target_kind == AttributeTarget.VARIABLE) { return "variable"; }
        return "declaration";
    }
}
