namespace djinnc;

unsafe static mut ptr ast_base = null;
unsafe static mut ptr ast_types = null;
unsafe static mut ptr ast_lists = null;
unsafe static mut ptr ast_extra = null;
unsafe static mut ptr ast_value_types = null;
unsafe static mut ptr ast_symbols = null;
unsafe static mut ptr ast_symbol_kinds = null;
unsafe static mut ptr ast_layout = null;
unsafe static mut ptr ast_extra_sizes = null;
unsafe static mut i32 ast_count = 0;
unsafe static mut i32 ast_capacity = 0;
unsafe static mut i32 ast_extra_count = 0;
unsafe static mut i32 ast_extra_capacity = 0;

struct Ast {
    public static void init(i32 capacity) {
        Arena* arena = Memory.arena();
        ast_capacity = capacity;
        ast_count = 1;
        ast_base = calloc((u64)capacity, sizeof(Node));
        ast_types = (ptr)PointerList.create();
        ast_lists = (ptr)PointerList.create();
        ast_extra_capacity = capacity + 64;
        ast_extra_count = 1;
        ast_extra = calloc((u64)ast_extra_capacity, 4);
        ast_value_types = calloc((u64)capacity, 4);
        ast_symbols = calloc((u64)capacity, 8);
        ast_symbol_kinds = calloc((u64)capacity, 1);
        NodeLayout.build();
    }

    public static void destroy() {
        free(ast_base);
        free(ast_extra);
        free(ast_value_types);
        free(ast_symbols);
        free(ast_symbol_kinds);
        ast_base = (ptr)0;
        ast_extra = (ptr)0;
        ast_value_types = (ptr)0;
        ast_symbols = (ptr)0;
        ast_symbol_kinds = (ptr)0;
        ast_count = 0;
        ast_capacity = 0;
    }

    public static unsafe Node* at(i32 id) {
        if (id == 0) {
            return (Node*)0;
        }
        ptr<i8> base = (ptr<i8>)ast_base;
        return (Node*)(base + (u64)id * sizeof(Node));
    }

    public static i32 id_of(Node* node) {
        if (node == null) {
            return 0;
        }
        ptr<i8> base = (ptr<i8>)ast_base;
        ptr<i8> address = (ptr<i8>)node;
        return (i32)(((i64)address - (i64)base) / (i64)sizeof(Node));
    }

    public static unsafe u32 intern_base_name(ptr<i8> text, i32 length) {
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                last = i + 2;
            }
        }
        AtomTable* table = Ast.atoms();
        return table.intern_copy(text + last, (u32)(length - last));
    }

    public static AtomTable* atoms() {
        return Atoms.get();
    }

    public static i32 node_count() {
        return ast_count - 1;
    }
}
