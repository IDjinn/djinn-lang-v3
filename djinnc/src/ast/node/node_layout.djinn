namespace djinnc;

struct NodeLayout {
    public static void build() {
        Arena* arena = Memory.arena();
        ast_layout = arena.zalloc((u64)NodeKinds.COUNT * (u64)NodeField.COUNT, 1);
        ast_extra_sizes = arena.zalloc((u64)NodeKinds.COUNT, 1);

        NodeLayout.list_only(NodeKind::PROGRAM);
        NodeLayout.define(NodeKind::IMPORT, NodeField.TEXT, Slot.A);
        NodeLayout.define(NodeKind::NAMESPACE_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind::NAMESPACE_DECL, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind::FUNCTION, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::FUNCTION, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::FUNCTION, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::FUNCTION, NodeField.LIST, Slot.EXTRA + 2);
        NodeLayout.define(NodeKind::FUNCTION, NodeField.GENERICS, Slot.EXTRA + 3);
        NodeLayout.define(NodeKind::FUNCTION, NodeField.SECOND, Slot.EXTRA + 4);
        NodeLayout.define(NodeKind::EXTERN_FUNCTION, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind::EXTERN_FUNCTION, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::EXTERN_FUNCTION, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::PARAMETER, NodeField.TYPE, Slot.A);
        NodeLayout.define(NodeKind::PARAMETER, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind::STRUCT_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind::STRUCT_DECL, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::STRUCT_DECL, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::STRUCT_DECL, NodeField.GENERICS, Slot.EXTRA + 2);
        NodeLayout.define(NodeKind::INTERFACE_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind::INTERFACE_DECL, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::INTERFACE_DECL, NodeField.GENERICS, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::INSPECT_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind::INSPECT_DECL, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::IMPL_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind::IMPL_DECL, NodeField.TYPE, Slot.EXTRA);
        NodeLayout.declaration(NodeKind::FIELD_DECL);
        NodeLayout.define(NodeKind::FIELD_DECL, NodeField.LIST, Slot.EXTRA + 2);
        NodeLayout.declaration(NodeKind::STATIC_VAR);
        NodeLayout.declaration(NodeKind::VAR_DECL);
        NodeLayout.list_only(NodeKind::BLOCK);
        NodeLayout.define(NodeKind::EXPR_STMT, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::RETURN, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::THROW_STMT, NodeField.FIRST, Slot.A);
        NodeLayout.pair(NodeKind::TRY_EXPR);
        NodeLayout.define(NodeKind::IF, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::IF, NodeField.SECOND, Slot.EXTRA);
        NodeLayout.define(NodeKind::IF, NodeField.THIRD, Slot.EXTRA + 1);
        NodeLayout.pair(NodeKind::WHILE);
        NodeLayout.pair(NodeKind::DO_WHILE);
        NodeLayout.define(NodeKind::FOR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::FOR, NodeField.SECOND, Slot.EXTRA);
        NodeLayout.define(NodeKind::FOR, NodeField.THIRD, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::FOR, NodeField.FOURTH, Slot.EXTRA + 2);
        NodeLayout.define(NodeKind::SWITCH, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::SWITCH, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind::CASE, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::CASE, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind::STRUCT_INIT, NodeField.TYPE, Slot.A);
        NodeLayout.define(NodeKind::STRUCT_INIT, NodeField.LIST, Slot.B);
        NodeLayout.list_only(NodeKind::ARRAY_LITERAL);
        NodeLayout.list_only(NodeKind::INTERPOLATION);
        NodeLayout.define(NodeKind::NEW_EXPR, NodeField.TYPE, Slot.A);
        NodeLayout.define(NodeKind::NEW_EXPR, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind::FIELD_INIT, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::FIELD_INIT, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind::NAMED_ARG, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::NAMED_ARG, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind::SWITCH_EXPR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::SWITCH_EXPR, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind::MATCH_ARM, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::MATCH_ARM, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::MATCH_ARM, NodeField.LIST, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::INT_LITERAL, NodeField.TEXT, Slot.TOKEN);
        NodeLayout.define(NodeKind::INT_LITERAL, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind::INT_LITERAL, NodeField.VALUE_HIGH, Slot.B);
        NodeLayout.define(NodeKind::FLOAT_LITERAL, NodeField.TEXT, Slot.TOKEN);
        NodeLayout.define(NodeKind::FLOAT_CONST, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind::FLOAT_CONST, NodeField.VALUE_HIGH, Slot.B);
        NodeLayout.define(NodeKind::STRING_LITERAL, NodeField.TEXT, Slot.TOKEN);
        NodeLayout.define(NodeKind::STRING_LITERAL, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind::STRING_LITERAL, NodeField.VALUE_HIGH, Slot.B);
        NodeLayout.define(NodeKind::BOOL_LITERAL, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind::IDENTIFIER, NodeField.TEXT, Slot.A);
        NodeLayout.define(NodeKind::IDENTIFIER, NodeField.TYPE, Slot.B);
        NodeLayout.define(NodeKind::UNARY, NodeField.FIRST, Slot.A);
        NodeLayout.pair(NodeKind::BINARY);
        NodeLayout.pair(NodeKind::ASSIGN);
        NodeLayout.pair(NodeKind::INDEX);
        NodeLayout.define(NodeKind::CALL, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::CALL, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind::AWAIT_EXPR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::SPAWN_STMT, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::LET_EXPR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::LET_EXPR, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind::IS_EXPR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::IS_EXPR, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::IS_EXPR, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::CAST, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::CAST, NodeField.TYPE, Slot.B);
        NodeLayout.define(NodeKind::FIELD_ACCESS, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind::FIELD_ACCESS, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind::FIELD_ACCESS, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind::INTRINSIC, NodeField.TYPE, Slot.A);
        NodeLayout.define(NodeKind::INTRINSIC, NodeField.FIRST, Slot.B);
    }

    static void list_only(NodeKind kind) {
        NodeLayout.define(kind, NodeField.LIST, Slot.A);
    }

    static void pair(NodeKind kind) {
        NodeLayout.define(kind, NodeField.FIRST, Slot.A);
        NodeLayout.define(kind, NodeField.SECOND, Slot.B);
    }

    static void declaration(NodeKind kind) {
        NodeLayout.define(kind, NodeField.FIRST, Slot.A);
        NodeLayout.define(kind, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(kind, NodeField.TYPE, Slot.EXTRA + 1);
    }

    static unsafe void define(NodeKind kind, i32 field, i32 slot) {
        ptr<u8> layout = (ptr<u8>)ast_layout;
        ptr<u8> sizes = (ptr<u8>)ast_extra_sizes;
        i32 index = kind.getValue();
        layout[index * NodeField.COUNT + field] = (u8)slot;
        if (slot >= Slot.EXTRA) {
            i32 needed = slot - Slot.EXTRA + 1;
            if (needed > (i32)sizes[index]) {
                sizes[index] = (u8)needed;
            }
        }
    }

    public static unsafe i32 slot(NodeKind kind, i32 field) {
        ptr<u8> layout = (ptr<u8>)ast_layout;
        return (i32)layout[kind.getValue() * NodeField.COUNT + field];
    }

    public static unsafe i32 extra_size(NodeKind kind) {
        ptr<u8> sizes = (ptr<u8>)ast_extra_sizes;
        return (i32)sizes[kind.getValue()];
    }
}
