namespace djinnc;

impl CodeGenerator {
    ptr coerce(Value* source, u32 target) {
        u32 from = source.type;
        ptr ref = source.ref;
        if (target == 0 || from == target) {
            return ref;
        }
        u32 boxed = this.symbols_core_type("object");
        if (boxed != 0 && target == boxed) {
            return this.box_value(source);
        }
        ptr destination = this.llvm_type(target);
        SymbolTable* symbols = this.symbols;
        if (Types.is_pointer(from) && symbols.nullable_payload(target) == from) {
            ptr wrapped = this.create_slot(target, "nullable.value");
            LLVMBuildStore(this.builder, ref, LLVMBuildStructGEP2(this.builder, destination, wrapped, 0, "nullable.slot"));
            return LLVMBuildLoad2(this.builder, destination, wrapped, "nullable.load");
        }

        bool to_flag = Types.is_integer(target) && Types.bits(target) == 1;
        if (to_flag && (Types.is_float(from) || (Types.is_integer(from) && Types.bits(from) > 1))) {
            return this.to_condition(source);
        }

        if (Types.is_integer(from) && Types.is_integer(target)) {
            if (Types.bits(from) == Types.bits(target)) {
                return ref;
            }
            if (Types.bits(from) > Types.bits(target)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_TRUNC, ref, destination, "trunc");
            }
            if (Types.is_signed(from) && Types.bits(from) > 1) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_SEXT, ref, destination, "sext");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_ZEXT, ref, destination, "zext");
        }
        if (Types.is_integer(from) && Types.is_float(target)) {
            if (Types.is_signed(from)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_SITOFP, ref, destination, "sitofp");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_UITOFP, ref, destination, "uitofp");
        }
        if (Types.is_float(from) && Types.is_integer(target)) {
            if (Types.is_signed(target)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_FPTOSI, ref, destination, "fptosi");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_FPTOUI, ref, destination, "fptoui");
        }
        if (Types.is_float(from) && Types.is_float(target)) {
            if (Types.bits(from) == Types.bits(target)) {
                return ref;
            }
            if (Types.bits(from) < Types.bits(target)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_FPEXT, ref, destination, "fpext");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_FPTRUNC, ref, destination, "fptrunc");
        }
        if (Types.is_integer(from) && Types.is_pointer(target)) {
            return LLVMBuildCast(this.builder, LlvmConst.OP_INTTOPTR, ref, destination, "inttoptr");
        }
        if (Types.is_pointer(from) && Types.is_integer(target)) {
            return LLVMBuildCast(this.builder, LlvmConst.OP_PTRTOINT, ref, destination, "ptrtoint");
        }
        return ref;
    }

    ptr to_condition(Value* source) {
        u32 type = source.type;
        ptr ref = source.ref;
        if (Types.is_integer(type) && Types.bits(type) == 1) {
            return ref;
        }
        ptr zero = LLVMConstNull(LLVMTypeOf(ref));
        if (Types.is_float(type)) {
            return LLVMBuildFCmp(this.builder, LlvmConst.REAL_UNE, ref, zero, "tobool");
        }
        return LLVMBuildICmp(this.builder, LlvmConst.INT_NE, ref, zero, "tobool");
    }

    Value* gen_unary(Node* node) {
        TokenKind op = node.op_kind();

        if (op == TokenKind::AMPERSAND) {
            return Value.create(this.gen_address(node.first()), node.value_type());
        }
        if (op == TokenKind::STAR) {
            return this.load_through(this.gen_address(node), node.value_type());
        }

        if (op == TokenKind::PLUS_PLUS || op == TokenKind::MINUS_MINUS) {
            return this.gen_count(node);
        }

        if (node.symbol_kind() == SymbolKind.OPERATOR) {
            return this.gen_operator_call(node, false);
        }

        Value* operand = this.gen_expression(node.first());
        u32 type = operand.type;
        if (op == TokenKind::MINUS) {
            if (Types.is_float(type)) {
                return Value.create(LLVMBuildFNeg(this.builder, operand.ref, "neg"), type);
            }
            return Value.create(LLVMBuildNeg(this.builder, operand.ref, "neg"), type);
        }
        if (op == TokenKind::TILDE) {
            return Value.create(LLVMBuildNot(this.builder, operand.ref, "not"), type);
        }
        ptr condition = this.to_condition(operand);
        return Value.create(LLVMBuildNot(this.builder, condition, "lnot"), Types.bool_type());
    }

    unsafe Value* gen_count(Node* node) {
        bool increment = node.op_kind() == TokenKind::PLUS_PLUS;
        u32 type = node.value_type();
        ptr llvm = this.llvm_type(type);
        ptr address = this.gen_address(node.first());
        ptr before = LLVMBuildLoad2(this.builder, llvm, address, "count.old");
        this.mark_volatile(before, node.first());
        mut ptr after = (ptr)0;
        if (Types.is_pointer(type)) {
            mut i64 step = 1;
            if (!increment) {
                step = 0 - 1;
            }
            ptr<ptr> indices = CodeGenerator.array_of(1);
            indices[0] = LLVMConstInt(LLVMIntTypeInContext(this.context, 64), (u64)step, 1);
            after = LLVMBuildGEP2(this.builder, LLVMIntTypeInContext(this.context, 8), before, indices, 1, "count.ptr");
        } else if (Types.is_float(type)) {
            ptr one = LLVMConstReal(llvm, 1.0);
            if (increment) {
                after = LLVMBuildFAdd(this.builder, before, one, "count.new");
            } else {
                after = LLVMBuildFSub(this.builder, before, one, "count.new");
            }
        } else {
            ptr one = LLVMConstInt(llvm, 1, 0);
            if (increment) {
                after = LLVMBuildAdd(this.builder, before, one, "count.new");
            } else {
                after = LLVMBuildSub(this.builder, before, one, "count.new");
            }
        }
        ptr count_store = LLVMBuildStore(this.builder, after, address);
        this.mark_volatile(count_store, node.first());
        if (node.flag()) {
            return Value.create(before, type);
        }
        return Value.create(after, type);
    }

    unsafe Value* gen_assign(Node* node) {
        Node* target = node.first();
        if (target.kind() == NodeKind::IDENTIFIER && target.symbol_kind() == SymbolKind.IMPLICIT_SET) {
            FunctionInfo* implicit_setter = (FunctionInfo*)target.symbol();
            IdList* implicit_parameters = implicit_setter.param_types;
            u32 implicit_held = implicit_parameters.get(1);
            ptr<ptr> implicit_args = CodeGenerator.array_of(2);
            implicit_args[0] = this.implicit_receiver();
            Value* implicit_assigned = this.gen_expression(node.second());
            implicit_args[1] = this.coerce(implicit_assigned, implicit_held);
            LLVMBuildCall2(this.builder, implicit_setter.function_type, implicit_setter.function, implicit_args, 2, "");
            return Value.create(implicit_args[1], implicit_held);
        }
        if (target.kind() == NodeKind::FIELD_ACCESS && target.symbol_kind() == SymbolKind.PROPERTY_SET) {
            FunctionInfo* setter = (FunctionInfo*)target.symbol();
            IdList* parameters = setter.param_types;
            u32 held = parameters.get(1);
            ptr<ptr> args = CodeGenerator.array_of(2);
            args[0] = this.method_receiver(setter.owner, target.first());
            Value* assigned = this.gen_expression(node.second());
            args[1] = this.coerce(assigned, held);
            LLVMBuildCall2(this.builder, setter.function_type, setter.function, args, 2, "");
            return Value.create(args[1], held);
        }
        if (target.kind() == NodeKind::INDEX && target.symbol_kind() == SymbolKind.INDEX_SET) {
            return this.gen_index_set(node);
        }
        ptr address = this.gen_address(node.first());
        u32 element = node.value_type();
        Value* value = this.gen_expression(node.second());
        ptr stored = this.coerce(value, element);
        ptr store = LLVMBuildStore(this.builder, stored, address);
        this.mark_volatile(store, node.first());
        return Value.create(stored, element);
    }

    unsafe Value* gen_logical(Node* node) {
        bool is_and = node.op_kind() == TokenKind::AND_AND;
        u32 flag = Types.bool_type();
        ptr left = this.to_condition(this.gen_expression(node.first()));
        ptr left_block = LLVMGetInsertBlock(this.builder);
        ptr right_block = this.new_block("logic.rhs");
        ptr end_block = this.new_block("logic.end");

        if (is_and) {
            LLVMBuildCondBr(this.builder, left, right_block, end_block);
        } else {
            LLVMBuildCondBr(this.builder, left, end_block, right_block);
        }

        LLVMPositionBuilderAtEnd(this.builder, right_block);
        ptr right = this.to_condition(this.gen_expression(node.second()));
        ptr right_end = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, end_block);

        LLVMPositionBuilderAtEnd(this.builder, end_block);
        ptr merged = LLVMBuildPhi(this.builder, this.llvm_type(flag), "logic");
        ptr<ptr> values = CodeGenerator.array_of(2);
        ptr<ptr> blocks = CodeGenerator.array_of(2);
        mut u64 shortcut = 1;
        if (is_and) {
            shortcut = 0;
        }
        values[0] = LLVMConstInt(this.llvm_type(flag), shortcut, 0);
        blocks[0] = left_block;
        values[1] = right;
        blocks[1] = right_end;
        LLVMAddIncoming(merged, values, blocks, 2);
        return Value.create(merged, flag);
    }

    unsafe Value* gen_coalesce(Node* node) {
        Value* left = this.gen_expression(node.first());
        u32 type = left.type;
        ptr present = LLVMBuildICmp(this.builder, LlvmConst.INT_NE, left.ref, LLVMConstNull(LLVMTypeOf(left.ref)), "present");
        ptr left_block = LLVMGetInsertBlock(this.builder);
        ptr right_block = this.new_block("coalesce.rhs");
        ptr end_block = this.new_block("coalesce.end");
        LLVMBuildCondBr(this.builder, present, end_block, right_block);

        LLVMPositionBuilderAtEnd(this.builder, right_block);
        ptr right = this.coerce(this.gen_expression(node.second()), type);
        ptr right_end = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, end_block);

        LLVMPositionBuilderAtEnd(this.builder, end_block);
        ptr merged = LLVMBuildPhi(this.builder, this.llvm_type(type), "coalesce");
        ptr<ptr> values = CodeGenerator.array_of(2);
        ptr<ptr> blocks = CodeGenerator.array_of(2);
        values[0] = left.ref;
        blocks[0] = left_block;
        values[1] = right;
        blocks[1] = right_end;
        LLVMAddIncoming(merged, values, blocks, 2);
        return Value.create(merged, type);
    }

    Value* gen_binary(Node* node) {
        TokenKind op = node.op_kind();
        if (op == TokenKind::QUESTION_QUESTION) {
            return this.gen_coalesce(node);
        }
        i32 symbol = node.symbol_kind();
        if (symbol == SymbolKind.OPERATOR || symbol == SymbolKind.NEGATED_OPERATOR) {
            return this.gen_operator_call(node, symbol == SymbolKind.NEGATED_OPERATOR);
        }
        if (op == TokenKind::AND_AND || op == TokenKind::OR_OR) {
            return this.gen_logical(node);
        }

        Value* left = this.gen_expression(node.first());
        Value* right = this.gen_expression(node.second());

        if (Types.is_pointer(left.type) && Types.is_integer(right.type)
            && (op == TokenKind::PLUS || op == TokenKind::MINUS)) {
            return this.gen_pointer_offset(node, left, right);
        }

        u32 common = Types.common(left.type, right.type);
        ptr lhs = this.coerce(left, common);
        ptr rhs = this.coerce(right, common);

        if (TypeChecker.is_comparison(op)) {
            return this.gen_comparison(node, common, lhs, rhs);
        }
        return this.gen_arithmetic(node, common, lhs, rhs);
    }

    unsafe Value* gen_pointer_offset(Node* node, Value* pointer, Value* offset) {
        mut ptr amount = this.coerce(offset, Types.i64_type());
        if (node.op_kind() == TokenKind::MINUS) {
            amount = LLVMBuildNeg(this.builder, amount, "negoffset");
        }
        ptr<ptr> indices = CodeGenerator.array_of(1);
        indices[0] = amount;
        ptr byte_type = LLVMIntTypeInContext(this.context, 8);
        ptr moved = LLVMBuildGEP2(this.builder, byte_type, pointer.ref, indices, 1, "ptradd");
        return Value.create(moved, pointer.type);
    }

    Value* gen_comparison(Node* node, u32 common, ptr lhs, ptr rhs) {
        TokenKind op = node.op_kind();
        u32 flag = Types.bool_type();

        if (Types.is_float(common)) {
            mut i32 real = LlvmConst.REAL_OEQ;
            if (op == TokenKind::BANG_EQUAL) { real = LlvmConst.REAL_UNE; }
            if (op == TokenKind::LESS) { real = LlvmConst.REAL_OLT; }
            if (op == TokenKind::LESS_EQUAL) { real = LlvmConst.REAL_OLE; }
            if (op == TokenKind::GREATER) { real = LlvmConst.REAL_OGT; }
            if (op == TokenKind::GREATER_EQUAL) { real = LlvmConst.REAL_OGE; }
            return Value.create(LLVMBuildFCmp(this.builder, real, lhs, rhs, "fcmp"), flag);
        }

        bool is_signed = Types.is_integer(common) && Types.is_signed(common);
        mut i32 predicate = LlvmConst.INT_EQ;
        if (op == TokenKind::BANG_EQUAL) { predicate = LlvmConst.INT_NE; }
        if (op == TokenKind::LESS) { predicate = LlvmConst.INT_ULT; }
        if (op == TokenKind::LESS_EQUAL) { predicate = LlvmConst.INT_ULE; }
        if (op == TokenKind::GREATER) { predicate = LlvmConst.INT_UGT; }
        if (op == TokenKind::GREATER_EQUAL) { predicate = LlvmConst.INT_UGE; }
        if (is_signed) {
            if (op == TokenKind::LESS) { predicate = LlvmConst.INT_SLT; }
            if (op == TokenKind::LESS_EQUAL) { predicate = LlvmConst.INT_SLE; }
            if (op == TokenKind::GREATER) { predicate = LlvmConst.INT_SGT; }
            if (op == TokenKind::GREATER_EQUAL) { predicate = LlvmConst.INT_SGE; }
        }
        return Value.create(LLVMBuildICmp(this.builder, predicate, lhs, rhs, "icmp"), flag);
    }

    Value* gen_arithmetic(Node* node, u32 common, ptr lhs, ptr rhs) {
        TokenKind op = node.op_kind();
        ptr builder = this.builder;
        bool is_signed = Types.is_signed(common);

        if (Types.is_float(common)) {
            return switch op {
                PLUS -> Value.create(LLVMBuildFAdd(builder, lhs, rhs, "fadd"), common),
                MINUS -> Value.create(LLVMBuildFSub(builder, lhs, rhs, "fsub"), common),
                STAR -> Value.create(LLVMBuildFMul(builder, lhs, rhs, "fmul"), common),
                SLASH -> Value.create(LLVMBuildFDiv(builder, lhs, rhs, "fdiv"), common),
                _ -> Value.create(LLVMBuildFRem(builder, lhs, rhs, "frem"), common)
            };
        }

        return switch op {
            PLUS -> Value.create(LLVMBuildAdd(builder, lhs, rhs, "add"), common),
            MINUS -> Value.create(LLVMBuildSub(builder, lhs, rhs, "sub"), common),
            STAR -> Value.create(LLVMBuildMul(builder, lhs, rhs, "mul"), common),
            AMPERSAND -> Value.create(LLVMBuildAnd(builder, lhs, rhs, "and"), common),
            PIPE -> Value.create(LLVMBuildOr(builder, lhs, rhs, "or"), common),
            CARET -> Value.create(LLVMBuildXor(builder, lhs, rhs, "xor"), common),
            LESS_LESS -> this.gen_shift_left(node, common, lhs, rhs),
            SLASH -> this.gen_division(node, is_signed, common, lhs, rhs),
            PERCENT -> this.gen_remainder(node, is_signed, common, lhs, rhs),
            GREATER_GREATER -> this.gen_shift_right(node, is_signed, common, lhs, rhs),
            _ -> this.unsupported_arithmetic(node, common, lhs)
        };
    }

    // x % -1 is always 0, but srem of the minimum value by -1 is undefined and traps on x86, while x % 1 is also 0.
    ptr remainder_divisor(ptr rhs) {
        ptr type = LLVMTypeOf(rhs);
        ptr minus_one = LLVMConstInt(type, (u64)(0 - 1), 1);
        ptr is_minus_one = LLVMBuildICmp(this.builder, LlvmConst.INT_EQ, rhs, minus_one, "rem.minus_one");
        return LLVMBuildSelect(this.builder, is_minus_one, LLVMConstInt(type, 1, 0), rhs, "rem.divisor");
    }

    unsafe void stop_when(ptr failed, Node* node, ptr<i8> message) {
        if (LLVMIsConstant(failed) != 0 && LLVMIsNull(failed) != 0) {
            return;
        }
        ptr stopped = this.new_block("check.failed");
        ptr valid = this.new_block("check.valid");
        LLVMBuildCondBr(this.builder, failed, stopped, valid);
        LLVMPositionBuilderAtEnd(this.builder, stopped);
        this.call_panic(this.string_constant(message), node);
        LLVMBuildUnreachable(this.builder);
        LLVMPositionBuilderAtEnd(this.builder, valid);
    }

    void check_divisor(Node* node, ptr rhs) {
        ptr is_zero = LLVMBuildICmp(this.builder, LlvmConst.INT_EQ, rhs, LLVMConstNull(LLVMTypeOf(rhs)), "div.zero");
        this.stop_when(is_zero, node, "division by zero");
    }

    void check_shift(Node* node, u32 common, ptr rhs) {
        ptr width = LLVMConstInt(LLVMTypeOf(rhs), (u64)Types.bits(common), 0);
        ptr too_far = LLVMBuildICmp(this.builder, LlvmConst.INT_UGE, rhs, width, "shift.range");
        this.stop_when(too_far, node, "shift amount is out of range");
    }

    static f64 power_of_two(u32 exponent) {
        mut f64 power = 1.0;
        for (mut u32 i = 0; i < exponent; i = i + 1) {
            power = power * 2.0;
        }
        return power;
    }

    // Truncation keeps values just outside the limits valid, so the signed lower limit is one below the minimum when the
    // float can hold that value, and the minimum itself when it cannot.
    void check_float_cast(Node* node, Value* source, u32 target) {
        u32 from = source.type;
        if (!Types.is_float(from) || !Types.is_integer(target) || Types.bits(target) == 1) {
            return;
        }
        u32 bits = Types.bits(target);
        mut u32 mantissa = 53;
        if (Types.bits(from) == 32) {
            mantissa = 24;
        }
        mut f64 upper = CodeGenerator.power_of_two(bits);
        mut f64 lower = 0.0 - 1.0;
        mut i32 lower_predicate = LlvmConst.REAL_OGT;
        if (Types.is_signed(target)) {
            upper = upper / 2.0;
            lower = 0.0 - upper;
            if (bits <= mantissa) {
                lower = lower - 1.0;
            } else {
                lower_predicate = LlvmConst.REAL_OGE;
            }
        }
        ptr value = source.ref;
        ptr type = LLVMTypeOf(value);
        ptr above = LLVMBuildFCmp(this.builder, lower_predicate, value, LLVMConstReal(type, lower), "cast.above");
        ptr below = LLVMBuildFCmp(this.builder, LlvmConst.REAL_OLT, value, LLVMConstReal(type, upper), "cast.below");
        ptr in_range = LLVMBuildAnd(this.builder, above, below, "cast.in_range");
        this.stop_when(LLVMBuildNot(this.builder, in_range, "cast.invalid"), node, "float value is out of range for the integer type");
    }

    unsafe void check_division_overflow(Node* node, u32 common, ptr lhs, ptr rhs) {
        ptr type = LLVMTypeOf(rhs);
        ptr is_minus_one = LLVMBuildICmp(this.builder, LlvmConst.INT_EQ, rhs, LLVMConstInt(type, (u64)(0 - 1), 1), "div.minus_one");
        if (LLVMIsConstant(is_minus_one) != 0 && LLVMIsNull(is_minus_one) != 0) {
            return;
        }
        ptr minimum = LLVMBuildShl(this.builder, LLVMConstInt(type, 1, 0), LLVMConstInt(type, (u64)Types.bits(common) - 1, 0), "div.minimum");
        ptr is_minimum = LLVMBuildICmp(this.builder, LlvmConst.INT_EQ, lhs, minimum, "div.is_minimum");
        ptr overflow = LLVMBuildAnd(this.builder, is_minus_one, is_minimum, "div.overflow");
        this.stop_when(overflow, node, "integer overflow: the minimum value divided by -1");
    }

    Value* gen_division(Node* node, bool is_signed, u32 common, ptr lhs, ptr rhs) {
        this.check_divisor(node, rhs);
        if (is_signed) {
            this.check_division_overflow(node, common, lhs, rhs);
            return Value.create(LLVMBuildSDiv(this.builder, lhs, rhs, "sdiv"), common);
        }
        return Value.create(LLVMBuildUDiv(this.builder, lhs, rhs, "udiv"), common);
    }

    Value* gen_remainder(Node* node, bool is_signed, u32 common, ptr lhs, ptr rhs) {
        this.check_divisor(node, rhs);
        if (is_signed) { return Value.create(LLVMBuildSRem(this.builder, lhs, this.remainder_divisor(rhs), "srem"), common); }
        return Value.create(LLVMBuildURem(this.builder, lhs, rhs, "urem"), common);
    }

    Value* gen_shift_left(Node* node, u32 common, ptr lhs, ptr rhs) {
        this.check_shift(node, common, rhs);
        return Value.create(LLVMBuildShl(this.builder, lhs, rhs, "shl"), common);
    }

    Value* gen_shift_right(Node* node, bool is_signed, u32 common, ptr lhs, ptr rhs) {
        this.check_shift(node, common, rhs);
        if (is_signed) { return Value.create(LLVMBuildAShr(this.builder, lhs, rhs, "ashr"), common); }
        return Value.create(LLVMBuildLShr(this.builder, lhs, rhs, "lshr"), common);
    }

    Value* unsupported_arithmetic(Node* node, u32 common, ptr lhs) {
        this.error_code(node, DiagnosticErrors.CODEGEN_NOT_SUPPORTED, "binary operator is not supported by code generation yet");
        return Value.create(lhs, common);
    }

    Value* promote_variadic(Value* argument) {
        u32 type = argument.type;
        if (Types.is_integer(type) && Types.bits(type) < 32) {
            u32 wide = Types.integer(32, Types.is_signed(type));
            return Value.create(this.coerce(argument, wide), wide);
        }
        if (Types.is_float(type) && Types.bits(type) < 64) {
            u32 wide = Types.floating(64);
            return Value.create(this.coerce(argument, wide), wide);
        }
        return argument;
    }
}
