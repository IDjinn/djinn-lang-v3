namespace djinnc;

impl CodeGenerator {
    unsafe ptr allocate_bytes(ptr size) {
        ptr i64_type = LLVMIntTypeInContext(this.context, 64);
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr<ptr> params = CodeGenerator.array_of(1);
        params[0] = i64_type;
        ptr allocator_type = LLVMFunctionType(pointer_llvm, params, 1, 0);
        mut ptr allocator = LLVMGetNamedFunction(this.module, "__djinn_malloc");
        if (allocator == null) {
            allocator = LLVMAddFunction(this.module, "__djinn_malloc", allocator_type);
            this.mark_allocator(allocator);
        }
        ptr<ptr> args = CodeGenerator.array_of(1);
        args[0] = size;
        return LLVMBuildCall2(this.builder, allocator_type, allocator, args, 1, "alloc");
    }

    unsafe ptr allocate_aligned(ptr size, u32 alignment) {
        if (alignment <= 16) {
            return this.allocate_bytes(size);
        }
        ptr i64_type = LLVMIntTypeInContext(this.context, 64);
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr<ptr> params = CodeGenerator.array_of(2);
        params[0] = i64_type;
        params[1] = i64_type;
        ptr allocator_type = LLVMFunctionType(pointer_llvm, params, 2, 0);
        mut ptr allocator = LLVMGetNamedFunction(this.module, "__djinn_malloc_aligned");
        if (allocator == null) {
            allocator = LLVMAddFunction(this.module, "__djinn_malloc_aligned", allocator_type);
            this.mark_allocator(allocator);
        }
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = size;
        args[1] = LLVMConstInt(i64_type, (u64)alignment, 0);
        return LLVMBuildCall2(this.builder, allocator_type, allocator, args, 2, "alloc.aligned");
    }

    unsafe u64 name_hash(ptr<i8> text) {
        mut u64 hash = 2166136261;
        for (mut i32 i = 0; text[i] != 0; i = i + 1) {
            hash = ((hash ^ (u64)(u8)text[i]) * 16777619) & 4294967295;
        }
        return hash;
    }

    u64 type_hash(u32 type) {
        SymbolTable* symbols = this.symbols;
        ByteBuffer* name = ByteBuffer.create();
        symbols.describe_type(type, name);
        return this.name_hash(name.cstr());
    }

    i32 type_kind(u32 type) {
        SymbolTable* kinds = this.symbols;
        StructInfo* enumeration = kinds.enum_of_type(type);
        if (enumeration != null) {
            if (enumeration.has_payload) {
                return ReflectionKind.UNION;
            }
            return ReflectionKind.ENUM;
        }
        if (Types.is_pointer(type)) {
            return ReflectionKind.POINTER;
        }
        if (Types.is_float(type)) {
            return ReflectionKind.FLOAT;
        }
        if (Types.is_integer(type)) {
            if (Types.is_signed(type)) {
                return ReflectionKind.SIGNED;
            }
            return ReflectionKind.UNSIGNED;
        }
        if (Types.is_struct(type)) {
            SymbolTable* symbols = this.symbols;
            StructInfo* info = symbols.struct_at(Types.struct_index(type));
            if (Strings.same(info.name, "str")) {
                return ReflectionKind.STR;
            }
            if (Strings.same(info.name, "string")) {
                return ReflectionKind.STRING;
            }
        }
        return ReflectionKind.STRUCT;
    }

    unsafe ptr base_type_info(u32 type, ptr<i8> name, bool reflected) {
        u32 info_type = this.symbols_core_type("TypeInfo");
        ptr info_llvm = this.llvm_type(info_type);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        mut u64 flags = 0;
        if (reflected) {
            flags = (u64)ReflectionKind.TYPE_REFLECTED;
        }
        ptr<ptr> values = CodeGenerator.array_of(5);
        values[0] = LLVMConstInt(i32_type, this.type_hash(type), 0);
        values[1] = LLVMConstInt(i32_type, LLVMABISizeOfType(this.layout_data, this.llvm_type(type)), 0);
        values[2] = LLVMBuildGlobalStringPtr(this.builder, name, "typeinfo.name");
        values[3] = LLVMConstInt(LLVMIntTypeInContext(this.context, 8), (u64)this.type_kind(type), 0);
        values[4] = LLVMConstInt(LLVMIntTypeInContext(this.context, 8), flags, 0);
        return LLVMConstNamedStruct(info_llvm, values, 5);
    }

    ptr type_info_of(u32 type) {
        SymbolTable* symbols = this.symbols;
        StructInfo* declared = this.reflectable_info(type);
        if (declared != null && declared.type_info != null) {
            return declared.type_info;
        }
        ByteBuffer* name = ByteBuffer.create();
        symbols.describe_type(type, name);
        ByteBuffer* global_name = ByteBuffer.create();
        global_name.append("__typeinfo_");
        global_name.append(name.cstr());
        ptr existing = LLVMGetNamedGlobal(this.module, global_name.cstr());
        if (existing != null) {
            if (declared != null) {
                declared.type_info = existing;
            }
            return existing;
        }
        bool reflected = this.is_reflected(type);
        mut ptr initializer = this.base_type_info(type, name.cstr(), reflected);
        if (reflected) {
            initializer = this.extended_type_info(type, initializer);
        }
        ptr global = LLVMAddGlobal(this.module, LLVMTypeOf(initializer), global_name.cstr());
        LLVMSetInitializer(global, initializer);
        LLVMSetGlobalConstant(global, 1);
        this.make_linkonce(global, global_name.cstr());
        if (declared != null) {
            declared.type_info = global;
        }
        return global;
    }

    unsafe FunctionInfo* formatter_of(u32 type) {
        if (!Types.is_struct(type)) {
            return (FunctionInfo*)0;
        }
        StructInfo* owner = this.struct_of(type);
        if (owner.contracts == null) {
            return (FunctionInfo*)0;
        }
        PointerList* contracts = owner.contracts;
        mut bool formattable = false;
        for (mut i32 i = 0; i < contracts.length; i = i + 1) {
            InterfaceInfo* contract = (InterfaceInfo*)contracts.get(i);
            if (Strings.same(contract.name, "IFormatable")) {
                formattable = true;
            }
        }
        if (!formattable) {
            return (FunctionInfo*)0;
        }
        SymbolTable* symbols = this.symbols;
        FunctionInfo* method = symbols.find_method(owner, Ast.intern_base_name("format", 6));
        if (method == null || method.return_type != this.symbols_core_type("string")) {
            return (FunctionInfo*)0;
        }
        return method;
    }

    unsafe Value* terminate_text(Value* source, ptr<i8> method_name) {
        SymbolTable* symbols = this.symbols;
        StructInfo* helper = symbols.find_core_struct(Ast.intern_base_name("Reflection", 10));
        FunctionInfo* terminate = symbols.find_method(helper, Ast.intern_base_name(method_name, (i32)strlen(method_name)));
        ptr<ptr> terminate_args = CodeGenerator.array_of(1);
        terminate_args[0] = source.ref;
        ptr cstring = LLVMBuildCall2(this.builder, terminate.function_type, terminate.function, terminate_args, 1, "text.terminated");
        return Value.create(cstring, terminate.return_type);
    }

    unsafe Value* format_for_boxing(Value* source) {
        if (source.type == this.symbols_core_type("string")) {
            return this.terminate_text(source, "terminated");
        }
        if (source.type == this.symbols_core_type("str")) {
            return this.terminate_text(source, "terminated_view");
        }
        FunctionInfo* formatter = this.formatter_of(source.type);
        if (formatter == null) {
            return source;
        }
        ptr receiver = this.create_slot(source.type, "format.receiver");
        LLVMBuildStore(this.builder, source.ref, receiver);
        ptr<ptr> args = CodeGenerator.array_of(1);
        args[0] = receiver;
        ptr text = LLVMBuildCall2(this.builder, formatter.function_type, formatter.function, args, 1, "format");
        SymbolTable* symbols = this.symbols;
        StructInfo* helper = symbols.find_core_struct(Ast.intern_base_name("Reflection", 10));
        FunctionInfo* terminate = symbols.find_method(helper, Ast.intern_base_name("terminated", 10));
        ptr<ptr> terminate_args = CodeGenerator.array_of(1);
        terminate_args[0] = text;
        ptr cstring = LLVMBuildCall2(this.builder, terminate.function_type, terminate.function, terminate_args, 1, "format.text");
        return Value.create(cstring, terminate.return_type);
    }

    ptr box_value(Value* source) {
        u32 boxed = this.symbols_core_type("object");
        ptr object_llvm = this.llvm_type(boxed);
        ptr memory = this.allocate_bytes(LLVMSizeOf(this.llvm_type(source.type)));
        LLVMBuildStore(this.builder, source.ref, memory);
        ptr slot = this.create_slot(boxed, "boxed");
        LLVMBuildStore(this.builder, this.type_info_of(source.type), LLVMBuildStructGEP2(this.builder, object_llvm, slot, 0, "boxed.type"));
        LLVMBuildStore(this.builder, memory, LLVMBuildStructGEP2(this.builder, object_llvm, slot, 1, "boxed.data"));
        return LLVMBuildLoad2(this.builder, object_llvm, slot, "boxed.value");
    }

    unsafe Value* gen_is_variant(Node* node) {
        IsPattern* pattern = (IsPattern*)node.symbol();
        Node* variant = pattern.variant;
        Value* subject = this.gen_expression(node.first());
        u32 subject_type = subject.type;
        ptr enum_llvm = this.llvm_type(subject_type);
        mut ptr tag = subject.ref;
        mut ptr spill = (ptr)0;
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        if (Types.is_struct(subject_type)) {
            spill = this.create_slot(subject_type, "is.subject");
            LLVMBuildStore(this.builder, subject.ref, spill);
            tag = this.load_tag(subject_type, enum_llvm, spill, "is.tag");
        }
        Node* tag_value = variant.first();
        ptr expected = LLVMConstInt(i32_type, (u64)tag_value.int_value(), 0);
        ptr matches = LLVMBuildICmp(this.builder, LlvmConst.INT_EQ, tag, expected, "is.match");
        PointerList* bindings = pattern.bindings;
        if (bindings.length > 0) {
            ptr bind_block = this.new_block("is.bind");
            ptr end_block = this.new_block("is.end");
            LLVMBuildCondBr(this.builder, matches, bind_block, end_block);
            LLVMPositionBuilderAtEnd(this.builder, bind_block);
            for (mut i32 b = 0; b < bindings.length; b = b + 1) {
                LocalVariable* variable = (LocalVariable*)bindings.get(b);
                variable.slot = this.create_slot(variable.type, variable.name);
                ptr address = this.payload_address(subject_type, enum_llvm, spill, variant, b);
                ptr loaded = LLVMBuildLoad2(this.builder, this.llvm_type(variable.type), address, "is.bound");
                LLVMBuildStore(this.builder, loaded, variable.slot);
                this.declare_variable(variable.slot, variable.name, variable.type, node, 0);
            }
            LLVMBuildBr(this.builder, end_block);
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
        return Value.create(matches, Types.bool_type());
    }

    unsafe Value* gen_is(Node* node) {
        if (node.symbol_kind() == SymbolKind.CONSTANT) {
            return this.gen_is_variant(node);
        }
        LocalVariable* variable = (LocalVariable*)node.symbol();
        Value* operand = this.gen_expression(node.first());
        u32 info_type = this.symbols_core_type("TypeInfo");
        ptr info_pointer = LLVMBuildExtractValue(this.builder, operand.ref, 0, "is.info");
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr id_address = LLVMBuildStructGEP2(this.builder, this.llvm_type(info_type), info_pointer, 0, "is.id.ptr");
        ptr id = LLVMBuildLoad2(this.builder, i32_type, id_address, "is.id");
        ptr expected = LLVMConstInt(i32_type, this.type_hash(variable.type), 0);
        ptr matches = LLVMBuildICmp(this.builder, LlvmConst.INT_EQ, id, expected, "is.match");
        if (node.flag()) {
            variable.slot = this.create_slot(variable.type, variable.name);
            ptr bind_block = this.new_block("is.bind");
            ptr end_block = this.new_block("is.end");
            LLVMBuildCondBr(this.builder, matches, bind_block, end_block);
            LLVMPositionBuilderAtEnd(this.builder, bind_block);
            ptr data = LLVMBuildExtractValue(this.builder, operand.ref, 1, "is.data");
            ptr loaded = LLVMBuildLoad2(this.builder, this.llvm_type(variable.type), data, "is.value");
            LLVMBuildStore(this.builder, loaded, variable.slot);
            LLVMBuildBr(this.builder, end_block);
            LLVMPositionBuilderAtEnd(this.builder, end_block);
            this.declare_variable(variable.slot, variable.name, variable.type, node, 0);
        }
        return Value.create(matches, Types.bool_type());
    }
}
