namespace djinnc;

impl CodeGenerator {
    unsafe void declare_functions() {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (info.is_template) {
                continue;
            }
            IdList* param_types = info.param_types;
            i32 count = param_types.length;
            ptr<ptr> params = CodeGenerator.array_of(count);
            for (mut i32 p = 0; p < count; p = p + 1) {
                params[p] = this.llvm_type(param_types.get(p));
            }

            if (info.has_throws) {
                this.prepare_result(info);
            }
            mut ptr return_type = this.llvm_type(info.return_type);
            if (info.is_async) {
                return_type = LLVMPointerTypeInContext(this.context, 0);
            } else if (info.has_throws) {
                return_type = info.result_type;
            }
            mut i32 variadic = 0;
            if (info.is_variadic) {
                variadic = 1;
            }
            info.function_type = LLVMFunctionType(return_type, params, (u32)count, variadic);

            mut ptr<i8> symbol = info.name;
            if (!info.is_extern && info.owner == null && info.name_atom == Atoms.MAIN_ATOM) {
                symbol = "__djinn_sync_main";
            }
            mut ptr existing = (ptr)0;
            if (info.is_extern) {
                existing = LLVMGetNamedFunction(this.module, symbol);
            }
            if (existing != null) {
                info.function = existing;
            } else {
                info.function = LLVMAddFunction(this.module, symbol, info.function_type);
                this.apply_attributes(info);
                if (!info.is_extern) {
                    this.share_definition(info);
                }
            }
        }
    }

    unsafe void declare_globals() {
        SymbolTable* symbols = this.symbols;
        PointerList* globals = symbols.globals;
        for (mut i32 i = 0; i < globals.length; i = i + 1) {
            LocalVariable* variable = (LocalVariable*)globals.get(i);
            Node* declaration = variable.node;
            u32 type = variable.type;
            ptr global = LLVMAddGlobal(this.module, this.llvm_type(type), variable.name);
            if (!declaration.is_header()) {
                Value* initial = this.gen_expression(declaration.first());
                LLVMSetInitializer(global, this.coerce(initial, type));
                if (!variable.is_mutable) {
                    LLVMSetGlobalConstant(global, 1);
                }
            }
            this.align_slot(global, type);
            variable.slot = global;
            if (this.debug != null) {
                DebugInfo* debug = this.debug;
                debug.declare_global(global, variable.name, type, declaration, this);
            }
        }
    }

    unsafe void define_all() {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (!info.is_extern && !info.is_template) {
                this.define_function(info.node, info);
            }
        }
    }

    unsafe void define_function(Node* declaration, FunctionInfo* info) {
        FunctionContext* function_context = this.function_context;
        function_context.begin(info);
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.begin_function(info, declaration, this);
        }

        ptr entry = LLVMAppendBasicBlockInContext(this.context, info.function, "entry");
        ptr body = LLVMAppendBasicBlockInContext(this.context, info.function, "body");
        LLVMPositionBuilderAtEnd(this.builder, entry);
        mut ptr jump = (ptr)0;
        if (info.is_async) {
            ptr prologue = LLVMAppendBasicBlockInContext(this.context, info.function, "coro.prologue");
            jump = LLVMBuildBr(this.builder, prologue);
            LLVMPositionBuilderBefore(this.alloca_builder, jump);
            this.begin_coroutine(info, prologue, body);
        } else {
            jump = LLVMBuildBr(this.builder, body);
            LLVMPositionBuilderBefore(this.alloca_builder, jump);
        }
        LLVMPositionBuilderAtEnd(this.builder, body);
        this.init_function_state(info);

        mut i32 offset = 0;
        if (info.is_instance) {
            offset = 1;
            LocalVariable* receiver = info.this_variable;
            receiver.slot = this.create_slot(receiver.type, "this");
            LLVMBuildStore(this.builder, LLVMGetParam(info.function, 0), receiver.slot);
            this.declare_variable(receiver.slot, "this", receiver.type, declaration, 1);
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            LocalVariable* variable = (LocalVariable*)parameter.symbol();
            variable.slot = this.create_slot(variable.type, variable.name);
            LLVMBuildStore(this.builder, LLVMGetParam(info.function, (u32)(i + offset)), variable.slot);
            this.declare_variable(variable.slot, variable.name, variable.type, parameter, i + offset + 1);
        }

        this.gen_statement(declaration.first());

        if (info.is_async) {
            if (!this.is_terminated()) {
                LLVMBuildBr(this.builder, function_context.final_block);
            }
            this.finish_coroutine();
        } else if (!this.is_terminated()) {
            if (Types.is_void(info.return_type)) {
                this.emit_void_return(info);
            } else {
                LLVMBuildUnreachable(this.builder);
            }
        }
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.end_function();
        }
    }

    ptr create_slot(u32 type, ptr<i8> name) {
        ptr slot = LLVMBuildAlloca(this.alloca_builder, this.llvm_type(type), name);
        this.align_slot(slot, type);
        return slot;
    }

    unsafe void align_slot(ptr slot, u32 type) {
        if (!Types.is_struct(type)) {
            return;
        }
        StructInfo* info = this.struct_of(type);
        if (info != null && info.align > 0) {
            LLVMSetAlignment(slot, info.align);
        }
    }

    unsafe bool is_volatile(Node* target) {
        NodeKind kind = target.kind();
        i32 symbol_kind = target.symbol_kind();
        if (kind == NodeKind::IDENTIFIER && (symbol_kind == SymbolKind.LOCAL || symbol_kind == SymbolKind.GLOBAL)) {
            LocalVariable* variable = (LocalVariable*)target.symbol();
            return variable.is_volatile;
        }
        bool is_field = (kind == NodeKind::IDENTIFIER && symbol_kind == SymbolKind.IMPLICIT_FIELD)
            || (kind == NodeKind::FIELD_ACCESS && symbol_kind == SymbolKind.FIELD);
        if (is_field) {
            FieldInfo* field = (FieldInfo*)target.symbol();
            return field.is_volatile;
        }
        return false;
    }

    void mark_volatile(ptr instruction, Node* target) {
        if (this.is_volatile(target)) {
            LLVMSetVolatile(instruction, 1);
        }
    }

    FunctionInfo* current_function() {
        FunctionContext* function_context = this.function_context;
        return function_context.function;
    }

    bool is_terminated() {
        ptr block = LLVMGetInsertBlock(this.builder);
        return LLVMGetBasicBlockTerminator(block) != null;
    }

    ptr new_block(ptr<i8> name) {
        return LLVMAppendBasicBlockInContext(this.context, this.current_function().function, name);
    }

    void branch_if_open(ptr target) {
        if (!this.is_terminated()) {
            LLVMBuildBr(this.builder, target);
        }
    }

    void start_dead_block() {
        ptr dead = this.new_block("dead");
        LLVMPositionBuilderAtEnd(this.builder, dead);
    }

    unsafe void emit_entry_point() {
        if (this.library_mode) {
            return;
        }
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* user = (FunctionInfo*)0;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* candidate = (FunctionInfo*)functions.get(i);
            if (candidate.name_atom == Atoms.MAIN_ATOM && candidate.owner == null && !candidate.is_extern) {
                user = candidate;
                break;
            }
        }
        if (user == null) {
            Diagnostics* diagnostics = this.diagnostics;
            diagnostics.error(DiagnosticErrors.MISSING_MAIN, 1, 1, "no 'main' function defined");
            return;
        }

        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr void_type = LLVMVoidTypeInContext(this.context);
        ptr<ptr> init_params = CodeGenerator.array_of(1);
        init_params[0] = i32_type;
        ptr init_type = LLVMFunctionType(void_type, init_params, 1, 0);
        ptr init_fn = LLVMAddFunction(this.module, "__djinn_runtime_init", init_type);
        ptr shutdown_type = LLVMFunctionType(void_type, CodeGenerator.array_of(0), 0, 0);
        ptr shutdown_fn = LLVMAddFunction(this.module, "__djinn_runtime_shutdown", shutdown_type);

        ptr main_type = LLVMFunctionType(i32_type, CodeGenerator.array_of(0), 0, 0);
        ptr main_fn = LLVMAddFunction(this.module, "main", main_type);
        ptr entry = LLVMAppendBasicBlockInContext(this.context, main_fn, "entry");
        LLVMPositionBuilderAtEnd(this.builder, entry);

        ptr<ptr> init_args = CodeGenerator.array_of(1);
        init_args[0] = LLVMConstInt(i32_type, 4, 0);
        LLVMBuildCall2(this.builder, init_type, init_fn, init_args, 1, "");
        this.register_reflected_types();

        mut ptr exit_code = LLVMConstInt(i32_type, 0, 0);
        if (user.is_async) {
            ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
            ptr handle = LLVMBuildCall2(this.builder, user.function_type, user.function, CodeGenerator.array_of(0), 0, "main.handle");
            ptr<ptr> loop_params = CodeGenerator.array_of(1);
            ptr<ptr> loop_args = CodeGenerator.array_of(1);
            loop_params[0] = pointer_llvm;
            loop_args[0] = handle;
            if (user.has_throws) {
                exit_code = this.emit_async_entry(main_fn, user, handle);
            } else if (Types.is_void(user.return_type)) {
                this.call_runtime("__djinn_event_loop_run", void_type, loop_params, loop_args, 1);
                this.call_runtime("__djinn_coro_destroy", void_type, loop_params, loop_args, 1);
            } else {
                exit_code = this.call_runtime("__djinn_event_loop", i32_type, loop_params, loop_args, 1);
            }
        } else if (user.has_throws) {
            ptr record = LLVMBuildCall2(this.builder, user.function_type, user.function, CodeGenerator.array_of(0), 0, "main.record");
            ptr value = this.emit_entry_result(main_fn, user, record);
            if (value != null) {
                exit_code = this.coerce(Value.create(value, user.return_type), Types.i32_type());
            }
        } else if (Types.is_void(user.return_type)) {
            LLVMBuildCall2(this.builder, user.function_type, user.function, CodeGenerator.array_of(0), 0, "");
        } else {
            ptr returned = LLVMBuildCall2(this.builder, user.function_type, user.function, CodeGenerator.array_of(0), 0, "exit");
            Value* wrapped = Value.create(returned, user.return_type);
            exit_code = this.coerce(wrapped, Types.i32_type());
        }

        LLVMBuildCall2(this.builder, shutdown_type, shutdown_fn, CodeGenerator.array_of(0), 0, "");
        LLVMBuildRet(this.builder, exit_code);
    }

    void add_attribute(ptr function, u32 index, ptr<i8> name, u64 value) {
        u64 length = (u64)strlen(name);
        u32 kind = LLVMGetEnumAttributeKindForName(name, length);
        mut ptr attribute = (ptr)0;
        if (kind != 0) {
            attribute = LLVMCreateEnumAttribute(this.context, kind, value);
        } else {
            attribute = LLVMCreateStringAttribute(this.context, name, (u32)length, "", 0);
        }
        LLVMAddAttributeAtIndex(function, index, attribute);
    }

    void add_function_attribute(ptr function, ptr<i8> name) {
        this.add_attribute(function, 4294967295, name, 0);
    }

    void mark_allocator(ptr function) {
        this.add_attribute(function, 0, "noalias", 0);
        this.add_function_attribute(function, "nounwind");
    }

    unsafe void apply_parameter_attributes(FunctionInfo* info) {
        Node* declaration = info.node;
        mut u32 slot = 0;
        IdList* params = info.param_types;
        if (info.is_instance) {
            slot = 1;
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            if (parameter.kind() != NodeKind::PARAMETER) {
                continue;
            }
            if ((i32)slot < params.length) {
                PointerList* uses = Attributes.of(parameter);
                for (mut i32 u = 0; u < uses.length; u = u + 1) {
                    AttributeUse* use = (AttributeUse*)uses.get(u);
                    ptr<i8> mapped = Attributes.parameter_llvm_name(use.name);
                    if (mapped != null) {
                        this.add_attribute(info.function, slot + 1, mapped, (u64)use.int_arg);
                    }
                }
            }
            slot = slot + 1;
        }
    }

    void warn_attribute(AttributeUse* use, ptr<i8> message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.warning(DiagnosticWarnings.ATTRIBUTE, use.line, use.column, message);
    }

    void align_function(FunctionInfo* info, AttributeUse* use) {
        i64 requested = use.int_arg;
        if (requested <= 0 || (requested & (requested - 1)) != 0) {
            this.warn_attribute(use, "'Align' needs a power of two");
            return;
        }
        LLVMSetAlignment(info.function, (u32)requested);
    }

    unsafe void apply_attributes(FunctionInfo* info) {
        if (info.node == null) {
            return;
        }
        if (!info.is_extern) {
            this.add_function_attribute(info.function, "nounwind");
            this.add_attribute(info.function, 4294967295, "uwtable", 2);
        }
        PointerList* uses = Attributes.of(info.node);
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            ptr<i8> mapped = Attributes.llvm_name(use.name);
            if (mapped != null) {
                this.add_function_attribute(info.function, mapped);
            } else if (Strings.equals(use.name, (i32)strlen(use.name), "Const")) {
                this.add_attribute(info.function, 4294967295, "memory", 0);
            } else if (Strings.equals(use.name, (i32)strlen(use.name), "Pure")) {
                this.add_attribute(info.function, 4294967295, "memory", 1365);
            } else if (use.text_arg != null && Strings.equals(use.name, (i32)strlen(use.name), "Llvm")) {
                this.add_function_attribute(info.function, use.text_arg);
            } else if (Strings.same(use.name, "NonNull")) {
                if (Types.is_pointer(info.return_type) && !info.is_async) {
                    this.add_attribute(info.function, 0, "nonnull", 0);
                } else {
                    this.warn_attribute(use, "'NonNull' on a function needs a pointer return type");
                }
            } else if (Strings.same(use.name, "Align")) {
                this.align_function(info, use);
            }
        }
        if (info.node != null) {
            this.apply_parameter_attributes(info);
        }
    }
}
