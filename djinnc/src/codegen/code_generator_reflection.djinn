namespace djinnc;

impl CodeGenerator {
    StructInfo* reflectable_info(u32 type) {
        SymbolTable* symbols = this.symbols;
        StructInfo* named = symbols.enum_of_type(type);
        if (named != null) {
            return named;
        }
        if (!Types.is_struct(type)) {
            return (StructInfo*)0;
        }
        return symbols.struct_at(Types.struct_index(type));
    }

    Node* reflection_node(StructInfo* info) {
        if (info.origin != null) {
            StructInfo* origin = info.origin;
            return origin.node;
        }
        return info.node;
    }

    bool is_reflected(u32 type) {
        if (this.reflect_mode == ReflectionMode.NONE) {
            return false;
        }
        StructInfo* info = this.reflectable_info(type);
        if (info == null || info.is_template || info.is_primitive || info.node == null) {
            return false;
        }
        if (this.reflect_mode == ReflectionMode.ALL) {
            return true;
        }
        return Attributes.has(this.reflection_node(info), "Reflect");
    }

    unsafe void register_reflected_types() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        ptr<ptr> values = CodeGenerator.array_of(structs.length + 1);
        mut i32 count = 0;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            u32 type = Types.structure((u32)i);
            if (info.origin == null && !info.is_enum && this.is_reflected(type)) {
                values[count] = this.type_info_of(type);
                count = count + 1;
            }
        }
        if (count == 0) {
            return;
        }
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr<ptr> params = CodeGenerator.array_of(2);
        params[0] = pointer_llvm;
        params[1] = i32_type;
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = this.constant_array(pointer_llvm, values, count, "__djinn_reflected_types");
        args[1] = LLVMConstInt(i32_type, (u64)count, 0);
        this.call_runtime("__djinn_reflect_register", LLVMVoidTypeInContext(this.context), params, args, 2);
    }

    ptr null_pointer() {
        return LLVMConstNull(LLVMPointerTypeInContext(this.context, 0));
    }

    ptr constant_array(ptr element, ptr<ptr> values, i32 count, ptr<i8> name) {
        ptr array_type = LLVMArrayType2(element, (u64)count);
        ptr global = LLVMAddGlobal(this.module, array_type, name);
        LLVMSetInitializer(global, LLVMConstArray2(element, values, (u64)count));
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, LlvmConst.LINKAGE_INTERNAL);
        return global;
    }

    ptr<i8> table_name(ptr<i8> prefix, ptr<i8> middle, ptr<i8> suffix) {
        ByteBuffer* name = ByteBuffer.create();
        name.append(prefix);
        name.append(middle);
        name.append(suffix);
        return name.cstr();
    }

    ptr<i8> attribute_text(AttributeUse* use) {
        if (use.text_arg != null) {
            return use.text_arg;
        }
        if (use.int_arg != 0) {
            ByteBuffer* digits = ByteBuffer.create();
            digits.append_int(use.int_arg);
            return digits.cstr();
        }
        return "";
    }

    unsafe ptr attribute_payload(AttributeUse* use, ptr<i8> name) {
        if (use.payload == null || use.payload_type == 0) {
            return this.null_pointer();
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* info = symbols.struct_at(Types.struct_index(use.payload_type));
        PointerList* fields = info.fields;
        Node* payload = use.payload;
        ptr<ptr> values = CodeGenerator.array_of(fields.length);
        for (mut i32 f = 0; f < fields.length; f = f + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(f);
            mut ptr value = LLVMConstNull(this.llvm_type(field.type));
            for (mut i32 a = 0; a < payload.count(); a = a + 1) {
                Node* init = payload.child(a);
                bool named = init.text() != null;
                if ((named && init.name() == field.name_atom) || (!named && a == f)) {
                    Value* constant = this.gen_expression(init.first());
                    value = constant.ref;
                }
            }
            values[f] = value;
        }
        ptr struct_type = this.llvm_type(use.payload_type);
        ptr global = LLVMAddGlobal(this.module, struct_type, name);
        LLVMSetInitializer(global, LLVMConstNamedStruct(struct_type, values, (u32)fields.length));
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, LlvmConst.LINKAGE_INTERNAL);
        return global;
    }

    unsafe ptr attribute_table(Node* target, ptr<i8> owner_name) {
        PointerList* uses = Attributes.of(target);
        if (uses.length == 0) {
            return this.null_pointer();
        }
        u32 info_type = this.symbols_core_type("AttributeInfo");
        ptr info_llvm = this.llvm_type(info_type);
        ptr<ptr> entries = CodeGenerator.array_of(uses.length);
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            ptr<ptr> values = CodeGenerator.array_of(3);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, use.name, "attr.name");
            values[1] = LLVMBuildGlobalStringPtr(this.builder, this.attribute_text(use), "attr.value");
            values[2] = this.attribute_payload(use, this.table_name(owner_name, ".payload", ""));
            entries[i] = LLVMConstNamedStruct(info_llvm, values, 3);
        }
        return this.constant_array(info_llvm, entries, uses.length, owner_name);
    }

    Node* field_declaration(StructInfo* info, FieldInfo* field) {
        Node* declaration = this.reflection_node(info);
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (member.kind() == NodeKind::FIELD_DECL && member.first() == null && member.name() == field.name_atom) {
                return member;
            }
        }
        return (Node*)0;
    }

    unsafe ptr field_table(StructInfo* info, u32 type, ptr<i8> prefix) {
        PointerList* fields = info.fields;
        if (fields.length == 0) {
            return this.null_pointer();
        }
        u32 field_info_type = this.symbols_core_type("FieldInfo");
        ptr field_llvm = this.llvm_type(field_info_type);
        ptr owner_llvm = this.llvm_type(type);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i16_type = LLVMIntTypeInContext(this.context, 16);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        ptr<ptr> entries = CodeGenerator.array_of(fields.length);
        for (mut i32 i = 0; i < fields.length; i = i + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(i);
            Node* declaration = this.field_declaration(info, field);
            mut u64 flags = 0;
            mut i32 attribute_count = 0;
            mut ptr attributes = this.null_pointer();
            if (declaration != null) {
                if (declaration.flag()) {
                    flags = (u64)ReflectionKind.FIELD_MUTABLE;
                }
                PointerList* uses = Attributes.of(declaration);
                attribute_count = uses.length;
                attributes = this.attribute_table(declaration, this.table_name(prefix, field.name, ".attrs"));
            }
            ptr<ptr> values = CodeGenerator.array_of(6);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, field.name, "field.name");
            values[1] = LLVMConstInt(i32_type, this.type_hash(field.type), 0);
            values[2] = LLVMConstInt(i16_type, LLVMOffsetOfElement(this.layout_data, owner_llvm, (u32)field.index), 0);
            values[3] = LLVMConstInt(i8_type, flags, 0);
            values[4] = LLVMConstInt(i8_type, (u64)attribute_count, 0);
            values[5] = attributes;
            entries[i] = LLVMConstNamedStruct(field_llvm, values, 6);
        }
        return this.constant_array(field_llvm, entries, fields.length, this.table_name(prefix, "", ".fields"));
    }

    unsafe ptr param_table(Node* declaration, IdList* types, i32 offset, ptr<i8> prefix) {
        i32 count = declaration.count();
        if (count == 0) {
            return this.null_pointer();
        }
        ptr param_llvm = this.llvm_type(this.symbols_core_type("ParamInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        ptr<ptr> entries = CodeGenerator.array_of(count);
        for (mut i32 p = 0; p < count; p = p + 1) {
            Node* parameter = declaration.child(p);
            mut u32 type = parameter.value_type();
            if (types != null) {
                type = types.get(p + offset);
            }
            mut u64 flags = 0;
            if (parameter.op() == 2) {
                flags = (u64)ReflectionKind.PARAM_PACK;
            }
            PointerList* uses = Attributes.of(parameter);
            ptr<ptr> values = CodeGenerator.array_of(5);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, parameter.text(), "param.name");
            values[1] = LLVMConstInt(i32_type, this.type_hash(type), 0);
            values[2] = LLVMConstInt(i8_type, flags, 0);
            values[3] = LLVMConstInt(i8_type, (u64)uses.length, 0);
            values[4] = this.attribute_table(parameter, this.table_name(prefix, ".param.", parameter.text()));
            entries[p] = LLVMConstNamedStruct(param_llvm, values, 5);
        }
        return this.constant_array(param_llvm, entries, count, this.table_name(prefix, "", ".params"));
    }

    unsafe ptr method_entry(ptr<i8> name, ptr pointer, u32 return_type, Node* declaration, IdList* types, i32 offset, u64 flags, ptr<i8> prefix) {
        ptr method_llvm = this.llvm_type(this.symbols_core_type("MethodInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        PointerList* uses = Attributes.of(declaration);
        ptr<ptr> values = CodeGenerator.array_of(8);
        values[0] = LLVMBuildGlobalStringPtr(this.builder, name, "method.name");
        values[1] = pointer;
        values[2] = LLVMConstInt(i32_type, this.type_hash(return_type), 0);
        values[3] = LLVMConstInt(i8_type, (u64)declaration.count(), 0);
        values[4] = LLVMConstInt(i8_type, flags, 0);
        values[5] = LLVMConstInt(i8_type, (u64)uses.length, 0);
        values[6] = this.attribute_table(declaration, this.table_name(prefix, "", ".attrs"));
        values[7] = this.param_table(declaration, types, offset, prefix);
        return LLVMConstNamedStruct(method_llvm, values, 8);
    }

    ptr function_entry(FunctionInfo* function, ptr<i8> prefix) {
        IdList* types = function.param_types;
        mut i32 offset = 0;
        mut u64 flags = 0;
        if (function.is_instance) {
            offset = 1;
        } else {
            flags = flags | (u64)ReflectionKind.METHOD_STATIC;
        }
        if (function.is_async) {
            flags = flags | (u64)ReflectionKind.METHOD_ASYNC;
        }
        if (function.is_variadic) {
            flags = flags | (u64)ReflectionKind.METHOD_VARIADIC;
        }
        if (function.is_extern) {
            flags = flags | (u64)ReflectionKind.METHOD_EXTERN;
        }
        mut ptr pointer = this.null_pointer();
        if (function.function != null) {
            pointer = function.function;
        }
        return this.method_entry(function.name, pointer, function.return_type, function.node, types, offset, flags, prefix);
    }

    unsafe bool is_reflected_method(FunctionInfo* method, StructInfo* info) {
        if (method.owner != info || method.is_template || method.node == null) {
            return false;
        }
        Node* declaration = method.node;
        if (declaration.first() == null && !declaration.is_header()) {
            return false;
        }
        return method.name[0] != 46;
    }

    i32 member_kind(FunctionInfo* method) {
        Node* declaration = method.node;
        return MemberKinds.classify(declaration.text());
    }

    unsafe ptr method_table(StructInfo* info, ptr<i8> prefix, ptr<i32> count, i32 want) {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        mut i32 total = 0;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* method = (FunctionInfo*)functions.get(i);
            if (this.is_reflected_method(method, info) && (want == MemberKinds.ANY || this.member_kind(method) == want)) {
                total = total + 1;
            }
        }
        count[0] = total;
        if (total == 0) {
            return this.null_pointer();
        }
        ptr method_llvm = this.llvm_type(this.symbols_core_type("MethodInfo"));
        ptr<ptr> entries = CodeGenerator.array_of(total);
        mut i32 next = 0;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* method = (FunctionInfo*)functions.get(i);
            if (!this.is_reflected_method(method, info) || (want != MemberKinds.ANY && this.member_kind(method) != want)) {
                continue;
            }
            entries[next] = this.function_entry(method, this.table_name(prefix, ".", method.name));
            next = next + 1;
        }
        return this.constant_array(method_llvm, entries, total, this.table_name(prefix, "", ".methods"));
    }

    unsafe ptr interface_table(StructInfo* info, ptr<i8> prefix, ptr<i32> count) {
        count[0] = 0;
        if (info.contracts == null) {
            return this.null_pointer();
        }
        PointerList* contracts = info.contracts;
        count[0] = contracts.length;
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr<ptr> entries = CodeGenerator.array_of(contracts.length);
        for (mut i32 i = 0; i < contracts.length; i = i + 1) {
            InterfaceInfo* contract = (InterfaceInfo*)contracts.get(i);
            entries[i] = LLVMBuildGlobalStringPtr(this.builder, contract.name, "interface.name");
        }
        return this.constant_array(pointer_llvm, entries, contracts.length, this.table_name(prefix, "", ".interfaces"));
    }

    unsafe ptr variant_table(StructInfo* info, ptr<i8> prefix, ptr<i32> variant_count) {
        Node* declaration = info.node;
        mut i32 total = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (member.kind() == NodeKind::FIELD_DECL && member.first() != null) {
                total = total + 1;
            }
        }
        variant_count[0] = total;
        if (total == 0) {
            return this.null_pointer();
        }
        ptr variant_llvm = this.llvm_type(this.symbols_core_type("VariantInfo"));
        ptr i64_type = LLVMIntTypeInContext(this.context, 64);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i16_type = LLVMIntTypeInContext(this.context, 16);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        ptr<ptr> entries = CodeGenerator.array_of(total);
        mut i32 next = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* variant = declaration.child(i);
            if (variant.kind() != NodeKind::FIELD_DECL || variant.first() == null) {
                continue;
            }
            Node* tag = variant.first();
            i32 payload_count = variant.payload_count();
            ByteBuffer* variant_prefix = ByteBuffer.create();
            variant_prefix.append(prefix);
            variant_prefix.append(".");
            variant_prefix.append(variant.text());
            mut ptr type_ids = this.null_pointer();
            mut ptr offsets = this.null_pointer();
            if (payload_count > 0) {
                ptr<ptr> id_values = CodeGenerator.array_of(payload_count);
                ptr<ptr> offset_values = CodeGenerator.array_of(payload_count);
                for (mut i32 p = 0; p < payload_count; p = p + 1) {
                    Node* payload = variant.child(p);
                    id_values[p] = LLVMConstInt(i32_type, this.type_hash(payload.value_type()), 0);
                    offset_values[p] = LLVMConstInt(i16_type, this.payload_offset(variant, p), 0);
                }
                type_ids = this.constant_array(i32_type, id_values, payload_count, this.table_name(variant_prefix.cstr(), "", ".types"));
                offsets = this.constant_array(i16_type, offset_values, payload_count, this.table_name(variant_prefix.cstr(), "", ".offsets"));
            }
            ptr<ptr> values = CodeGenerator.array_of(7);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, variant.text(), "variant.name");
            values[1] = LLVMConstInt(i64_type, (u64)tag.int_value(), 1);
            values[2] = LLVMConstInt(i16_type, (u64)payload_count, 0);
            values[3] = LLVMConstInt(i8_type, 0, 0);
            values[4] = this.null_pointer();
            values[5] = type_ids;
            values[6] = offsets;
            entries[next] = LLVMConstNamedStruct(variant_llvm, values, 7);
            next = next + 1;
        }
        return this.constant_array(variant_llvm, entries, total, this.table_name(prefix, "", ".variants"));
    }

    i32 enum_row_count(StructInfo* info) {
        Node* declaration = info.node;
        mut i64 highest = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* variant = declaration.child(i);
            if (variant.kind() == NodeKind::FIELD_DECL && variant.first() != null) {
                Node* tag = variant.first();
                if (tag.int_value() > highest) {
                    highest = tag.int_value();
                }
            }
        }
        return (i32)highest + 1;
    }

    unsafe ptr header_table(StructInfo* info, ptr<i8> prefix, i32 rows) {
        if (info.header_count == 0) {
            return this.null_pointer();
        }
        Node* declaration = info.node;
        ptr header_llvm = this.llvm_type(this.symbols_core_type("HeaderInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr<ptr> entries = CodeGenerator.array_of(info.header_count);
        for (mut i32 k = 0; k < info.header_count; k = k + 1) {
            Node* header = declaration.child(k);
            u32 header_type = header.value_type();
            mut ptr table = this.null_pointer();
            mut u64 row_total = (u64)rows;
            if (k > 0) {
                table = this.enum_field_table(info, k, header_type);
                ptr<ptr> known = (ptr<ptr>)info.field_rows;
                row_total = (u64)known[k];
            }
            ptr<ptr> values = CodeGenerator.array_of(5);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, header.text(), "header.name");
            values[1] = LLVMConstInt(i32_type, this.type_hash(header_type), 0);
            values[2] = LLVMConstInt(i32_type, LLVMABISizeOfType(this.layout_data, this.llvm_type(header_type)), 0);
            values[3] = LLVMConstInt(i32_type, row_total, 0);
            values[4] = table;
            entries[k] = LLVMConstNamedStruct(header_llvm, values, 5);
        }
        return this.constant_array(header_llvm, entries, info.header_count, this.table_name(prefix, "", ".headers"));
    }

    unsafe ptr enum_detail(StructInfo* info, ptr<i8> prefix) {
        ptr enum_llvm = this.llvm_type(this.symbols_core_type("EnumInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i16_type = LLVMIntTypeInContext(this.context, 16);
        ptr<i32> variant_count = (ptr<i32>)Memory.zalloc(8);
        i32 rows = this.enum_row_count(info);
        ptr variants = this.variant_table(info, prefix, variant_count);
        ptr headers = this.header_table(info, prefix, rows);
        ptr<ptr> values = CodeGenerator.array_of(5);
        values[0] = LLVMConstInt(i16_type, (u64)variant_count[0], 0);
        values[1] = LLVMConstInt(i16_type, (u64)info.header_count, 0);
        values[2] = LLVMConstInt(i32_type, (u64)rows, 0);
        values[3] = variants;
        values[4] = headers;
        ptr constant = LLVMConstNamedStruct(enum_llvm, values, 5);
        ptr global = LLVMAddGlobal(this.module, LLVMTypeOf(constant), this.table_name(prefix, "", ".enum"));
        LLVMSetInitializer(global, constant);
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, LlvmConst.LINKAGE_INTERNAL);
        return global;
    }

    unsafe ptr extended_type_info(u32 type, ptr base) {
        StructInfo* info = this.reflectable_info(type);
        ByteBuffer* prefix = ByteBuffer.create();
        prefix.append("__typeinfo_");
        prefix.append(info.name);
        ptr ext_llvm = this.llvm_type(this.symbols_core_type("TypeInfoExt"));
        ptr i16_type = LLVMIntTypeInContext(this.context, 16);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        PointerList* fields = info.fields;
        ptr<i32> method_count = (ptr<i32>)Memory.zalloc(8);
        ptr<i32> interface_count = (ptr<i32>)Memory.zalloc(8);
        mut ptr field_pointer = this.null_pointer();
        mut ptr detail = this.null_pointer();
        if (info.is_enum) {
            detail = this.enum_detail(info, prefix.cstr());
        } else {
            field_pointer = this.field_table(info, type, prefix.cstr());
        }
        ptr method_pointer = this.method_table(info, prefix.cstr(), method_count, MemberKinds.ANY);
        ptr interface_pointer = this.interface_table(info, prefix.cstr(), interface_count);
        Node* declaration = this.reflection_node(info);
        PointerList* uses = Attributes.of(declaration);
        ptr attribute_pointer = this.attribute_table(declaration, this.table_name(prefix.cstr(), "", ".attrs"));
        ptr<ptr> values = CodeGenerator.array_of(10);
        values[0] = base;
        values[1] = LLVMConstInt(i16_type, (u64)fields.length, 0);
        values[2] = LLVMConstInt(i16_type, (u64)method_count[0], 0);
        values[3] = LLVMConstInt(i8_type, (u64)uses.length, 0);
        values[4] = field_pointer;
        values[5] = method_pointer;
        values[6] = attribute_pointer;
        values[7] = detail;
        values[8] = interface_pointer;
        values[9] = LLVMConstInt(i16_type, (u64)interface_count[0], 0);
        return LLVMConstNamedStruct(ext_llvm, values, 10);
    }

    unsafe ptr contract_field_table(Node* declaration, ptr<i8> prefix, ptr<i32> count) {
        mut i32 total = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (member.kind() == NodeKind::FIELD_DECL) {
                total = total + 1;
            }
        }
        count[0] = total;
        if (total == 0) {
            return this.null_pointer();
        }
        ptr field_llvm = this.llvm_type(this.symbols_core_type("FieldInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i16_type = LLVMIntTypeInContext(this.context, 16);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        ptr<ptr> entries = CodeGenerator.array_of(total);
        mut i32 next = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (member.kind() != NodeKind::FIELD_DECL) {
                continue;
            }
            PointerList* uses = Attributes.of(member);
            ptr<ptr> values = CodeGenerator.array_of(6);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, member.text(), "field.name");
            values[1] = LLVMConstInt(i32_type, this.type_hash(member.value_type()), 0);
            values[2] = LLVMConstInt(i16_type, 0, 0);
            values[3] = LLVMConstInt(i8_type, 0, 0);
            values[4] = LLVMConstInt(i8_type, (u64)uses.length, 0);
            values[5] = this.attribute_table(member, this.table_name(prefix, ".", member.text()));
            entries[next] = LLVMConstNamedStruct(field_llvm, values, 6);
            next = next + 1;
        }
        return this.constant_array(field_llvm, entries, total, this.table_name(prefix, "", ".fields"));
    }

    unsafe ptr contract_method_table(Node* declaration, ptr<i8> prefix, ptr<i32> count) {
        mut i32 total = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (member.kind() == NodeKind::FUNCTION) {
                total = total + 1;
            }
        }
        count[0] = total;
        if (total == 0) {
            return this.null_pointer();
        }
        ptr method_llvm = this.llvm_type(this.symbols_core_type("MethodInfo"));
        ptr<ptr> entries = CodeGenerator.array_of(total);
        mut i32 next = 0;
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* signature = declaration.child(i);
            if (signature.kind() != NodeKind::FUNCTION) {
                continue;
            }
            mut u64 flags = 0;
            if (signature.flag()) {
                flags = (u64)ReflectionKind.METHOD_STATIC;
            }
            entries[next] = this.method_entry(signature.text(), this.null_pointer(), signature.value_type(), signature, (IdList*)0, 0, flags, this.table_name(prefix, ".", signature.text()));
            next = next + 1;
        }
        return this.constant_array(method_llvm, entries, total, this.table_name(prefix, "", ".methods"));
    }

    unsafe ptr interface_info_of(InterfaceInfo* contract) {
        if (contract.type_info != null) {
            return contract.type_info;
        }
        ByteBuffer* global_name = ByteBuffer.create();
        global_name.append("__typeinfo_");
        global_name.append(contract.name);
        Node* declaration = contract.node;
        ptr ext_llvm = this.llvm_type(this.symbols_core_type("TypeInfoExt"));
        ptr info_llvm = this.llvm_type(this.symbols_core_type("TypeInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i16_type = LLVMIntTypeInContext(this.context, 16);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        ptr<i32> method_count = (ptr<i32>)Memory.zalloc(8);
        ptr<i32> field_count = (ptr<i32>)Memory.zalloc(8);
        ptr field_pointer = this.contract_field_table(declaration, global_name.cstr(), field_count);
        ptr method_pointer = this.contract_method_table(declaration, global_name.cstr(), method_count);
        PointerList* uses = Attributes.of(declaration);
        ptr attribute_pointer = this.attribute_table(declaration, this.table_name(global_name.cstr(), "", ".attrs"));
        ptr<ptr> base_values = CodeGenerator.array_of(5);
        base_values[0] = LLVMConstInt(i32_type, this.name_hash(contract.name), 0);
        base_values[1] = LLVMConstInt(i32_type, 0, 0);
        base_values[2] = LLVMBuildGlobalStringPtr(this.builder, contract.name, "typeinfo.name");
        base_values[3] = LLVMConstInt(i8_type, (u64)ReflectionKind.INTERFACE, 0);
        base_values[4] = LLVMConstInt(i8_type, (u64)ReflectionKind.TYPE_REFLECTED, 0);
        ptr<ptr> values = CodeGenerator.array_of(10);
        values[0] = LLVMConstNamedStruct(info_llvm, base_values, 5);
        values[1] = LLVMConstInt(i16_type, (u64)field_count[0], 0);
        values[2] = LLVMConstInt(i16_type, (u64)method_count[0], 0);
        values[3] = LLVMConstInt(i8_type, (u64)uses.length, 0);
        values[4] = field_pointer;
        values[5] = method_pointer;
        values[6] = attribute_pointer;
        values[7] = this.null_pointer();
        values[8] = this.null_pointer();
        values[9] = LLVMConstInt(i16_type, 0, 0);
        ptr initializer = LLVMConstNamedStruct(ext_llvm, values, 10);
        ptr global = LLVMAddGlobal(this.module, LLVMTypeOf(initializer), global_name.cstr());
        LLVMSetInitializer(global, initializer);
        LLVMSetGlobalConstant(global, 1);
        this.make_linkonce(global, global_name.cstr());
        contract.type_info = global;
        return global;
    }

    ptr function_info_of(FunctionInfo* function) {
        if (function.reflection != null) {
            return function.reflection;
        }
        ByteBuffer* global_name = ByteBuffer.create();
        global_name.append("__fninfo_");
        global_name.append(function.name);
        ptr initializer = this.function_entry(function, global_name.cstr());
        ptr global = LLVMAddGlobal(this.module, LLVMTypeOf(initializer), global_name.cstr());
        LLVMSetInitializer(global, initializer);
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, LlvmConst.LINKAGE_INTERNAL);
        function.reflection = global;
        return global;
    }

    unsafe ptr member_list(ptr<i8> core_name, ptr items, i32 count) {
        ptr list_llvm = this.llvm_type(this.symbols_core_type(core_name));
        ptr<ptr> values = CodeGenerator.array_of(2);
        values[0] = items;
        values[1] = LLVMConstInt(LLVMIntTypeInContext(this.context, 32), (u64)count, 0);
        return LLVMConstNamedStruct(list_llvm, values, 2);
    }

    ptr accessor_entry(FunctionInfo* accessor, ptr<i8> prefix) {
        if (accessor == null) {
            return this.null_pointer();
        }
        ptr initializer = this.function_entry(accessor, prefix);
        ptr global = LLVMAddGlobal(this.module, LLVMTypeOf(initializer), prefix);
        LLVMSetInitializer(global, initializer);
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, LlvmConst.LINKAGE_INTERNAL);
        return global;
    }

    unsafe FunctionInfo* paired_accessor(StructInfo* info, FunctionInfo* getter) {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        Node* getter_node = getter.node;
        ptr<i8> property = MemberKinds.property_name(getter_node.text());
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* candidate = (FunctionInfo*)functions.get(i);
            if (this.is_reflected_method(candidate, info) && this.member_kind(candidate) == MemberKinds.SETTER) {
                Node* candidate_node = candidate.node;
                if (Strings.same(MemberKinds.property_name(candidate_node.text()), property)) {
                    return candidate;
                }
            }
        }
        return (FunctionInfo*)0;
    }

    unsafe ptr property_list(StructInfo* info, ptr<i8> prefix) {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        mut i32 total = 0;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* method = (FunctionInfo*)functions.get(i);
            if (this.is_reflected_method(method, info) && this.member_kind(method) == MemberKinds.GETTER) {
                total = total + 1;
            }
        }
        if (total == 0) {
            return this.member_list("PropertyList", this.null_pointer(), 0);
        }
        ptr property_llvm = this.llvm_type(this.symbols_core_type("PropertyInfo"));
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr<ptr> entries = CodeGenerator.array_of(total);
        mut i32 next = 0;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* getter = (FunctionInfo*)functions.get(i);
            if (!this.is_reflected_method(getter, info) || this.member_kind(getter) != MemberKinds.GETTER) {
                continue;
            }
            Node* getter_node = getter.node;
            ptr<i8> property = MemberKinds.property_name(getter_node.text());
            ptr<ptr> values = CodeGenerator.array_of(4);
            values[0] = LLVMBuildGlobalStringPtr(this.builder, property, "property.name");
            values[1] = LLVMConstInt(i32_type, this.type_hash(getter.return_type), 0);
            values[2] = this.accessor_entry(getter, this.table_name(prefix, ".get.", property));
            values[3] = this.accessor_entry(this.paired_accessor(info, getter), this.table_name(prefix, ".set.", property));
            entries[next] = LLVMConstNamedStruct(property_llvm, values, 4);
            next = next + 1;
        }
        return this.member_list("PropertyList", this.constant_array(property_llvm, entries, total, this.table_name(prefix, "", ".properties")), total);
    }

    unsafe Value* gen_member_query(i32 id, u32 type, u32 result_type) {
        StructInfo* info = this.reflectable_info(type);
        ByteBuffer* prefix = ByteBuffer.create();
        prefix.append("__members_");
        prefix.append(info.name);
        ptr<i32> count = (ptr<i32>)Memory.zalloc(8);
        mut ptr produced = (ptr)0;
        if (id == Intrinsic.FIELDS) {
            mut ptr table = this.null_pointer();
            PointerList* fields = info.fields;
            mut i32 total = 0;
            if (!info.is_enum) {
                table = this.field_table(info, type, prefix.cstr());
                total = fields.length;
            }
            produced = this.member_list("FieldList", table, total);
        } else if (id == Intrinsic.METHODS || id == Intrinsic.CONSTRUCTORS) {
            mut i32 want = MemberKinds.METHOD;
            if (id == Intrinsic.CONSTRUCTORS) {
                want = MemberKinds.CONSTRUCTOR;
            }
            ptr table = this.method_table(info, prefix.cstr(), count, want);
            produced = this.member_list("MethodList", table, count[0]);
        } else if (id == Intrinsic.PROPERTIES) {
            produced = this.property_list(info, prefix.cstr());
        } else if (id == Intrinsic.ATTRIBUTES) {
            Node* declaration = this.reflection_node(info);
            PointerList* uses = Attributes.of(declaration);
            produced = this.member_list("AttributeList", this.attribute_table(declaration, this.table_name(prefix.cstr(), "", ".attrs")), uses.length);
        } else {
            ptr table = this.interface_table(info, prefix.cstr(), count);
            produced = this.member_list("NameList", table, count[0]);
        }
        return Value.create(produced, result_type);
    }
}
