namespace djinnc;

impl CodeGenerator {
    ptr llvm_type(u32 type) {
        i32 kind = Types.kind(type);
        if (kind == TypeKind.VOID) {
            return LLVMVoidTypeInContext(this.context);
        }
        if (kind == TypeKind.INTEGER) {
            return LLVMIntTypeInContext(this.context, Types.bits(type));
        }
        if (kind == TypeKind.FLOAT) {
            if (Types.bits(type) == 32) {
                return LLVMFloatTypeInContext(this.context);
            }
            return LLVMDoubleTypeInContext(this.context);
        }
        if (kind == TypeKind.POINTER) {
            return LLVMPointerTypeInContext(this.context, 0);
        }
        if (kind == TypeKind.NAMED) {
            StructInfo* info = this.struct_of(type);
            return info.llvm;
        }
        logger_error(Log.get(), "djinnc: type %d has no code generation", type);
        exit(1);
        return null;
    }

    StructInfo* struct_of(u32 type) {
        SymbolTable* symbols = this.symbols;
        return symbols.struct_at(Types.struct_index(type));
    }

    StructInfo* struct_behind(u32 type) {
        if (Types.is_pointer(type)) {
            return this.struct_of(Types.element(type));
        }
        return this.struct_of(type);
    }

    unsafe void declare_structs() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (!info.is_template) {
                info.llvm = LLVMStructCreateNamed(this.context, info.name);
            }
        }
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (!info.is_template) {
                this.define_struct(info);
            }
        }
    }

    void require_layout(u32 type, Node* at) {
        if (!Types.is_struct(type)) {
            return;
        }
        StructInfo* dependency = this.struct_of(type);
        if (dependency.is_template) {
            return;
        }
        if (dependency.layout_state == 1) {
            this.error_code(at, DiagnosticErrors.INFINITE_SIZE_TYPE, "recursive type has infinite size; hold it through a pointer");
            return;
        }
        this.define_struct(dependency);
    }

    unsafe void define_struct(StructInfo* info) {
        if (info.layout_state != 0) {
            return;
        }
        info.layout_state = 1;
        Node* declaration = info.node;
        if (info.has_payload) {
            mut u64 largest = 0;
            for (mut i32 v = 0; v < declaration.count(); v = v + 1) {
                Node* variant = declaration.child(v);
                for (mut i32 p = 0; p < variant.count(); p = p + 1) {
                    Node* payload = variant.child(p);
                    this.require_layout(payload.value_type(), declaration);
                }
                u64 size = this.payload_offset(variant, variant.count());
                if (size > largest) {
                    largest = size;
                }
            }
            if (this.detect_niche(info)) {
                ptr<ptr> niche_layout = CodeGenerator.array_of(1);
                niche_layout[0] = LLVMPointerTypeInContext(this.context, 0);
                LLVMStructSetBody(info.llvm, niche_layout, 1, 0);
            } else {
                ptr<ptr> layout = CodeGenerator.array_of(2);
                layout[0] = LLVMIntTypeInContext(this.context, 32);
                layout[1] = LLVMArrayType2(LLVMIntTypeInContext(this.context, 64), (largest + 7) / 8);
                LLVMStructSetBody(info.llvm, layout, 2, 0);
            }
        } else {
            PointerList* fields = info.fields;
            for (mut i32 f = 0; f < fields.length; f = f + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(f);
                this.require_layout(field.type, declaration);
            }
            ptr<ptr> types = CodeGenerator.array_of(fields.length + 1);
            for (mut i32 f = 0; f < fields.length; f = f + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(f);
                types[f] = this.llvm_type(field.type);
            }
            mut i32 member_count = fields.length;
            u32 alignment = this.declared_alignment(info);
            if (alignment > 0 && fields.length > 0) {
                ptr measured = LLVMStructTypeInContext(this.context, types, (u32)fields.length, 0);
                u64 size = LLVMABISizeOfType(this.layout_data, measured);
                u64 padded = (size + (u64)alignment - 1) / (u64)alignment * (u64)alignment;
                if (padded > size) {
                    types[fields.length] = LLVMArrayType2(LLVMIntTypeInContext(this.context, 8), padded - size);
                    member_count = fields.length + 1;
                }
                info.align = alignment;
            }
            LLVMStructSetBody(info.llvm, types, (u32)member_count, 0);
        }
        info.layout_state = 2;
    }

    unsafe u32 declared_alignment(StructInfo* info) {
        Node* declaration = info.node;
        if (declaration == null) {
            return 0;
        }
        PointerList* uses = Attributes.of(declaration);
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (!Strings.same(use.name, "Align")) {
                continue;
            }
            i64 requested = use.int_arg;
            if (requested <= 0 || (requested & (requested - 1)) != 0) {
                this.warn_attribute(use, "'Align' needs a power of two");
                return 0;
            }
            return (u32)requested;
        }
        return 0;
    }

    u64 payload_offset(Node* variant, i32 index) {
        mut u64 offset = 0;
        for (mut i32 j = 0; j <= index && j < variant.count(); j = j + 1) {
            Node* payload = variant.child(j);
            ptr field_type = this.llvm_type(payload.value_type());
            u64 alignment = (u64)LLVMABIAlignmentOfType(this.layout_data, field_type);
            offset = (offset + alignment - 1) / alignment * alignment;
            if (j < index) {
                offset = offset + LLVMABISizeOfType(this.layout_data, field_type);
            }
        }
        return offset;
    }

    bool detect_niche(StructInfo* info) {
        Node* declaration = info.node;
        if (declaration.count() != 2) {
            return false;
        }
        Node* first = declaration.child(0);
        Node* second = declaration.child(1);
        mut Node* with_pointer = first;
        mut Node* empty = second;
        if (first.count() == 0) {
            with_pointer = second;
            empty = first;
        }
        if (empty.count() != 0 || with_pointer.count() != 1) {
            return false;
        }
        Node* payload = with_pointer.child(0);
        if (!Types.is_pointer(payload.value_type())) {
            return false;
        }
        Node* some_tag = with_pointer.first();
        Node* none_tag = empty.first();
        info.is_niche = true;
        info.niche_some_tag = (i32)some_tag.int_value();
        info.niche_none_tag = (i32)none_tag.int_value();
        return true;
    }

    ptr load_tag(u32 enum_type, ptr enum_llvm, ptr slot, ptr<i8> name) {
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        StructInfo* info = this.struct_of(enum_type);
        if (info.is_niche) {
            ptr pointer_type = LLVMPointerTypeInContext(this.context, 0);
            ptr field = LLVMBuildStructGEP2(this.builder, enum_llvm, slot, 0, "niche.ptr");
            ptr pointer = LLVMBuildLoad2(this.builder, pointer_type, field, "niche.value");
            ptr present = LLVMBuildICmp(this.builder, LlvmConst.INT_NE, pointer, LLVMConstPointerNull(pointer_type), "niche.present");
            ptr some_tag = LLVMConstInt(i32_type, (u64)info.niche_some_tag, 0);
            ptr none_tag = LLVMConstInt(i32_type, (u64)info.niche_none_tag, 0);
            return LLVMBuildSelect(this.builder, present, some_tag, none_tag, name);
        }
        ptr tag_address = LLVMBuildStructGEP2(this.builder, enum_llvm, slot, 0, "enum.tag.ptr");
        return LLVMBuildLoad2(this.builder, i32_type, tag_address, name);
    }

    unsafe ptr payload_address(u32 enum_type, ptr enum_llvm, ptr slot, Node* variant, i32 index) {
        StructInfo* info = this.struct_of(enum_type);
        if (info.is_niche) {
            return LLVMBuildStructGEP2(this.builder, enum_llvm, slot, 0, "niche.payload");
        }
        ptr area = LLVMBuildStructGEP2(this.builder, enum_llvm, slot, 1, "enum.area");
        ptr<ptr> offsets = CodeGenerator.array_of(1);
        offsets[0] = LLVMConstInt(LLVMIntTypeInContext(this.context, 64), this.payload_offset(variant, index), 0);
        return LLVMBuildGEP2(this.builder, LLVMIntTypeInContext(this.context, 8), area, offsets, 1, "enum.payload");
    }

    u32 symbols_core_type(ptr<i8> name) {
        SymbolTable* symbols = this.symbols;
        u32 atom = Ast.intern_base_name(name, (i32)strlen(name));
        StructInfo* info = symbols.find_core_struct(atom);
        if (info == null || info.is_template) {
            return 0;
        }
        return info.type_id;
    }
}
