namespace djinnc;

struct ReflectionDiagnostics {
    public static unsafe void check(SymbolTable* symbols, Diagnostics* diagnostics, i32 reflect_mode) {
        PointerList* uses = Attributes.all();
        PointerList* structs = symbols.structs;
        for (mut i32 u = 0; u < uses.length; u = u + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(u);
            if (!Strings.same(use.name, "Reflect") || use.target == null) {
                continue;
            }
            Node* target = use.target;
            if (reflect_mode == ReflectionMode.NONE) {
                diagnostics.warning_in(DiagnosticWarnings.REFLECT_IGNORED, target.file_name(), use.line, use.column, "[Reflect] is ignored because of --reflect-none");
                continue;
            }
            if (target.kind() != NodeKind::STRUCT_DECL) {
                continue;
            }
            mut StructInfo* owner = (StructInfo*)0;
            mut bool instantiated = false;
            for (mut i32 s = 0; s < structs.length; s = s + 1) {
                StructInfo* candidate = (StructInfo*)structs.get(s);
                if (candidate.node == target) {
                    owner = candidate;
                } else if (candidate.origin != null) {
                    StructInfo* origin = candidate.origin;
                    if (origin.node == target) {
                        instantiated = true;
                    }
                }
            }
            if (owner == null) {
                diagnostics.warning_in(DiagnosticWarnings.REFLECT_IGNORED, target.file_name(), use.line, use.column, "[Reflect] has no effect on a type alias");
            } else if (owner.is_template && !instantiated) {
                diagnostics.warning_in(DiagnosticWarnings.REFLECT_IGNORED, target.file_name(), use.line, use.column, "[Reflect] has no effect on a generic type that is never instantiated");
            }
        }
    }
}
