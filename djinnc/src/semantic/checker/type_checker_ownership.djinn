namespace djinnc;

impl TypeChecker {
    void ownership_error(Node* at, ptr<i8> before, ptr<i8> name, ptr<i8> after) {
        ByteBuffer* message = ByteBuffer.create();
        message.append(before);
        message.append(name);
        message.append(after);
        this.error_code(at, DiagnosticErrors.BORROW_CONFLICT, message.cstr());
    }

    unsafe Borrow* conflicting_borrow(LocalVariable* source, bool exclusive) {
        LocalScopes* scopes = this.scopes;
        PointerList* borrows = this.borrows;
        for (mut i32 i = 0; i < borrows.length; i = i + 1) {
            Borrow* borrow = (Borrow*)borrows.get(i);
            if (borrow.source == source && scopes.contains(borrow.borrower) && (exclusive || borrow.is_exclusive)) {
                return borrow;
            }
        }
        return (Borrow*)0;
    }

    unsafe void require_not_borrowed(Node* at, LocalVariable* source, ptr<i8> action) {
        Borrow* borrow = this.conflicting_borrow(source, true);
        if (borrow == null) {
            return;
        }
        ByteBuffer* message = ByteBuffer.create();
        message.append("cannot ");
        message.append(action);
        message.append(" '");
        message.append(source.name);
        message.append("' while it is borrowed by '");
        message.append(borrow.borrower.name);
        message.append("'");
        this.error_code(at, DiagnosticErrors.BORROW_CONFLICT, message.cstr());
    }

    unsafe void borrow_from(Node* initializer, LocalVariable* borrower) {
        if (initializer.kind() != NodeKind::UNARY || initializer.op_kind() != TokenKind::AMPERSAND) {
            return;
        }
        if (Types.is_raw_pointer(borrower.type)) {
            return;
        }
        Node* operand = initializer.first();
        if (operand.kind() != NodeKind::IDENTIFIER || operand.symbol_kind() != SymbolKind.LOCAL) {
            return;
        }
        LocalVariable* source = (LocalVariable*)operand.symbol();
        bool exclusive = source.is_mutable;
        Borrow* conflict = this.conflicting_borrow(source, exclusive);
        if (conflict != null) {
            this.ownership_error(initializer, "cannot borrow '", source.name, "': it is already borrowed");
        }
        Borrow* borrow = (Borrow*)Memory.zalloc(sizeof(Borrow));
        borrow.source = source;
        borrow.borrower = borrower;
        borrow.is_exclusive = exclusive;
        borrow.at = initializer;
        PointerList* borrows = this.borrows;
        borrows.push((ptr)borrow);
    }

    void check_returned_borrow(Node* value) {
        if (value.kind() != NodeKind::UNARY || value.op_kind() != TokenKind::AMPERSAND) {
            return;
        }
        Node* operand = value.first();
        if (operand.kind() == NodeKind::IDENTIFIER && operand.symbol_kind() == SymbolKind.LOCAL) {
            this.error_code(value, DiagnosticErrors.BORROW_OUTLIVES_VALUE, "cannot return a pointer to a local variable");
        }
    }
}
