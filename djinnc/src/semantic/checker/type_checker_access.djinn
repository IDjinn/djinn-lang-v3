namespace djinnc;

impl TypeChecker {
    bool is_struct_name(Node* node) {
        if (node.kind() != NodeKind::IDENTIFIER) {
            return false;
        }
        if (this.find_variable(node.name()) != null) {
            return false;
        }
        SymbolTable* symbols = this.symbols;
        return symbols.find_struct(node.text_atom(), node.name(), this.scope) != null;
    }

    bool is_addressable(Node* node) {
        NodeKind kind = node.kind();
        if (kind == NodeKind::IDENTIFIER || kind == NodeKind::INDEX) {
            return true;
        }
        if (kind == NodeKind::FIELD_ACCESS) {
            return !this.is_struct_name(node.first());
        }
        return kind == NodeKind::UNARY && node.op_kind() == TokenKind::STAR;
    }

    u32 check_lvalue(Node* node) {
        u32 type = this.compute_lvalue(node);
        node.set_value_type(type);
        return type;
    }

    u32 compute_lvalue(Node* node) {
        NodeKind kind = node.kind();

        if (kind == NodeKind::IDENTIFIER) {
            LocalVariable* variable = this.find_variable(node.name());
            if (variable == null) {
                FieldInfo* implicit = this.implicit_field(node);
                if (implicit != null) {
                    node.set_symbol(SymbolKind.IMPLICIT_FIELD, (ptr)implicit);
                    return implicit.type;
                }
                FunctionInfo* implicit_getter = this.implicit_accessor(node, "get:");
                if (implicit_getter != null) {
                    node.set_symbol(SymbolKind.IMPLICIT_GET, (ptr)implicit_getter);
                    return implicit_getter.return_type;
                }
                Node* sibling = this.implicit_constant(node);
                if (sibling != null) {
                    node.set_symbol(SymbolKind.CONSTANT, (ptr)sibling);
                    return sibling.value_type();
                }
                Diagnostics.add_argument(node.text());
                this.error_code(node, DiagnosticErrors.UNDEFINED_VARIABLE, "undefined variable");
                return Types.i32_type();
            }
            LocalScopes* scopes = this.scopes;
            if (variable.moved && this.assign_target != node) {
                this.error_code(node, DiagnosticErrors.USE_AFTER_MOVE, "use of moved value");
            }
            if (scopes.find(node.name()) != null) {
                node.set_symbol(SymbolKind.LOCAL, (ptr)variable);
            } else {
                node.set_symbol(SymbolKind.GLOBAL, (ptr)variable);
            }
            return variable.type;
        }

        if (kind == NodeKind::FIELD_ACCESS) {
            return this.check_field(node);
        }

        if (kind == NodeKind::INDEX) {
            u32 base = this.check_expression(node.first(), 0);
            u32 held = this.array_element(base);
            if (held == 0 && Types.is_raw_pointer(base)) {
                this.require_unsafe(node, "indexing a raw pointer");
            }
            if (held == 0 && Types.is_struct(base)) {
                return this.check_index_operator(node, base);
            }
            this.check_expression(node.second(), Types.i64_type());
            if (held != 0) {
                return held;
            }
            if (!Types.is_sized_pointer(base)) {
                this.error_code(node, DiagnosticErrors.INVALID_INDEX_TARGET, "only pointers to sized types can be indexed");
                return Types.i32_type();
            }
            return Types.element(base);
        }

        if (kind == NodeKind::UNARY && node.op_kind() == TokenKind::STAR) {
            u32 pointer = this.check_expression(node.first(), 0);
            if (!Types.is_sized_pointer(pointer)) {
                this.error_code(node, DiagnosticErrors.INVALID_DEREFERENCE, "cannot dereference this value");
                return Types.i32_type();
            }
            if (Types.is_raw_pointer(pointer)) {
                this.require_unsafe(node, "dereferencing a raw pointer");
            }
            return Types.element(pointer);
        }

        this.error_code(node, DiagnosticErrors.NOT_ADDRESSABLE, "expression is not addressable");
        return Types.i32_type();
    }

    StructInfo* struct_of_base(Node* base) {
        mut u32 type = 0;
        if (this.is_addressable(base)) {
            type = this.check_lvalue(base);
        } else {
            type = this.check_expression(base, 0);
            if (Types.is_void(type)) {
                this.error_code(base, DiagnosticErrors.INVALID_MEMBER_ACCESS, "member access needs a struct or a pointer to one");
                return (StructInfo*)0;
            }
        }
        mut u32 target = type;
        if (Types.is_pointer(type)) {
            target = Types.element(type);
        }
        SymbolTable* enumerations = this.symbols;
        StructInfo* enumeration = enumerations.enum_of_type(target);
        if (enumeration != null) {
            return enumeration;
        }
        SymbolTable* symbols = this.symbols;
        if (!Types.is_struct(target)) {
            if (Types.is_void(target)) {
                this.error_code(base, DiagnosticErrors.INVALID_MEMBER_ACCESS, "member access on a value that is not a struct");
                return (StructInfo*)0;
            }
            return symbols.primitive_owner(target);
        }
        return symbols.struct_at(Types.struct_index(target));
    }

    unsafe u32 check_field(Node* node) {
        Node* base = node.first();
        if (this.is_struct_name(base)) {
            this.error_code(node, DiagnosticErrors.INVALID_MEMBER_ACCESS, "a struct constant cannot be used as a variable");
            return Types.i32_type();
        }
        StructInfo* info = this.struct_of_base(base);
        if (info == null) {
            return Types.i32_type();
        }
        if (info.is_enum && info.header_count > 0) {
            Node* declaration = info.node;
            for (mut i32 k = 0; k < info.header_count; k = k + 1) {
                Node* header = declaration.child(k);
                if (Strings.same(header.text(), node.text())) {
                    node.set_symbol(SymbolKind.ENUM_FIELD, (ptr)(u64)k);
                    return this.resolve_type(header.type(), header);
                }
            }
        }
        SymbolTable* symbols = this.symbols;
        FieldInfo* field = symbols.find_field(info, node.name());
        if (field == null) {
            FunctionInfo* getter = this.find_accessor(info, "get:", node.text());
            if (getter != null) {
                node.set_symbol(SymbolKind.PROPERTY_GET, (ptr)getter);
                return getter.return_type;
            }
            Diagnostics.add_argument(node.text());
            this.error_code(node, DiagnosticErrors.UNKNOWN_FIELD, "struct has no such field");
            return Types.i32_type();
        }
        node.set_symbol(SymbolKind.FIELD, (ptr)field);
        return field.type;
    }

    FunctionInfo* find_accessor(StructInfo* owner, ptr<i8> prefix, ptr<i8> name) {
        ByteBuffer* full = ByteBuffer.create();
        full.append(prefix);
        full.append(name);
        SymbolTable* symbols = this.symbols;
        return symbols.find_method(owner, Ast.intern_base_name(full.cstr(), (i32)strlen(full.cstr())));
    }

    FunctionInfo* implicit_accessor(Node* node, ptr<i8> prefix) {
        FunctionInfo* current = this.function;
        if (current == null || !current.is_instance || current.owner == null) {
            return (FunctionInfo*)0;
        }
        return this.find_accessor(current.owner, prefix, node.text());
    }

    Node* implicit_constant(Node* node) {
        FunctionInfo* current = this.function;
        if (current == null || current.owner == null) {
            return (Node*)0;
        }
        SymbolTable* symbols = this.symbols;
        return symbols.find_constant(current.owner, node.name());
    }

    FieldInfo* implicit_field(Node* node) {
        FunctionInfo* current = this.function;
        if (current == null || !current.is_instance || current.owner == null) {
            return (FieldInfo*)0;
        }
        StructInfo* owner = current.owner;
        SymbolTable* symbols = this.symbols;
        return symbols.find_field(owner, node.name());
    }

    u32 check_member(Node* node) {
        Node* base = node.first();
        if (base.kind() == NodeKind::IDENTIFIER && !this.is_struct_name(base) && this.find_variable(base.name()) == null) {
            Node* provided = this.intrinsic_constant(base, node);
            if (provided != null) {
                base.set_symbol(SymbolKind.STRUCT_NAME, (ptr)0);
                node.set_symbol(SymbolKind.CONSTANT, (ptr)provided);
                return provided.value_type();
            }
        }
        if (this.is_struct_name(base)) {
            SymbolTable* symbols = this.symbols;
            StructInfo* info = symbols.find_struct(base.text_atom(), base.name(), this.scope);
            base.set_symbol(SymbolKind.STRUCT_NAME, (ptr)info);
            Node* constant = symbols.find_constant(info, node.name());
            if (constant == null) {
                this.error_code(node, DiagnosticErrors.UNKNOWN_CONSTANT, "struct has no such constant");
                return Types.i32_type();
            }
            if (info.has_payload) {
                this.error_code(node, DiagnosticErrors.PAYLOAD_ENUM_SYNTAX, "a payload enum is built with Enum::Variant(...)");
            }
            node.set_symbol(SymbolKind.CONSTANT, (ptr)constant);
            return constant.value_type();
        }
        return this.check_field(node);
    }
}

impl TypeChecker {
    unsafe u32 check_intrinsic(Node* node) {
        i32 id = node.op();
        if (id == Intrinsic.ALLOCA) {
            u32 element = this.resolve_type(node.type(), node);
            this.check_expression(node.first(), Types.i64_type());
            return Types.pointer_to(element);
        }
        if (id >= Intrinsic.FIELDS && id <= Intrinsic.INTERFACES) {
            SymbolTable* queried = this.symbols;
            queried.blame = node;
            u32 subject = queried.resolve_type(node.type(), this.scope);
            mut StructInfo* owner = (StructInfo*)0;
            if (subject != 0) {
                owner = queried.enum_of_type(subject);
                if (owner == null && Types.is_struct(subject)) {
                    owner = queried.struct_at(Types.struct_index(subject));
                }
            }
            if (owner == null || owner.is_primitive || owner.is_template) {
                this.error_code(node, DiagnosticErrors.INVALID_REFLECTION_TARGET, "a reflection query needs a concrete struct, enum or union");
                return Types.i32_type();
            }
            node.set_symbol(SymbolKind.TYPE, (ptr)(u64)subject);
            if (id == Intrinsic.FIELDS) { return this.core_type("FieldList"); }
            if (id == Intrinsic.METHODS || id == Intrinsic.CONSTRUCTORS) { return this.core_type("MethodList"); }
            if (id == Intrinsic.PROPERTIES) { return this.core_type("PropertyList"); }
            if (id == Intrinsic.ATTRIBUTES) { return this.core_type("AttributeList"); }
            return this.core_type("NameList");
        }
        if (id == Intrinsic.TYPEOF) {
            TypeRef* reference = node.type();
            SymbolTable* known = this.symbols;
            known.blame = node;
            mut u32 measured = known.resolve_type(reference, this.scope);
            if (measured == 0 && reference.kind == TypeKind.NAMED && reference.args == null) {
                InterfaceInfo* contract = known.find_interface(reference.full_atom, reference.name_atom, this.scope);
                if (contract != null) {
                    node.set_symbol(SymbolKind.INTERFACE_NAME, (ptr)contract);
                    return Types.pointer_to(this.core_type("TypeInfo"));
                }
                FunctionInfo* function = known.find_function(reference.full_atom, reference.name_atom, this.scope);
                if (function != null) {
                    if (function.is_template) {
                        this.error_code(node, DiagnosticErrors.INVALID_REFLECTION_TARGET, "typeof needs a concrete function: instantiate the generic function first");
                    } else if (function.overload != null) {
                        this.error_code(node, DiagnosticErrors.INVALID_REFLECTION_TARGET, "typeof is ambiguous on an overloaded function");
                    }
                    node.set_symbol(SymbolKind.FUNCTION, (ptr)function);
                    return Types.pointer_to(this.core_type("MethodInfo"));
                }
            }
            if (measured == 0) {
                this.error_code(node, DiagnosticErrors.UNKNOWN_TYPE, "unknown type");
                measured = Types.i32_type();
            }
            if (Types.is_void(measured) || measured == Types.auto_type()) {
                this.error_code(node, DiagnosticErrors.INVALID_REFLECTION_TARGET, "typeof needs a concrete type");
            }
            node.set_symbol(SymbolKind.TYPE, (ptr)(u64)measured);
            return Types.pointer_to(this.core_type("TypeInfo"));
        }
        if (id == Intrinsic.UNLIKELY || id == Intrinsic.LIKELY || id == Intrinsic.ASSUME) {
            this.check_expression(node.first(), Types.bool_type());
            if (id == Intrinsic.UNLIKELY || id == Intrinsic.LIKELY) {
                return Types.bool_type();
            }
        }
        if (id == Intrinsic.PANIC) {
            this.check_expression(node.first(), Types.byte_pointer());
        }
        return Types.void_type();
    }
}
