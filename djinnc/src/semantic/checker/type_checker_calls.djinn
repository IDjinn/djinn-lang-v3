namespace djinnc;

impl TypeChecker {
    unsafe bool names_fit(Node* call, FunctionInfo* info) {
        Node* declaration = info.node;
        if (declaration == null || declaration.count() != call.count()) {
            return false;
        }
        mut bool named_seen = false;
        IdList* taken = IdList.create();
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            taken.push(0);
        }
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind() != NodeKind::NAMED_ARG) {
                if (named_seen) {
                    return false;
                }
                taken.data[i] = 1;
            } else {
                named_seen = true;
                i32 position = this.parameter_index(declaration, argument.text());
                if (position < 0 || taken.get(position) != 0) {
                    return false;
                }
                taken.data[position] = 1;
            }
        }
        return true;
    }

    i32 parameter_index(Node* declaration, ptr<i8> name) {
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (strcmp(member.text(), name) == 0) {
                return i;
            }
        }
        return 0 - 1;
    }

    unsafe FunctionInfo* apply_named_arguments(Node* call, FunctionInfo* head) {
        mut bool named = false;
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* candidate = call.child(i);
            if (candidate.kind() == NodeKind::NAMED_ARG) {
                named = true;
            }
        }
        if (!named || head == null) {
            return head;
        }
        mut FunctionInfo* candidate = head;
        while (candidate != null) {
            if (this.names_fit(call, candidate)) {
                Node* declaration = candidate.node;
                i32 count = call.count();
                Node** ordered = (Node**)Memory.zalloc((u64)count * 8);
                for (mut i32 i = 0; i < count; i = i + 1) {
                    Node* argument = call.child(i);
                    if (argument.kind() == NodeKind::NAMED_ARG) {
                        ordered[this.parameter_index(declaration, argument.text())] = argument.first();
                    } else {
                        ordered[i] = argument;
                    }
                }
                for (mut i32 i = 0; i < count; i = i + 1) {
                    call.set_child(i, ordered[i]);
                }
                return candidate;
            }
            candidate = candidate.overload;
        }
        this.error_code(call, DiagnosticErrors.NO_MATCHING_OVERLOAD, "no declaration matches these argument names");
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind() == NodeKind::NAMED_ARG) {
                call.set_child(i, argument.first());
            }
        }
        return head;
    }

    FunctionInfo* pick_overload(FunctionInfo* head, Node* call, i32 offset) {
        IdList* types = IdList.create();
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind() == NodeKind::STRUCT_INIT) {
                types.push(0);
            } else {
                types.push(this.check_expression(argument, 0));
            }
        }
        mut FunctionInfo* best = (FunctionInfo*)0;
        mut i32 best_score = 0 - 1;
        mut bool ambiguous = false;
        mut FunctionInfo* candidate = head;
        while (candidate != null) {
            IdList* params = candidate.param_types;
            i32 fixed = params.length - offset;
            bool arity_ok = call.count() == fixed || (candidate.is_variadic && call.count() >= fixed);
            if (!candidate.is_template && arity_ok) {
                mut i32 score = 0;
                mut bool fits = true;
                for (mut i32 i = 0; i < call.count() && i < fixed; i = i + 1) {
                    u32 expected = params.get(i + offset);
                    u32 actual = types.get(i);
                    if (actual == 0) {
                        if (Types.is_struct(expected)) {
                            score = score + 1;
                        } else {
                            fits = false;
                        }
                    } else if (actual == expected) {
                        score = score + 4;
                    } else if ((Types.is_integer(actual) || Types.is_float(actual)) && (Types.is_integer(expected) || Types.is_float(expected))) {
                        score = score + 1;
                    } else if (Types.is_pointer(actual) && Types.is_pointer(expected)) {
                        if (Types.element(actual) == Types.element(expected)) {
                            score = score + 3;
                        } else {
                            score = score + 1;
                        }
                        if (Types.is_raw_pointer(actual) == Types.is_raw_pointer(expected)) {
                            score = score + 1;
                        }
                    } else {
                        fits = false;
                    }
                }
                if (fits) {
                    if (score > best_score) {
                        best = candidate;
                        best_score = score;
                        ambiguous = false;
                    } else if (score == best_score) {
                        ambiguous = true;
                    }
                }
            }
            candidate = candidate.overload;
        }
        if (best == null) {
            this.error_code(call, DiagnosticErrors.NO_MATCHING_OVERLOAD, "no overload matches these arguments");
            return (FunctionInfo*)0;
        }
        if (ambiguous) {
            this.error_code(call, DiagnosticErrors.AMBIGUOUS_CALL, "call is ambiguous between overloads");
            return (FunctionInfo*)0;
        }
        return best;
    }

    FunctionInfo* check_constructor_arguments(Node* node, StructInfo* owner) {
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* constructor = symbols.find_method(owner, Ast.intern_base_name(".ctor", 5));
        constructor = this.apply_named_arguments(node, constructor);
        if (constructor != null && constructor.overload != null) {
            constructor = this.pick_overload(constructor, node, 1);
            if (constructor == null) {
                return constructor;
            }
        }
        if (constructor == null) {
            if (node.count() > 0) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTRUCTOR_CALL, "struct has no constructor");
            }
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.check_expression(node.child(i), 0);
            }
            return constructor;
        }
        IdList* params = constructor.param_types;
        if (params.length != node.count() + 1) {
            this.error_code(node, DiagnosticErrors.INVALID_CONSTRUCTOR_CALL, "wrong number of constructor arguments");
            return constructor;
        }
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            this.check_expression(node.child(i), params.get(i + 1));
        }
        return constructor;
    }

    u32 check_null(u32 expected) {
        SymbolTable* symbols = this.symbols;
        if (expected != 0 && symbols.nullable_payload(expected) != 0) {
            return expected;
        }
        return Types.pointer_to(Types.void_type());
    }

    bool wraps_pointer(u32 passed, u32 wanted) {
        SymbolTable* symbols = this.symbols;
        return Types.is_pointer(passed) && symbols.nullable_payload(wanted) == passed;
    }

    void require_safe_pointer(Node* value, u32 passed, u32 wanted) {
        if (!Types.is_safe_pointer(wanted)) {
            return;
        }
        if (value.kind() == NodeKind::NULL_LITERAL) {
            this.error_code(value, DiagnosticErrors.VALUE_TYPE_MISMATCH, "null needs a nullable pointer; declare it as 'T*?'");
        } else if (Types.is_nullable_pointer(passed)) {
            this.error_code(value, DiagnosticErrors.VALUE_TYPE_MISMATCH, "a nullable pointer cannot be used as 'T*' without a cast");
        }
    }

    void require_explicit_cast(Node* value, u32 passed, u32 wanted) {
        bool passed_number = Types.is_integer(passed) || Types.is_float(passed);
        bool wanted_number = Types.is_integer(wanted) || Types.is_float(wanted);
        if (passed_number && wanted_number && !Types.widens(passed, wanted)) {
            this.error_code(value, DiagnosticErrors.IMPLICIT_CONVERSION, "only a wider type of the same kind converts implicitly; use an explicit cast");
        }
        if (passed_number && Types.is_pointer(wanted) && value.kind() != NodeKind::NULL_LITERAL) {
            this.error_code(value, DiagnosticErrors.IMPLICIT_CONVERSION, "a number does not convert to a pointer implicitly; use an explicit cast");
        }
    }

    void require_argument_shape(Node* argument, u32 passed, u32 wanted) {
        this.require_safe_pointer(argument, passed, wanted);
        this.require_explicit_cast(argument, passed, wanted);
        if (wanted == 0 || passed == wanted || wanted == this.core_type("object") || this.wraps_pointer(passed, wanted)) {
            return;
        }
        SymbolTable* symbols = this.symbols;
        bool passed_struct = Types.is_struct(passed) && symbols.enum_of_type(passed) == null;
        bool wanted_struct = Types.is_struct(wanted) && symbols.enum_of_type(wanted) == null;
        bool passed_scalar = Types.is_integer(passed) || Types.is_float(passed) || Types.is_pointer(passed);
        bool wanted_scalar = Types.is_integer(wanted) || Types.is_float(wanted) || Types.is_pointer(wanted);
        if ((passed_struct && wanted_scalar) || (passed_scalar && wanted_struct)) {
            this.error_code(argument, DiagnosticErrors.ARGUMENT_TYPE_MISMATCH, "argument type does not match the parameter; a struct and a scalar or pointer are not convertible (use .ptr() to get the text pointer of a str or string)");
        }
    }

    void require_value_type(Node* value, u32 passed, u32 wanted) {
        this.require_safe_pointer(value, passed, wanted);
        this.require_explicit_cast(value, passed, wanted);
        if (passed == 0 || wanted == 0 || passed == wanted || wanted == this.core_type("object") || this.wraps_pointer(passed, wanted)) {
            return;
        }
        SymbolTable* symbols = this.symbols;
        bool passed_struct = Types.is_struct(passed) && symbols.enum_of_type(passed) == null;
        bool wanted_struct = Types.is_struct(wanted) && symbols.enum_of_type(wanted) == null;
        bool passed_scalar = Types.is_integer(passed) || Types.is_float(passed) || Types.is_pointer(passed);
        bool wanted_number = Types.is_integer(wanted) || Types.is_float(wanted);
        bool wanted_scalar = wanted_number || Types.is_pointer(wanted);
        bool mixes_struct = (passed_struct && wanted_scalar) || (passed_scalar && wanted_struct);
        if (mixes_struct || (Types.is_pointer(passed) && wanted_number)) {
            this.error_code(value, DiagnosticErrors.VALUE_TYPE_MISMATCH, "value type does not match the declared type");
        }
    }

    u32 constructor_owner_type(Node* at, u32 type) {
        SymbolTable* symbols = this.symbols;
        if (!Types.is_struct(type) || symbols.enum_of_type(type) != null) {
            this.error_code(at, DiagnosticErrors.INVALID_CONSTRUCTOR_CALL, "only structs have constructors");
            return 0;
        }
        return type;
    }

    u32 check_constructor(Node* node, Node* callee, u32 type) {
        if (this.constructor_owner_type(node, type) == 0) {
            return Types.i32_type();
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(type));
        FunctionInfo* constructor = this.check_constructor_arguments(node, owner);
        callee.set_symbol(SymbolKind.CONSTRUCTOR, (ptr)constructor);
        return type;
    }

    u32 check_new(Node* node) {
        u32 type = this.resolve_type(node.type(), node);
        if (this.constructor_owner_type(node, type) == 0) {
            return Types.pointer_to(Types.i32_type());
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(type));
        FunctionInfo* constructor = this.check_constructor_arguments(node, owner);
        node.set_symbol(SymbolKind.CONSTRUCTOR, (ptr)constructor);
        return Types.pointer_to(type);
    }

    u32 check_call(Node* node, u32 expected) {
        Node* callee = node.first();
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* info = (FunctionInfo*)0;
        mut i32 offset = 0;

        if (callee.kind() == NodeKind::IDENTIFIER) {
            Node* variant = this.find_enum_variant(callee, node, expected);
            if (variant != null) {
                if (node.count() != variant.payload_count()) {
                    this.error_code(node, DiagnosticErrors.WRONG_ARGUMENT_COUNT, "wrong number of enum variant arguments");
                }
                for (mut i32 a = 0; a < node.count() && a < variant.payload_count(); a = a + 1) {
                    Node* payload = variant.child(a);
                    this.check_expression(node.child(a), payload.value_type());
                }
                callee.set_symbol(SymbolKind.CONSTANT, (ptr)variant);
                return variant.value_type();
            }
            if (callee.flag() && callee.type() != null) {
                u32 constructed = this.resolve_type(callee.type(), callee);
                return this.check_constructor(node, callee, constructed);
            }
            info = symbols.find_function(callee.text_atom(), callee.name(), this.scope);
            info = this.apply_named_arguments(node, info);
            if (info == null) {
                StructInfo* named = symbols.find_struct(callee.text_atom(), callee.name(), this.scope);
                if (named != null && !named.is_template && !named.is_enum) {
                    return this.check_constructor(node, callee, named.type_id);
                }
            }
            if (info != null && info.is_template) {
                info = this.instantiate_call(node, callee, info);
                if (info == null) {
                    return Types.i32_type();
                }
            }
            if (info != null && info.overload != null) {
                info = this.pick_overload(info, node, 0);
                if (info == null) {
                    return Types.i32_type();
                }
            }
            callee.set_symbol(SymbolKind.FUNCTION, (ptr)info);
        } else if (callee.kind() == NodeKind::FIELD_ACCESS) {
            Node* base = callee.first();
            if (this.is_struct_name(base)) {
                StructInfo* owner = symbols.find_struct(base.text_atom(), base.name(), this.scope);
                base.set_symbol(SymbolKind.STRUCT_NAME, (ptr)owner);
                info = symbols.find_method(owner, callee.name());
                info = this.apply_named_arguments(node, info);
                if (info != null && info.is_template) {
                    info = this.instantiate_call(node, callee, info);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && info.is_instance) {
                    this.error_code(callee, DiagnosticErrors.INSTANCE_STATIC_MISMATCH, "instance method called without an instance");
                    return Types.i32_type();
                }
                if (info != null && info.overload != null) {
                    info = this.pick_overload(info, node, 0);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                callee.set_symbol(SymbolKind.STATIC_METHOD, (ptr)info);
            } else {
                StructInfo* owner = this.struct_of_base(base);
                if (owner == null) {
                    return Types.i32_type();
                }
                info = symbols.find_method(owner, callee.name());
                if (info == null && owner.is_enum && !owner.has_payload && node.count() == 0
                    && callee.name() == Ast.intern_base_name("getValue", 8)) {
                    callee.set_symbol(SymbolKind.ENUM_VALUE, null);
                    return Types.i32_type();
                }
                info = this.apply_named_arguments(node, info);
                if (info != null && info.is_template) {
                    info = this.instantiate_call(node, callee, info);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && !info.is_instance) {
                    this.error_code(callee, DiagnosticErrors.INSTANCE_STATIC_MISMATCH, "static method called on an instance");
                    return Types.i32_type();
                }
                if (info != null && info.overload != null) {
                    info = this.pick_overload(info, node, 1);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                callee.set_symbol(SymbolKind.INSTANCE_METHOD, (ptr)info);
                offset = 1;
            }
        } else {
            this.error_code(node, DiagnosticErrors.UNDECLARED_FUNCTION, "only calls to named functions are supported yet");
            return Types.i32_type();
        }

        if (info == null) {
            Diagnostics.add_argument(callee.text());
            this.error_code(callee, DiagnosticErrors.UNDECLARED_FUNCTION, "call to an undeclared function");
            return Types.i32_type();
        }

        IdList* param_types = info.param_types;
        i32 fixed = param_types.length;
        if (node.count() + offset + 1 == fixed && this.takes_location(info)) {
            this.append_location(node);
        }
        i32 given = node.count() + offset;
        mut i32 normal = fixed;
        if (info.packs_variadic) {
            normal = fixed - 1;
        }
        if (given < normal || (given > fixed && !info.is_variadic && !info.packs_variadic)) {
            this.error_code(node, DiagnosticErrors.WRONG_ARGUMENT_COUNT, "wrong number of arguments");
            return info.return_type;
        }

        for (mut i32 i = offset; i < given; i = i + 1) {
            Node* argument = node.child(i - offset);
            if (i < normal) {
                u32 wanted = param_types.get(i);
                u32 passed = this.check_expression(argument, wanted);
                this.require_argument_shape(argument, passed, wanted);
            } else if (info.packs_variadic) {
                SymbolTable* pack_symbols = this.symbols;
                u32 element = pack_symbols.pack_element(param_types.get(fixed - 1));
                u32 passed = this.check_expression(argument, element);
                if (element != this.core_type("object")) {
                    this.require_argument_shape(argument, passed, element);
                }
            } else {
                this.check_expression(argument, 0);
            }
        }
        this.check_throwing_call(node, info);
        if (info.is_async) {
            return this.task_of(info.return_type, this.error_of(info), node);
        }
        if (info.const_kind != 0 && !info.is_instance && !info.is_template) {
            this.fold_call(node, info);
        }
        return info.return_type;
    }

    unsafe bool takes_location(FunctionInfo* info) {
        Node* declaration = info.node;
        IdList* param_types = info.param_types;
        if (declaration == null || declaration.kind() != NodeKind::FUNCTION || !Types.is_struct(param_types.get(param_types.length - 1))) {
            return false;
        }
        Node* last = declaration.child(declaration.count() - 1);
        if (last.kind() != NodeKind::PARAMETER) {
            return false;
        }
        PointerList* uses = Attributes.all();
        for (mut i32 i = uses.length - 1; i >= 0; i = i - 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target == last && Strings.same(use.name, "Location")) {
                return true;
            }
        }
        return false;
    }

    unsafe void append_location(Node* call) {
        i32 token = call.token;
        ptr<i8> path = Strings.duplicate(call.file_name(), strlen(call.file_name()));
        i32 length = strlen(path);
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (path[i] == 92) {
                path[i] = 47;
            }
        }
        Node* init = Node.create_list(NodeKind::STRUCT_INIT, token);
        Node* file_field = Node.create(NodeKind::FIELD_INIT, token);
        file_field.set_text("fileName");
        Node* file = Node.create(NodeKind::STRING_LITERAL, token);
        file.set_text_n(path, length);
        file.set_int_value(length);
        file_field.set_first(file);
        init.add(file_field);
        Node* line_field = Node.create(NodeKind::FIELD_INIT, token);
        line_field.set_text("line");
        Node* line = Node.create(NodeKind::INT_LITERAL, token);
        line.set_int_value(call.line());
        line_field.set_first(line);
        init.add(line_field);
        Node* column_field = Node.create(NodeKind::FIELD_INIT, token);
        column_field.set_text("column");
        Node* column = Node.create(NodeKind::INT_LITERAL, token);
        column.set_int_value(call.column());
        column_field.set_first(column);
        init.add(column_field);
        call.add(init);
    }
}
