namespace djinnc;

impl TypeChecker {
    public unsafe CheckState* enter_nested() {
        CheckState* state = (CheckState*)Memory.zalloc(sizeof(CheckState));
        SymbolTable* symbols = this.symbols;
        state.function = this.function;
        state.scope = this.scope;
        state.scopes = this.scopes;
        state.loop_depth = this.loop_depth;
        state.switch_depth = this.switch_depth;
        state.unsafe_depth = this.unsafe_depth;
        state.assign_target = this.assign_target;
        state.bindings = symbols.bindings;
        this.scopes = LocalScopes.create();
        return state;
    }

    public void leave_nested(CheckState* state) {
        SymbolTable* symbols = this.symbols;
        this.function = state.function;
        this.scope = state.scope;
        this.scopes = state.scopes;
        this.loop_depth = state.loop_depth;
        this.switch_depth = state.switch_depth;
        this.unsafe_depth = state.unsafe_depth;
        this.assign_target = state.assign_target;
        symbols.bindings = state.bindings;
    }

    unsafe void check_function(FunctionInfo* info) {
        info.check_state = 1;
        SymbolTable* active = this.symbols;
        active.bindings = info.bindings;
        if (info.owner != null && info.bindings == null) {
            StructInfo* owner = info.owner;
            active.bindings = owner.bindings;
        }
        this.scope = info.namespace_id;
        this.function = info;
        this.loop_depth = 0;
        this.switch_depth = 0;
        this.unsafe_depth = 0;
        this.try_target = (Node*)0;
        LocalScopes* scopes = this.scopes;
        scopes.reset_to(0);
        PointerList* borrows = this.borrows;
        borrows.length = 0;

        Node* declaration = info.node;
        IdList* params = info.param_types;
        mut i32 offset = 0;
        if (info.is_instance) {
            offset = 1;
            LocalVariable* receiver = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
            receiver.name = "this";
            receiver.name_atom = Atoms.THIS_ATOM;
            receiver.type = params.get(0);
            info.this_variable = receiver;
            scopes.define(Atoms.THIS_ATOM, receiver);
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
            variable.name = parameter.text();
            variable.name_atom = parameter.name();
            variable.type = params.get(i + offset);
            variable.is_mutable = parameter.flag();
            variable.node = parameter;
            parameter.set_symbol(SymbolKind.LOCAL, (ptr)variable);
            parameter.set_value_type(variable.type);
            scopes.define(variable.name_atom, variable);
        }

        this.check_statement(declaration.first());
        info.check_state = 2;
    }

    void check_statement(Node* node) {
        NodeKind kind = node.kind();
        LocalScopes* scopes = this.scopes;

        switch (kind) {
            case BLOCK:
                i32 mark = scopes.mark();
                bool guarded = node.op() == 8;
                if (guarded) {
                    this.unsafe_depth = this.unsafe_depth + 1;
                }
                for (mut i32 i = 0; i < node.count(); i = i + 1) {
                    this.check_statement(node.child(i));
                }
                if (guarded) {
                    this.unsafe_depth = this.unsafe_depth - 1;
                }
                scopes.reset_to(mark);
            case VAR_DECL:
                this.check_variable(node);
            case EXPR_STMT:
                this.check_expression(node.first(), 0);
            case SPAWN_STMT:
                u32 spawned = this.check_expression(node.first(), 0);
                if (this.task_result(spawned) == 0) {
                    this.error_code(node, DiagnosticErrors.AWAIT_NEEDS_TASK, "'spawn' needs the task returned by an async function");
                }
            case RETURN:
                this.check_return(node);
            case THROW_STMT:
                this.check_throw(node);
            case IF:
                if (node.op() != 0) {
                    this.check_compile_time_if(node);
                } else {
                    this.check_condition(node.first());
                    this.check_statement(node.second());
                    if (node.third() != null) {
                        this.check_statement(node.third());
                    }
                }
            case WHILE:
                this.check_condition(node.first());
                this.check_loop_body(node.second());
            case DO_WHILE:
                this.check_loop_body(node.second());
                this.check_condition(node.first());
            case FOR:
                i32 mark = scopes.mark();
                if (node.first() != null) {
                    this.check_statement(node.first());
                }
                if (node.second() != null) {
                    this.check_condition(node.second());
                }
                if (node.third() != null) {
                    this.check_expression(node.third(), 0);
                }
                this.check_loop_body(node.fourth());
                scopes.reset_to(mark);
            case BREAK:
                if (this.loop_depth == 0 && this.switch_depth == 0) {
                    this.error_code(node, DiagnosticErrors.INVALID_JUMP, "'break' outside of a loop or switch");
                }
            case CONTINUE:
                if (this.loop_depth == 0) {
                    this.error_code(node, DiagnosticErrors.INVALID_JUMP, "'continue' outside of a loop");
                }
            case SWITCH:
                this.check_switch(node);
            default:
                this.error_code(node, DiagnosticErrors.NOT_SUPPORTED_YET, "statement is not supported yet");
        }
    }

    unsafe void check_enum_label(Node* arm, StructInfo* enumeration) {
        mut Node* label = arm.first();
        if (label.kind() == NodeKind::CALL && label.count() == 0) {
            label = label.first();
            arm.set_first(label);
        }
        SymbolTable* symbols = this.symbols;
        mut Node* variant = (Node*)0;
        if (label.kind() == NodeKind::IDENTIFIER) {
            ptr<i8> text = label.text();
            mut i32 start = 0;
            for (mut i32 i = 0; text[i] != 0; i = i + 1) {
                if (text[i] == 58) {
                    start = i + 1;
                }
            }
            variant = symbols.find_constant(enumeration, Ast.intern_base_name(text + start, (i32)strlen(text + start)));
        }
        if (variant == null) {
            this.error_code(label, DiagnosticErrors.INVALID_CASE, "case label must name a variant of the switched enum");
            return;
        }
        label.set_symbol(SymbolKind.CONSTANT, (ptr)variant);
        label.set_value_type(enumeration.type_id);
    }

    void check_switch(Node* node) {
        u32 value_type = this.check_expression(node.first(), 0);
        SymbolTable* symbols = this.symbols;
        StructInfo* enumeration = symbols.enum_of_type(value_type);
        bool over_enum = enumeration != null && !enumeration.has_payload;
        if (!over_enum && !Types.is_integer(value_type)) {
            this.error_code(node.first(), DiagnosticErrors.INVALID_CASE, "switch value must be an integer or an enum");
        }
        mut bool has_default = false;
        this.switch_depth = this.switch_depth + 1;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            if (arm.first() == null) {
                if (has_default) {
                    this.error_code(arm, DiagnosticErrors.INVALID_CASE, "switch has more than one 'default'");
                }
                has_default = true;
            } else if (over_enum) {
                this.check_enum_label(arm, enumeration);
            } else {
                u32 label_type = this.check_expression(arm.first(), value_type);
                if (!Types.is_integer(label_type)) {
                    this.error_code(arm.first(), DiagnosticErrors.INVALID_CASE, "case label must be an integer constant");
                }
            }
            LocalScopes* scopes = this.scopes;
            i32 mark = scopes.mark();
            for (mut i32 j = 0; j < arm.count(); j = j + 1) {
                this.check_statement(arm.child(j));
            }
            scopes.reset_to(mark);
        }
        this.switch_depth = this.switch_depth - 1;
    }

    void check_loop_body(Node* body) {
        this.loop_depth = this.loop_depth + 1;
        this.check_statement(body);
        this.loop_depth = this.loop_depth - 1;
    }

    void check_condition(Node* node) {
        u32 type = this.check_expression(node, 0);
        this.require_condition(node, type);
    }

    void require_condition(Node* node, u32 type) {
        bool usable = Types.is_integer(type) || Types.is_float(type) || Types.is_pointer(type);
        if (!usable) {
            this.error_code(node, DiagnosticErrors.INVALID_CONDITION, "condition must be a number or a pointer");
        }
    }

    unsafe void check_variable(Node* node) {
        mut u32 declared = this.resolve_type(node.type(), node);
        mut u32 initial = 0;
        if (node.first() != null) {
            mut u32 hint = declared;
            if (declared == Types.auto_type()) {
                hint = 0;
            }
            initial = this.check_expression(node.first(), hint);
        }
        if (declared == Types.auto_type()) {
            if (initial == 0) {
                this.error_code(node, DiagnosticErrors.INVALID_VARIABLE, "'auto' variable needs an initializer");
                declared = Types.i32_type();
            } else {
                declared = initial;
            }
        }
        if (Types.is_void(declared)) {
            this.error_code(node, DiagnosticErrors.INVALID_VARIABLE, "variable cannot have type void");
            declared = Types.i32_type();
        }
        Node* initializer = node.first();
        if (initializer != null) {
            if (initializer.kind() == NodeKind::NEW_EXPR && initial == Types.pointer_to(declared)) {
                declared = initial;
            }
            this.require_value_type(initializer, initial, declared);
        }

        LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
        variable.name = node.text();
        variable.name_atom = node.name();
        variable.type = declared;
        variable.is_mutable = node.flag();
        variable.node = node;
        node.set_symbol(SymbolKind.LOCAL, (ptr)variable);
        node.set_value_type(declared);
        if (node.first() != null) {
            this.move_from(node.first(), (Node*)0);
        }
        if (node.op() != 0) {
            if (node.flag()) {
                this.error_code(node, DiagnosticErrors.INVALID_VARIABLE, "a constexpr variable cannot be mut");
            }
            this.evaluate_variable(variable, node);
        }
        LocalScopes* scopes = this.scopes;
        scopes.define(variable.name_atom, variable);
        if (node.first() != null) {
            this.borrow_from(node.first(), variable);
        }
    }

    void check_return(Node* node) {
        FunctionInfo* info = this.function;
        u32 expected = info.return_type;
        if (node.first() == null) {
            if (!Types.is_void(expected)) {
                this.error_code(node, DiagnosticErrors.RETURN_MISMATCH, "missing return value");
            }
            return;
        }
        if (Types.is_void(expected)) {
            this.error_code(node, DiagnosticErrors.RETURN_MISMATCH, "void function cannot return a value");
            this.check_expression(node.first(), 0);
            return;
        }
        u32 returned = this.check_expression(node.first(), expected);
        this.require_value_type(node.first(), returned, expected);
        this.check_returned_borrow(node.first());
    }

    LocalVariable* find_variable(u32 name) {
        LocalScopes* scopes = this.scopes;
        LocalVariable* local = scopes.find(name);
        if (local != null) {
            return local;
        }
        SymbolTable* symbols = this.symbols;
        return symbols.find_global(name, name, this.scope);
    }
}
