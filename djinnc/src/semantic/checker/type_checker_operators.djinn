namespace djinnc;

impl TypeChecker {
    u32 check_unary(Node* node, u32 expected) {
        TokenKind op = node.op_kind();

        if (op == TokenKind::AMPERSAND) {
            u32 addressed = this.check_lvalue(node.first());
            Node* operand = node.first();
            if (operand.symbol_kind() == SymbolKind.PROPERTY_GET || operand.symbol_kind() == SymbolKind.INDEX_GET) {
                this.error_code(node, DiagnosticErrors.NOT_ADDRESSABLE, "cannot take the address of a property or an indexer");
            }
            return Types.pointer_to(addressed);
        }
        if (op == TokenKind::STAR) {
            return this.check_lvalue(node);
        }
        if (op == TokenKind::PLUS_PLUS || op == TokenKind::MINUS_MINUS) {
            return this.check_count(node);
        }

        Node* negated = node.first();
        this.negated_literal = op == TokenKind::MINUS && negated.kind() == NodeKind::INT_LITERAL;
        u32 operand = this.check_expression(node.first(), expected);
        if (Types.is_struct(operand) && (op == TokenKind::MINUS || op == TokenKind::TILDE || op == TokenKind::BANG)) {
            return this.check_unary_operator(node, op, operand);
        }
        if (op == TokenKind::MINUS) {
            if (!Types.is_integer(operand) && !Types.is_float(operand)) {
                this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "operator is not valid for this operand");
            }
            return operand;
        }
        if (op == TokenKind::TILDE) {
            if (!Types.is_integer(operand)) {
                this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "operator is not valid for this operand");
            }
            return operand;
        }
        if (op == TokenKind::BANG) {
            return Types.bool_type();
        }

        this.error_code(node, DiagnosticErrors.NOT_SUPPORTED_YET, "unary operator is not supported yet");
        return Types.i32_type();
    }

    unsafe u32 check_count(Node* node) {
        Node* target = node.first();
        if (!this.is_addressable(target)) {
            this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "the operand of ++ and -- must be a variable, a field or an element");
            return Types.i32_type();
        }
        u32 type = this.check_lvalue(target);
        if (target.symbol_kind() == SymbolKind.PROPERTY_GET || target.symbol_kind() == SymbolKind.INDEX_GET
            || target.symbol_kind() == SymbolKind.IMPLICIT_GET) {
            this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "++ and -- cannot be applied to a property or an indexer");
            return type;
        }
        if (target.kind() == NodeKind::IDENTIFIER && (target.symbol_kind() == SymbolKind.LOCAL || target.symbol_kind() == SymbolKind.GLOBAL)) {
            LocalVariable* variable = (LocalVariable*)target.symbol();
            if (!variable.is_mutable) {
                this.error_code(target, DiagnosticErrors.ASSIGN_TO_IMMUTABLE, "cannot assign to an immutable variable");
            }
            this.require_not_borrowed(target, variable, "assign to");
        }
        if (Types.is_pointer(type)) {
            if (Types.is_raw_pointer(type)) {
                this.require_unsafe(node, "pointer arithmetic on a raw pointer");
            }
            return type;
        }
        if (!Types.is_integer(type) && !Types.is_float(type)) {
            this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "++ and -- need an integer, a float or a pointer");
        }
        return type;
    }

    bool is_untyped_literal(Node* node) {
        if (node.kind() == NodeKind::INT_LITERAL) {
            return true;
        }
        if (node.kind() != NodeKind::UNARY || node.op_kind() != TokenKind::MINUS) {
            return false;
        }
        Node* operand = node.first();
        return operand.kind() == NodeKind::INT_LITERAL;
    }

    bool is_plain_enum(u32 type) {
        SymbolTable* symbols = this.symbols;
        StructInfo* enumeration = symbols.enum_of_type(type);
        return enumeration != null && !enumeration.has_payload;
    }

    public static bool is_comparison(TokenKind op) {
        return op == TokenKind::EQUAL_EQUAL || op == TokenKind::BANG_EQUAL || op == TokenKind::LESS
            || op == TokenKind::LESS_EQUAL || op == TokenKind::GREATER || op == TokenKind::GREATER_EQUAL;
    }

    FunctionInfo* find_operator(StructInfo* owner, TokenKind op) {
        ByteBuffer* name = ByteBuffer.create();
        name.append("operator");
        name.append(op.text);
        return this.find_operator_named(owner, name.cstr());
    }

    FunctionInfo* find_operator_named(StructInfo* owner, ptr<i8> name) {
        SymbolTable* symbols = this.symbols;
        return symbols.find_method(owner, Ast.intern_base_name(name, (i32)strlen(name)));
    }

    u32 check_unary_operator(Node* node, TokenKind op, u32 operand) {
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(operand));
        mut FunctionInfo* walk = this.find_operator(owner, op);
        if (walk == null) {
            this.error_code(node, DiagnosticErrors.OPERATOR_NOT_DEFINED, "struct does not define this operator");
            return Types.i32_type();
        }
        while (walk != null) {
            IdList* candidate_params = walk.param_types;
            if (candidate_params.length == 1 && candidate_params.get(0) == operand) {
                node.set_symbol(SymbolKind.OPERATOR, (ptr)walk);
                return walk.return_type;
            }
            walk = walk.overload;
        }
        this.error_code(node, DiagnosticErrors.OPERATOR_NOT_DEFINED, "operator operand does not match its parameter");
        return Types.i32_type();
    }

    u32 check_index_operator(Node* node, u32 base) {
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(base));
        mut FunctionInfo* method = this.find_operator_named(owner, "operatorget[]");
        if (method == null) {
            this.check_expression(node.second(), Types.i64_type());
            this.error_code(node, DiagnosticErrors.OPERATOR_NOT_DEFINED, "struct does not define operator get[]");
            return Types.i32_type();
        }
        u32 index = this.check_expression(node.second(), 0);
        mut FunctionInfo* exact = (FunctionInfo*)0;
        mut FunctionInfo* walk = method;
        while (walk != null) {
            IdList* candidate_params = walk.param_types;
            if (candidate_params.length == 2 && candidate_params.get(0) == base) {
                if (exact == null || candidate_params.get(1) == index) {
                    exact = walk;
                }
            }
            walk = walk.overload;
        }
        if (exact == null) {
            this.error_code(node, DiagnosticErrors.OPERATOR_NOT_DEFINED, "operator get[] does not accept this collection");
            return Types.i32_type();
        }
        IdList* chosen_params = exact.param_types;
        this.check_expression(node.second(), chosen_params.get(1));
        node.set_symbol(SymbolKind.INDEX_GET, (ptr)exact);
        return exact.return_type;
    }

    unsafe void bind_index_setter(Node* target) {
        Node* collection = target.first();
        u32 base = collection.value_type();
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(base));
        FunctionInfo* getter = (FunctionInfo*)target.symbol();
        IdList* getter_params = getter.param_types;
        mut FunctionInfo* walk = this.find_operator_named(owner, "operatorset[]");
        while (walk != null) {
            IdList* candidate_params = walk.param_types;
            bool takes_collection = candidate_params.length == 3 && (candidate_params.get(0) == base || candidate_params.get(0) == Types.pointer_to(base));
            if (takes_collection && candidate_params.get(1) == getter_params.get(1)) {
                target.set_symbol(SymbolKind.INDEX_SET, (ptr)walk);
                return;
            }
            walk = walk.overload;
        }
        this.error_code(target, DiagnosticErrors.OPERATOR_NOT_DEFINED, "struct does not define a matching operator set[]");
    }

    u32 check_operator(Node* node, TokenKind op, u32 left, u32 right) {
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(left));
        mut FunctionInfo* method = this.find_operator(owner, op);
        mut i32 kind = SymbolKind.OPERATOR;
        if (method == null && op == TokenKind::BANG_EQUAL) {
            method = this.find_operator(owner, TokenKind::EQUAL_EQUAL);
            kind = SymbolKind.NEGATED_OPERATOR;
        }
        if (method == null) {
            this.error_code(node, DiagnosticErrors.OPERATOR_NOT_DEFINED, "struct does not define this operator");
            return Types.i32_type();
        }
        mut FunctionInfo* exact = (FunctionInfo*)0;
        mut FunctionInfo* walk = method;
        while (walk != null) {
            IdList* candidate_params = walk.param_types;
            if (candidate_params.length == 2 && candidate_params.get(0) == left && candidate_params.get(1) == right) {
                exact = walk;
                break;
            }
            walk = walk.overload;
        }
        if (exact == null) {
            this.error_code(node, DiagnosticErrors.OPERATOR_NOT_DEFINED, "operator operands do not match its parameters");
            return method.return_type;
        }
        method = exact;
        node.set_symbol(kind, (ptr)method);
        return method.return_type;
    }

    u32 check_binary(Node* node, u32 expected) {
        TokenKind op = node.op_kind();
        if (op == TokenKind::AND_AND || op == TokenKind::OR_OR) {
            u32 first = this.check_expression(node.first(), 0);
            if (Types.is_struct(first)) {
                u32 second = this.check_expression(node.second(), first);
                return this.check_operator(node, op, first, second);
            }
            this.require_condition(node.first(), first);
            u32 other = this.check_expression(node.second(), 0);
            this.require_condition(node.second(), other);
            return Types.bool_type();
        }

        if (op == TokenKind::QUESTION_QUESTION) {
            u32 pointer = this.check_expression(node.first(), expected);
            if (!Types.is_pointer(pointer)) {
                this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "the left operand of ?? must be a pointer");
                return pointer;
            }
            u32 fallback = this.check_expression(node.second(), pointer);
            if (Types.is_nullable_pointer(pointer) && Types.is_safe_pointer(fallback)) {
                return fallback;
            }
            return pointer;
        }

        mut u32 hint = expected;
        if (TypeChecker.is_comparison(op)) {
            hint = 0;
        }

        mut u32 left = 0;
        mut u32 right = 0;
        if (this.is_untyped_literal(node.first()) && !this.is_untyped_literal(node.second())) {
            right = this.check_expression(node.second(), hint);
            left = this.check_expression(node.first(), right);
        } else {
            left = this.check_expression(node.first(), hint);
            right = this.check_expression(node.second(), left);
        }

        if (Types.is_pointer(left) && Types.is_integer(right) && (op == TokenKind::PLUS || op == TokenKind::MINUS)) {
            if (Types.is_raw_pointer(left)) {
                this.require_unsafe(node, "pointer arithmetic on a raw pointer");
            }
            return left;
        }

        if (this.is_plain_enum(left) || this.is_plain_enum(right)) {
            bool equality = op == TokenKind::EQUAL_EQUAL || op == TokenKind::BANG_EQUAL;
            if (!equality || left != right) {
                this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "an enum is its own type: it only supports == and != with a value of the same enum, compare other values with getValue()");
            }
            return Types.bool_type();
        }

        if (Types.is_struct(left)) {
            return this.check_operator(node, op, left, right);
        }

        bool numbers = (Types.is_integer(left) || Types.is_float(left)) && (Types.is_integer(right) || Types.is_float(right));
        if (numbers && !Types.widens(left, right) && !Types.widens(right, left)) {
            this.error_code(node, DiagnosticErrors.IMPLICIT_CONVERSION, "operands of different types need an explicit cast");
        }
        u32 common = Types.common(left, right);
        this.check_constant_operands(node, op, common);
        if (TypeChecker.is_comparison(op)) {
            return Types.bool_type();
        }
        if (Types.is_float(common)) {
            bool valid = op == TokenKind::PLUS || op == TokenKind::MINUS || op == TokenKind::STAR
                || op == TokenKind::SLASH || op == TokenKind::PERCENT;
            if (!valid) {
                this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "operator is not valid for floating point operands");
            }
        } else if (!Types.is_integer(common)) {
            this.error_code(node, DiagnosticErrors.INVALID_OPERATOR_OPERAND, "operator is not valid for these operands");
        }
        return common;
    }

    unsafe u32 check_assign(Node* node) {
        Node* target = node.first();
        this.assign_target = target;
        u32 type = this.check_lvalue(target);
        this.assign_target = (Node*)0;
        if (target.kind() == NodeKind::FIELD_ACCESS && target.symbol_kind() == SymbolKind.PROPERTY_GET) {
            FunctionInfo* getter = (FunctionInfo*)target.symbol();
            FunctionInfo* setter = this.find_accessor(getter.owner, "set:", target.text());
            if (setter == null) {
                this.error_code(target, DiagnosticErrors.PROPERTY_WITHOUT_SETTER, "property has no setter");
            } else {
                target.set_symbol(SymbolKind.PROPERTY_SET, (ptr)setter);
            }
        }
        if (target.kind() == NodeKind::INDEX && target.symbol_kind() == SymbolKind.INDEX_GET) {
            this.bind_index_setter(target);
        }
        if (target.kind() == NodeKind::IDENTIFIER && target.symbol_kind() == SymbolKind.IMPLICIT_GET) {
            FunctionInfo* implicit_setter = this.implicit_accessor(target, "set:");
            if (implicit_setter == null) {
                this.error_code(target, DiagnosticErrors.PROPERTY_WITHOUT_SETTER, "property has no setter");
            } else {
                target.set_symbol(SymbolKind.IMPLICIT_SET, (ptr)implicit_setter);
            }
        }
        if (target.kind() == NodeKind::IDENTIFIER && (target.symbol_kind() == SymbolKind.LOCAL || target.symbol_kind() == SymbolKind.GLOBAL)) {
            LocalVariable* variable = (LocalVariable*)target.symbol();
            if (!variable.is_mutable) {
                this.error_code(target, DiagnosticErrors.ASSIGN_TO_IMMUTABLE, "cannot assign to an immutable variable");
            }
            this.require_not_borrowed(target, variable, "assign to");
        }
        u32 assigned = this.check_expression(node.second(), type);
        this.require_value_type(node.second(), assigned, type);
        if (target.kind() == NodeKind::IDENTIFIER) {
            this.move_from(node.second(), target);
        }
        if (target.kind() == NodeKind::IDENTIFIER && (target.symbol_kind() == SymbolKind.LOCAL || target.symbol_kind() == SymbolKind.GLOBAL)) {
            LocalVariable* reinitialized = (LocalVariable*)target.symbol();
            reinitialized.moved = false;
        }
        return type;
    }

    bool is_copy_type(u32 type) {
        return !Types.is_struct(type);
    }

    unsafe void move_from(Node* source, Node* destination) {
        if (source.kind() != NodeKind::IDENTIFIER || source.symbol_kind() != SymbolKind.LOCAL) {
            return;
        }
        if (destination != null && destination.kind() == NodeKind::IDENTIFIER && destination.symbol() == source.symbol()) {
            return;
        }
        LocalVariable* variable = (LocalVariable*)source.symbol();
        if (!this.is_copy_type(variable.type)) {
            this.require_not_borrowed(source, variable, "move");
            variable.moved = true;
        }
    }
}
