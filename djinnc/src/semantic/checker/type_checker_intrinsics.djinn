namespace djinnc;

impl TypeChecker {
    unsafe Node* provided_constant(Node* member, u32 type, i64 value) {
        mut Node* literal = Node.create(NodeKind::INT_LITERAL, member.token);
        if (type == Types.bool_type()) {
            literal = Node.create(NodeKind::BOOL_LITERAL, member.token);
        }
        literal.set_int_value(value);
        literal.set_value_type(type);
        Node* constant = Node.create(NodeKind::STATIC_VAR, member.token);
        constant.set_first(literal);
        constant.set_value_type(type);
        return constant;
    }

    unsafe Node* provided_flag(Node* member, bool value) {
        mut i64 raw = 0;
        if (value) {
            raw = 1;
        }
        return this.provided_constant(member, Types.bool_type(), raw);
    }

    unsafe Node* intrinsic_constant(Node* base, Node* member) {
        ptr<i8> group = base.text();
        ptr<i8> name = member.text();
        if (Strings.same(group, "Platform")) {
            if (Strings.same(name, "Windows")) { return this.provided_flag(member, Target.is_windows()); }
            if (Strings.same(name, "Linux")) { return this.provided_flag(member, Target.is_linux()); }
            if (Strings.same(name, "MacOs")) { return this.provided_flag(member, Target.is_macos()); }
        }
        if (Strings.same(group, "Arch")) {
            if (Strings.same(name, "X64")) { return this.provided_flag(member, Target.is_x64()); }
            if (Strings.same(name, "X86")) { return this.provided_flag(member, Target.is_x86()); }
            if (Strings.same(name, "Arm64")) { return this.provided_flag(member, Target.is_arm64()); }
        }
        if (Strings.same(group, "Build")) {
            if (Strings.same(name, "Debug")) { return this.provided_flag(member, Target.is_debug()); }
            if (Strings.same(name, "Release")) { return this.provided_flag(member, !Target.is_debug()); }
        }
        if (Strings.same(group, "Runtime") && Strings.same(name, "PointerSize")) {
            return this.provided_constant(member, Types.i32_type(), (i64)(Target.pointer_bits() / 8));
        }
        return (Node*)0;
    }
}
