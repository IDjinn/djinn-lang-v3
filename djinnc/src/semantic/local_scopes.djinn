namespace djinnc;

struct LocalScopes {
    ptr<u32> names;
    LocalVariable** variables;
    i32 length;
    i32 capacity;

    public static unsafe LocalScopes* create() {
        LocalScopes* scopes = (LocalScopes*)Memory.zalloc(sizeof(LocalScopes));
        scopes.capacity = 64;
        scopes.names = (ptr<u32>)Memory.zalloc(64 * 4);
        scopes.variables = (LocalVariable**)Memory.zalloc(64 * 8);
        return scopes;
    }

    public i32 mark() {
        return this.length;
    }

    public void reset_to(i32 mark) {
        this.length = mark;
    }

    public unsafe void define(u32 name, LocalVariable* variable) {
        if (this.length == this.capacity) {
            this.grow();
        }
        this.names[this.length] = name;
        this.variables[this.length] = variable;
        this.length = this.length + 1;
    }

    public unsafe LocalVariable* find(u32 name) {
        mut i32 index = this.length - 1;
        while (index >= 0) {
            if (this.names[index] == name) {
                return this.variables[index];
            }
            index = index - 1;
        }
        return (LocalVariable*)0;
    }

    public unsafe bool contains(LocalVariable* variable) {
        for (mut i32 i = 0; i < this.length; i = i + 1) {
            if (this.variables[i] == variable) {
                return true;
            }
        }
        return false;
    }

    unsafe void grow() {
        i32 capacity = this.capacity * 2;
        ptr<u32> names = (ptr<u32>)Memory.zalloc((u64)capacity * 4);
        LocalVariable** variables = (LocalVariable**)Memory.zalloc((u64)capacity * 8);
        memcpy(names, this.names, (u64)this.length * 4);
        memcpy(variables, this.variables, (u64)this.length * 8);
        this.names = names;
        this.variables = variables;
        this.capacity = capacity;
    }
}
