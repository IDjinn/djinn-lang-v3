namespace djinnc;

struct Types {
    public static u32 void_type() {
        return 1;
    }

    public static u32 auto_type() {
        return 2;
    }

    public static u32 integer(u32 bits, bool is_signed) {
        TypeTable* table = TypeTable.get();
        return table.integer(bits, is_signed);
    }

    public static u32 floating(u32 bits) {
        TypeTable* table = TypeTable.get();
        return table.floating(bits);
    }

    public static u32 bool_type() {
        return Types.integer(1, false);
    }

    public static u32 i32_type() {
        return Types.integer(32, true);
    }

    public static u32 i64_type() {
        return Types.integer(64, true);
    }

    public static u32 byte_pointer() {
        return Types.pointer_to(Types.integer(8, true));
    }

    public static u32 enumeration(u32 struct_index) {
        TypeTable* table = TypeTable.get();
        return table.enumeration(struct_index);
    }

    public static i64 enum_index(u32 id) {
        TypeTable* table = TypeTable.get();
        return table.enum_index(id);
    }

    public static u32 pointer_to(u32 element) {
        TypeTable* table = TypeTable.get();
        return table.pointer_to(element);
    }

    public static u32 nullable_pointer_to(u32 element) {
        TypeTable* table = TypeTable.get();
        return table.nullable_pointer_to(element);
    }

    public static bool is_nullable_pointer(u32 id) {
        TypeTable* table = TypeTable.get();
        return Types.is_pointer(id) && table.is_nullable_pointer(id);
    }

    public static bool is_safe_pointer(u32 id) {
        return Types.is_pointer(id) && !Types.is_raw_pointer(id) && !Types.is_nullable_pointer(id);
    }

    public static u32 raw_pointer_to(u32 element) {
        TypeTable* table = TypeTable.get();
        return table.raw_pointer_to(element);
    }

    public static bool is_raw_pointer(u32 id) {
        return Types.is_pointer(id) && Types.is_signed(id);
    }

    public static u32 structure(u32 struct_index) {
        TypeTable* table = TypeTable.get();
        return table.structure(struct_index);
    }

    public static i32 kind(u32 id) {
        TypeTable* table = TypeTable.get();
        return table.kind(id);
    }

    public static bool is_void(u32 id) {
        return Types.kind(id) == TypeKind.VOID;
    }

    public static bool is_integer(u32 id) {
        return Types.kind(id) == TypeKind.INTEGER;
    }

    public static bool is_float(u32 id) {
        return Types.kind(id) == TypeKind.FLOAT;
    }

    public static bool is_pointer(u32 id) {
        return Types.kind(id) == TypeKind.POINTER;
    }

    public static bool is_struct(u32 id) {
        return Types.kind(id) == TypeKind.NAMED;
    }

    public static u32 bits(u32 id) {
        TypeTable* table = TypeTable.get();
        return table.operand(id);
    }

    public static bool is_signed(u32 id) {
        TypeTable* table = TypeTable.get();
        return table.is_signed(id);
    }

    public static u32 element(u32 id) {
        TypeTable* table = TypeTable.get();
        return table.operand(id);
    }

    public static u32 struct_index(u32 id) {
        TypeTable* table = TypeTable.get();
        return table.operand(id);
    }

    public static bool is_sized_pointer(u32 id) {
        return Types.is_pointer(id) && !Types.is_void(Types.element(id));
    }

    public static bool widens(u32 from, u32 to) {
        if (Types.is_float(from)) {
            return Types.is_float(to) && Types.bits(to) >= Types.bits(from);
        }
        if (!Types.is_integer(to) || (Types.bits(from) == 1) != (Types.bits(to) == 1)) {
            return false;
        }
        return Types.is_signed(from) == Types.is_signed(to) && Types.bits(to) >= Types.bits(from);
    }

    public static u32 common(u32 left, u32 right) {
        if (Types.is_float(right) && Types.is_integer(left)) {
            return right;
        }
        if (Types.is_integer(left) && Types.is_integer(right) && Types.bits(right) > Types.bits(left)) {
            return right;
        }
        if (Types.is_float(left) && Types.is_float(right) && Types.bits(right) > Types.bits(left)) {
            return right;
        }
        return left;
    }

    public static void describe(u32 id, ByteBuffer* out) {
        i32 kind = Types.kind(id);
        if (kind == TypeKind.VOID) {
            out.append("void");
        } else if (kind == TypeKind.AUTO) {
            out.append("auto");
        } else if (kind == TypeKind.INTEGER) {
            if (Types.bits(id) == 1) {
                out.append("bool");
            } else {
                if (Types.is_signed(id)) {
                    out.append_char(105);
                } else {
                    out.append_char(117);
                }
                out.append_int((i64)Types.bits(id));
            }
        } else if (kind == TypeKind.FLOAT) {
            out.append_char(102);
            out.append_int((i64)Types.bits(id));
        } else if (kind == TypeKind.POINTER) {
            Types.describe(Types.element(id), out);
            out.append_char(42);
        } else if (kind == TypeKind.NAMED) {
            out.append("struct");
        } else {
            out.append("?");
        }
    }
}
