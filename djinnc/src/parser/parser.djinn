namespace djinnc;

struct Parser {
    TokenList* tokens;

    i32 pos;

    i32 end;

    bool failed;

    bool scan_half;

    bool half_greater;

    i32 hidden_count;

    PointerList* extra_declarations;

    Diagnostics* diagnostics;

    U32Map* type_names;

    bool bodyless_seen;

    i32 generic_depth;

    i32 bodyless_token;

    public static unsafe Parser* create(TokenList* tokens, SourceFile* file, Diagnostics* diagnostics, U32Map* type_names) {
        Parser* parser = (Parser*)Memory.zalloc(sizeof(Parser));
        parser.tokens = tokens;
        parser.pos = file.first_token;
        parser.end = file.token_end;
        parser.diagnostics = diagnostics;
        parser.type_names = type_names;
        return parser;
    }

    public static void collect_type_names(TokenList* list, SourceFile* file, U32Map* names) {
        for (mut i32 i = file.first_token; i + 1 < file.token_end; i = i + 1) {
            TokenKind kind = list.kind(i);
            bool endsType = kind == TokenKind::IDENTIFIER || kind == TokenKind::STAR || kind == TokenKind::GREATER || kind == TokenKind::VOID;
            if (endsType && i + 3 < file.token_end && list.kind(i + 1) == TokenKind::IDENTIFIER
                && list.kind(i + 2) == TokenKind::LESS && list.kind(i + 3) == TokenKind::IDENTIFIER) {
                mut i32 scan = i + 3;
                while (scan + 1 < file.token_end && list.kind(scan) == TokenKind::IDENTIFIER && list.kind(scan + 1) == TokenKind::COMMA) {
                    scan = scan + 2;
                }
                if (scan + 2 < file.token_end && list.kind(scan) == TokenKind::IDENTIFIER
                    && list.kind(scan + 1) == TokenKind::GREATER && list.kind(scan + 2) == TokenKind::LPAREN) {
                    mut i32 cursor = i + 3;
                    while (cursor <= scan) {
                        if (list.kind(cursor) == TokenKind::IDENTIFIER) {
                            names.put(list.atom(cursor), 1);
                        }
                        cursor = cursor + 1;
                    }
                }
            }
            if (kind == TokenKind::IDENTIFIER && Strings.equals(list.text(i), list.text_length(i), "attribute")) {
                Parser.collect_attribute_name(list, file, i);
                bool declaration = i + 2 < file.token_end && list.kind(i + 1) == TokenKind::IDENTIFIER
                    && (list.kind(i + 2) == TokenKind::LPAREN || list.kind(i + 2) == TokenKind::LBRACE || list.kind(i + 2) == TokenKind::SEMICOLON);
                if (declaration && !(i > file.first_token && list.kind(i - 1) == TokenKind::LBRACKET)) {
                    names.put(list.atom(i + 1), 1);
                }
            }
            bool declaresUnion = kind == TokenKind::IDENTIFIER && Strings.equals(list.text(i), list.text_length(i), "union");
            bool declaresType = kind == TokenKind::STRUCT || kind == TokenKind::ENUM || kind == TokenKind::INTERFACE || declaresUnion;
            if (declaresType && list.kind(i + 1) == TokenKind::IDENTIFIER) {
                names.put(list.atom(i + 1), 1);
                if (list.kind(i + 2) == TokenKind::LESS) {
                    mut i32 cursor = i + 3;
                    while (cursor < file.token_end && list.kind(cursor) == TokenKind::IDENTIFIER) {
                        names.put(list.atom(cursor), 1);
                        cursor = cursor + 1;
                        if (list.kind(cursor) == TokenKind::COMMA) {
                            cursor = cursor + 1;
                        }
                    }
                }
            }
        }
    }

    static unsafe void collect_attribute_name(TokenList* list, SourceFile* file, i32 at) {
        if (at > file.first_token && list.kind(at - 1) == TokenKind::LBRACKET) {
            mut i32 scan = at;
            while (scan < file.token_end && list.kind(scan) != TokenKind::RBRACKET) {
                scan = scan + 1;
            }
            scan = scan + 1;
            if (scan < file.token_end && (list.kind(scan) == TokenKind::CONSTEXPR || list.kind(scan) == TokenKind::CONSTEVAL)) {
                scan = scan + 1;
            }
            if (scan + 1 < file.token_end && list.kind(scan) == TokenKind::STRUCT && list.kind(scan + 1) == TokenKind::IDENTIFIER) {
                ptr<i8> full = list.copy_text(scan + 1);
                Attributes.declare(full);
                i32 length = strlen(full);
                if (length > 9 && Strings.equals(full + length - 9, 9, "Attribute")) {
                    Attributes.declare(Strings.duplicate(full, length - 9));
                }
            }
            return;
        }
        if (at + 2 < file.token_end && list.kind(at + 1) == TokenKind::IDENTIFIER) {
            TokenKind follow = list.kind(at + 2);
            if (follow == TokenKind::LPAREN || follow == TokenKind::LBRACE || follow == TokenKind::SEMICOLON) {
                Attributes.declare(list.copy_text(at + 1));
            }
        }
    }

    TokenKind kind_of(i32 token) {
        TokenList* list = this.tokens;
        return list.kind(token);
    }

    bool is_union_keyword(i32 token) {
        return this.kind_of(token) == TokenKind::IDENTIFIER
            && Strings.equals(this.text_of(token), this.length_of(token), "union")
            && this.kind_of(this.peek_token(1)) == TokenKind::IDENTIFIER;
    }

    ptr<i8> text_of(i32 token) {
        TokenList* list = this.tokens;
        return list.text(token);
    }

    i32 length_of(i32 token) {
        TokenList* list = this.tokens;
        return list.text_length(token);
    }

    i32 line_of(i32 token) {
        TokenList* list = this.tokens;
        return list.line(token);
    }

    i32 column_of(i32 token) {
        TokenList* list = this.tokens;
        return list.column(token);
    }

    ptr<i8> copy_of(i32 token) {
        TokenList* list = this.tokens;
        return list.copy_text(token);
    }

    u32 atom_of(i32 token) {
        TokenList* list = this.tokens;
        return list.atom(token);
    }

    unsafe void add_declaration(Node* container, Node* declaration) {
        if (declaration != null) {
            container.add(declaration);
        }
        PointerList* extra = this.extra_declarations;
        if (extra == null) {
            return;
        }
        for (mut i32 i = 0; i < extra.length; i = i + 1) {
            container.add((Node*)extra.get(i));
        }
        extra.length = 0;
    }

    public Node* parse_program() {
        i32 first = this.current();
        Node* program = Node.create_list(NodeKind::PROGRAM, first);
        while (!this.at_end()) {
            this.add_declaration(program, this.parse_declaration());
        }
        return program;
    }

    i32 current() {
        return this.peek_token(0);
    }

    i32 peek_token(i32 offset) {
        mut i32 index = this.pos + offset;
        if (index >= this.end) {
            index = this.end - 1;
        }
        return index;
    }

    bool at_end() {
        i32 token = this.current();
        return this.failed || this.kind_of(token) == TokenKind::END_OF_FILE;
    }

    i32 advance() {
        i32 token = this.current();
        if (this.kind_of(token) != TokenKind::END_OF_FILE) {
            this.pos = this.pos + 1;
        }
        return token;
    }

    bool check(TokenKind kind) {
        i32 token = this.current();
        return this.kind_of(token) == kind;
    }

    bool match(TokenKind kind) {
        if (this.check(kind)) {
            this.advance();
            return true;
        }
        return false;
    }

    void fail(ptr<i8> message) {
        if (this.failed) {
            return;
        }
        i32 token = this.current();
        Diagnostics* diagnostics = this.diagnostics;
        mut ptr<i8> found = this.copy_of(token);
        if (this.kind_of(token) == TokenKind::END_OF_FILE) {
            found = "end of file";
        }
        diagnostics.error_near(DiagnosticErrors.UNEXPECTED_TOKEN, this.line_of(token), this.column_of(token), message, found);
        this.failed = true;
    }

    i32 expect(TokenKind kind, ptr<i8> message) {
        i32 token = this.current();
        if (this.kind_of(token) != kind) {
            this.fail(message);
            return token;
        }
        return this.advance();
    }
}
