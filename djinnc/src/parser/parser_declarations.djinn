namespace djinnc;

impl Parser {
    void parse_member(Node* owner) {
        PointerList* found = this.parse_attributes();
        i32 before = owner.count();
        this.parse_struct_member(owner);
        if (found.length == 0) {
            return;
        }
        if (owner.count() <= before) {
            this.attach_attributes(found, (Node*)0, AttributeTarget.OTHER);
            return;
        }
        Node* member = owner.child(before);
        mut i32 target_kind = AttributeTarget.OTHER;
        if (member.kind() == NodeKind::FUNCTION) {
            target_kind = AttributeTarget.METHOD;
        } else if (member.kind() == NodeKind::FIELD_DECL) {
            target_kind = AttributeTarget.FIELD;
        }
        this.attach_attributes(found, member, target_kind);
    }

    Node* parse_declaration() {
        PointerList* attributes = this.parse_attributes();
        this.bodyless_seen = false;
        Node* declaration = this.parse_declaration_body();
        bool declared_bodyless = this.bodyless_seen;
        if (this.bodyless_seen) {
            bool provided = declaration != null && declaration.kind() == NodeKind::STRUCT_DECL
                && (this.has_attribute(attributes, "intrinsic") || this.has_attribute(attributes, "no_mangle"));
            this.bodyless_seen = false;
            if (!provided) {
                this.diagnostics.error(DiagnosticErrors.MISPLACED_BODYLESS_FUNCTION, this.line_of(this.bodyless_token), this.column_of(this.bodyless_token), "expected '{' (a function without a body is only allowed in [intrinsic] and [no_mangle] structs)");
            }
        }
        if (declaration != null && declaration.kind() == NodeKind::STRUCT_DECL && this.has_attribute(attributes, "no_mangle")) {
            return (Node*)0;
        }
        if (declaration != null && declaration.kind() == NodeKind::STRUCT_DECL && this.has_attribute(attributes, "intrinsic") && !declared_bodyless) {
            return (Node*)0;
        }
        if (attributes.length > 0) {
            mut i32 target_kind = AttributeTarget.OTHER;
            if (declaration != null && declaration.kind() == NodeKind::STRUCT_DECL) {
                target_kind = AttributeTarget.STRUCT;
            } else if (declaration != null && declaration.kind() == NodeKind::FUNCTION) {
                target_kind = AttributeTarget.FUNCTION;
            } else if (declaration != null && declaration.kind() == NodeKind::INTERFACE_DECL) {
                target_kind = AttributeTarget.INTERFACE;
            } else if (declaration != null && declaration.kind() == NodeKind::STATIC_VAR) {
                target_kind = AttributeTarget.VARIABLE;
            }
            this.attach_attributes(attributes, declaration, target_kind);
        }
        return declaration;
    }

    unsafe bool has_attribute(PointerList* found, ptr<i8> name) {
        for (mut i32 i = 0; i < found.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)found.get(i);
            if (Strings.same(use.name, name)) {
                return true;
            }
        }
        return false;
    }

    Node* parse_declaration_body() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind::IMPORT) {
            this.advance();
            Node* import_node = Node.create(NodeKind::IMPORT, token);
            import_node.set_text(this.qualified_name());
            this.expect(TokenKind::SEMICOLON, "expected ';' after import");
            return import_node;
        }

        if (this.kind_of(token) == TokenKind::DOLLAR && this.is_inspect_start()) {
            return this.parse_inspect();
        }

        if (this.kind_of(token) == TokenKind::NAMESPACE) {
            return this.parse_namespace();
        }

        if (this.kind_of(token) == TokenKind::EXTERN) {
            return this.parse_extern();
        }

        if (this.kind_of(token) == TokenKind::STRUCT) {
            return this.parse_struct();
        }

        if (this.kind_of(token) == TokenKind::IDENTIFIER && this.is_attribute_declaration()) {
            return this.parse_attribute_declaration();
        }

        if (this.kind_of(token) == TokenKind::ENUM || this.is_union_keyword(token)) {
            return this.parse_enum();
        }

        if (this.kind_of(token) == TokenKind::STATIC || (this.kind_of(token) == TokenKind::UNSAFE && this.kind_of(this.peek_token(1)) == TokenKind::STATIC)) {
            return this.parse_static_var();
        }

        if (this.kind_of(token) == TokenKind::INTERFACE) {
            return this.parse_interface();
        }

        if (this.kind_of(token) == TokenKind::IMPL) {
            return this.parse_impl();
        }

        if (this.kind_of(token) == TokenKind::MACRO) {
            return this.parse_macro_declaration();
        }

        if (this.kind_of(token) == TokenKind::CONSTEXPR || this.kind_of(token) == TokenKind::CONSTEVAL) {
            if (this.kind_of(this.peek_token(1)) == TokenKind::STRUCT) {
                this.advance();
                return this.parse_struct();
            }
            i32 end = this.scan_type_end(1);
            if (end >= 0 && this.kind_of(this.peek_token(end)) == TokenKind::IDENTIFIER && this.kind_of(this.peek_token(end + 1)) == TokenKind::EQUAL) {
                return this.parse_compile_time_var();
            }
        }

        return this.parse_function(false);
    }

    bool is_inspect_start() {
        TokenList* list = this.tokens;
        i32 word = this.peek_token(1);
        return this.kind_of(word) == TokenKind::IDENTIFIER && Strings.equals(list.text(word), list.text_length(word), "inspect");
    }

    Node* parse_inspect() {
        i32 start = this.advance();
        this.advance();
        Node* node = Node.create_list(NodeKind::INSPECT_DECL, start);
        node.set_text(this.qualified_name());
        this.expect(TokenKind::LBRACE, "expected '{' to open the $inspect body");
        TokenList* list = this.tokens;
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            i32 word = this.current();
            if (this.kind_of(word) == TokenKind::IDENTIFIER && Strings.equals(list.text(word), list.text_length(word), "generate")) {
                this.advance();
                this.expect(TokenKind::LBRACE, "expected '{' to open the generate block");
                while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
                    this.parse_member(node);
                }
                this.expect(TokenKind::RBRACE, "expected '}' to close the generate block");
            } else {
                this.fail("expected 'generate' inside $inspect");
                this.advance();
            }
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close the $inspect body");
        return node;
    }

    bool is_attribute_declaration() {
        TokenList* list = this.tokens;
        i32 token = this.current();
        if (!Strings.equals(list.text(token), list.text_length(token), "attribute")) {
            return false;
        }
        if (this.kind_of(this.peek_token(1)) != TokenKind::IDENTIFIER) {
            return false;
        }
        TokenKind follow = this.kind_of(this.peek_token(2));
        return follow == TokenKind::LPAREN || follow == TokenKind::LBRACE || follow == TokenKind::SEMICOLON;
    }

    Node* parse_attribute_declaration() {
        i32 start = this.advance();
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected attribute name");
        if (this.match(TokenKind::LPAREN)) {
            mut i32 depth = 1;
            while (depth > 0 && !this.at_end()) {
                i32 token = this.advance();
                if (this.kind_of(token) == TokenKind::LPAREN) {
                    depth = depth + 1;
                } else if (this.kind_of(token) == TokenKind::RPAREN) {
                    depth = depth - 1;
                }
            }
        }
        if (this.match(TokenKind::SEMICOLON)) {
            return (Node*)0;
        }
        Node* node = Node.create_list(NodeKind::STRUCT_DECL, start);
        node.set_text(this.copy_of(name));
        this.expect(TokenKind::LBRACE, "expected ';' or '{' after the attribute declaration");
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            this.parse_member(node);
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close the attribute declaration");
        return node;
    }

    Node* parse_compile_time_var() {
        i32 start = this.current();
        this.advance();
        Node* node = Node.create(NodeKind::STATIC_VAR, start);
        node.set_op(1);
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected constant name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind::EQUAL, "expected '=' in constant declaration");
        node.set_first(this.parse_expression());
        this.expect(TokenKind::SEMICOLON, "expected ';' after constant");
        return node;
    }

    Node* parse_namespace() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::NAMESPACE_DECL, start);
        node.set_text(this.qualified_name());
        if (this.match(TokenKind::SEMICOLON)) {
            while (!this.at_end()) {
                this.add_declaration(node, this.parse_declaration());
            }
            return node;
        }

        this.expect(TokenKind::LBRACE, "expected ';' or '{' after namespace name");
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            this.add_declaration(node, this.parse_declaration());
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close namespace");
        return node;
    }

    Node* parse_extern() {
        i32 start = this.advance();
        Node* group = Node.create_list(NodeKind::NAMESPACE_DECL, start);
        group.set_text("");
        group.set_flag(true);

        if (this.check(TokenKind::STRING_LITERAL)) {
            this.advance();
        }

        if (this.match(TokenKind::LBRACE)) {
            while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
                mut PointerList* found = (PointerList*)0;
                if (this.check(TokenKind::LBRACKET)) {
                    found = this.parse_attributes();
                }
                group.add(this.parse_extern_function(found));
            }
            this.expect(TokenKind::RBRACE, "expected '}' to close extern block");
            return group;
        }

        mut PointerList* single = (PointerList*)0;
        if (this.check(TokenKind::LBRACKET)) {
            single = this.parse_attributes();
        }
        group.add(this.parse_extern_function(single));
        return group;
    }

    Node* parse_extern_function(PointerList* found) {
        i32 start = this.current();
        Node* node = Node.create_list(NodeKind::EXTERN_FUNCTION, start);
        if (found != null) {
            this.attach_attributes(found, node, AttributeTarget.FUNCTION);
        }
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected extern function name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind::LPAREN, "expected '(' after function name");
        this.parse_parameters(node);
        this.expect(TokenKind::RPAREN, "expected ')' after parameters");
        this.expect(TokenKind::SEMICOLON, "expected ';' after extern function");
        return node;
    }

    void parse_parameters(Node* owner) {
        if (this.check(TokenKind::RPAREN)) {
            return;
        }
        while (!this.at_end()) {
            if (this.check(TokenKind::DOT_DOT_DOT)) {
                this.advance();
                if (this.check(TokenKind::IDENTIFIER)) {
                    i32 pack_name = this.advance();
                    Node* pack = Node.create(NodeKind::PARAMETER, pack_name);
                    TypeRef* boxed_array = TypeRef.named("arr");
                    PointerList* boxed_args = PointerList.create();
                    boxed_args.push((ptr)TypeRef.named("object"));
                    boxed_array.args = boxed_args;
                    pack.set_type(boxed_array);
                    pack.set_text(this.copy_of(pack_name));
                    pack.set_op(2);
                    owner.add(pack);
                } else {
                    owner.set_variadic(true);
                }
                break;
            }

            mut PointerList* found = (PointerList*)0;
            if (this.check(TokenKind::LBRACKET)) {
                found = this.parse_attributes();
            }
            i32 start = this.current();
            Node* parameter = Node.create(NodeKind::PARAMETER, start);
            if (found != null) {
                this.attach_attributes(found, parameter, AttributeTarget.PARAMETER);
            }
            if (this.match(TokenKind::MUT)) {
                parameter.set_flag(true);
            }
            parameter.set_type(this.parse_type());
            if (this.match(TokenKind::DOT_DOT_DOT)) {
                TypeRef* element = parameter.type();
                TypeRef* packed = TypeRef.named("arr");
                PointerList* packed_args = PointerList.create();
                packed_args.push((ptr)element);
                packed.args = packed_args;
                parameter.set_type(packed);
                parameter.set_op(2);
            }
            i32 name = this.expect(TokenKind::IDENTIFIER, "expected parameter name");
            parameter.set_text(this.copy_of(name));
            if (this.match(TokenKind::MUT)) {
                parameter.set_flag(true);
            }
            owner.add(parameter);

            if (!this.match(TokenKind::COMMA)) {
                break;
            }
        }
    }

    Node* parse_function(bool allowConstructor) {
        mut bool is_static = false;
        mut bool is_async = false;
        mut bool is_unsafe = false;
        mut i32 compile_time = 0;
        while (this.check(TokenKind::PUBLIC) || this.check(TokenKind::PRIVATE) || this.check(TokenKind::STATIC) || this.check(TokenKind::ASYNC) || this.check(TokenKind::UNSAFE)
            || this.check(TokenKind::CONSTEXPR) || this.check(TokenKind::CONSTEVAL)) {
            i32 modifier = this.advance();
            if (this.kind_of(modifier) == TokenKind::STATIC) {
                is_static = true;
            }
            if (this.kind_of(modifier) == TokenKind::ASYNC) {
                is_async = true;
            }
            if (this.kind_of(modifier) == TokenKind::UNSAFE) {
                is_unsafe = true;
            }
            if (this.kind_of(modifier) == TokenKind::CONSTEXPR) {
                compile_time = 2;
            }
            if (this.kind_of(modifier) == TokenKind::CONSTEVAL) {
                compile_time = 4;
            }
        }

        if (is_async && compile_time != 0) {
            this.fail("a constexpr or consteval function cannot be async");
            return (Node*)0;
        }

        i32 start = this.current();
        Node* function = Node.create_list(NodeKind::FUNCTION, start);
        function.set_flag(is_static);
        mut i32 modifiers = compile_time;
        if (is_async) {
            modifiers = 1;
        }
        if (is_unsafe) {
            modifiers = modifiers | 8;
        }
        if (modifiers != 0) {
            function.set_op(modifiers);
        }
        function.set_type(this.parse_type());
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected function name");
        function.set_text(this.copy_of(name));
        if (this.check(TokenKind::LESS)) {
            function.set_generics(this.parse_generic_params());
        }
        this.expect(TokenKind::LPAREN, "expected '(' after function name");
        this.parse_parameters(function);
        this.expect(TokenKind::RPAREN, "expected ')' after parameters");
        if (this.check(TokenKind::WHERE)) {
            GenericParams* constraints = function.generics();
            if (constraints == null) {
                this.fail("'where' needs a generic function");
                return function;
            }
            this.parse_where_clauses(constraints);
        }

        this.parse_throws_clause(function);
        if (this.check(TokenKind::REQUIRE) || this.check(TokenKind::ENSURE)) {
            this.fail("contracts are not supported yet");
            return function;
        }

        if (this.match(TokenKind::ARROW)) {
            i32 arrow = this.current();
            Node* body = Node.create_list(NodeKind::BLOCK, arrow);
            Node* ret = Node.create(NodeKind::RETURN, arrow);
            ret.set_first(this.parse_expression());
            body.add(ret);
            this.expect(TokenKind::SEMICOLON, "expected ';' after expression body");
            function.set_first(body);
            return function;
        }

        if (this.check(TokenKind::SEMICOLON)) {
            if (!this.bodyless_seen) {
                this.bodyless_seen = true;
                this.bodyless_token = this.current();
            }
            this.advance();
            return function;
        }

        function.set_first(this.parse_body(function.generics() == null && (function.op() & 7) == 0));
        return function;
    }

    void parse_throws_clause(Node* function) {
        if (!this.check(TokenKind::THROWS)) {
            return;
        }
        i32 start = this.advance();
        function.set_op(function.op() | 16);
        if (!this.match(TokenKind::LPAREN)) {
            return;
        }
        Node* clause = Node.create_list(NodeKind::BLOCK, start);
        while (!this.check(TokenKind::RPAREN) && !this.at_end() && !this.failed) {
            Node* entry = Node.create(NodeKind::PARAMETER, this.current());
            entry.set_type(this.parse_type());
            clause.add(entry);
            if (!this.match(TokenKind::COMMA)) {
                break;
            }
        }
        this.expect(TokenKind::RPAREN, "expected ')' after the throws types");
        function.set_second(clause);
    }

    Node* parse_body(bool strippable) {
        i32 open = this.current();
        Node* block = this.parse_block();
        if (strippable && this.generic_depth == 0 && !this.failed) {
            Library.record_body(open, this.pos - 1);
        }
        return block;
    }

    Node* parse_operator(bool with_body) {
        i32 start = this.advance();
        Node* function = Node.create_list(NodeKind::FUNCTION, start);
        function.set_flag(true);
        i32 symbol = this.advance();
        ByteBuffer* name = ByteBuffer.create();
        name.append("operator");
        if (this.kind_of(symbol) == TokenKind::IDENTIFIER && this.check(TokenKind::LBRACKET)) {
            name.append(this.copy_of(symbol));
            this.advance();
            this.expect(TokenKind::RBRACKET, "expected ']' after '['");
            name.append("[]");
        } else {
            name.append(this.kind_of(symbol).text);
        }
        function.set_text(name.cstr());
        this.expect(TokenKind::LPAREN, "expected '(' after the operator");
        this.parse_parameters(function);
        this.expect(TokenKind::RPAREN, "expected ')' after parameters");
        this.expect(TokenKind::THIN_ARROW, "expected '->' and the return type of the operator");
        function.set_type(this.parse_type());
        if (with_body) {
            function.set_first(this.parse_body(true));
        } else {
            this.expect(TokenKind::SEMICOLON, "expected ';' after the operator signature");
        }
        return function;
    }

    Node* parse_static_var() {
        i32 start = this.current();
        bool has_unsafe = this.match(TokenKind::UNSAFE);
        Node* node = Node.create(NodeKind::STATIC_VAR, start);
        i32 after_static = this.peek_token(1);
        if (!has_unsafe && this.kind_of(after_static) == TokenKind::MUT) {
            this.fail("'static mut' requires 'unsafe'");
            return node;
        }
        this.expect(TokenKind::STATIC, "expected 'static'");
        bool is_mutable = this.match(TokenKind::MUT);
        if (has_unsafe && !is_mutable) {
            this.fail("'unsafe' is only valid on 'static mut'");
            return node;
        }
        node.set_flag(is_mutable);
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected static variable name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind::EQUAL, "expected '=' in static variable declaration");
        node.set_first(this.parse_expression());
        this.expect(TokenKind::SEMICOLON, "expected ';' after static variable");
        return node;
    }
}
