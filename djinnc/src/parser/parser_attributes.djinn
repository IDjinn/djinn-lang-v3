namespace djinnc;

impl Parser {
    unsafe PointerList* parse_attributes() {
        PointerList* found = PointerList.create();
        while (this.check(TokenKind::LBRACKET) && !this.failed) {
            this.advance();
            while (!this.check(TokenKind::RBRACKET) && !this.at_end()) {
                i32 name = this.expect(TokenKind::IDENTIFIER, "expected an attribute name");
                AttributeUse* use = (AttributeUse*)Memory.zalloc(sizeof(AttributeUse));
                use.name = this.copy_of(name);
                use.line = this.line_of(name);
                use.column = this.column_of(name);
                if (this.match(TokenKind::LPAREN)) {
                    Node* payload = Node.create_list(NodeKind::STRUCT_INIT, name);
                    while (!this.check(TokenKind::RPAREN) && !this.at_end() && !this.failed) {
                        i32 argument = this.current();
                        mut Node* field = (Node*)0;
                        if (this.kind_of(argument) == TokenKind::IDENTIFIER && this.kind_of(this.peek_token(1)) == TokenKind::EQUAL) {
                            this.advance();
                            this.advance();
                            field = Node.create(NodeKind::FIELD_INIT, argument);
                            field.set_text(this.copy_of(argument));
                        } else {
                            field = Node.create(NodeKind::FIELD_INIT, argument);
                        }
                        i32 value_start = this.current();
                        field.set_first(this.parse_expression());
                        payload.add(field);
                        if (this.current() == value_start + 1) {
                            if (this.kind_of(value_start) == TokenKind::INTEGER_LITERAL) {
                                use.int_arg = Strings.parse_integer(this.text_of(value_start), this.length_of(value_start));
                            } else if (this.kind_of(value_start) == TokenKind::STRING_LITERAL) {
                                use.text_arg = this.copy_of(value_start);
                            }
                        }
                        if (!this.match(TokenKind::COMMA)) {
                            break;
                        }
                    }
                    if (payload.count() > 0) {
                        use.payload = payload;
                    }
                    this.expect(TokenKind::RPAREN, "expected ')' after the attribute arguments");
                }
                found.push((ptr)use);
                if (!this.match(TokenKind::COMMA)) {
                    break;
                }
            }
            this.expect(TokenKind::RBRACKET, "expected ']' after the attribute");
        }
        return found;
    }

    unsafe void attach_attributes(PointerList* found, Node* target, i32 target_kind) {
        Diagnostics* diagnostics = this.diagnostics;
        for (mut i32 i = 0; i < found.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)found.get(i);
            use.target = target;
            use.target_kind = target_kind;
            i32 allowed = Attributes.allowed_targets(use.name);
            if (allowed == 0) {
                ByteBuffer* message = ByteBuffer.create();
                message.append("unknown attribute '");
                message.append(use.name);
                message.append("'");
                diagnostics.error(DiagnosticErrors.UNKNOWN_ATTRIBUTE, use.line, use.column, message.cstr());
                continue;
            }
            if (target != null && (allowed & target_kind) == 0) {
                ByteBuffer* message = ByteBuffer.create();
                message.append("attribute '");
                message.append(use.name);
                message.append("' is not valid on ");
                message.append(Attributes.target_name(target_kind));
                diagnostics.warning(DiagnosticWarnings.INVALID_ATTRIBUTE_TARGET, use.line, use.column, message.cstr());
            }
            if (target != null && target_kind == AttributeTarget.FIELD && Strings.same(use.name, "Align")) {
                diagnostics.warning(DiagnosticWarnings.ATTRIBUTE_NOT_APPLIED, use.line, use.column, "attribute 'Align' on a field is accepted but not applied yet");
            }
            if (target != null) {
                Attributes.record(use);
            }
        }
    }
}
