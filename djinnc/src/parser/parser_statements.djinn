namespace djinnc;

impl Parser {
    Node* parse_block() {
        i32 start = this.expect(TokenKind::LBRACE, "expected '{'");
        Node* block = Node.create_list(NodeKind::BLOCK, start);
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            Node* statement = this.parse_statement();
            if (statement != null) {
                block.add(statement);
            }
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close block");
        return block;
    }

    Node* parse_statement() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind::UNSAFE && this.kind_of(this.peek_token(1)) == TokenKind::LBRACE) {
            this.advance();
            Node* guarded = this.parse_block();
            guarded.set_op(8);
            return guarded;
        }
        if (this.kind_of(token) == TokenKind::LBRACE) {
            return this.parse_block();
        }
        if (this.kind_of(token) == TokenKind::SEMICOLON) {
            this.advance();
            return (Node*)0;
        }
        if (this.kind_of(token) == TokenKind::RETURN) {
            this.advance();
            Node* ret = Node.create(NodeKind::RETURN, token);
            if (!this.check(TokenKind::SEMICOLON)) {
                ret.set_first(this.parse_expression());
            }
            this.expect(TokenKind::SEMICOLON, "expected ';' after return");
            return ret;
        }
        if (this.kind_of(token) == TokenKind::THROW) {
            this.advance();
            Node* thrown = Node.create(NodeKind::THROW_STMT, token);
            thrown.set_first(this.parse_expression());
            this.expect(TokenKind::SEMICOLON, "expected ';' after throw");
            return thrown;
        }
        if (this.kind_of(token) == TokenKind::IF) {
            return this.parse_if();
        }
        if (this.kind_of(token) == TokenKind::WHILE) {
            this.advance();
            Node* loop = Node.create(NodeKind::WHILE, token);
            this.expect(TokenKind::LPAREN, "expected '(' after while");
            loop.set_first(this.parse_expression());
            this.expect(TokenKind::RPAREN, "expected ')' after condition");
            loop.set_second(this.parse_statement_or_empty());
            return loop;
        }
        if (this.kind_of(token) == TokenKind::DO) {
            this.advance();
            Node* loop = Node.create(NodeKind::DO_WHILE, token);
            loop.set_second(this.parse_statement_or_empty());
            this.expect(TokenKind::WHILE, "expected 'while' after do body");
            this.expect(TokenKind::LPAREN, "expected '(' after while");
            loop.set_first(this.parse_expression());
            this.expect(TokenKind::RPAREN, "expected ')' after condition");
            this.expect(TokenKind::SEMICOLON, "expected ';' after do-while");
            return loop;
        }
        if (this.kind_of(token) == TokenKind::FOR) {
            return this.parse_for();
        }
        if (this.kind_of(token) == TokenKind::BREAK) {
            this.advance();
            this.expect(TokenKind::SEMICOLON, "expected ';' after break");
            return Node.create(NodeKind::BREAK, token);
        }
        if (this.kind_of(token) == TokenKind::CONTINUE) {
            this.advance();
            this.expect(TokenKind::SEMICOLON, "expected ';' after continue");
            return Node.create(NodeKind::CONTINUE, token);
        }
        if (this.kind_of(token) == TokenKind::SWITCH) {
            return this.parse_switch();
        }
        if (this.kind_of(token) == TokenKind::SPAWN) {
            this.advance();
            Node* spawned = Node.create(NodeKind::SPAWN_STMT, token);
            spawned.set_first(this.parse_expression());
            this.expect(TokenKind::SEMICOLON, "expected ';' after spawn");
            return spawned;
        }

        if (this.kind_of(token) == TokenKind::CONSTEXPR || this.kind_of(token) == TokenKind::CONSTEVAL) {
            this.advance();
            Node* constant = this.parse_variable_declaration();
            constant.set_op(1);
            this.expect(TokenKind::SEMICOLON, "expected ';' after declaration");
            return constant;
        }

        if (this.is_declaration_start()) {
            Node* declaration = this.parse_variable_declaration();
            this.expect(TokenKind::SEMICOLON, "expected ';' after declaration");
            return declaration;
        }

        Node* statement = Node.create(NodeKind::EXPR_STMT, token);
        statement.set_first(this.parse_expression());
        this.expect(TokenKind::SEMICOLON, "expected ';' after expression");
        return statement;
    }

    Node* parse_switch() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::SWITCH, start);
        this.expect(TokenKind::LPAREN, "expected '(' after switch");
        node.set_first(this.parse_expression());
        this.expect(TokenKind::RPAREN, "expected ')' after switch value");
        this.expect(TokenKind::LBRACE, "expected '{' to open switch");
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            i32 label = this.current();
            Node* arm = Node.create_list(NodeKind::CASE, label);
            if (this.match(TokenKind::CASE)) {
                arm.set_first(this.parse_expression());
            } else if (!this.match(TokenKind::DEFAULT)) {
                this.fail("expected 'case' or 'default'");
                return node;
            }
            this.expect(TokenKind::COLON, "expected ':' after case label");
            while (!this.check(TokenKind::CASE) && !this.check(TokenKind::DEFAULT) && !this.check(TokenKind::RBRACE) && !this.at_end()) {
                Node* statement = this.parse_statement();
                if (statement != null) {
                    arm.add(statement);
                }
            }
            node.add(arm);
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close switch");
        return node;
    }

    Node* parse_switch_expression() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::SWITCH_EXPR, start);
        node.set_first(this.parse_expression());
        this.expect(TokenKind::LBRACE, "expected '{' to open switch expression");
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            i32 label = this.current();
            Node* arm = Node.create_list(NodeKind::MATCH_ARM, label);
            arm.set_text(this.qualified_name());
            while (this.check(TokenKind::IDENTIFIER)) {
                i32 binding_token = this.advance();
                Node* binding = Node.create(NodeKind::PARAMETER, binding_token);
                binding.set_text(this.copy_of(binding_token));
                arm.add(binding);
            }
            this.expect(TokenKind::THIN_ARROW, "expected '->' after match pattern");
            arm.set_first(this.parse_expression());
            node.add(arm);
            if (!this.check(TokenKind::RBRACE)) {
                this.expect(TokenKind::COMMA, "expected ',' between match arms");
            }
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close switch expression");
        return node;
    }

    Node* parse_statement_or_empty() {
        i32 token = this.current();
        Node* statement = this.parse_statement();
        if (statement == null) {
            return Node.create_list(NodeKind::BLOCK, token);
        }
        return statement;
    }

    Node* parse_variable_declaration() {
        i32 start = this.current();
        Node* declaration = Node.create(NodeKind::VAR_DECL, start);
        if (this.match(TokenKind::MUT)) {
            declaration.set_flag(true);
        }
        declaration.set_type(this.parse_type());
        if (this.match(TokenKind::MUT)) {
            declaration.set_flag(true);
        }
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected variable name");
        declaration.set_text(this.copy_of(name));
        if (this.match(TokenKind::EQUAL)) {
            declaration.set_first(this.parse_expression());
        }
        return declaration;
    }

    Node* parse_if() {
        i32 start = this.advance();
        Node* node = Node.create(NodeKind::IF, start);
        mut bool compile_time = false;
        if (this.match(TokenKind::CONSTEXPR) || this.match(TokenKind::CONSTEVAL)) {
            compile_time = true;
        } else if (!this.check(TokenKind::LPAREN)) {
            compile_time = true;
        }
        if (compile_time) {
            node.set_op(1);
            node.set_first(this.parse_expression());
        } else {
            this.expect(TokenKind::LPAREN, "expected '(' after if");
            node.set_first(this.parse_expression());
            this.expect(TokenKind::RPAREN, "expected ')' after condition");
        }
        node.set_second(this.parse_statement_or_empty());
        if (this.match(TokenKind::ELSE)) {
            node.set_third(this.parse_statement_or_empty());
        }
        return node;
    }

    bool is_open_start_range() {
        if (!this.check(TokenKind::LPAREN)) {
            return false;
        }
        mut i32 depth = 1;
        mut i32 offset = 1;
        while (offset < this.end - this.pos) {
            TokenKind kind = this.kind_of(this.peek_token(offset));
            if (kind == TokenKind::END_OF_FILE) {
                return false;
            }
            if (kind == TokenKind::LPAREN || kind == TokenKind::LBRACKET) {
                depth = depth + 1;
            } else if (kind == TokenKind::RPAREN || kind == TokenKind::RBRACKET) {
                depth = depth - 1;
                if (depth == 0) {
                    return false;
                }
            } else if (depth == 1 && (kind == TokenKind::DOT_DOT || kind == TokenKind::DOT_DOT_EQUAL)) {
                return true;
            }
            offset = offset + 1;
        }
        return false;
    }

    bool range_ahead() {
        bool opened_first = this.check(TokenKind::LPAREN) || this.check(TokenKind::LBRACKET);
        mut i32 depth = 0;
        mut i32 offset = 0;
        while (offset < this.end - this.pos) {
            TokenKind kind = this.kind_of(this.peek_token(offset));
            if (kind == TokenKind::END_OF_FILE) {
                return false;
            }
            if (kind == TokenKind::LPAREN || kind == TokenKind::LBRACKET) {
                depth = depth + 1;
            } else if (kind == TokenKind::RPAREN || kind == TokenKind::RBRACKET) {
                if (depth == 0) {
                    return false;
                }
                depth = depth - 1;
            } else if (kind == TokenKind::DOT_DOT || kind == TokenKind::DOT_DOT_EQUAL) {
                if (depth == 0 || (depth == 1 && opened_first)) {
                    return true;
                }
            }
            offset = offset + 1;
        }
        return false;
    }

    bool is_plain_path(Node* node) {
        if (node.kind() == NodeKind::IDENTIFIER) {
            return true;
        }
        return node.kind() == NodeKind::FIELD_ACCESS && this.is_plain_path(node.first());
    }

    Node* parse_collection_for(i32 start, Node* variable) {
        Node* source = this.parse_expression();
        this.expect(TokenKind::RPAREN, "expected ')' after the collection");

        this.hidden_count = this.hidden_count + 1;
        ByteBuffer* items_name = ByteBuffer.create();
        items_name.append("__items");
        items_name.append_int((i64)this.hidden_count);
        ByteBuffer* index_name = ByteBuffer.create();
        index_name.append("__index");
        index_name.append_int((i64)this.hidden_count);

        Node* scope = Node.create_list(NodeKind::BLOCK, start);
        mut Node* collection = source;
        if (!this.is_plain_path(source)) {
            Node* items = Node.create(NodeKind::VAR_DECL, start);
            items.set_type(TypeRef.create(TypeKind.AUTO));
            items.set_text(items_name.cstr());
            items.set_first(source);
            scope.add(items);
            collection = Node.create(NodeKind::IDENTIFIER, start);
            collection.set_text(items_name.cstr());
        }

        Node* index = Node.create(NodeKind::VAR_DECL, start);
        index.set_type(TypeRef.integer(32, false));
        index.set_text(index_name.cstr());
        index.set_flag(true);
        Node* zero = Node.create(NodeKind::INT_LITERAL, start);
        zero.set_int_value(0);
        zero.set_text("0");
        index.set_first(zero);

        Node* counter = Node.create(NodeKind::IDENTIFIER, start);
        counter.set_text(index_name.cstr());
        Node* length = Node.create(NodeKind::FIELD_ACCESS, start);
        length.set_first(collection);
        length.set_text("length");
        Node* element = Node.create(NodeKind::INDEX, start);
        element.set_first(collection);
        element.set_second(counter);
        variable.set_first(element);

        Node* body = Node.create_list(NodeKind::BLOCK, start);
        body.add(variable);
        body.add(this.parse_statement_or_empty());

        Node* loop = Node.create(NodeKind::FOR, start);
        loop.set_first(index);
        loop.set_second(this.make_binary(TokenKind::LESS, counter, length, start));
        loop.set_third(this.make_count(counter, TokenKind::PLUS_PLUS, false, start));
        loop.set_fourth(body);
        scope.add(loop);
        return scope;
    }

    Node* parse_range_for(i32 start, Node* variable) {
        this.advance();
        if (!this.range_ahead()) {
            return this.parse_collection_for(start, variable);
        }
        bool open_start = this.is_open_start_range();
        mut bool bracket = this.match(TokenKind::LBRACKET);
        if (open_start) {
            this.advance();
            bracket = true;
        }
        mut Node* low = this.parse_expression();
        if (open_start) {
            Node* one = Node.create(NodeKind::INT_LITERAL, start);
            one.set_int_value(1);
            one.set_text("1");
            low = this.make_binary(TokenKind::PLUS, low, one, start);
        }
        mut bool inclusive = false;
        if (this.match(TokenKind::DOT_DOT_EQUAL)) {
            inclusive = true;
        } else {
            this.expect(TokenKind::DOT_DOT, "expected '..' or '..=' in the range");
        }
        Node* high = this.parse_expression();
        if (bracket) {
            if (this.match(TokenKind::RBRACKET)) {
                inclusive = true;
            } else {
                this.expect(TokenKind::RPAREN, "expected ']' or ')' to close the range");
                inclusive = false;
            }
        }
        this.expect(TokenKind::RPAREN, "expected ')' after the range");

        this.hidden_count = this.hidden_count + 1;
        ByteBuffer* limit_name = ByteBuffer.create();
        limit_name.append("__limit");
        limit_name.append_int((i64)this.hidden_count);

        Node* limit = Node.create(NodeKind::VAR_DECL, start);
        limit.set_type(variable.type());
        limit.set_text(limit_name.cstr());
        limit.set_first(high);

        variable.set_flag(true);
        variable.set_first(low);

        Node* counter = Node.create(NodeKind::IDENTIFIER, start);
        counter.set_text(variable.text());
        Node* bound = Node.create(NodeKind::IDENTIFIER, start);
        bound.set_text(limit_name.cstr());
        mut TokenKind comparison = TokenKind::LESS;
        if (inclusive) {
            comparison = TokenKind::LESS_EQUAL;
        }

        Node* loop = Node.create(NodeKind::FOR, start);
        loop.set_first(variable);
        loop.set_second(this.make_binary(comparison, counter, bound, start));
        loop.set_third(this.make_step(counter, TokenKind::PLUS, start));
        loop.set_fourth(this.parse_statement_or_empty());

        Node* scope = Node.create_list(NodeKind::BLOCK, start);
        scope.add(limit);
        scope.add(loop);
        return scope;
    }

    Node* parse_for() {
        i32 start = this.advance();
        Node* node = Node.create(NodeKind::FOR, start);
        this.expect(TokenKind::LPAREN, "expected '(' after for");

        if (!this.check(TokenKind::SEMICOLON)) {
            if (this.is_declaration_start()) {
                node.set_first(this.parse_variable_declaration());
                if (this.check(TokenKind::IN)) {
                    return this.parse_range_for(start, node.first());
                }
            } else {
                i32 initToken = this.current();
                Node* init = Node.create(NodeKind::EXPR_STMT, initToken);
                init.set_first(this.parse_expression());
                node.set_first(init);
            }
        }
        this.expect(TokenKind::SEMICOLON, "expected ';' after for initializer");

        if (!this.check(TokenKind::SEMICOLON)) {
            node.set_second(this.parse_expression());
        }
        this.expect(TokenKind::SEMICOLON, "expected ';' after for condition");

        if (!this.check(TokenKind::RPAREN)) {
            node.set_third(this.parse_expression());
        }
        this.expect(TokenKind::RPAREN, "expected ')' after for clauses");
        node.set_fourth(this.parse_statement_or_empty());
        return node;
    }
}
