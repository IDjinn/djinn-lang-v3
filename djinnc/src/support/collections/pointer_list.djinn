namespace djinnc;

struct PointerList {
    ptr<ptr> data;
    i32 length;
    i32 capacity;

    public static unsafe PointerList* create() {
        PointerList* vec = (PointerList*)Memory.zalloc(sizeof(PointerList));
        vec.capacity = 8;
        vec.data = (ptr<ptr>)Memory.zalloc(64);
        return vec;
    }

    public unsafe void push(ptr item) {
        if (this.length == this.capacity) {
            this.grow();
        }
        this.data[this.length] = item;
        this.length = this.length + 1;
    }

    public unsafe ptr get(i32 index) {
        return this.data[index];
    }

    public unsafe bool contains(ptr item) {
        for (mut i32 i = 0; i < this.length; i = i + 1) {
            if (this.data[i] == item) {
                return true;
            }
        }
        return false;
    }

    public unsafe bool contains_string(ptr<i8> text) {
        for (mut i32 i = 0; i < this.length; i = i + 1) {
            if (Strings.same((ptr<i8>)this.data[i], text)) {
                return true;
            }
        }
        return false;
    }

    public unsafe void sort_strings() {
        for (mut i32 i = 1; i < this.length; i = i + 1) {
            ptr item = this.data[i];
            mut i32 j = i - 1;
            while (j >= 0 && strcmp((ptr<i8>)this.data[j], (ptr<i8>)item) > 0) {
                this.data[j + 1] = this.data[j];
                j = j - 1;
            }
            this.data[j + 1] = item;
        }
    }

    public void truncate(i32 count) {
        this.length = count;
    }

    void grow() {
        i32 newCapacity = this.capacity * 2;
        ptr<ptr> newData = (ptr<ptr>)Memory.zalloc((u64)newCapacity * 8);
        memcpy(newData, this.data, (u64)this.length * 8);
        this.data = newData;
        this.capacity = newCapacity;
    }
}
