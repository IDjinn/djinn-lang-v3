namespace djinnc;

struct Strings {
    public static bool equals(ptr<i8> text, i32 length, ptr<i8> literal) {
        i32 literalLength = strlen(literal);
        if (literalLength != length) {
            return false;
        }
        return memcmp(text, literal, (u64)length) == 0;
    }

    public static bool same(ptr<i8> left, ptr<i8> right) {
        i32 leftLength = strlen(left);
        return Strings.equals(left, leftLength, right);
    }

    public static unsafe bool starts_with(ptr<i8> source, i32 pos, i32 length, ptr<i8> prefix) {
        i32 prefixLength = strlen(prefix);
        if (pos + prefixLength > length) {
            return false;
        }
        return memcmp(source + pos, prefix, (u64)prefixLength) == 0;
    }

    public static ptr<i8> duplicate(ptr<i8> text, i32 length) {
        ptr<i8> copy = (ptr<i8>)Memory.zalloc((u64)length + 1);
        memcpy(copy, text, (u64)length);
        return copy;
    }

    public static bool is_digit(i32 c) {
        return c >= 48 && c <= 57;
    }

    public static bool is_hex_digit(i32 c) {
        return (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
    }

    public static bool is_letter(i32 c) {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90);
    }

    public static bool is_ident_start(i32 c) {
        return Strings.is_letter(c) || c == 95;
    }

    public static bool is_ident_part(i32 c) {
        return Strings.is_letter(c) || Strings.is_digit(c) || c == 95;
    }

    public static i32 digit_value(i32 c) {
        if (c >= 48 && c <= 57) {
            return c - 48;
        }
        if (c >= 97 && c <= 102) {
            return c - 97 + 10;
        }
        if (c >= 65 && c <= 70) {
            return c - 65 + 10;
        }
        return 0 - 1;
    }

    public static unsafe i64 parse_integer(ptr<i8> text, i32 length) {
        mut i32 pos = 0;
        mut i64 radix = 10;
        if (length > 2 && text[0] == 48 && (text[1] == 120 || text[1] == 88)) {
            radix = 16;
            pos = 2;
        } else if (length > 2 && text[0] == 48 && (text[1] == 98 || text[1] == 66)) {
            radix = 2;
            pos = 2;
        }

        mut i64 value = 0;
        while (pos < length) {
            i32 c = text[pos];
            i32 digit = Strings.digit_value(c);
            if (digit < 0 || digit >= radix) {
                if (c == 95 || c == 39) {
                    pos = pos + 1;
                    continue;
                }
                return value;
            }
            value = value * radix + digit;
            pos = pos + 1;
        }
        return value;
    }

    public static unsafe f64 parse_float(ptr<i8> text, i32 length) {
        ByteBuffer* clean = ByteBuffer.create();
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = text[i];
            if (c != 95 && c != 39) {
                clean.append_char(c);
            }
        }
        return strtod(clean.cstr(), null);
    }
}
