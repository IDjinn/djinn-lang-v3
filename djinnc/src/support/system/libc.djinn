namespace djinnc;

extern "C" {
    i32 printf(ptr<i8> format, ...);

    ptr malloc(u64 size);
    ptr calloc(u64 count, u64 size);
    void free(ptr pointer);
    ptr memset(ptr pointer, i32 value, u64 count);
    ptr memcpy(ptr destination, ptr source, u64 count);
    i32 memcmp(ptr left, ptr right, u64 count);
    i32 strlen(ptr<i8> text);
    i32 strcmp(ptr<i8> left, ptr<i8> right);
    f64 strtod(ptr<i8> text, ptr<ptr<i8>> end);

    ptr fopen(ptr<i8> path, ptr<i8> mode);
    i32 fclose(ptr file);
    i32 fseek(ptr file, i64 offset, i32 origin);
    i64 ftell(ptr file);
    u64 fread(ptr buffer, u64 size, u64 count, ptr file);
    u64 fwrite(ptr buffer, u64 size, u64 count, ptr file);
    i32 remove(ptr<i8> path);

    void exit(i32 status);
    i32 system(ptr<i8> command);
    i32 fflush(ptr stream);
    i32 __djinn_call_entry(ptr address);
    void __djinn_link_debug_support();
    ptr<i8> getenv(ptr<i8> name);

    i64 __djinn_now_us();
    i32 __djinn_argc();
    ptr<i8> __djinn_argv(i32 index);
    ptr<i8> __djinn_list_files(ptr<i8> directory, ptr<i8> extension);

    ptr logger_get(ptr<i8> name, i32 output, i32 level);
    void logger_set_format(ptr logger, ptr<i8> format);
    void logger_error(ptr logger, ptr<i8> format, ...);
    void logger_warn(ptr logger, ptr<i8> format, ...);
    void logger_info(ptr logger, ptr<i8> format, ...);
}
