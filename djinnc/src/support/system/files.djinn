namespace djinnc;

struct Files {
    public static unsafe ptr<i8> read_all(ptr<i8> path) {
        ptr file = fopen(path, "rb");
        if (file == null) {
            return null;
        }
        fseek(file, 0, 2);
        i32 length = (i32)ftell(file);
        fseek(file, 0, 0);
        Arena* arena = Memory.arena();
        ptr<i8> buffer = (ptr<i8>)arena.alloc((u64)length + 1, 1);
        fread(buffer, 1, (u64)length, file);
        fclose(file);
        buffer[length] = 0;
        return buffer;
    }

    public static unsafe ptr<i8> read_bytes(ptr<i8> path, ptr<i32> length) {
        ptr file = fopen(path, "rb");
        if (file == null) {
            return null;
        }
        fseek(file, 0, 2);
        i32 size = (i32)ftell(file);
        fseek(file, 0, 0);
        ptr<i8> buffer = (ptr<i8>)Memory.zalloc((u64)size + 1);
        fread(buffer, 1, (u64)size, file);
        fclose(file);
        length[0] = size;
        return buffer;
    }

    public static bool write_bytes(ptr<i8> path, ptr<i8> data, i32 length) {
        ptr file = fopen(path, "wb");
        if (file == null) {
            return false;
        }
        u64 written = fwrite(data, 1, (u64)length, file);
        fclose(file);
        return written == (u64)length;
    }
}
