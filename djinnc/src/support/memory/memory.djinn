namespace djinnc;

unsafe static mut ptr process_arena = null;

struct Memory {
    public static unsafe Arena* arena() {
        if (unlikely(process_arena == null)) {
            process_arena = (ptr)Arena.create(1048576);
        }
        return (Arena*)process_arena;
    }

    public static unsafe void release() {
        if (process_arena == null) {
            return;
        }
        Arena* arena = (Arena*)process_arena;
        process_arena = (ptr)0;
        arena.destroy();
        free((ptr)arena);
    }

    public static ptr zalloc(u64 count) {
        Arena* arena = Memory.arena();
        return arena.zalloc(count, 16);
    }
}
