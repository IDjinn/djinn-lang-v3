struct TypeInfo {
    i32 id;
    i32 size;
    i8* name;
    u8 kind;
    u8 flags;
}
struct AttributeInfo {
    i8* name;
    i8* value;
    void* payload;
}
struct FieldInfo {
    i8* name;
    i32 typeId;
    u16 offset;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
}
struct ParamInfo {
    i8* name;
    i32 typeId;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
}
struct MethodInfo {
    i8* name;
    void* funcPtr;
    i32 returnTypeId;
    u8 paramCount;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
    ParamInfo* params;
}
struct TypeInfoExt {
    TypeInfo base;
    u16 fieldCount;
    u16 methodCount;
    u8 attrCount;
    FieldInfo* fields;
    MethodInfo* methods;
    AttributeInfo* attrs;
    void* detail;
    i8** interfaces;
    u16 interfaceCount;
}
struct VariantInfo {
    i8* name;
    i64 value;
    u16 payloadCount;
    u8 attrCount;
    AttributeInfo* attrs;
    i32* payloadTypeIds;
    u16* payloadOffsets;
}
struct HeaderInfo {
    i8* name;
    i32 typeId;
    i32 size;
    i32 rowCount;
    void* table;
}
struct EnumInfo {
    u16 variantCount;
    u16 headerCount;
    i32 rowCount;
    VariantInfo* variants;
    HeaderInfo* headers;
}
