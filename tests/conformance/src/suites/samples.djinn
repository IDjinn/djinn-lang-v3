attribute Tag(AttributeTarget.All);

interface Named {
    i32 id();
}

[Tag(3)]
struct Person {
    i32 age;
    i64 score;

    Person(i32 age) {
        this.age = age;
    }

    i32 id() {
        return this.age;
    }

    i32 bonus {
        get => this.age + 1;
        set { this.age = value; }
    }
}

impl Named for Person {
}

$inspect Person {
    generate {
        public i32 extra;
    }
}

enum Kind(i32 flag, i8* name) {
    A(0, "a"),
    B(1, "b")
}

i32 main() {
    FieldList fields = Person#fields;
    MethodList methods = Person#methods;
    MethodList constructors = Person#constructors;
    PropertyList properties = Person#properties;
    AttributeList attributes = Person#attributes;
    NameList interfaces = Person#interfaces;
    if (fields.length != 3 || fields.items[2].name[0] != 101) {
        return 1;
    }
    if (methods.length != 1 || constructors.length != 1 || constructors.items[0].paramCount != 1) {
