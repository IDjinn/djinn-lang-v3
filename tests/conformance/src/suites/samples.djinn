    [Test]
    void attributes() {
        str source = """
[Align(16)]
struct Vec4 {
    i32 x;
    i32 y;
}

struct Math {
    [ForceInline]
    [Hot]
    public static i32 add(i32 a, i32 b) {
        return a + b;
    }

    [NoInline, Cold]
    public static i32 rare() {
        return 5;
    }

    [Llvm("mustprogress")]
    public static i32 twice(i32 value) {
        return value * 2;
    }
}

[Deprecated(message = "use add")]
i32 old_add(i32 a, i32 b) {
    return a + b;
}

[NoRecurse]
i32 main() {
    Vec4 v = { .x = 1, .y = 2 };
    return Math.add(v.x, v.y) + Math.rare() + Math.twice(4) + old_add(1, 1);
}
""";
        Verify.source(source).runs(Expected.exit(18));
    }

    [Test]
    void attributes_applied() {
        str source = """
[Align(32)]
struct Block {
    i32 a;
    i32 b;
}

struct Device {
    [Volatile]
    i32 status;
    i32 plain;
}

[Volatile]
unsafe static mut i32 ticks = 0;

[NonNull]
i32* identity(i32* value) {
    return value;
}

[Align(64)]
i32 aligned_function() {
    return 3;
}

i32 poll(Device* device) {
    mut i32 seen = 0;
    for (mut i32 i = 0; i < 3; i++) {
        seen = seen + device.status;
    }
    return seen;
}

i32 main() {
    Block block = { .a = 1, .b = 2 };
    if (sizeof(Block) != 32) { return 1; }
    mut i32 number = 7;
    i32* same = identity(&number);
    if (*same != 7) { return 2; }
    Device device = { .status = 2, .plain = 0 };
    if (poll(&device) != 6) { return 3; }
    unsafe { ticks = 5; ticks++; }
    unsafe { if (ticks != 6) { return 4; } }
    return aligned_function() + block.a + block.b - 6;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void borrow() {
        str source = """
i32 main() {
    i32 a = 5;
    i32* first = &a;
    i32* second = &a;
    mut i32 b = 7;
    if (a == 5) {
        i32* inner = &b;
    }
    b = 8;
    return *first + *second + b;
}
""";
        Verify.source(source).runs(Expected.exit(18));
    }

    [Test]
    void coalesce() {
        str source = """
i32 main() {
    mut i32 value = 5;
    i32* present = &value;
    i32*? missing = null;
    i32* chosen = missing ?? present;
    i32* kept = present ?? missing;
    i32* last = missing ?? missing ?? present;
    return *chosen + *kept + *last;
}
""";
        Verify.source(source).runs(Expected.exit(15));
    }

    [Test]
    void constexpr_test() {
        str source = """
constexpr i32 BASE = 6 * 7;
constexpr i32 NEXT = BASE + 1;
constexpr bool FLAG = NEXT > 40;
constexpr i32 LATER = EARLIER + 1;
constexpr i32 EARLIER = 9;

constexpr i32 square(i32 n) {
    return n * n;
}

constexpr i32 factorial(i32 n) {
    mut i32 result = 1;
    for (mut i32 i = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

constexpr i32 fib(i32 n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

consteval i32 cube(i32 n) {
    return n * n * n;
}

constexpr i64 shifted(i64 x) {
    return x << 40;
}

constexpr f64 half(f64 x) {
    return x / 2.0;
}

i32 runtime_square(i32 n) {
    return square(n);
}

i32 main() {
    constexpr i32 local = factorial(5);
    mut i32 total = 0;
    if constexpr FLAG {
        total = total + 1;
    } else {
        total = total + 100;
    }
    total = total + local + fib(10) + cube(3) + runtime_square(4) + LATER;
    constexpr i32 high = (i32)(shifted(1) >> 40);
    total = total + high + NEXT - BASE;
    f64 h = half(9.0);
    if (h > 4.0) {
        total = total + 1;
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(232));
    }

    [Test]
    void constexpr_loops() {
        str source = """
constexpr u32 mask(u32 bits) {
    return (1 << bits) - 1;
}

constexpr i32 collatz(i32 n) {
    mut i32 steps = 0;
    mut i32 value = n;
    while (value != 1) {
        if (value % 2 == 0) {
            value = value / 2;
        } else {
            value = value * 3 + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

constexpr i32 pick(i32 n) {
    switch (n) {
        case 1:
            return 10;
        case 2:
            return 20;
        default:
            return 5;
    }
    return 0;
}

constexpr u8 wrapped(i32 n) {
    return (u8)(n + 250);
}

constexpr i32 sum_to(i32 n) {
    mut i32 total = 0;
    for (mut i32 i = 1; i <= n; i = i + 1) {
        if (i == 5) {
            continue;
        }
        if (i > 8) {
            break;
        }
        total = total + i;
    }
    return total;
}

i32 main() {
    return collatz(27) + pick(2) + (i32)wrapped(10) + sum_to(10) + (i32)mask(4);
}
""";
        Verify.source(source).runs(Expected.exit(181));
    }

    [Test]
    void constexpr_strings() {
        str source = """
extern "C" { i32 printf(i8* format, ...); }
constexpr i8* GREETING = "hello, djinn";

constexpr i32 length(i8* text) {
    mut i32 n = 0;
    while (text[n] != 0) {
        n = n + 1;
    }
    return n;
}

constexpr i32 count_char(i8* text, i8 wanted) {
    mut i32 total = 0;
    mut i8* cursor = text;
    while (*cursor != 0) {
        if (*cursor == wanted) {
            total = total + 1;
        }
        cursor = cursor + 1;
    }
    return total;
}

constexpr i8* tail(i8* text, i32 skip) {
    return text + skip;
}

constexpr i32 LEN = length(GREETING);
constexpr i32 LS = count_char("a lazy llama", 108);

consteval i32 first_after(i8* text) { return text[7]; }

i32 main() {
    i8* rest = tail(GREETING, 7);
    printf("%s %d %d %d\n", rest, LEN, LS, first_after(GREETING));
    return LEN + LS;
}
""";
        Verify.source(source).runs(Expected.exit(15).stdout("djinn 12 3 100\n"));
    }

    [Test]
    void constructors() {
        str source = """
struct Point {
    i32 x;
    i32 y;

    Point(i32 x, i32 y) {
        this.x = x;
        this.y = y;
    }

    i32 sum() {
        return this.x + this.y;
    }
}

struct Counter {
    i32 count;

    Counter() {
        this.count = 5;
        this.bump();
    }

    void bump() {
        this.count = this.count + 1;
    }
}

struct Box<T> {
    T value;

    Box(T v) {
        this.value = v;
    }

    T get() {
        return this.value;
    }
}

struct Pair<K, V> {
    K first;
    V second;

    Pair(K a, V b) {
        this.first = a;
        this.second = b;
    }
}

i32 main() {
    Point p = Point(10, 20);
    Point* heap = new Point(1, 2);
    Counter c = Counter();
    Box<i32> box = Box<i32>(7);
    Box<i32>* shared = new Box<i32>(9);
    Pair<i32, i64> pair = Pair<i32, i64>(3, 4);
    return p.sum() + heap.sum() + c.count + box.get() + shared.get() + pair.first + (i32)pair.second;
}
""";
        Verify.source(source).runs(Expected.exit(62));
    }

    [Test]
    void control() {
        str source = """
i32 main() {
    mut i32 count = 0;
    mut i32 n = 0;
    while (n < 20) {
        n = n + 1;
        if (n % 2 == 0 && n > 4) {
            continue;
        }
        if (n > 15) {
            break;
        }
        count = count + 1;
    }
    return count;
}
""";
        Verify.source(source).runs(Expected.exit(10));
    }

    [Test]
    void enum_fields() {
        str source = """
extern i32 strlen(i8* text);

enum Kind(i32 flag, i8* name, i32 width) {
    PROGRAM(0, "Program", 7),
    IMPORT(10, "Import", 6),
    WHILE(3, "While", 5)
}

i32 weigh(Kind kind) {
    return kind.flag * 100 + kind.width;
}

i32 main() {
    Kind first = Kind::IMPORT;
    Kind second = Kind::WHILE;
    i32 total = weigh(first) + weigh(second) + strlen(Kind::PROGRAM.name) + strlen(second.name) + first.getValue();
    if (first == Kind::IMPORT && second != Kind::PROGRAM) {
        return total - 1333;
    }
    return 99;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void enum_is() {
        str source = """
union Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

enum Light {
    Red(),
    Green()
}

i32 score(Message m) {
    mut i32 total = 0;
    if (m is Message::Empty) {
        total = total + 1;
    }
    if (m is Message::Number n) {
        total = total + n;
    }
    if (m is Message::Pair a b) {
        total = total + a * b;
    }
    return total;
}

i32 main() {
    Light light = Light::Green();
    mut i32 total = score(Message::Empty()) + score(Message::Number(7)) + score(Message::Pair(3, 4));
    if (light is Light::Green) {
        total = total + 100;
    }
    if (light is Light::Red) {
        total = total + 1000;
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(120));
    }

    [Test]
    void enum_methods() {
        str source = """
enum Light {
    Red(),
    Green(),
    Blue()
}

union Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

interface Ranked {
    i32 rank();
}

interface Named {
    i32 id();
}

interface Sized {
    i32 size();
}

impl Ranked for Light {
    i32 rank() {
        return switch this {
            Red -> 1,
            Green -> 2,
            Blue -> 3
        };
    }
}

impl Message {
    i32 weight() {
        return switch this {
            Empty -> 1,
            Number n -> n,
            Pair a b -> a * b
        };
    }
}

struct Crate {
    i32 number;
    i32 volume;
}

impl Named, Sized for Crate {
    i32 id() {
        return this.number;
    }

    i32 size() {
        return this.volume;
    }
}

extern "C" {
    void* malloc(u64 size);
}

i32 main() {
    Light light = Light::Green();
    Message pair = Message::Pair(3, 4);
    Message number = Message::Number(7);
    Crate* crate = (Crate*)malloc(sizeof(Crate));
    crate.number = 5;
    crate.volume = 6;
    return light.rank() + pair.weight() + number.weight() + crate.id() + crate.size();
}
""";
        Verify.source(source).runs(Expected.exit(32));
    }

    [Test]
    void enum_payload_layout() {
        str source = """
union optional<T> {
    Some(T),
    None()
}

union Shape {
    Circle(i64),
    Rect(i32, i64),
    Label(string),
    Nothing()
}

struct Point {
    i32 x;
    i64 y;
}

i32 area(Shape shape) {
    return switch shape {
        Circle r -> (i32)r,
        Rect w h -> w * (i32)h,
        Label text -> (i32)text.length,
        Nothing -> 0
    };
}

i32 main() {
    optional<string> greeting = optional<string>::Some("hello");
    i32 a = switch greeting { Some s -> (i32)s.length, None -> 0 };
    Point p = { .x = 3, .y = 4 };
    optional<Point> boxed = optional<Point>::Some(p);
    i32 b = switch boxed { Some q -> q.x + (i32)q.y, None -> 0 };
    i32 c = area(Shape::Rect(6, 7)) + area(Shape::Label("abc")) + area(Shape::Circle(2)) + area(Shape::Nothing());
    return a + b + c;
}
""";
        Verify.source(source).runs(Expected.exit(59));
    }

    [Test]
    void enum_switch_statement() {
        str source = """
enum Tone {
    Low,
    Mid,
    High
}

i32 weigh(Tone tone) {
    mut i32 total = 0;
    switch (tone) {
        case Low:
            total = 1;
        case Tone::Mid:
            total = 20;
        default:
            total = 300;
    }
    return total;
}

i32 main() {
    Tone peak = Tone::High;
    return weigh(Tone::Low) + weigh(Tone::Mid) + weigh(peak) - 300;
}
""";
        Verify.source(source).runs(Expected.exit(21));
    }

    [Test]
    void enum_switch_wildcard() {
        str source = """
enum Tone {
    Low,
    Mid,
    High,
    Peak
}

i32 weight(Tone tone) {
    return switch tone {
        Low -> 1,
        Mid -> 2,
        _ -> 10
    };
}

i32 main() {
    Tone peak = Tone::Peak();
    i32 total = weight(Tone::Low()) + weight(Tone::Mid()) + weight(Tone::High()) + weight(peak);
    if (peak == Tone::Peak() && peak != Tone::Low()) {
        return total;
    }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(23));
    }

    [Test]
    void enum_value() {
        str source = """
enum Tone {
    A(),
    B(),
    C()
}

enum Shade {
    X(),
    Y()
}

struct Holder {
    Tone kind;
    u32 token;
}

i32 main() {
    Holder h = { .kind = Tone::C(), .token = 2 };
    Tone back = Tone::C();
    mut i32 total = 0;
    if (h.kind == back) { total = total + 1; }
    if (h.kind != Tone::A()) { total = total + 2; }
    if (h.kind == Tone::B()) { total = total + 100; }
    total = total + h.kind.getValue();
    Shade o = Shade::Y();
    total = total + o.getValue();
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(6));
    }

    [Test]
    void enums() {
