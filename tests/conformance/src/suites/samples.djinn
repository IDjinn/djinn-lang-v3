        return 3;
    }
    if (attributes.length != 1 || interfaces.length != 1 || interfaces.items[0][0] != 78) {
        return 4;
    }
    FieldList none = Kind#fields;
    if (none.length != 0) {
        return 5;
    }
    string text = fields.format();
    if (text.length != 17) {
        return 6;
    }
    return fields.length * 10 + methods.length;
}
""";
        Verify.source(source).runs(Expected.exit(31));
    }

