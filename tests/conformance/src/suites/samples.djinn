namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct SamplesTests {
    [Test]
    void arith() {
        str source = """
i32 add(i32 a, i32 b) {
    return a + b;
}

i32 main() {
    mut i32 total = 0;
    for (mut i32 i = 1; i <= 10; i = i + 1) {
        total = total + add(i, i);
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(110));
    }

    [Test]
    void arrays() {
        str source = """
i32 sum(i32[] values) {
    mut i32 total = 0;
    for (mut u32 i = 0; i < values.length; i = i + 1) {
        total = total + values[i];
    }
    return total;
}

i32 main() {
    i32[] numbers = [1, 2, 3, 4];
    numbers[0] = 10;
    str name = "djinn";
    i64[] wide = [5, 6];
    if (name.is_empty()) {
        return 1;
    }
    return sum(numbers) + (i32)name.length + (i32)wide[1] + (i32)numbers.length + sum([7, 8]);
}
""";
        Verify.source(source).runs(Expected.exit(49));
    }

    [Test]
    void async_basic() {
        str source = """
async i32 twice(i32 value) {
    return value * 2;
}

async i32 chain(i32 value) {
    i32 first = await twice(value);
    i32 second = await twice(first);
    return first + second;
}

async void noop() {
    return;
}

i32 main() {
    await noop();
    i32 direct = await twice(5);
    i32 nested = await chain(3);
    return direct + nested;
}
""";
        Verify.source(source).runs(Expected.exit(28));
    }

    [Test]
    void async_main() {
        str source = """
async i32 compute(i32 a, i32 b) {
    return a + b;
}

async void background() {
    return;
}

async i32 main() {
    spawn background();
    i32 sum = await compute(20, 22);
    return sum;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void attr_location() {
        str source = """
attribute Location(AttributeTarget.Parameter) {
    i8* fileName;
    i32 line;
    i32 column;
}

attribute Marker(AttributeTarget.All);

i32 line_of([Location] Location site) {
    return site.line;
}

i32 pick([Marker] i32 value, [Location] Location site) {
    return value + site.line;
}

i32 main() {
    i32 here = line_of();
    if (unlikely(here == 0)) {
        trap();
    }
    assume(here > 0);
    return here + pick(1);
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void attribute_payload() {
        str source = """
struct Phase {
    const i32 IR = 1;
    const i32 JIT = 2;
}

attribute Stage(AttributeTarget.All) {
    i32 mask;
    i8* label;
}

[Stage(Phase.IR | Phase.JIT, label = "both")]
i32 target() {
    return 1;
}

[Stage(mask = 4)]
i32 other() {
    return 2;
}

i32 main() {
    MethodInfo* info = typeof(target);
    Stage* stage = (Stage*)info.attrs[0].payload;
    if (stage.mask != 3) {
        return 1;
    }
    if (stage.label[0] != 98) {
        return 2;
    }
    MethodInfo* second = typeof(other);
    Stage* partial = (Stage*)second.attrs[0].payload;
    if (partial.mask != 4 || partial.label != null) {
        return 3;
    }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

