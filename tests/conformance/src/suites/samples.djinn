    [Test]
    void generic_interfaces() {
        str source = """
interface Equatable<T> {
    operator ==(T left, T right) -> bool;
}

interface Comparable<T> {
    i32 compare(T other);
}

struct Point : Equatable<Point>, Comparable<Point> {
    i32 x;
    i32 y;

    operator ==(Point left, Point right) -> bool {
        return left.x == right.x && left.y == right.y;
    }

    i32 compare(Point other) {
        return this.x - other.x;
    }
}

struct Sorted<T> where T : Comparable<T> {
    T low;
    T high;

    i32 order() {
        return this.low.compare(this.high);
    }
}

i32 main() {
    Point a = { .x = 9, .y = 1 };
    Point b = { .x = 4, .y = 1 };
    Sorted<Point> pair = { .low = a, .high = b };
    mut i32 total = pair.order();
    if (a == a) {
        total = total + 10;
    }
    if (a != b) {
        total = total + 20;
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(35));
    }

    [Test]
    void generic_methods() {
        str source = """
interface Equatable<T> {
    operator ==(T left, T right) -> bool;
}

struct Holder<T> {
    T value;

    T pick<U>(U marker, T other) {
        return other;
    }

    U convert<U>(U seed) {
        return seed;
    }
}

struct Utility {
    public static T twice<T>(T item) {
        return item;
    }
}

bool same<T>(T a, T b) where T : Equatable<T> {
    return a == b;
}

i32 main() {
    Holder<i32> holder = { .value = 4 };
    i32 a = holder.pick(true, 20);
    i64 b = holder.convert<i64>(30);
    i32 c = Utility.twice(5);
    mut i32 total = a + (i32)b + c;
    if (same(3, 3)) {
        total = total + 1;
    }
    if (same(1, 2)) {
        total = total + 100;
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(56));
    }

    [Test]
    void generics() {
        str source = """
struct Pair<K, V> {
    K key;
    V value;

    K first() {
        return this.key;
    }
}

struct Wrapper<T> {
    T data;
    i32 id;
}

union optional<T> {
    Empty(),
    Value(T)
}

interface IValue {
    i32 getValue();
}

struct Container<T> where T : IValue {
    T item;

    i32 read() {
        return this.item.getValue();
    }
}

struct MyItem : IValue {
    i32 data;

    i32 getValue() {
        return this.data;
    }
}

Pair<i32, i32> makePair(i32 k, i32 v) {
    return { .key = k, .value = v };
}

i32 unwrap(optional<i32> maybe) {
    return switch maybe {
        Empty -> 0,
        Value v -> v
    };
}

i32 main() {
    auto p = makePair(5, 10);
    Wrapper<Pair<i32, i32>> w = { .data = p, .id = 3 };
    Pair<i32, i64> mixed = { .key = 4, .value = 100 };
    MyItem item = { .data = 7 };
    Container<MyItem> box = { .item = item };
    optional<i32> some = optional<i32>::Value(20);
    optional<i32> none = optional<i32>::Empty();
    return p.key + p.value + w.data.value + w.id + mixed.first() + box.read() + unwrap(some) + unwrap(none);
}
""";
        Verify.source(source).runs(Expected.exit(59));
    }

