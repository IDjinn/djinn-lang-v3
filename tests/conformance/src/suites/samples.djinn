enum Color {
    Red(),
    Green(),
    Blue()
}

enum Level {
    Low = 10,
    Mid,
    High
}

i32 weight(Color c) {
    switch (c) {
        case Color::Red():
            return 1;
        case Color::Green():
            return 2;
        default:
            return 3;
    }
    return 0;
}

i32 main() {
    Color c = Color::Green();
    mut i32 total = weight(c) + weight(Color::Blue());
    if (c == Color::Green()) {
        total = total + 10;
    }
    if (c != Color::Red()) {
        total = total + 20;
    }
    Level l = Level::Mid();
    total = total + (i32)l;
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(46));
    }

    [Test]
    void error_async() {
        str source = """
struct OddError {
    i32 value;

    OddError(i32 value) {
        this.value = value;
    }
}

async i32 half(i32 value) throws(OddError) {
    if (value % 2 != 0) {
        throw OddError(value);
    }
    return value / 2;
}

async i32 run() {
    i32 first = try await half(8) ?: -1;
    i32 second = try await half(7) ?: 20;
    return first + second;
}

i32 main() {
    i32 total = await run();
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(24));
    }

    [Test]
    void error_basic() {
        str source = """
struct DivisionByZeroError {
    i32 dividend;

    DivisionByZeroError(i32 dividend) {
        this.dividend = dividend;
    }
}

i32 division(i32 value, i32 divisor) throws(DivisionByZeroError) {
    if (divisor == 0) {
        throw DivisionByZeroError(value);
    }
    return value / divisor;
}

i32 main() {
    i32 ok = try division(10, 2) ?: -1;
    i32 recovered = try division(1, 0) ?: 100;
    return ok + recovered;
}
""";
        Verify.source(source).runs(Expected.exit(105));
    }

    [Test]
    void error_primitive() {
        str source = """
i32 check(i32 value) throws(bool) {
    if (value < 0) {
        throw true;
    }
    return value;
}

i32 main() {
    i32 first = switch check(4) {
        Result v -> v,
        bool e -> 100
    };
    i32 second = switch check(-1) {
        Result v -> v,
        bool e -> 3
    };
    return first + second;
}
""";
        Verify.source(source).runs(Expected.exit(7));
    }

    [Test]
    void error_propagate() {
        str source = """
struct DivisionByZeroError {
    i32 dividend;

    DivisionByZeroError(i32 dividend) {
        this.dividend = dividend;
    }
}

i32 inner(i32 value) throws(DivisionByZeroError) {
    if (value == 0) {
        throw DivisionByZeroError(value);
    }
    return value;
}

i32 middle(i32 value) throws(DivisionByZeroError) {
    i32 result = inner(value);
    return result + 1;
}

i32 wide(i32 value) throws {
    i32 result = try middle(value);
    return result;
}

i32 main() {
    i32 first = try middle(0) ?: 10;
    i32 second = switch wide(0) {
        Result v -> v,
        Error e -> 5
    };
    i32 third = try middle(3) ?: 0;
    return first + second + third;
}
""";
        Verify.source(source).runs(Expected.exit(19));
    }

    [Test]
    void error_switch() {
        str source = """
struct DivisionByZeroError {
    i32 dividend;

    DivisionByZeroError(i32 dividend) {
        this.dividend = dividend;
    }
}

struct NegativeError {
    i32 code;

    NegativeError(i32 code) {
        this.code = code;
    }
}

i32 parse(i32 input) throws(DivisionByZeroError, NegativeError) {
    if (input == 0) {
        throw DivisionByZeroError(7);
    }
    if (input < 0) {
        throw NegativeError(30);
    }
    return input;
}

i32 main() {
    i32 first = switch parse(5) {
        Result v -> v,
        DivisionByZeroError e -> e.dividend,
        NegativeError e -> e.code
    };
    i32 second = switch parse(0) {
        Result v -> v,
        DivisionByZeroError e -> e.dividend,
        NegativeError e -> e.code
    };
    i32 third = switch parse(-1) {
        Result v -> v,
        DivisionByZeroError e -> e.dividend,
        NegativeError e -> e.code
    };
    return first + second + third;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void error_task() {
        str source = """
async i32 half(i32 value) throws(bool) {
    if (value % 2 != 0) {
        throw true;
    }
    return value / 2;
}

async i32 plain() {
    return 5;
}

i32 main() {
    task<i32, bool> pending = half(6);
    task<i32> simple = plain();
    i32 first = try await pending ?: -1;
    i32 second = await simple;
    return first + second;
}
""";
        Verify.source(source).runs(Expected.exit(8));
    }

    [Test]
    void for_in_arr() {
        str source = """
struct Bag {
    i32[] items;
}

i32[] make() {
    return [4, 5, 6];
}

i32 sum_bag(Bag* bag) {
    mut i32 total = 0;
    for (i32 item in bag.items) {
        total = total + item;
    }
    return total;
}

i32 main() {
    i32[] numbers = [1, 2, 3, 4];
    mut i32 total = 0;
    for (i32 n in numbers) {
        total = total + n;
    }
    if (total != 10) { return 1; }

    mut i32 skipped = 0;
    for (auto n in numbers) {
        if (n == 2) { continue; }
        if (n == 4) { break; }
        skipped = skipped + n;
    }
    if (skipped != 4) { return 2; }

    mut i32 produced = 0;
    for (i32 n in make()) {
        produced = produced + n;
    }
    if (produced != 15) { return 3; }

    for (i32 n in [10, 20]) {
        produced = produced + n;
    }
    if (produced != 45) { return 4; }

    Bag bag = { .items = [7, 8] };
    if (sum_bag(&bag) != 15) { return 5; }

    mut i32 nested = 0;
    for (i32 a in numbers) {
        for (i32 b in 0..2) {
            nested = nested + a * b;
        }
    }
    if (nested != 10) { return 6; }

    i32[] names = [1, 2];
    for (i32 n in numbers) { }
    if (numbers.length != 4 || names.length != 2) { return 7; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void generic_enum_infer() {
        str source = """
union optional<T> {
    Some(T),
    None()
}

union result<T, E> {
    Ok(T),
    Err(E)
}

enum MathError {
    DivByZero(),
    Negative()
}

result<i32, MathError> div(i32 a, i32 b) {
    if (b == 0) {
        return result::Err(MathError::DivByZero());
    }
    return result::Ok(a / b);
}

optional<i64> wrap(i64 value) {
    return optional::Some(value);
}

i32 main() {
    auto inferred = optional::Some(7);
    i32 first = switch inferred { Some v -> v, None -> 0 };
    i32 second = switch div(40, 4) { Ok v -> v, Err e -> 1000 };
    i32 third = switch div(1, 0) { Ok v -> v, Err e -> 5 };
    i32 fourth = switch wrap(3) { Some v -> (i32)v, None -> 0 };
    return first + second + third + fourth;
}
""";
        Verify.source(source).runs(Expected.exit(25));
    }

    [Test]
    void generic_functions() {
        str source = """
interface Comparable<T> {
    i32 compare(T other);
}

struct Pair<K, V> {
    K key;
    V value;
}

struct Score : Comparable<Score> {
    i32 points;

    i32 compare(Score other) {
        return this.points - other.points;
    }
}

T first<T>(T a, T b) {
    return a;
}

T larger<T>(T a, T b) where T : Comparable<T> {
    if (a.compare(b) >= 0) {
        return a;
    }
    return b;
}

K keyOf<K, V>(Pair<K, V> pair) {
    return pair.key;
}

i32 deref<T>(T* pointer) {
    return 1;
}

i32 main() {
    i32 a = first(7, 9);
    i64 b = first<i64>(30, 40);
    Score low = { .points = 3 };
    Score high = { .points = 11 };
    Score best = larger(low, high);
    Pair<i32, i64> pair = { .key = 5, .value = 90 };
    i32 key = keyOf(pair);
    return a + (i32)b + best.points + key + deref(&a);
}
""";
        Verify.source(source).runs(Expected.exit(54));
    }

