    [Test]
    void heap_aligned() {
        str source = """
extern "C" {
    void __djinn_free_aligned(void* pointer);
}

[Align(64)]
struct Line {
    i32 a;
    i32 b;
}

[Align(4096)]
struct Page {
    i64 id;
}

i32 main() {
    Line* line = new Line();
    Page* page = new Page();
    line.a = 3;
    line.b = 4;
    page.id = 5;
    unsafe {
        u64 line_address = (u64)(ptr)line;
        u64 page_address = (u64)(ptr)page;
        if ((line_address & 63) != 0) {
            return 1;
        }
        if ((page_address & 4095) != 0) {
            return 2;
        }
        __djinn_free_aligned((void*)line);
        __djinn_free_aligned((void*)page);
    }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void impl_many_structs() {
        str source = """
interface Named {
    i32 id();
}

interface Scaled {
    i32 scale(i32 factor);
}

struct Circle {
    i32 radius;
}

struct Triangle {
    i32 base;
}

struct Square {
    i32 side;
}

enum Tone {
    Low,
    High
}

impl Named for Circle, Square {
    [ForceInline]
    i32 id() {
        return 7;
    }
}

impl Named, Scaled for Tone, Triangle {
    i32 id() {
        return 3;
    }

    i32 scale(i32 factor) {
        return factor * 2;
    }
}

struct Plain {
    i32 value;
}

impl Named for Plain {
    [ForceInline]
    i32 id() {
        return 11;
    }
}

i32 total<T>(T item) where T : Named {
    return item.id();
}

i32 main() {
    Circle circle = { .radius = 1 };
    Square square = { .side = 2 };
    Tone tone = Tone::High();
    Plain plain = { .value = 5 };
    Triangle triangle = { .base = 3 };
    i32 named = total(circle) + total(square) + total(tone) + total(triangle);
    if (named != 7 + 7 + 3 + 3) { return 1; }
    if (triangle.scale(4) != 8 || tone.scale(5) != 10) { return 2; }
    if (total(plain) != 11) { return 3; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

