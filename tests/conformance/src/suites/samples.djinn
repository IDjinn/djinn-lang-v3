    [Test]
    void nullable_pointer() {
        str source = """
struct Box {
    i32 value;
}

i32 read(Box*? box) {
    if (box == null) {
        return 0 - 1;
    }
    return box.value;
}

i32 main() {
    Box local = { .value = 7 };
    Box* safe = &local;
    mut Box*? maybe = null;
    i32 empty = read(maybe);
    maybe = safe;
    return read(maybe) + empty;
}
""";
        Verify.source(source).runs(Expected.exit(6));
    }

