    [Test]
    void variadic_pack() {
        str source = """
i32 total(i32 base, i32... values) {
    mut i32 sum = base;
    for (mut u32 i = 0; i < values.length; i = i + 1) {
        sum = sum + values[i];
    }
    return sum;
}

i32 kinds(object... items) {
    mut i32 mask = 0;
    for (mut u32 i = 0; i < items.length; i = i + 1) {
        TypeInfo* info = items[i].type;
        mask = mask + (i32)info.kind * 10 + 1;
    }
    return mask;
}

i32 main() {
    i32 a = total(1, 2, 3, 4);
    i32 b = kinds(5, 2.5, "x");
    return a + b;
}
""";
        Verify.source(source).runs(Expected.exit(43));
    }

