    [Test]
    void rem_signs() {
        str source = """
i8 narrow(i8 left, i8 right) {
    return left % right;
}

i16 short(i16 left, i16 right) {
    return left % right;
}

i32 rem(i32 left, i32 right) {
    return left % right;
}

i64 wide(i64 left, i64 right) {
    return left % right;
}

i128 widest(i128 left, i128 right) {
    return left % right;
}

i32 main() {
    i32 minimum = 0 - 2147483647 - 1;
    if (rem(minimum, 0 - 1) != 0) { return 1; }
    if (rem(minimum, 1) != 0) { return 2; }
    if (rem(0 - 10, 0 - 1) != 0) { return 3; }
    if (rem(10, 0 - 1) != 0) { return 4; }
    if (rem(0 - 10, 3) != 0 - 1) { return 5; }
    if (rem(10, 0 - 3) != 1) { return 6; }
    if (narrow(-128, -1) != 0) { return 7; }
    if (short(-32768, -1) != 0) { return 8; }
    if (wide((i64)1 << 63, 0 - 1) != 0) { return 9; }
    if (widest((i128)1 << 127, 0 - 1) != 0) { return 10; }
    if ((0 - 2147483647 - 1) % (0 - 1) != 0) { return 11; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void wide_division() {
        str source = """
i128 divide(i128 left, i128 right) {
    return left / right;
}

i128 rem(i128 left, i128 right) {
    return left % right;
}

u128 divide_unsigned(u128 left, u128 right) {
    return left / right;
}

u128 rem_unsigned(u128 left, u128 right) {
    return left % right;
}

i32 main() {
    i128 big = (i128)1 << 100;
    if (divide(big, (i128)1 << 98) != 4) { return 1; }
    if (divide(0 - big, (i128)1 << 98) != 0 - 4) { return 2; }
    if (rem(big + 1, 7) != (i128)3) { return 3; }
    if (rem(0 - big - 1, 7) != 0 - (i128)3) { return 4; }
    u128 top = (u128)1 << 127;
    if (divide_unsigned(top + top - 1, top) != 1) { return 5; }
    if (rem_unsigned(top + top - 1, top) != top - 1) { return 6; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void wide_float_conversion() {
        str source = """
i128 to_signed(f64 value) {
    return (i128)value;
}

u128 to_unsigned(f32 value) {
    return (u128)value;
}

f64 from_signed(i128 value) {
    return (f64)value;
}

f32 from_unsigned(u128 value) {
    return (f32)value;
}

i32 main() {
    i128 big = (i128)1 << 100;
    if (to_signed(0.0 - 3.5) != 0 - 3) { return 1; }
    if (to_signed(1267650600228229401496703205376.0) != big) { return 2; }
    if (to_unsigned(16777216.0) != 16777216) { return 3; }
    if (from_signed(0 - big) != 0.0 - 1267650600228229401496703205376.0) { return 4; }
    if (from_signed(7) != 7.0) { return 5; }
    if (from_unsigned((u128)1 << 64) != 18446744073709551616.0) { return 6; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void implicit_widening() {
        str source = """
i64 widen(i32 value) {
    return value;
}

u64 sum(u8 small, u32 large) {
    return small + large;
}

f64 precise(f32 value) {
    return value;
}

struct Holder {
    i64 wide;
}

i32 main() {
    i8 small = 3;
    i16 medium = small;
    i32 regular = medium;
    i64 large = regular;
    Holder holder = { .wide = regular };
    f32 single = 1.5;
    f64 double = single;
    mut i64 total = large + widen(regular) + holder.wide;
    total += regular;
    if (sum((u8)2, (u32)3) != 5) { return 1; }
    if (precise(single) != double) { return 2; }
    if (regular + large != 6) { return 3; }
    if (double + single != 3.0) { return 4; }
    return (i32)total;
}
""";
        Verify.source(source).runs(Expected.exit(12));
    }

    [Test]
    void float_to_integer_limits() {
        str source = """
i32 signed(f64 value) {
    return (i32)value;
}

i32 single(f32 value) {
    return (i32)value;
}

u8 byte(f64 value) {
    return (u8)value;
}

i64 wide(f64 value) {
    return (i64)value;
}

u64 wide_unsigned(f64 value) {
    return (u64)value;
}

bool flag(f64 value) {
    return (bool)value;
}

bool from_integer(i32 value) {
    return (bool)value;
}

i32 main() {
    if (signed(2147483647.5) != 2147483647) { return 1; }
    if (signed(0.0 - 2147483648.5) != 0 - 2147483647 - 1) { return 2; }
    if (single(0.0 - 2147483648.0) != 0 - 2147483647 - 1) { return 3; }
    if (byte(255.9) != 255) { return 4; }
    if (byte(0.0 - 0.5) != 0) { return 5; }
    if (wide(0.0 - 9223372036854775808.0) != (i64)1 << 63) { return 6; }
    if (wide_unsigned(9223372036854775808.0) != (u64)1 << 63) { return 7; }
    if (!flag(2.0) || !flag(0.5) || flag(0.0)) { return 8; }
    if (!from_integer(2) || from_integer(0)) { return 9; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void integer_limits() {
        str source = """
i32 left(i32 value, i32 amount) {
    return value << amount;
}

u8 right(u8 value, u8 amount) {
    return value >> amount;
}

i32 arithmetic(i32 value, i32 amount) {
    return value >> amount;
}

i32 main() {
    if (left(1, 31) >= 0) { return 1; }
    if (left(1, 0) != 1) { return 2; }
    if (right((u8)128, (u8)7) != 1) { return 3; }
    if (arithmetic(0 - 8, 1) != 0 - 4) { return 4; }
    i32 largest = 2147483647;
    i32 wrapped = largest + 1;
    if (wrapped >= 0) { return 5; }
    i32 minimum = wrapped;
    if (0 - minimum != minimum) { return 6; }
    mut u8 byte = 255;
    byte++;
    if (byte != 0) { return 7; }
    i8 lowest = -128;
    i8 highest = 127;
    u8 largest_byte = 255;
    u64 everything = 0xFFFFFFFFFFFFFFFF;
    if (lowest + highest != -1) { return 8; }
    if (largest_byte != (u8)255) { return 9; }
    if ((everything >> 60) != 15) { return 10; }
    i32 source = 300;
    if ((u8)source != 44) { return 11; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void wide_division_limits() {
        str source = """
i128 divide(i128 left, i128 right) {
    return left / right;
}

i128 rem(i128 left, i128 right) {
    return left % right;
}

i128 minimum() {
    return (i128)1 << 127;
}

i32 main() {
    i128 min = minimum();
    i128 max = 0 - (min + 1);
    if (divide(min, 1) != min) { return 1; }
    if (divide(min, 2) != 0 - ((i128)1 << 126)) { return 2; }
    if (divide(min, 0 - 2) != (i128)1 << 126) { return 3; }
    if (divide(min, min) != 1) { return 4; }
    if (divide(max, min) != 0) { return 5; }
    if (rem(min, 0 - 1) != 0) { return 6; }
    if (rem(min, min) != 0) { return 7; }
    if (rem(min, 3) != 0 - 2) { return 8; }
    if (rem(max, min) != max) { return 9; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

