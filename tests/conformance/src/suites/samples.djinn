    [Test]
    void macros() {
        str source = """
macro double_it {
    (local expression v) => { v + v }
}

macro mul {
    (expression a, expression b) => { a * b }
}

macro op {
    (add, expression a, expression b) => { a + b }
    (sub, expression a, expression b) => { a - b }
    (local expression v) => { v * 2 }
}

macro get_value {
    (identifier name) => { name }
}

macro feature {
    (enabled, expression code) => { code }
    (disabled, expression code) => void
}

macro sum_squares {
    local (expression a, expression b) => { a * a + b * b }
}

macro size_hint {
    (type T) => { 8 }
}

static i32 base = 7;
unsafe static mut i32 counter = 0;

i32 next() {
    counter = counter + 1;
    return counter;
}

i32 main() {
    i32 a = double_it(next());
    i32 b = mul(2 + 3, 4 + 1);
    i32 c = op(add, 10, 5) + op(sub, 10, 5) + op(3);
    i32 d = get_value(base);
    i32 e = feature(enabled, 4) + feature(disabled, 99);
    i32 f = sum_squares(next(), next());
    i32 g = size_hint(i32);
    return a + b + c + d + e + f + g;
}
""";
        Verify.source(source).runs(Expected.exit(85));
    }

