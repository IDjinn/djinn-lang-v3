    [Test]
    void overloads() {
        str source = """
struct Vec {
    i32 x;
    i32 y;

    Vec(i32 x, i32 y) {
        this.x = x;
        this.y = y;
    }

    Vec(i32 both) {
        this.x = both;
        this.y = both;
    }

    Vec() {
        this.x = 1;
        this.y = 1;
    }

    i32 scaled(i32 factor) {
        return (this.x + this.y) * factor;
    }

    i32 scaled(Vec other) {
        return this.x * other.x + this.y * other.y;
    }

    i32 scaled() {
        return this.x + this.y;
    }

    operator +(Vec left, Vec right) -> Vec {
        return Vec(left.x + right.x, left.y + right.y);
    }

    operator +(Vec left, i32 amount) -> Vec {
        return Vec(left.x + amount, left.y + amount);
    }
}

i32 describe(i32 value) {
    return value;
}

i32 describe(i64 value) {
    return (i32)value + 100;
}

i32 describe(i32 a, i32 b) {
    return a * b;
}

i32 main() {
    Vec a = Vec(2, 3);
    Vec b = Vec(4);
    Vec c = Vec();
    Vec d = a + b;
    Vec e = a + 10;
    i64 wide = 5;
    return describe(1) + describe(wide) + describe(2, 3) + a.scaled(2) + a.scaled(b) + c.scaled() + d.x + e.y;
}
""";
        Verify.source(source).runs(Expected.exit(163));
    }

