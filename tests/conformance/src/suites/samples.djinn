    [Test]
    void strings() {
        str source = """
extern "C" {
    i32 printf(i8* format, ...);
}

struct Point {
    i32 x;
    i32 y;
}

i32 main() {
    i32 count = 3;
    i64 big = 5000000000;
    u32 small = 7;
    f64 ratio = 2.5;
    bool ready = true;
    i8* name = "djinn";
    str view = "view";
    Point p = { .x = 1, .y = 2 };

    string greeting = $"hello {name}, count={count}";
    printf("%s\n", greeting.ptr());
    string numbers = $"big={big} small={small} ratio={ratio} ready={ready}";
    printf("%s\n", numbers.ptr());
    string math = $"sum={p.x + p.y} view={view} neg={count - 6}";
    printf("%s\n", math.ptr());
    string joined = greeting + "!" + numbers;
    printf("%s\n", joined.ptr());
    string literal = "plain";
    string nested = $"[{greeting}] {literal}";
    printf("%s\n", nested.ptr());
    string braces = $"{{{count}}} and }}";
    printf("%s\n", braces.ptr());
    string plain = "{count} stays text";
    printf("%s\n", plain.ptr());
    string empty = $"only text";
    printf("%s|%d\n", empty.ptr(), (i32)empty.length);
    return (i32)nested.length;
}
""";
        Verify.source(source).runs(Expected.exit(28).stdout("hello djinn, count=3\nbig=5000000000 small=7 ratio=2.5 ready=true\nsum=3 view=view neg=-3\nhello djinn, count=3!big=5000000000 small=7 ratio=2.5 ready=true\n[hello djinn, count=3] plain\n{3} and }\n{count} stays text\nonly text|9\n"));
    }

    [Test]
    void struct_values() {
        str source = """
struct Point {
    i32 x;
    i32 y;

    i32 sum() {
        return this.x + this.y;
    }
}

struct Segment {
    Point from;
    Point to;
}

Point make(i32 a, i32 b) {
    return { .x = a, .y = b };
}

i32 total(Point p) {
    return p.x + p.y;
}

i32 main() {
    Point p = make(3, 4);
    i32 px = p.x;
    mut Point q = p;
    q.x = 10;
    auto r = make(1, 2);
    Segment s = { .from = { .x = 1, .y = 1 }, .to = r };
    return px + q.x + total(r) + r.sum() + s.from.x + s.to.y;
}
""";
        Verify.source(source).runs(Expected.exit(22));
    }

    [Test]
    void structs() {
        str source = """
struct Kind {
    const i32 SMALL = 3;
    const i32 LARGE = 40;
}

struct Counter {
    i32 total;
    i32 steps;

    public static Counter* create(i32 start) {
        Counter* counter = (Counter*)malloc(sizeof(Counter));
        counter.total = start;
        counter.steps = 0;
        return counter;
    }

    public void add(i32 amount) {
        this.total = this.total + amount;
        this.bump();
    }

    void bump() {
        this.steps = this.steps + 1;
    }

    public i32 summary() {
        return this.total + this.steps;
    }
}

struct Pair {
    Counter* left;
    Counter* right;
}

extern "C" {
    void* malloc(u64 size);
}

i32 main() {
    Pair* pair = (Pair*)malloc(sizeof(Pair));
    pair.left = Counter.create(Kind.SMALL);
    pair.right = Counter.create(Kind.LARGE);
    pair.left.add(2);
    pair.right.add(1);
    return pair.left.summary() + pair.right.summary();
}
""";
        Verify.source(source).runs(Expected.exit(48));
    }

    [Test]
    void switch_test() {
        str source = """
i32 classify(i32 n) {
    switch (n) {
        case 1:
            return 10;
        case 2:
            return 20;
        default:
            return 5;
    }
    return 0;
}

i32 main() {
    mut i32 total = classify(1) + classify(2) + classify(9);
    for (mut i32 i = 0; i < 6; i = i + 1) {
        switch (i) {
            case 0:
                continue;
            case 3:
                break;
            default:
                total = total + 1;
        }
        total = total + 10;
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(89));
    }

    [Test]
    void tagged_enums() {
        str source = """
union Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

enum Light {
    Red(),
    Green(),
    Blue()
}

i32 describe(Message m) {
    return switch m {
        Empty -> 1,
        Number n -> n,
        Pair a b -> a * b
    };
}

i32 rank(Light l) {
    return switch l {
        Red -> 1,
        Green -> 2,
        Blue -> 3
    };
}

i32 main() {
    Message a = Message::Empty();
    Message b = Message::Number(7);
    Message c = Message::Pair(3, 4);
    mut i32 total = describe(a) + describe(b) + describe(c);
    total = total + rank(Light::Blue()) + rank(Light::Red());
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(24));
    }

