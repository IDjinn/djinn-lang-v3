    TypeInfo* small = typeof(i32);
    TypeInfo* wide = typeof(i64);
    if (info.paramCount != 2 || info.returnTypeId != small.id || info.funcPtr == null) {
        return 1;
    }
    if (info.params[0].typeId != small.id || info.params[1].typeId != wide.id || info.params[1].name[0] != 114) {
        return 2;
    }
    if (info.attrs[0].value[0] != 53 || info.params[1].attrs[0].value[0] != 56 || info.params[0].attrCount != 0) {
        return 3;
    }
    MethodInfo* nothing = typeof(ping);
    MethodInfo* suspended = typeof(later);
    if (nothing.paramCount != 0 || (suspended.flags & 4) == 0 || (info.flags & 4) != 0) {
        return 4;
    }
    return 7;
}
