    [Test]
    void object_is() {
        str source = """
struct Point {
    i32 x;
    i32 y;
}

i32 classify(object value) {
    if (value is i64 big) {
        return (i32)big;
    }
    if (value is Point point) {
        return point.x * point.y;
    }
    if (value is i32 small) {
        return small + 1;
    }
    return 0;
}

i32 main() {
    Point point = { .x = 6, .y = 7 };
    object boxed = 5;
    mut i32 total = classify(40) + classify((i64)7) + classify(point) + classify(2.5);
    if (boxed is i32 five && !(boxed is i64)) {
        total = total + five;
    }
    return total;
}
""";
        Verify.source(source).runs(Expected.exit(95));
    }

    [Test]
    void operators() {
        str source = """
struct Vec2 {
    i32 x;
    i32 y;
}

impl Vec2 {
    operator +(Vec2 left, Vec2 right) -> Vec2 {
        return { .x = left.x + right.x, .y = left.y + right.y };
    }

    operator ==(Vec2 left, Vec2 right) -> bool {
        return left.x == right.x && left.y == right.y;
    }
}

struct Money {
    i32 cents;

    operator -(Money left, Money right) -> Money {
        return { .cents = left.cents - right.cents };
    }
}

i32 main() {
    Vec2 a = { .x = 1, .y = 2 };
    Vec2 b = { .x = 3, .y = 4 };
    Vec2 c = a + b;
    Money m = { .cents = 50 };
    Money n = { .cents = 8 };
    Money d = m - n;
    mut i32 total = c.x + c.y;
    if (a == b) {
        total = total + 100;
    }
    if (a != b) {
        total = total + 20;
    }
    if (c == b + a) {
        total = total + 2;
    }
    return total + d.cents;
}
""";
        Verify.source(source).runs(Expected.exit(74));
    }

    [Test]
    void operators_unary_index() {
        str source = """
struct Vec2 {
    i32 x;
    i32 y;
}

impl Vec2 {
    operator -(Vec2 value) -> Vec2 {
        return { .x = -value.x, .y = -value.y };
    }

    operator ~(Vec2 value) -> Vec2 {
        return { .x = value.y, .y = value.x };
    }

    operator !(Vec2 value) -> bool {
        return value.x == 0 && value.y == 0;
    }

    operator &&(Vec2 left, Vec2 right) -> bool {
        return left.x != 0 && right.x != 0;
    }

    operator ||(Vec2 left, Vec2 right) -> bool {
        return left.x != 0 || right.x != 0;
    }
}

struct Grid {
    i32 a;
    i32 b;
    i32 c;

    operator get[](Grid grid, i32 index) -> i32 {
        if (index == 0) {
            return grid.a;
        }
        if (index == 1) {
            return grid.b;
        }
        return grid.c;
    }

    operator set[](Grid* grid, i32 index, i32 value) -> void {
        if (index == 0) {
            grid.a = value;
        } else if (index == 1) {
            grid.b = value;
        } else {
            grid.c = value;
        }
    }
}

i32 main() {
    Vec2 a = { .x = 1, .y = 2 };
    Vec2 zero = { .x = 0, .y = 0 };
    Vec2 negated = -a;
    Vec2 swapped = ~a;
    mut i32 total = negated.x + negated.y + swapped.x * 10;
    if (!zero) {
        total = total + 100;
    }
    if (!a) {
        total = total + 1000;
    }
    if (a && swapped) {
        total = total + 5;
    }
    if (zero || a) {
        total = total + 3;
    }
    if (zero && a) {
        total = total + 1000;
    }
    mut Grid grid = { .a = 1, .b = 2, .c = 3 };
    grid[1] = 10;
    grid[2] = grid[0] + grid[1];
    return total + grid[1] + grid[2];
}
""";
        Verify.source(source).runs(Expected.exit(146));
    }

    [Test]
    void optional_niche() {
        str source = """
union optional<T> {
    Some(T),
    None()
}

struct Pair {
    i32 left;
    i32 right;
}

optional<Pair*> pick(Pair* pair, bool present) {
    if (present) {
        return optional<Pair*>::Some(pair);
    }
    return optional<Pair*>::None();
}

i32 total(optional<Pair*> maybe) {
    return switch maybe { Some p -> p.left + p.right, None -> 100 };
}

i32 main() {
    mut Pair pair = { .left = 3, .right = 4 };
    Pair* address = &pair;
    i32 present = total(pick(address, true));
    i32 absent = total(pick(address, false));
    optional<i32*> none_number = optional<i32*>::None();
    i32 empty = switch none_number { Some n -> 1, None -> 0 };
    i32 size = (i32)sizeof(optional<Pair*>);
    return present + absent + empty + size;
}
""";
        Verify.source(source).runs(Expected.exit(115));
    }

    [Test]
    void optional_sugar() {
        str source = """
union optional<T> {
    Some(T),
    None()
}

struct Pair {
    i32 left;
    i32 right;
}

Pair*? find(Pair* pair, bool present) {
    if (present) {
        return optional<Pair*>::Some(pair);
    }
    return optional<Pair*>::None();
}

i32? half(i32 value) {
    if (value % 2 == 0) {
        return optional<i32>::Some(value / 2);
    }
    return optional<i32>::None();
}

i32 main() {
    mut Pair pair = { .left = 3, .right = 4 };
    Pair* address = &pair;
    i32 a = switch find(address, true) { Some p -> p.left, None -> 0 };
    i32 b = switch find(address, false) { Some p -> 1, None -> 10 };
    i32 c = switch half(8) { Some v -> v, None -> 0 };
    i32 d = switch half(7) { Some v -> v, None -> 20 };
    return a + b + c + d + (i32)sizeof(Pair*?);
}
""";
        Verify.source(source).runs(Expected.exit(45));
    }

