namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct TestAttributeTests {
    [Test]
    [Requires(TestPath.JIT | TestPath.LINK)]
    void reads_attributes_from_the_method() {
        Verify.source("i32 main() { return 6; }").runs(Expected.exit(6));
    }

    [Test]
    void finds_positions() {
        Source* source = Sources.text("""
i32 main() {
    return null;
}
""");
        Verify.with_source(source).diagnostics(Expected.error(DiagnosticErrors.VALUE_TYPE_MISMATCH).at_position(source.find("null")));
    }

    [Test]
    void names_every_check() {
        Verify.source("i32 main() { return 1; }").runs(Expected.exit(1));
        Verify.source("i32 main() { return 2; }").runs(Expected.exit(2));
    }

    [Test]
    static void runs_static_methods() {
        Verify.source("i32 main() { return 0; }").compiles();
    }

    void skips_other_methods() {
        Verify.source("i32 main() { return 7; }").runs(Expected.exit(0));
    }

    [Test]
    void inline_source() {
        Verify.source("i32 main() { return 0; }").compiles();
    }

    [Test]
    void block_string() {
        str source = """
i32 main() {
    return 3;
}
""";
        Verify.source(source).runs(Expected.exit(3));
    }

    [Test]
    void many_diagnostics() {
        Source* source = Sources.text("""
i32 main() {
    mut i32 first = null;
    mut i32 second = null;
    return first + second;
}
""");
        Verify.with_source(source).diagnostics(
            Expected.error(DiagnosticErrors.VALUE_TYPE_MISMATCH).at_position(source.find("null")).with_message("does not match")
                .and_error(DiagnosticErrors.VALUE_TYPE_MISMATCH).at(3, 22));
    }

    [Test]
    void arguments() {
        Verify.source("i32 main() { return missing(); }").diagnostics(
            Expected.error(DiagnosticErrors.UNDECLARED_FUNCTION).at(1, 21).with_arguments("missing"));
    }

    [Test]
    void ranges() {
        Verify.source("i32 main() { return missing(); }").diagnostics(
            Expected.error(DiagnosticErrors.UNDECLARED_FUNCTION).at_range(1, 21, 1, 28));
    }

    [Test]
    void failure_output() {
        Verify.source("extern \"C\" { i32 printf(i8* format, ...); } i32 main() { printf(\"seen\"); return 1; }")
            .runs(Expected.failure().and_contains("seen"));
    }

    [Test]
    [Requires(TestPath.IR)]
    void requires_ir() {
        Verify.source("i32 main() { return 0; }").compiles();
    }

    [Test]
    void deduced_ir() {
        Verify.source("i32 helper() { return 0; }").diagnostics(Expected.error(DiagnosticErrors.MISSING_MAIN).at(1, 1));
    }

    [Test]
    [Requires(TestPath.JIT | TestPath.LINK)]
    void requires_jit_and_link() {
        Verify.source("i32 main() { return 4; }").runs(Expected.exit(4));
    }

    [Test]
    [Requires(TestPath.LINK)]
    void requires_link() {
        Verify.source("i32 main() { return 5; }").runs(Expected.exit(5));
    }

    [Test]
    void compiler_selftest() {
        Verify.selftest();
    }
}
