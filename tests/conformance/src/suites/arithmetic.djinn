namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct MathTests {
    [Test]
    void IntegerDivFunction() {
        str source = """
i32 div(i32 a, i32 b) {
    return a / b;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void IntegerDiv() {
        str source = """
i32 div(i32 a, i32 b) {
    return a / b;
}

i32 main() {
    return div(10, 2);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }

    [Test]
    void IntegerDivWithRemainder() {
        str source = """
i32 div(i32 a, i32 b) {
    return a / b;
}

i32 main() {
    return div(7, 2);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void Sqrt() {
        str source = """
extern "C" {
    f64 sqrt(f64 x);
}

i32 main() {
    f64 res = sqrt(16.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(4));
    }

    [Test]
    void SqrtFloat() {
        str source = """
extern "C" {
    f32 sqrtf(f32 x);
}

i32 main() {
    f32 res = sqrtf(25.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(5));
    }

    [Test]
    void Pow() {
        str source = """
extern "C" {
    f64 pow(f64 base, f64 exponent);
}

i32 main() {
    f64 res = pow(2.0, 3.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(8));
    }

    [Test]
    void Floor() {
        str source = """
extern "C" {
    f64 floor(f64 x);
}

i32 main() {
    f64 res = floor(3.7);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(3));
    }

    [Test]
    void Ceil() {
        str source = """
extern "C" {
    f64 ceil(f64 x);
}

i32 main() {
    f64 res = ceil(3.2);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(4));
    }

    [Test]
    void Round() {
        str source = """
extern "C" {
    f64 round(f64 x);
}

i32 main() {
    f64 res = round(3.5);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(4));
    }

    [Test]
    void Fabs() {
        str source = """
extern "C" {
    f64 fabs(f64 x);
}

i32 main() {
    f64 res = fabs(-42.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void Fmax() {
        str source = """
extern "C" {
    f64 fmax(f64 x, f64 y);
}

i32 main() {
    f64 res = fmax(10.0, 20.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(20));
    }

    [Test]
    void Fmin() {
        str source = """
extern "C" {
    f64 fmin(f64 x, f64 y);
}

i32 main() {
    f64 res = fmin(10.0, 5.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(5));
    }

    [Test]
    void Cbrt() {
        str source = """
extern "C" {
    f64 cbrt(f64 x);
}

i32 main() {
    f64 res = cbrt(27.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(3));
    }

    [Test]
    void Exp() {
        str source = """
extern "C" {
    f64 exp(f64 x);
    f64 floor(f64 x);
}

i32 main() {
    f64 e_squared = exp(2.0);
    return (i32)floor(e_squared);
}
""";
        Verify.source(source).runs(Expected.exit(7));
    }

    [Test]
    void Log() {
        str source = """
extern "C" {
    f64 log(f64 x);
    f64 exp(f64 x);
    f64 round(f64 x);
}

i32 main() {
    f64 e = exp(1.0);
    f64 ln_e = log(e);
    return (i32)round(ln_e);
}
""";
        Verify.source(source).runs(Expected.exit(1));
    }

    [Test]
    void Log10() {
        str source = """
extern "C" {
    f64 log10(f64 x);
}

i32 main() {
    f64 res = log10(1000.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(3));
    }

    [Test]
    void Log2() {
        str source = """
extern "C" {
    f64 log2(f64 x);
}

i32 main() {
    f64 res = log2(8.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(3));
    }

    [Test]
    void Fmod() {
        str source = """
extern "C" {
    f64 fmod(f64 x, f64 y);
}

i32 main() {
    f64 res = fmod(10.0, 3.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(1));
    }

    [Test]
    void Hypot() {
        str source = """
extern "C" {
    f64 hypot(f64 x, f64 y);
}

i32 main() {
    f64 res = hypot(3.0, 4.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(5));
    }

    [Test]
    void Trunc() {
        str source = """
extern "C" {
    f64 trunc(f64 x);
}

i32 main() {
    f64 res = trunc(7.9);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(7));
    }

    [Test]
    void Exp2() {
        str source = """
extern "C" {
    f64 exp2(f64 x);
}

i32 main() {
    f64 res = exp2(4.0);
    return (i32)res;
}
""";
        Verify.source(source).runs(Expected.exit(16));
    }

    [Test]
    void ImportMathSqrt() {
        str source = """
import std::math;

i32 main() {
    f64 res = sqrt(49.0);
    return (i32)res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void ImportMathPow() {
        str source = """
import std::math;

i32 main() {
    f64 res = pow(3.0, 2.0);
    return (i32)res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(9));
    }

    [Test]
    void ImportMathMultipleFunctions() {
        str source = """
import std::math;

i32 main() {
    f64 a = sqrt(16.0);
    f64 b = pow(2.0, 2.0);
    f64 c = fabs(-2.0);
    return (i32)(a + b + c);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void ImportMathFloatFunctions() {
        str source = """
import std::math;

i32 main() {
    f32 res = sqrtf(36.0);
    return (i32)res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void CombinedMathOperations() {
        str source = """
import std::math;

i32 main() {
    f64 x = 3.0;
    f64 y = 4.0;

    // Calculate hypotenuse using sqrt(x^2 + y^2)
    f64 h = sqrt(pow(x, 2.0) + pow(y, 2.0));
    return (i32)h;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }

    [Test]
    void IntegerMultFunction() {
        str source = """
i32 mult(i32 a, i32 b) {
    return a * b;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void IntegerMult() {
        str source = """
i32 mult(i32 a, i32 b) {
    return a * b;
}

i32 main() {
    return mult(2, 3);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void IntegerSubFunction() {
        str source = """
i32 sub(i32 a, i32 b) {
    return a - b;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void IntegerSub() {
        str source = """
i32 sub(i32 a, i32 b) {
    return a - b;
}

i32 main() {
    return sub(10, 3);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void IntegerSubNegative() {
        str source = """
i32 sub(i32 a, i32 b) {
    return a - b;
}

i32 main() {
    return sub(3, 10);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(-7));
    }

    [Test]
    void IntegerSumFunction() {
        str source = """
i32 sum(i32 a, i32 b) {
    return a + b;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void IntegerSum() {
        str source = """
i32 sum(i32 a, i32 b) {
    return a + b;
}

i32 main() {
    return sum(2, 3);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }
}

struct NumbersTests {
    [Test]
    void MultipleNumbersDeclaration() {
        str source = """
async i32 main() {
    i32 first = 69;
    i32 second = 420_000;
    i32 third = 800'000'000;
    f32 forth = 1e9;

    i32 hexa = 0x93fa34;
    i32 bin = 0b001010;
    return 0;
}
""";
        Verify.source(source).with_std().compiles();
    }
}

struct OverflowTests {
    [Test]
    void SuffixDeclarationsCompile() {
        str source = """
i32 main() throws {
    i32 common = 123;
    i32w wrapped = 121231234w;
    i32t trapped = 232134324t;
    i32c checked = 232343c;
    i32s saturation = 23498s;
    return 0;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void TrappedLiteralOutOfRangeIsCompileError() {
        str source = """
i32 main() {
    i32t a = 3000000000t;
    return a;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
    }

    [Test]
    void PostfixIncrementRespectsMode() {
        str source = """
i32 main() {
    mut i32s a = 2147483646s;
    a++;
    return a / 1000000000;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

    [Test]
    void HexDigitCIsNotASuffix() {
        str source = """
i32 main() {
    i32 c = 0x1c;
    return c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(28));
    }

    [Test]
    void BinaryLiteralSuffix() {
        str source = """
i32 main() {
    i32s b = 0b1010s;
    return b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void DivIntMinMinusOneTrappedAborts() {
        str source = """
i32 main() {
    i32t m = -2147483648t;
    i32t q = m / -1t;
    return q;
}
""";
        Verify.source(source).with_std().runs(Expected.failure());
    }

    [Test]
    void SaturatingRemIntMinIsZero() {
        str source = """
i32 main() {
    i32s m = -2147483648s;
    i32s r = m % -1s;
    return r + 5;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }

    [Test]
    void CheckedNoOverflowReturnsValue() {
        str source = """
i32 safeAdd(i32c a, i32c b) throws {
    return a + b;
}

i32 main() {
    i32 result = try safeAdd(1000c, 32c) ?: -1;
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1032));
    }

    [Test]
    void ModeIsNotTypeIdentity() {
        str source = """
i32 main() {
    i32s a = 100s;
    i32 b = a;
    i32w c = b;
    return c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(100));
    }

    [Test]
    void StructFieldWithMode() {
        str source = """
struct Packet {
    i32t checksum;
    i32s size;
}

i32 main() {
    Packet p = Packet { .checksum = 1000t, .size = 42s };
    return p.size;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }
}
