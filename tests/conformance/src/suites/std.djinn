namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct StdTests {
    [Test]
    void async_delay() {
        str source = """
import std::sys;
import std::types;
namespace app;

async i32 check_delay() {
    i64 start = __djinn_unix_timestamp_ms();
    await Task.delay(60);
    i64 elapsed = __djinn_unix_timestamp_ms() - start;
    if (elapsed < 55) { return 10; }
    return 0;
}

async i32 check_process() {
    void*? started = Process.start("clang --version", "", 0);
    return switch started {
        Value child -> await wait_child(child),
        Empty -> 20
    };
}

async i32 wait_child(void* child) {
    bool done = await Process.wait_async(child, 20000);
    if (!done) { return 21; }
    if (Process.exit_code(child) != 0) { return 22; }
    if (Process.stdout_length(child) == 0) { return 23; }
    return 0;
}

async i32 main() {
    i32 first = await check_delay();
    if (first != 0) { return first; }
    return await check_process();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void collections() {
        str source = """
import std::collections;
import std::types;
namespace app;

i32 main() {
    array<i32> list = array<i32>();
    for (mut i32 i = 0; i < 20; i = i + 1) {
        list.push(i);
    }
    list.set(3, 100);
    mut i32 total = list.get(3) + list.get(19);

    map<i32, i32> table = map<i32, i32>();
    for (mut i32 i = 0; i < 40; i = i + 1) {
        table.set(i, i * 2);
    }
    if (!table.has(7) || table.has(99)) { return 1; }
    total = total + table.get(7);
    table.remove(7);
    if (table.has(7)) { return 2; }

    range window = { .start = 0, .end = 10, .step = 2, .start_inclusive = true, .end_inclusive = false };
    total = total + window.length();
    list.destroy();
    table.destroy();
    return total - 100;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(38));
    }

