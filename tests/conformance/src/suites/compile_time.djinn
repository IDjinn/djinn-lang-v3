namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct AttributesTests {
    [Test]
    void ParameterizedAttributeParses() {
        str source = """
[Align(16)]
struct Vec4 {
    f32 x;
    f32 y;
    f32 z;
    f32 w;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void NamedParameterAttributeParses() {
        str source = """
[Deprecated(message = "use v2")]
struct OldApi {
    public static i32 call() {
        return 0;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void ErrorOnUnknownAttribute() {
        str source = """
struct Util {
    [InvalidAttribute]
    public static i32 rare_path() {
        return -1;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.UNKNOWN_ATTRIBUTE));
    }

    [Test]
    void ErrorOnUnknownStructAttribute() {
        str source = """
[NotARealAttribute]
struct Foo {
    i32 x;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.UNKNOWN_ATTRIBUTE));
    }

    [Test]
    void WarningWhenFunctionAttributeOnStruct() {
        str source = """
[ForceInline]
struct Foo {
    i32 x;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.warning(DiagnosticWarnings.INVALID_ATTRIBUTE_TARGET));
    }

    [Test]
    void NoWarningWhenAttributeOnValidTarget() {
        str source = """
struct Foo {
    [ForceInline]
    public static i32 bar() {
        return 42;
    }
}

i32 main() {
    return Foo.bar();
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void DeprecatedValidOnAnyTarget() {
        str source = """
[Deprecated(message = "use NewFoo")]
struct Foo {
    [Deprecated(message = "use bar2")]
    public static i32 bar() {
        return 0;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().compiles();
    }
}

struct ConstExprTests {
    [Test]
    void SimpleConstExprVariable() {
        str source = """
constexpr i32 VALUE = 42;

i32 main() {
    return VALUE;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ConstExprDependingOnLaterDeclaration() {
        str source = """
constexpr i32 A = B + 1;
constexpr i32 B = C * 2;
constexpr i32 C = 20;

i32 main() {
    return A;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(41));
    }

    [Test]
    void ConstExprWithArithmetic() {
        str source = """
constexpr i32 A = 10;
constexpr i32 B = 20 + 5;

i32 main() {
    return A + B;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(35));
    }

    [Test]
    void ConstExprMultiplication() {
        str source = """
constexpr i32 WIDTH = 80;
constexpr i32 HEIGHT = 24;
constexpr i32 AREA = 80 * 24;

i32 main() {
    return AREA / 10;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(192));
    }

    [Test]
    void ConstExprNegative() {
        str source = """
constexpr i32 NEG = -42;

i32 main() {
    return 0 - NEG;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ConstExprUsedInArraySize() {
        str source = """
constexpr i32 SIZE = 64;

i32 main() {
    i8* buf = i8[SIZE];
    buf[0] = 99;
    return (i32)buf[0];
}
""";
        Verify.source(source).with_std().runs(Expected.exit(99));
    }

    [Test]
    void ConstFieldUsedInExpression() {
        str source = """
struct Config {
    const i32 MAX = 100;
    const i32 MIN = 1;
}

i32 main() {
    return Config.MAX - Config.MIN;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(99));
    }

    [Test]
    void ConstFieldWithArithmetic() {
        str source = """
struct Settings {
    const i32 WIDTH = 80;
    const i32 HEIGHT = 24;
    const i32 AREA = 80 * 24;
}

i32 main() {
    return Settings.AREA / 10;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(192));
    }

    [Test]
    void ConstExprFunctionCompiles() {
        str source = """
constexpr i32 add(i32 a, i32 b) {
    return a + b;
}

i32 main() {
    auto test = add(1, 2);
    return test;
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void ConstExprFunctionResult() {
        str source = """
constexpr i32 double_it(i32 x) {
    return x * 2;
}

i32 main() {
    return double_it(21);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void LocalConstExprVariable() {
        str source = """
i32 main() {
    constexpr i32 x = 10 + 32;
    return x;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void LocalConstevalVariable() {
        str source = """
i32 main() {
    consteval i32 x = 7 * 6;
    return x;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void LocalConstExprUsedInExpression() {
        str source = """
i32 main() {
    constexpr i32 a = 10;
    constexpr i32 b = 20;
    return a + b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(30));
    }

    [Test]
    void LocalConstExprInArraySize() {
        str source = """
i32 main() {
    constexpr i32 SIZE = 32;
    i8* buf = i8[SIZE];
    buf[0] = 77;
    return (i32)buf[0];
}
""";
        Verify.source(source).with_std().runs(Expected.exit(77));
    }

    [Test]
    void GlobalConstevalVariable() {
        str source = """
consteval i32 MAGIC = 2 + 5;

i32 main() {
    return MAGIC;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void InvalidConstExprAndAsyncModifier() {
        str source = """
constexpr async i32 add(i32 a, i32 b) {
    return a + b;
}

i32 main() {
    auto test = add(1, 2);
    return test;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.UNEXPECTED_TOKEN));
    }
}

struct CompileTimeIfTests {
    [Test]
    void TrueBranch() {
        str source = """
consteval i32 ENABLED = 1;

i32 main() {
    if ENABLED {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void FalseBranch() {
        str source = """
consteval i32 DISABLED = 0;

i32 main() {
    if DISABLED {
        return 1;
    }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void FalseBranchWithElse() {
        str source = """
consteval i32 DISABLED = 0;

i32 main() {
    if DISABLED {
        return 1;
    } else {
        return 42;
    }
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void TrueBranchWithElse() {
        str source = """
consteval i32 ENABLED = 1;

i32 main() {
    if ENABLED {
        return 42;
    } else {
        return 0;
    }
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void BinaryExpression() {
        str source = """
consteval i32 PLATFORM = 2;

i32 main() {
    if PLATFORM == 2 {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void CompoundExpression() {
        str source = """
consteval i32 A = 1;
consteval i32 B = 1;

i32 main() {
    if A && B {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ElseIfChain() {
        str source = """
consteval i32 MODE = 2;

i32 main() {
    if MODE == 1 {
        return 1;
    } else if MODE == 2 {
        return 42;
    } else {
        return 0;
    }
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void WarningOnConstExprInRuntimeIf() {
        str source = """
consteval i32 FLAG = 1;

i32 main() {
    if (FLAG) {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void NoWarningOnRuntimeVariable() {
        str source = """
i32 main() {
    i32 x = 1;
    if (x) {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ErrorOnNonConstExprWithoutParens() {
        str source = """
i32 main() {
    i32 x = 1;
    if x {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
    }

    [Test]
    void LiteralCondition() {
        str source = """
i32 main() {
    if 1 {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void DeadCodeEliminated() {
        str source = """
consteval i32 DEBUG = 0;

i32 main() {
    i32 mut result = 10;
    if DEBUG {
        result = 999;
    }
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void ExplicitConstexprKeyword() {
        str source = """
consteval i32 ENABLED = 1;

i32 main() {
    if constexpr ENABLED {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ExplicitConstevalKeyword() {
        str source = """
consteval i32 ENABLED = 1;

i32 main() {
    if consteval ENABLED {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ConstevalErrorOnRuntimeExpr() {
        str source = """
i32 main() {
    i32 x = 1;
    if consteval x {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
    }

    [Test]
    void ExplicitConstexprWithElseIf() {
        str source = """
consteval i32 MODE = 3;

i32 main() {
    if constexpr MODE == 1 {
        return 1;
    } else if constexpr MODE == 2 {
        return 2;
    } else if constexpr MODE == 3 {
        return 42;
    } else {
        return 0;
    }
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void NoWarningOnMixedExpr() {
        str source = """
consteval i32 FLAG = 1;

i32 main() {
    i32 x = 5;
    if (FLAG && x > 3) {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }
}

struct IntrinsicTests {
    [Test]
    void ConstexprStructFieldAccess() {
        str source = """
constexpr struct Config {
    const i32 VERSION = 42;
}

i32 main() {
    return Config.VERSION;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ConstexprStructAllFieldsAreConst() {
        str source = """
constexpr struct Limits {
    const i32 MIN = 1;
    const i32 MAX = 100;
}

i32 main() {
    return Limits.MAX - Limits.MIN;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(99));
    }
}

struct IntrinsicsTests {
    [Test]
    void Likely() {
        str source = """
i32 main() {
    i32 x = 1;
    if (likely(x == 1)) {
        return 42;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void Unlikely() {
        str source = """
i32 main() {
    i32 x = 0;
    if (unlikely(x == 1)) {
        return 0;
    }
    return 99;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(99));
    }
}

struct MacroTests {
    [Test]
    void SimpleExprMacro() {
        str source = """
macro double_it {
    (expression x) => {
        x + x
    }
}

i32 main() {
    return double_it(21);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.warning(DiagnosticWarnings.MACRO_SIDE_EFFECT));
    }

    [Test]
    void MultipleParameters() {
        str source = """
macro add {
    (expression a, expression b) => {
        a + b
    }
}

i32 main() {
    return add(10, 32);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void PrecedencePreserved() {
        str source = """
macro mul {
    (expression a, expression b) => {
        a * b
    }
}

i32 main() {
    return mul(2 + 3, 4 + 1);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void LocalAvoidsDoubleEvaluation() {
        str source = """
macro square {
    (local expression v) => {
        v * v
    }
}

unsafe static mut i32 counter = 0;

i32 next() {
    counter = counter + 1;
    return counter;
}

i32 main() {
    i32 result = square(next());
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void WithoutLocalCausesDoubleEvaluation() {
        str source = """
macro square_no_local {
    (expression v) => {
        v * v
    }
}

unsafe static mut i32 counter = 0;

i32 next() {
    counter = counter + 1;
    return counter;
}

i32 main() {
    i32 result = square_no_local(next());
    return result;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.warning(DiagnosticWarnings.MACRO_SIDE_EFFECT));
    }

    [Test]
    void LocalWithArithmeticExpression() {
        str source = """
macro square {
    (local expression v) => {
        v * v
    }
}

i32 main() {
    i32 x = 5;
    return square(x + 2);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(49));
    }

    [Test]
    void MixedLocalAndNonLocal() {
        str source = """
macro add_squared {
    (local expression a, expression b) => {
        a * a + b
    }
}

i32 main() {
    return add_squared(3, 10);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(19));
    }

    [Test]
    void NestedMacroCall() {
        str source = """
macro square {
    (local expression v) => {
        v * v
    }
}

macro add {
    (expression a, expression b) => {
        a + b
    }
}

i32 main() {
    return add(square(3), square(4));
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void WarnOnPossibleSideEffect() {
        str source = """
macro bad_square {
    (expression v) => {
        v * v
    }
}

i32 main() {
    return bad_square(5);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void NoWarnWhenLocalUsed() {
        str source = """
macro good_square {
    (local expression v) => {
        v * v
    }
}

i32 main() {
    return good_square(5);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void NoWarnWhenSingleUse() {
        str source = """
macro identity {
    (expression v) => {
        v
    }
}

i32 main() {
    return identity(42);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void MacroStoredInProgram() {
        str source = """
macro my_macro {
    (expression x) => {
        x
    }
}

i32 main() {
    return my_macro(10);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void MultiRuleByArity() {
        str source = """
macro op {
    (local expression v, expression multiplier) => { v * multiplier }
    (local expression v) => { v * 2 }
}

i32 main() {
    i32 a = op(5, 3);
    i32 b = op(5);
    return a + b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void AmbiguousRulesError() {
        str source = """
macro pick {
    (expression a, expression b) => { a }
    (expression a, expression b) => { b }
}

i32 main() {
    return pick(10, 99);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.MACRO));
    }

    [Test]
    void MultiRuleNoMatch() {
        str source = """
macro single {
    (expression a) => { a }
}

i32 main() {
    return single(1, 2, 3);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.MACRO));
    }

    [Test]
    void LiteralTokenMatching() {
        str source = """
macro op {
    (add, expression a, expression b) => { a + b }
    (mul, expression a, expression b) => { a * b }
}

i32 main() {
    i32 x = op(add, 10, 5);
    i32 y = op(mul, 3, 7);
    return x + y;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(36));
    }

    [Test]
    void LiteralTokenNoMatch() {
        str source = """
macro op {
    (add, expression a, expression b) => { a + b }
}

i32 main() {
    return op(sub, 10, 5);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.MACRO));
    }

    [Test]
    void IdentifierFragment() {
        str source = """
macro get_val {
    (identifier name) => { name }
}

static i32 x_val = 42;

i32 main() {
    return get_val(x_val);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void LiteralTokenWithMultiRule() {
        str source = """
macro calc {
    (double, local expression v) => { v + v }
    (square, local expression v) => { v * v }
    (expression v) => { v }
}

i32 main() {
    i32 a = calc(double, 5);
    i32 b = calc(square, 4);
    i32 c = calc(7);
    return a + b + c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(33));
    }

    [Test]
    void RuleLevelLocal() {
        str source = """
macro sum_squares {
    local (expression a, expression b) => { a * a + b * b }
}

unsafe static mut i32 counter = 0;

i32 next() {
    counter = counter + 1;
    return counter;
}

i32 main() {
    i32 result = sum_squares(next(), next());
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }

    [Test]
    void LogWithLiteralTokenLevels() {
        str source = """
macro log {
    (debug, expression msg) => { do_log(msg) }
    (info, expression msg)  => { do_log(msg) }
    (off, expression msg)   => void
}

unsafe static mut i32 log_count = 0;

void do_log(i32 x) {
    log_count = log_count + x;
}

i32 main() {
    log(debug, 10);
    log(info, 20);
    log(off, 99);
    return log_count;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(30));
    }

    [Test]
    void LogLiteralTokenNoMatchLevel() {
        str source = """
macro log {
    (debug, expression msg) => { msg }
    (info, expression msg)  => { msg }
}

i32 main() {
    return log(warn, 42);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.MACRO));
    }

    [Test]
    void LogMultiRuleWithIdentifier() {
        str source = """
macro get_level {
    (debug) => { debug_val }
    (info)  => { info_val }
}

static i32 debug_val = 1;
static i32 info_val = 2;

i32 main() {
    i32 a = get_level(debug);
    i32 b = get_level(info);
    return a + b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void LiteralTokenWithIdentifierAndExpression() {
        str source = """
macro dispatch {
    (get, identifier name) => { name }
    (set, identifier name, expression val) => { name = val }
    (add, expression a, expression b) => { a + b }
}

static i32 x = 10;
unsafe static mut i32 y = 20;

i32 main() {
    i32 a = dispatch(get, x);
    dispatch(set, y, 99);
    i32 b = dispatch(add, a, y);
    return b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(109));
    }

    [Test]
    void LiteralTokenPatternMatchingComplex() {
        str source = """
macro math {
    (double, local expression v) => { v + v }
    (square, local expression v) => { v * v }
    (negate, expression v) => { 0 - v }
    (identity, expression v) => { v }
}

i32 main() {
    i32 a = math(double, 7);
    i32 b = math(square, 5);
    i32 c = math(negate, 3);
    i32 d = math(identity, 42);
    return a + b + c + d;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(78));
    }

    [Test]
    void LogPatternLikeRust() {
        str source = """
macro log {
    (debug, expression msg) => { trace(msg) }
    (info, expression msg)  => { trace(msg) }
    (off, expression msg)   => void
}

unsafe static mut i32 call_count = 0;

void trace(i32 val) {
    call_count = call_count + val;
}

i32 main() {
    log(debug, 1);
    log(info, 2);
    log(off, 100);
    log(debug, 4);
    log(off, 200);
    log(info, 8);
    return call_count;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(15));
    }

    [Test]
    void ConditionalCodegenViaLiteralToken() {
        str source = """
macro feature {
    (enabled, expression code) => { code }
    (disabled, expression code) => void
}

i32 main() {
    i32 a = feature(enabled, 42);
    i32 b = feature(disabled, 99);
    i32 c = feature(enabled, 8);
    return a + b + c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(50));
    }

    [Test]
    void LiteralFragment() {
        str source = """
macro double_lit {
    (literal val) => { val + val }
}

i32 main() {
    return double_lit(21);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void LiteralFragmentRejectsExpression() {
        str source = """
macro lit_only {
    (literal val) => { val }
}

i32 main() {
    i32 x = 5;
    return lit_only(x);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.MACRO));
    }

    [Test]
    void TypeFragment() {
        str source = """
macro default_val {
    (type T) => { 123 }
}

i32 main() {
    return default_val(i32);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(123));
    }

    [Test]
    void LiteralTokenWithLiteralFragment() {
        str source = """
macro config {
    (max_size) => { 1024 }
    (min_size) => { 64 }
    (literal fallback) => { fallback }
}

i32 main() {
    i32 a = config(max_size);
    i32 b = config(min_size);
    i32 c = config(42);
    return a + b + c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1130));
    }
}

struct StaticVarTests {
    [Test]
    void SimpleImmutable() {
        str source = """
static i32 value = 42;

i32 main() {
    return value;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void Mutable() {
        str source = """
unsafe static mut i32 counter = 0;

void increment() {
    counter = counter + 1;
}

i32 main() {
    increment();
    increment();
    increment();
    return counter;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void MultipleGlobals() {
        str source = """
static i32 a = 10;
static i32 b = 20;
static i32 c = 12;

i32 main() {
    return a + b + c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void MutableWithFunctions() {
        str source = """
unsafe static mut i32 state = 0;

void set_state(i32 val) {
    state = val;
}

i32 get_state() {
    return state;
}

i32 main() {
    set_state(42);
    return get_state();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void UsedInExpressions() {
        str source = """
static i32 base = 10;
static i32 multiplier = 4;

i32 compute() {
    return base * multiplier + 2;
}

i32 main() {
    return compute();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void MutableAccumulator() {
        str source = """
unsafe static mut i32 total = 0;

void add(i32 x) {
    total = total + x;
}

i32 main() {
    add(10);
    add(20);
    add(12);
    return total;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void MutableRequiresUnsafe() {
        str source = """
static mut i32 counter = 0;

i32 main() {
    return counter;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.UNEXPECTED_TOKEN));
    }

    [Test]
    void UnsafeRequiresMutable() {
        str source = """
unsafe static i32 counter = 0;

i32 main() {
    return counter;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.UNEXPECTED_TOKEN));
    }
}
