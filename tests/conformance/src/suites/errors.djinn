    [Test]
    void narrow_return() {
        str source = """
i32 main() {
    i64 value = 1;
    return value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(3, 12));
    }

    [Test]
    void narrow_assignment() {
        str source = """
i32 main() {
    i64 value = 1;
    mut i32 result = 0;
    result = value;
    return result;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(4, 14));
    }

    [Test]
    void narrow_compound_assignment() {
        str source = """
i32 main() {
    i64 value = 1;
    mut i32 result = 0;
    result += value;
    return result;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(4, 12));
    }

    [Test]
    void narrow_field() {
        str source = """
struct Holder {
    i32 value;
}

i32 main() {
    i64 wide = 1;
    Holder holder = { .value = wide };
    return holder.value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(7, 32));
    }

    [Test]
    void mixed_sign_operands() {
        str source = """
i32 main() {
    i32 left = 1;
    u32 right = 1;
    u32 result = (u32)(left + right);
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(4, 29));
    }

    [Test]
    void mixed_sign_comparison() {
        str source = """
i32 main() {
    i32 left = 1;
    u32 right = 1;
    if (left < right) { return 1; }
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(4, 14));
    }

    [Test]
    void integer_and_float_operands() {
        str source = """
i32 main() {
    i32 left = 1;
    f64 right = 1.5;
    f64 result = left + right;
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(4, 23));
    }

    [Test]
    void constant_division_by_zero() {
        str source = """
i32 main() {
    i32 value = 10;
    return value / 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(3, 20));
    }

    [Test]
    void constant_remainder_by_zero() {
        str source = """
i32 main() {
    i32 value = 10;
    return value % (1 - 1);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(3, 23));
    }

    [Test]
    void constant_shift_too_far() {
        str source = """
i32 main() {
    i32 value = 1;
    return value << 32;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(3, 21));
    }

    [Test]
    void constant_shift_negative() {
        str source = """
i32 main() {
    i32 value = 1;
    return value >> (0 - 1);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(3, 24));
    }

    [Test]
    void constant_division_overflow() {
        str source = """
i32 main() {
    return (0 - 2147483647 - 1) / (0 - 1);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 33));
    }

    [Test]
    void constant_float_out_of_range() {
        str source = """
i32 main() {
    return (i32)1.0e30;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 12));
    }

    [Test]
    void constexpr_division_overflow() {
        str source = """
constexpr i32 VALUE = (0 - 2147483647 - 1) / (0 - 1);

i32 main() {
    return VALUE;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 44));
    }

    [Test]
    void constexpr_float_out_of_range() {
        str source = """
constexpr i32 VALUE = (i32)1.0e30;

i32 main() {
    return VALUE;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 23));
    }

    [Test]
    void literal_out_of_range() {
        str source = """
i32 main() {
    u8 value = 300;
    return (i32)value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 16));
    }

    [Test]
    void cast_literal_out_of_range() {
        str source = """
i32 main() {
    return (i32)(u8)300;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 21));
    }

    [Test]
    void negative_literal_into_unsigned() {
        str source = """
i32 main() {
    u8 value = -1;
    return (i32)value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 17));
    }

    [Test]
    void literal_above_signed_maximum() {
        str source = """
i32 main() {
    i8 value = 128;
    return (i32)value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 16));
    }

    [Test]
    void literal_below_signed_minimum() {
        str source = """
i32 main() {
    i8 value = -129;
    return (i32)value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 17));
    }

    [Test]
    void literal_argument_out_of_range() {
        str source = """
i32 same(u8 value) {
    return (i32)value;
}

i32 main() {
    return same(256);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(6, 17));
    }

    [Test]
    void literal_operand_out_of_range() {
        str source = """
i32 main() {
    u8 value = 1;
    if (value == 300) { return 1; }
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(3, 18));
    }

    [Test]
    void constant_cast_out_of_range() {
        str source = """
constexpr i32 LIMIT = 300;

i32 main() {
    return (i32)(u8)LIMIT;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(4, 17));
    }

    [Test]
    void negative_constant_cast_to_unsigned() {
        str source = """
constexpr i32 LIMIT = -1;

i32 main() {
    return (i32)(u8)LIMIT;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(4, 17));
    }
}
