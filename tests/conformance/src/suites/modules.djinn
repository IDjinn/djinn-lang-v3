namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct ExternTests {
    [Test]
    void PrintfHelloWorld() {
        str source = """
extern i32 printf(i8* format, ...);

void main() {
    printf("Hello from extern!\n");
}
""";
        Verify.source(source).compiles();
    }

    [Test]
    void BlockSyntax() {
        str source = """
extern "C" {
    i32 printf(i8* format, ...);
    i32 puts(i8* s);
}

void main() {
    printf("Hello %s!\n", "World");
    puts("From extern block");
}
""";
        Verify.source(source).compiles();
    }

    [Test]
    void MultipleExternBlocks() {
        str source = """
extern i32 printf(i8* format, ...);

extern "C" {
    i32 puts(i8* s);
}

void main() {
    printf("Test 1\n");
    puts("Test 2");
}
""";
        Verify.source(source).compiles();
    }
}

struct ImportTests {
    [Test]
    void BasicImport() {
        str source = """
import math;

namespace math {
    i32 add(i32 a, i32 b) {
        return a + b;
    }
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void QualifiedImport() {
        str source = """
import std::io;

namespace std {
    namespace io {
        i32 dummy() {
            return 0;
        }
    }
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void MultipleImports() {
        str source = """
import math;
import utils;

namespace math {
    i32 add(i32 a, i32 b) {
        return a + b;
    }
}

namespace utils {
    i32 identity(i32 x) {
        return x;
    }
}
""";
        Verify.source(source).with_std().compiles();
    }

    [Test]
    void ImportParsesQualifiedName() {
        str source = """
import a::b::c;
""";
        Verify.source(source).with_std().compiles();
    }
}

struct NamespaceTests {
    [Test]
    void BasicDefinition() {
        str source = """
namespace math {
    i32 add(i32 a, i32 b) {
        return a + b;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void StructInNamespace() {
        str source = """
namespace geom {
    struct Point {
        i32 x;
        i32 y;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void NestedNamespace() {
        str source = """
namespace std {
    namespace io {
        i32 dummy() {
            return 42;
        }
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void MultipleFunctionsInNamespace() {
        str source = """
namespace math {
    i32 add(i32 a, i32 b) {
        return a + b;
    }

    i32 sub(i32 a, i32 b) {
        return a - b;
    }

    i32 mul(i32 a, i32 b) {
        return a * b;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void StructAndFunctionInNamespace() {
        str source = """
namespace geom {
    struct Vector {
        f32 x;
        f32 y;
    }

    f32 length() {
        return 0;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void FileScopedNamespace() {
        str source = """
namespace myapp;

i32 helper() {
    return 42;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void FileScopedQualifiedNamespace() {
        str source = """
namespace myapp::utils;

i32 helper() {
    return 42;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void NoNamespaceIsGlobal() {
        str source = """
i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }
}
