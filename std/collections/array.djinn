import std::types;
import std::libc;
import std::debug;
import std::types::constraints;

namespace std::collections;

struct array<T> : Hashable
where T : Hashable {
    T* data;
    size length;
    size capacity;

    array() {
        this.data = malloc(0);
        this.length = 0u;
        this.capacity = 0u;
    }

    public u64 hash() {
        mut u64 result = 1;
        for (mut size i = 0; i < this.length; i = i + 1) {
            u64 item_hash = this.data[i].hash();
            result = 31 * result + (u32)(item_hash ^ (item_hash >> 32));
        }
        return result;
    }

    public void push(T value) {
        if (this.length == this.capacity) {
            this.grow();
        }
        this.data[this.length] = value;
        this.length = this.length + 1u;
    }

    public T get(size index) {
        Debug.assert(index < this.length || index < 0, "array::get - index out of bounds");
        return this.data[index];
    }

    public void set(size index, T value) {
        Debug.assert(index < this.length || index < 0, "array::set - index out of bounds");
        this.data[index] = value;
    }

    public size length() {
        return this.length;
    }

    private void grow() {
        this.reserve(this.capacity * 2u);
    }

    public void reserve(size capacity) {
        this.capacity = capacity;
        this.data = realloc(this.data, this.capacity * sizeof(T));
    }

    public void destroy() {
        free(this.data);
    }

    operator ==(array<T> left, array<T> right) -> bool {
        return left.hash() == right.hash();
    }
}