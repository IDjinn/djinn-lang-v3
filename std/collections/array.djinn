import std::types;
import std::libc;
namespace std::collections;

struct array<T> {
    T* data;
    size length;
    size capacity;

    array() {
        this.data = malloc(0);
        this.length = 0u;
        this.capacity = 0u;
    }

    public void push(T value) {
        if (this.length == this.capacity) {
            printf("this.length == this.capacity, %d\n", this.length);
            this.grow();
        }
        this.data[this.length] = value;
        this.length = this.length + 1u;
    }

    public T get(size index) {
        return this.data[index];
    }

    public void set(size index, T value) {
        this.data[index] = value;
    }

    public size len() {
        return this.length;
    }

    public void grow() {
        mut size new_cap = 4u;
        if (this.capacity > 0u) {
            new_cap = this.capacity * 2u;
        }
        this.data = realloc(this.data, new_cap * sizeof(T));
        printf("called grow! capacity is %d, new %d\n", this.capacity, new_cap);
        this.capacity = new_cap;
    }

    public void destroy() {
        free(this.data);
    }
}
