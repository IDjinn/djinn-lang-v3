import std::types;
import std::libc;
import std::debug;
import std::types::constraints;

namespace std::collections;

struct array<T> : Hashable {
    T* data;
    size length;
    size capacity;

    array() {
        this.data = malloc(0);
        this.length = 0u;
        this.capacity = 0u;
    }

    public void push(T value) {
        if (this.length == this.capacity) {
            this.grow();
        }
        this.data[this.length] = value;
        this.length = this.length + 1u;
    }

    public T get(size index) {
        Debug.assert(index < this.length, "array::get - index out of bounds");
        return this.data[index];
    }

    public void set(size index, T value) {
        Debug.assert(index < this.length, "array::set - index out of bounds");
        this.data[index] = value;
    }

    public size length() {
        return this.length;
    }

    public void grow() {
        this.capacity = this.capacity * 2u;
        this.data = realloc(this.data, this.capacity * sizeof(T));
    }

    public i32 hash() {
        mut i32 hash_result = 1;
        for (mut size i = 0u; i < this.length; i = i + 1u) {
          hash_result = 31 * hash_result + this.data[i].hash(); // TODO: THIS DOES NOT SUPPORT GENERIC TYPES!
        }
        return hash_result;
    }

    public void destroy() {
        free(this.data);
    }
}
