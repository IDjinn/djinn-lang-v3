namespace std::debug;

struct Debug {
    public static void pause() {
        debugtrap();
    }

    public static void assert(bool condition, i8* message, i8* file, i32 line) {
        if (condition) {
            return;
        }

        printf("assertion failed: %s\n  at %s:%d\n", message, file, line);
        debugtrap();
    }
}
