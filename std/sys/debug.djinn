import std::sys;

namespace std::debug;

struct Debug {
    public static void pause() {
        debugtrap();
    }

    [ForceInline]
    public static void assert(bool condition, i8* message, [Location] Location sourceLocation) {
          if (unlikely(condition == false)) {
              Debug.assert_fail(message, sourceLocation);
          }
          assume(condition);
    }

    [Cold]
    [NoInline]
    [NoReturn]
    private static void assert_fail(i8* message, Location sourceLocation) {
      printf("assertion failed: %s\n  at %s:%d:%d\n", message, sourceLocation.fileName, sourceLocation.line, sourceLocation.column);
      debugtrap();
      unreachable();
    }
}
