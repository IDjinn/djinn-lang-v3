import std::types;

namespace std::sys;

extern "C" {
    i32 __djinn_terminal_width();
    i32 __djinn_terminal_height();
    void __djinn_raw_enable();
    void __djinn_raw_disable();
    i32 __djinn_read_key();
    i32 __djinn_read_line(i8* buf, i32 maxLen);
    i32 __djinn_console_open_line(i32 set);
}

struct Spectre {
    const i32 RESET = 0;
    const i32 BOLD = 1;
    const i32 DIM = 2;
    const i32 ITALIC = 3;
    const i32 UNDERLINE = 4;
    const i32 BLINK = 5;
    const i32 STRIKETHROUGH = 9;

    const i32 FG_BLACK = 30;
    const i32 FG_RED = 31;
    const i32 FG_GREEN = 32;
    const i32 FG_YELLOW = 33;
    const i32 FG_BLUE = 34;
    const i32 FG_MAGENTA = 35;
    const i32 FG_CYAN = 36;
    const i32 FG_WHITE = 37;

    const i32 BG_BLACK = 40;
    const i32 BG_RED = 41;
    const i32 BG_GREEN = 42;
    const i32 BG_YELLOW = 43;
    const i32 BG_BLUE = 44;
    const i32 BG_MAGENTA = 45;
    const i32 BG_CYAN = 46;
    const i32 BG_WHITE = 47;

    const i32 bufSize = 4096;

    public static i32 width() {
        return __djinn_terminal_width();
    }

    public static i32 height() {
        return __djinn_terminal_height();
    }

    public static void rawEnable() {
        __djinn_raw_enable();
    }

    public static void rawDisable() {
        __djinn_raw_disable();
    }

    public static i32 readKey() {
        return __djinn_read_key();
    }

    private static i32 escStart(i8* buf, i32 pos) {
        buf[pos] = 27;
        buf[pos + 1] = 91;
        return pos + 2;
    }

    private static i32 writeCode(i8* buf, i32 pos, i32 code) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        i32 len = snprintf(buf + p, 16, "%d", code);
        p = p + len;
        buf[p] = 109;
        return p + 1;
    }

    private static i32 writeReset(i8* buf, i32 pos) {
        return Spectre.writeCode(buf, pos, 0);
    }

    private static i32 writeCodes2(i8* buf, i32 pos, i32 c1, i32 c2) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        i32 len = snprintf(buf + p, 16, "%d;%d", c1, c2);
        p = p + len;
        buf[p] = 109;
        return p + 1;
    }

    private static i32 writeText(i8* buf, i32 pos, i8* text) {
        i32 len = strlen(text);
        memcpy(buf + pos, text, len);
        return pos + len;
    }

    public static void styled(i8* text, i32 style) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeCode(buf, pos, style);
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
    }

    public static void styled2(i8* text, i32 s1, i32 s2) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeCodes2(buf, pos, s1, s2);
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
    }

    public static void styledLn(i8* text, i32 style) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeCode(buf, pos, style);
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void styled2Ln(i8* text, i32 s1, i32 s2) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeCodes2(buf, pos, s1, s2);
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void color256(i8* text, i32 color) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.escStart(buf, pos);
        i32 len = snprintf(buf + pos, 16, "38;5;%d", color);
        pos = pos + len;
        buf[pos] = 109;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
    }

    public static void color256bg(i8* text, i32 color) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.escStart(buf, pos);
        i32 len = snprintf(buf + pos, 16, "48;5;%d", color);
        pos = pos + len;
        buf[pos] = 109;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
    }

    public static void rgb(i8* text, i32 r, i32 g, i32 b) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.escStart(buf, pos);
        i32 len = snprintf(buf + pos, 24, "38;2;%d;%d;%d", r, g, b);
        pos = pos + len;
        buf[pos] = 109;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
    }

    public static void rgbBg(i8* text, i32 r, i32 g, i32 b) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.escStart(buf, pos);
        i32 len = snprintf(buf + pos, 24, "48;2;%d;%d;%d", r, g, b);
        pos = pos + len;
        buf[pos] = 109;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, text);
        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
    }

    public static void reset() {
        i8* buf = i8[8];
        i32 pos = Spectre.writeReset(buf, 0);
        write(1, buf, pos);
    }

    private static bool tagMatch(i8* tag, i32 tagLen, i8* keyword) {
        i32 kwLen = strlen(keyword);
        if (tagLen != kwLen) { return false; }
        mut i32 i = 0;
        while (i < tagLen) {
            if (tag[i] != keyword[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    private static i32 tagToCode(i8* tag, i32 tagLen) {
        if (Spectre.tagMatch(tag, tagLen, "bold")) { return 1; }
        if (Spectre.tagMatch(tag, tagLen, "dim")) { return 2; }
        if (Spectre.tagMatch(tag, tagLen, "italic")) { return 3; }
        if (Spectre.tagMatch(tag, tagLen, "underline")) { return 4; }
        if (Spectre.tagMatch(tag, tagLen, "blink")) { return 5; }
        if (Spectre.tagMatch(tag, tagLen, "strikethrough")) { return 9; }
        if (Spectre.tagMatch(tag, tagLen, "black")) { return 30; }
        if (Spectre.tagMatch(tag, tagLen, "red")) { return 31; }
        if (Spectre.tagMatch(tag, tagLen, "green")) { return 32; }
        if (Spectre.tagMatch(tag, tagLen, "yellow")) { return 33; }
        if (Spectre.tagMatch(tag, tagLen, "blue")) { return 34; }
        if (Spectre.tagMatch(tag, tagLen, "magenta")) { return 35; }
        if (Spectre.tagMatch(tag, tagLen, "cyan")) { return 36; }
        if (Spectre.tagMatch(tag, tagLen, "white")) { return 37; }
        if (Spectre.tagMatch(tag, tagLen, "on_black")) { return 40; }
        if (Spectre.tagMatch(tag, tagLen, "on_red")) { return 41; }
        if (Spectre.tagMatch(tag, tagLen, "on_green")) { return 42; }
        if (Spectre.tagMatch(tag, tagLen, "on_yellow")) { return 43; }
        if (Spectre.tagMatch(tag, tagLen, "on_blue")) { return 44; }
        if (Spectre.tagMatch(tag, tagLen, "on_magenta")) { return 45; }
        if (Spectre.tagMatch(tag, tagLen, "on_cyan")) { return 46; }
        if (Spectre.tagMatch(tag, tagLen, "on_white")) { return 47; }
        return -1;
    }

    private static i32 writeBytes(i8* buf, i32 pos, i32 count, i32 b0, i32 b1, i32 b2, i32 b3) {
        buf[pos] = (i8)b0;
        buf[pos + 1] = (i8)b1;
        if (count > 2) { buf[pos + 2] = (i8)b2; }
        if (count > 3) { buf[pos + 3] = (i8)b3; }
        return pos + count;
    }

    private static i32 writeEmoji(i8* buf, i32 pos, i8* tag, i32 len) {
        if (Spectre.tagMatch(tag, len, "thumbsup")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x91, 0x8D); }
        if (Spectre.tagMatch(tag, len, "apple")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x8D, 0x8E); }
        if (Spectre.tagMatch(tag, len, "ant")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x90, 0x9C); }
        if (Spectre.tagMatch(tag, len, "bear")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x90, 0xBB); }
        if (Spectre.tagMatch(tag, len, "bus")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x9A, 0x8C); }
        if (Spectre.tagMatch(tag, len, "fire")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x94, 0xA5); }
        if (Spectre.tagMatch(tag, len, "rocket")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x9A, 0x80); }
        if (Spectre.tagMatch(tag, len, "smile")) { return Spectre.writeBytes(buf, pos, 4, 0xF0, 0x9F, 0x98, 0x84); }
        if (Spectre.tagMatch(tag, len, "pencil")) { return Spectre.writeBytes(buf, pos, 3, 0xE2, 0x9C, 0x8F, 0); }
        if (Spectre.tagMatch(tag, len, "check")) { return Spectre.writeBytes(buf, pos, 3, 0xE2, 0x9C, 0x93, 0); }
        if (Spectre.tagMatch(tag, len, "star")) { return Spectre.writeBytes(buf, pos, 3, 0xE2, 0xAD, 0x90, 0); }
        if (Spectre.tagMatch(tag, len, "heart")) { return Spectre.writeBytes(buf, pos, 3, 0xE2, 0x9D, 0xA4, 0); }
        if (Spectre.tagMatch(tag, len, "warning")) { return Spectre.writeBytes(buf, pos, 3, 0xE2, 0x9A, 0xA0, 0); }
        return pos;
    }

    private static i32 hexDigit(i8 ch) {
        if (ch >= 48 && ch <= 57) { return (i32)ch - 48; }
        if (ch >= 97 && ch <= 102) { return (i32)ch - 87; }
        if (ch >= 65 && ch <= 70) { return (i32)ch - 55; }
        return -1;
    }

    private static i32 writeTrueColor(i8* buf, i32 pos, i32 base, i32 r, i32 g, i32 b) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        i32 len = snprintf(buf + p, 24, "%d;2;%d;%d;%d", base, r, g, b);
        p = p + len;
        buf[p] = 109;
        return p + 1;
    }

    private static i32 writeExtendedTag(i8* buf, i32 pos, i8* word, i32 len) {
        mut i32 base = 38;
        mut i32 off = 0;
        mut i32 hexLen = len;
        if (len == 10 && word[0] == 111 && word[1] == 110 && word[2] == 95) {
            base = 48;
            off = 3;
            hexLen = 7;
        }
        i8* hex = word + off;
        if (hexLen == 7 && hex[0] == 35) {
            i32 h0 = Spectre.hexDigit(hex[1]);
            i32 h1 = Spectre.hexDigit(hex[2]);
            i32 h2 = Spectre.hexDigit(hex[3]);
            i32 h3 = Spectre.hexDigit(hex[4]);
            i32 h4 = Spectre.hexDigit(hex[5]);
            i32 h5 = Spectre.hexDigit(hex[6]);
            if (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 || h4 < 0 || h5 < 0) { return pos; }
            i32 comp0 = h0 * 16 + h1;
            i32 comp1 = h2 * 16 + h3;
            i32 comp2 = h4 * 16 + h5;
            return Spectre.writeTrueColor(buf, pos, base, comp0, comp1, comp2);
        }
        if (len > 5 && len <= 8 && word[0] == 99 && word[1] == 111 && word[2] == 108 && word[3] == 111 && word[4] == 114) {
            mut i32 n = 0;
            mut i32 k = 5;
            while (k < len) {
                if (word[k] < 48 || word[k] > 57) { return pos; }
                n = n * 10 + ((i32)word[k] - 48);
                k = k + 1;
            }
            mut i32 p = pos;
            p = Spectre.escStart(buf, p);
            i32 wrote = snprintf(buf + p, 16, "38;5;%d", n);
            p = p + wrote;
            buf[p] = 109;
            return p + 1;
        }
        return pos;
    }

    public static void markup(i8* text) {
        i32 textLen = strlen(text);
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        mut i32 i = 0;

        while (i < textLen) {
            if (text[i] == 91) {
                i = i + 1;

                if (i < textLen && text[i] == 47) {
                    while (i < textLen && text[i] != 93) {
                        i = i + 1;
                    }
                    if (i < textLen) { i = i + 1; }
                    pos = Spectre.writeReset(buf, pos);
                } else {
                    i8* tagStart = text + i;
                    mut i32 tagTotalLen = 0;
                    while (i < textLen && text[i] != 93) {
                        tagTotalLen = tagTotalLen + 1;
                        i = i + 1;
                    }
                    if (i < textLen) { i = i + 1; }

                    mut i32 tpos = 0;
                    while (tpos < tagTotalLen) {
                        while (tpos < tagTotalLen && tagStart[tpos] == 32) {
                            tpos = tpos + 1;
                        }
                        i32 wordStart = tpos;
                        while (tpos < tagTotalLen && tagStart[tpos] != 32) {
                            tpos = tpos + 1;
                        }
                        i32 wordLen = tpos - wordStart;
                        if (wordLen > 0) {
                            i32 code = Spectre.tagToCode(tagStart + wordStart, wordLen);
                            if (code >= 0) {
                                pos = Spectre.writeCode(buf, pos, code);
                            } else {
                                pos = Spectre.writeExtendedTag(buf, pos, tagStart + wordStart, wordLen);
                            }
                        }
                    }
                }
            } else {
                mut bool emitted = false;
                if (text[i] == 58) {
                    mut i32 j = i + 1;
                    while (j < textLen && (text[j] == 95 || (text[j] >= 97 && text[j] <= 122))) {
                        j = j + 1;
                    }
                    if (j < textLen && text[j] == 58 && j > i + 1) {
                        i32 np = Spectre.writeEmoji(buf, pos, text + i + 1, j - i - 1);
                        if (np > pos) {
                            pos = np;
                            i = j + 1;
                            emitted = true;
                        }
                    }
                }
                if (!emitted) {
                    buf[pos] = text[i];
                    pos = pos + 1;
                    i = i + 1;
                }
            }

            if (pos >= bufSize - 64) {
                write(1, buf, pos);
                pos = 0;
            }
        }

        if (pos > 0) {
            write(1, buf, pos);
        }
    }

    public static void markupLine(i8* text) {
        Spectre.markup(text);
        i8* nl = i8[1];
        nl[0] = 10;
        write(1, nl, 1);
    }

    private static i32 writeBoxH(i8* buf, i32 pos) {
        buf[pos] = 45;
        return pos + 1;
    }

    private static i32 writeBoxV(i8* buf, i32 pos) {
        buf[pos] = 124;
        return pos + 1;
    }

    private static i32 writeBoxTL(i8* buf, i32 pos) {
        buf[pos] = 43;
        return pos + 1;
    }

    private static i32 writeBoxTR(i8* buf, i32 pos) {
        buf[pos] = 43;
        return pos + 1;
    }

    private static i32 writeBoxBL(i8* buf, i32 pos) {
        buf[pos] = 43;
        return pos + 1;
    }

    private static i32 writeBoxBR(i8* buf, i32 pos) {
        buf[pos] = 43;
        return pos + 1;
    }

    public static void rule() {
        i32 w = Spectre.width();
        i8* buf = i8[512];
        mut i32 pos = 0;
        mut i32 i = 0;
        while (i < w) {
            pos = Spectre.writeBoxH(buf, pos);
            i = i + 1;
        }
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void ruleTitle(i8* title) {
        i32 titleLen = strlen(title);
        i32 totalWidth = Spectre.width();
        i32 titleSection = titleLen + 2;
        i32 leftDashes = (totalWidth - titleSection) / 2;
        i32 rightDashes = totalWidth - titleSection - leftDashes;

        i8* buf = i8[512];
        mut i32 pos = 0;

        mut i32 i = 0;
        while (i < leftDashes) {
            pos = Spectre.writeBoxH(buf, pos);
            i = i + 1;
        }

        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, title);
        buf[pos] = 32;
        pos = pos + 1;

        i = 0;
        while (i < rightDashes) {
            pos = Spectre.writeBoxH(buf, pos);
            i = i + 1;
        }

        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void panel(i8* content, i8* title) {
        i32 contentLen = strlen(content);
        i32 titleLen = strlen(title);
        mut i32 innerWidth = contentLen;
        if (titleLen > innerWidth) {
            innerWidth = titleLen;
        }
        innerWidth = innerWidth + 2;

        i8* buf = i8[bufSize];
        mut i32 pos = 0;

        pos = Spectre.writeBoxTL(buf, pos);
        pos = Spectre.writeBoxH(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, title);
        buf[pos] = 32;
        pos = pos + 1;
        mut i32 remaining = innerWidth - titleLen - 2;
        while (remaining > 0) {
            pos = Spectre.writeBoxH(buf, pos);
            remaining = remaining - 1;
        }
        pos = Spectre.writeBoxH(buf, pos);
        pos = Spectre.writeBoxTR(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;

        pos = Spectre.writeBoxV(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, content);
        remaining = innerWidth - contentLen;
        while (remaining > 0) {
            buf[pos] = 32;
            pos = pos + 1;
            remaining = remaining - 1;
        }
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeBoxV(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;

        pos = Spectre.writeBoxBL(buf, pos);
        mut i32 j = 0;
        while (j < innerWidth + 2) {
            pos = Spectre.writeBoxH(buf, pos);
            j = j + 1;
        }
        pos = Spectre.writeBoxBR(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;

        write(1, buf, pos);
    }

    private static i32 writeCursorErase(i8* buf, i32 pos) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        buf[p] = 50;
        buf[p + 1] = 75;
        return p + 2;
    }

    private static i32 writeCursorCol1(i8* buf, i32 pos) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        buf[p] = 71;
        return p + 1;
    }

    private static i32 writeCursorHide(i8* buf, i32 pos) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        buf[p] = 63;
        buf[p + 1] = 50;
        buf[p + 2] = 53;
        buf[p + 3] = 108;
        return p + 4;
    }

    private static i32 writeCursorShow(i8* buf, i32 pos) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        buf[p] = 63;
        buf[p + 1] = 50;
        buf[p + 2] = 53;
        buf[p + 3] = 104;
        return p + 4;
    }

    private static void setCursorVisible(bool visible) {
        i8* buf = i8[16];
        mut i32 pos = 0;
        if (visible) {
            pos = Spectre.writeCursorShow(buf, pos);
        } else {
            pos = Spectre.writeCursorHide(buf, pos);
        }
        write(1, buf, pos);
    }

    public static void progressBar(i32 current, i32 total, i32 width) {
        i32 filled = (current * width) / total;
        i32 empty = width - filled;

        i8* buf = i8[256];
        mut i32 pos = 0;

        pos = Spectre.writeCursorHide(buf, pos);
        pos = Spectre.writeCursorErase(buf, pos);
        pos = Spectre.writeCursorCol1(buf, pos);

        pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
        buf[pos] = 91;
        pos = pos + 1;

        mut i32 fi = 0;
        while (fi < filled) {
            buf[pos] = 35;
            pos = pos + 1;
            fi = fi + 1;
        }

        mut i32 ei = 0;
        while (ei < empty) {
            buf[pos] = 45;
            pos = pos + 1;
            ei = ei + 1;
        }

        buf[pos] = 93;
        pos = pos + 1;
        buf[pos] = 32;
        pos = pos + 1;

        i32 pct = (current * 100) / total;
        i32 len = snprintf(buf + pos, 8, "%d%%", pct);
        pos = pos + len;

        pos = Spectre.writeReset(buf, pos);
        write(1, buf, pos);
        __djinn_console_open_line(1);
    }

    public static void progressFinish(i32 width) {
        Spectre.progressBar(1, 1, width);
        i8* nl = i8[1];
        nl[0] = 10;
        write(1, nl, 1);
        __djinn_console_open_line(0);
        Spectre.setCursorVisible(true);
    }

    private static i32 writeOpenLineBreak(i8* buf, i32 pos) {
        if (__djinn_console_open_line(0) == 0) { return pos; }
        buf[pos] = 10;
        return pos + 1;
    }

    public static i32 prompt(i8* question) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeOpenLineBreak(buf, pos);
        pos = Spectre.writeCursorShow(buf, pos);
        pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
        pos = Spectre.writeCode(buf, pos, Spectre.FG_CYAN);
        buf[pos] = 63;
        pos = pos + 1;
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeReset(buf, pos);
        pos = Spectre.writeText(buf, pos, question);
        buf[pos] = 32;
        pos = pos + 1;
        write(1, buf, pos);

        i8* input = i8[1024];
        i32 len = __djinn_read_line(input, 1023);
        return len;
    }

    public static i32 promptInto(i8* question, i8* output) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeOpenLineBreak(buf, pos);
        pos = Spectre.writeCursorShow(buf, pos);
        pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
        pos = Spectre.writeCode(buf, pos, Spectre.FG_CYAN);
        buf[pos] = 63;
        pos = pos + 1;
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeReset(buf, pos);
        pos = Spectre.writeText(buf, pos, question);
        buf[pos] = 32;
        pos = pos + 1;
        write(1, buf, pos);

        i32 len = __djinn_read_line(output, 1023);
        return len;
    }

    public static bool confirm(i8* question) {
        i8* buf = i8[bufSize];
        mut i32 pos = 0;
        pos = Spectre.writeOpenLineBreak(buf, pos);
        pos = Spectre.writeCursorShow(buf, pos);
        pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
        pos = Spectre.writeCode(buf, pos, Spectre.FG_YELLOW);
        buf[pos] = 63;
        pos = pos + 1;
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeReset(buf, pos);
        pos = Spectre.writeText(buf, pos, question);
        pos = Spectre.writeText(buf, pos, " [y/n] ");
        write(1, buf, pos);

        i8* input = i8[16];
        i32 len = __djinn_read_line(input, 15);
        if (len > 0) {
            i8 first = input[0];
            if (first == 121 || first == 89) {
                return true;
            }
        }
        return false;
    }
}

struct SpectreTable {
    const i32 MAX_COLS = 16;
    const i32 MAX_ROWS = 128;
    const i32 CELL_WIDTH = 64;

    i8* headers;
    i8* cells;
    i8* colWidths;
    mut i32 numCols;
    mut i32 numRows;
    mut i32 headerIdx;
    mut i32 cellIdx;

    public static SpectreTable create() {
        i8* h = (i8*)malloc(16 * 64);
        i8* c = (i8*)malloc(128 * 16 * 64);
        i8* w = (i8*)malloc(16);
        memset(h, 0, 16 * 64);
        memset(c, 0, 128 * 16 * 64);
        memset(w, 0, 16);
        SpectreTable t = { .headers = h, .cells = c, .colWidths = w, .numCols = 0, .numRows = 0, .headerIdx = 0, .cellIdx = 0 };
        return t;
    }

    public void addHeader(i8* text) {
        i32 idx = this.headerIdx;
        if (idx >= MAX_COLS) { return; }
        i32 offset = idx * CELL_WIDTH;
        mut i32 len = strlen(text);
        if (len >= CELL_WIDTH) { len = CELL_WIDTH - 1; }
        memcpy(this.headers + offset, text, len);
        this.headers[offset + len] = 0;

        if ((i8)len > this.colWidths[idx]) {
            this.colWidths[idx] = (i8)len;
        }

        this.headerIdx = idx + 1;
        this.numCols = this.headerIdx;
    }

    public void addRow() {
        this.numRows = this.numRows + 1;
        this.cellIdx = 0;
    }

    public void addCell(i8* text) {
        i32 col = this.cellIdx;
        i32 row = this.numRows - 1;
        if (col >= this.numCols || row < 0) { return; }

        i32 offset = (row * MAX_COLS + col) * CELL_WIDTH;
        mut i32 len = strlen(text);
        if (len >= CELL_WIDTH) { len = CELL_WIDTH - 1; }
        memcpy(this.cells + offset, text, len);
        this.cells[offset + len] = 0;

        if ((i8)len > this.colWidths[col]) {
            this.colWidths[col] = (i8)len;
        }

        this.cellIdx = col + 1;
    }

    private void renderSeparator(i8* buf) {
        mut i32 pos = 0;
        buf[pos] = 43;
        pos = pos + 1;
        mut i32 c = 0;
        while (c < this.numCols) {
            mut i32 w = (i32)this.colWidths[c] + 2;
            while (w > 0) {
                buf[pos] = 45;
                pos = pos + 1;
                w = w - 1;
            }
            buf[pos] = 43;
            pos = pos + 1;
            c = c + 1;
        }
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    private void renderRow(i8* buf, i8* rowData) {
        mut i32 pos = 0;
        buf[pos] = 124;
        pos = pos + 1;
        mut i32 c = 0;
        while (c < this.numCols) {
            buf[pos] = 32;
            pos = pos + 1;

            i8* cell = rowData + c * CELL_WIDTH;
            i32 len = strlen(cell);
            memcpy(buf + pos, cell, len);
            pos = pos + len;

            mut i32 pad = (i32)this.colWidths[c] - len;
            while (pad > 0) {
                buf[pos] = 32;
                pos = pos + 1;
                pad = pad - 1;
            }
            buf[pos] = 32;
            pos = pos + 1;
            buf[pos] = 124;
            pos = pos + 1;
            c = c + 1;
        }
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public void render() {
        i8* buf = i8[4096];

        this.renderSeparator(buf);
        this.renderRow(buf, this.headers);
        this.renderSeparator(buf);

        mut i32 r = 0;
        while (r < this.numRows) {
            i8* rowData = this.cells + r * MAX_COLS * CELL_WIDTH;
            this.renderRow(buf, rowData);
            r = r + 1;
        }

        this.renderSeparator(buf);
    }

    public void destroy() {
        __djinn_free(this.headers);
        __djinn_free(this.cells);
        __djinn_free(this.colWidths);
    }
}

struct SpectreTree {
    const i32 MAX_NODES = 256;
    const i32 LABEL_SIZE = 64;

    i8* labels;
    i8* parentsBuf;
    i8* depthsBuf;
    mut i32 count;

    public static SpectreTree create() {
        i8* l = (i8*)malloc(256 * 64);
        i8* p = (i8*)malloc(256);
        i8* d = (i8*)malloc(256);
        memset(l, 0, 256 * 64);
        memset(p, 0, 256);
        memset(d, 0, 256);
        SpectreTree t = { .labels = l, .parentsBuf = p, .depthsBuf = d, .count = 0 };
        return t;
    }

    private i8 encodeParent(i32 parentIdx) {
        if (parentIdx < 0) { return (i8)255; }
        return (i8)parentIdx;
    }

    private i32 decodeParent(i8 val) {
        if ((u8)val == (u8)255) { return -1; }
        return (i32)(u8)val;
    }

    public i32 add(i8* label, i32 parentIdx) {
        i32 idx = this.count;
        if (idx >= MAX_NODES) { return -1; }

        i32 offset = idx * LABEL_SIZE;
        mut i32 len = strlen(label);
        if (len >= LABEL_SIZE) { len = LABEL_SIZE - 1; }
        memcpy(this.labels + offset, label, len);
        this.labels[offset + len] = 0;

        this.parentsBuf[idx] = this.encodeParent(parentIdx);

        if (parentIdx < 0) {
            this.depthsBuf[idx] = 0;
        } else {
            this.depthsBuf[idx] = this.depthsBuf[parentIdx] + 1;
        }

        this.count = idx + 1;
        return idx;
    }

    private bool isLastChild(i32 idx) {
        i32 myParent = this.decodeParent(this.parentsBuf[idx]);
        mut i32 j = idx + 1;
        while (j < this.count) {
            i32 jParent = this.decodeParent(this.parentsBuf[j]);
            if (jParent == myParent) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    private bool hasChildAtDepth(i32 idx, i32 depth) {
        mut i32 ancestor = idx;
        while (ancestor >= 0 && (i32)this.depthsBuf[ancestor] > depth) {
            ancestor = this.decodeParent(this.parentsBuf[ancestor]);
        }
        if (ancestor < 0) { return false; }
        return !this.isLastChild(ancestor);
    }

    public void render() {
        i8* buf = i8[4096];

        mut i32 i = 0;
        while (i < this.count) {
            mut i32 pos = 0;
            i32 depth = (i32)this.depthsBuf[i];

            mut i32 d = 0;
            while (d < depth) {
                if (d == depth - 1) {
                    if (this.isLastChild(i)) {
                        pos = Spectre.writeText(buf, pos, "  +-- ");
                    } else {
                        pos = Spectre.writeText(buf, pos, "  |-- ");
                    }
                } else {
                    if (this.hasChildAtDepth(i, d + 1)) {
                        pos = Spectre.writeText(buf, pos, "  |   ");
                    } else {
                        pos = Spectre.writeText(buf, pos, "      ");
                    }
                }
                d = d + 1;
            }

            i8* label = this.labels + i * LABEL_SIZE;
            if (depth == 0) {
                pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
            }
            pos = Spectre.writeText(buf, pos, label);
            if (depth == 0) {
                pos = Spectre.writeReset(buf, pos);
            }
            buf[pos] = 10;
            pos = pos + 1;
            write(1, buf, pos);

            i = i + 1;
        }
    }

    public void destroy() {
        __djinn_free(this.labels);
        __djinn_free(this.parentsBuf);
        __djinn_free(this.depthsBuf);
    }
}

struct SpectreSpinner {
    const i32 FRAME_COUNT = 4;

    i8* message;
    mut i32 frame;

    public static SpectreSpinner create(i8* message) {
        SpectreSpinner s = { .message = message, .frame = 0 };
        return s;
    }

    public void tick() {
        i8* buf = i8[512];
        mut i32 pos = 0;

        pos = Spectre.writeCursorHide(buf, pos);
        pos = Spectre.writeCursorErase(buf, pos);
        pos = Spectre.writeCursorCol1(buf, pos);

        pos = Spectre.writeCode(buf, pos, Spectre.FG_CYAN);

        i32 f =this.frame % FRAME_COUNT;
        if (f == 0) { buf[pos] = 124; }
        if (f == 1) { buf[pos] = 47; }
        if (f == 2) { buf[pos] = 45; }
        if (f == 3) { buf[pos] = 92; }
        pos = pos + 1;

        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, this.message);
        write(1, buf, pos);

        this.frame = this.frame + 1;
    }

    public void finish(i8* doneMessage) {
        i8* buf = i8[512];
        mut i32 pos = 0;
        pos = Spectre.writeCursorErase(buf, pos);
        pos = Spectre.writeCursorCol1(buf, pos);
        pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
        pos = Spectre.writeText(buf, pos, doneMessage);
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;
        pos = Spectre.writeCursorShow(buf, pos);
        write(1, buf, pos);
    }
}

struct SpectreBar {
    public static void bar(i8* label, i32 value, i32 maxValue, i32 width, i32 color) {
        i32 filled = (value * width) / maxValue;
        i32 labelLen = strlen(label);

        i8* buf = i8[512];
        mut i32 pos = 0;

        pos = Spectre.writeText(buf, pos, label);

        mut i32 pad = 12 - labelLen;
        while (pad > 0) {
            buf[pos] = 32;
            pos = pos + 1;
            pad = pad - 1;
        }

        pos = Spectre.writeCode(buf, pos, color);
        mut i32 fi = 0;
        while (fi < filled) {
            buf[pos] = 35;
            pos = pos + 1;
            fi = fi + 1;
        }
        pos = Spectre.writeReset(buf, pos);

        mut i32 ei = 0;
        i32 empty = width - filled;
        while (ei < empty) {
            buf[pos] = 32;
            pos = pos + 1;
            ei = ei + 1;
        }

        buf[pos] = 32;
        pos = pos + 1;
        i32 len = snprintf(buf + pos, 16, "%d", value);
        pos = pos + len;
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void chart(i8* title) {
        Spectre.styledLn(title, Spectre.BOLD);
    }
}

struct SpectreAlign {
    public static void center(i8* text) {
        i32 w = Spectre.width();
        i32 len = strlen(text);
        i32 pad = (w - len) / 2;

        i8* buf = i8[512];
        mut i32 pos = 0;

        mut i32 i = 0;
        while (i < pad) {
            buf[pos] = 32;
            pos = pos + 1;
            i = i + 1;
        }
        pos = Spectre.writeText(buf, pos, text);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void right(i8* text) {
        i32 w = Spectre.width();
        i32 len = strlen(text);
        i32 pad = w - len;

        i8* buf = i8[512];
        mut i32 pos = 0;

        mut i32 i = 0;
        while (i < pad) {
            buf[pos] = 32;
            pos = pos + 1;
            i = i + 1;
        }
        pos = Spectre.writeText(buf, pos, text);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void repeat(i8 ch, i32 count) {
        i8* buf = i8[512];
        mut i32 pos = 0;
        mut i32 i = 0;
        while (i < count) {
            buf[pos] = ch;
            pos = pos + 1;
            i = i + 1;
            if (pos >= 500) {
                write(1, buf, pos);
                pos = 0;
            }
        }
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }
}

struct SpectreGrid {
    const i32 MAX_COLS = 16;
    const i32 MAX_ROWS = 128;
    const i32 CELL_WIDTH = 64;

    i8* cells;
    i8* colWidths;
    mut i32 numCols;
    mut i32 numRows;
    mut i32 cellIdx;

    public static SpectreGrid create(i32 cols) {
        i8* c = (i8*)__djinn_malloc(128 * 16 * 64);
        i8* w = (i8*)__djinn_malloc(16);
        memset(c, 0, 128 * 16 * 64);
        memset(w, 0, 16);
        SpectreGrid g = { .cells = c, .colWidths = w, .numCols = cols, .numRows = 0, .cellIdx = 0 };
        return g;
    }

    public void addRow() {
        this.numRows = this.numRows + 1;
        this.cellIdx = 0;
    }

    public void addCell(i8* text) {
        i32 col = this.cellIdx;
        i32 row = this.numRows - 1;
        if (col >= this.numCols || row < 0) { return; }

        i32 offset = (row * MAX_COLS + col) * CELL_WIDTH;
        mut i32 len = strlen(text);
        if (len >= CELL_WIDTH) { len = CELL_WIDTH - 1; }
        memcpy(this.cells + offset, text, len);
        this.cells[offset + len] = 0;

        if ((i8)len > this.colWidths[col]) {
            this.colWidths[col] = (i8)len;
        }
        this.cellIdx = col + 1;
    }

    public void render() {
        i8* buf = i8[4096];

        mut i32 r = 0;
        while (r < this.numRows) {
            mut i32 pos = 0;
            mut i32 c = 0;
            while (c < this.numCols) {
                i8* cell = this.cells + (r * MAX_COLS + c) * CELL_WIDTH;
                i32 len = strlen(cell);
                memcpy(buf + pos, cell, len);
                pos = pos + len;

                mut i32 pad = (i32)this.colWidths[c] - len + 2;
                while (pad > 0) {
                    buf[pos] = 32;
                    pos = pos + 1;
                    pad = pad - 1;
                }
                c = c + 1;
            }
            buf[pos] = 10;
            pos = pos + 1;
            write(1, buf, pos);
            r = r + 1;
        }
    }

    public void destroy() {
        __djinn_free(this.cells);
        __djinn_free(this.colWidths);
    }
}

struct SpectreColumns {
    public static void render(i8* items, i32 itemCount, i32 itemSize) {
        i32 termW = Spectre.width();
        mut i32 maxLen = 0;
        mut i32 i = 0;
        while (i < itemCount) {
            i32 len = strlen(items + i * itemSize);
            if (len > maxLen) { maxLen = len; }
            i = i + 1;
        }
        i32 colW = maxLen + 2;
        mut i32 numCols = termW / colW;
        if (numCols < 1) { numCols = 1; }

        i8* buf = i8[4096];
        mut i32 pos = 0;
        i = 0;
        mut i32 col = 0;
        while (i < itemCount) {
            i8* item = items + i * itemSize;
            i32 len = strlen(item);
            memcpy(buf + pos, item, len);
            pos = pos + len;

            mut i32 pad = colW - len;
            while (pad > 0) {
                buf[pos] = 32;
                pos = pos + 1;
                pad = pad - 1;
            }

            col = col + 1;
            if (col >= numCols) {
                buf[pos] = 10;
                pos = pos + 1;
                write(1, buf, pos);
                pos = 0;
                col = 0;
            }
            i = i + 1;
        }
        if (pos > 0) {
            buf[pos] = 10;
            pos = pos + 1;
            write(1, buf, pos);
        }
    }
}

struct SpectreTextPath {
    public static void render(i8* path) {
        i32 len = strlen(path);
        i8* buf = i8[4096];
        mut i32 pos = 0;
        mut i32 i = 0;
        mut i32 lastSep = -1;

        while (i < len) {
            if (path[i] == 47 || path[i] == 92) {
                lastSep = i;
            }
            i = i + 1;
        }

        if (lastSep < 0) {
            pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
            pos = Spectre.writeText(buf, pos, path);
            pos = Spectre.writeReset(buf, pos);
        } else {
            pos = Spectre.writeCode(buf, pos, Spectre.FG_BLUE);
            i = 0;
            while (i <= lastSep) {
                buf[pos] = path[i];
                pos = pos + 1;
                i = i + 1;
            }
            pos = Spectre.writeReset(buf, pos);

            pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
            while (i < len) {
                buf[pos] = path[i];
                pos = pos + 1;
                i = i + 1;
            }
            pos = Spectre.writeReset(buf, pos);
        }

        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }
}

struct SpectreEmoji {
    public static void printCheck(i8* message) {
        i8* buf = i8[512];
        mut i32 pos = 0;
        pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
        buf[pos] = (i8)0xE2;
        buf[pos + 1] = (i8)0x9C;
        buf[pos + 2] = (i8)0x93;
        pos = pos + 3;
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, message);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void printCross(i8* message) {
        i8* buf = i8[512];
        mut i32 pos = 0;
        pos = Spectre.writeCode(buf, pos, Spectre.FG_RED);
        buf[pos] = (i8)0xE2;
        buf[pos + 1] = (i8)0x9C;
        buf[pos + 2] = (i8)0x97;
        pos = pos + 3;
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, message);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void printWarning(i8* message) {
        i8* buf = i8[512];
        mut i32 pos = 0;
        pos = Spectre.writeCode(buf, pos, Spectre.FG_YELLOW);
        buf[pos] = (i8)0xE2;
        buf[pos + 1] = (i8)0x9A;
        buf[pos + 2] = (i8)0xA0;
        pos = pos + 3;
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, message);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void printInfo(i8* message) {
        i8* buf = i8[512];
        mut i32 pos = 0;
        pos = Spectre.writeCode(buf, pos, Spectre.FG_BLUE);
        buf[pos] = (i8)0xE2;
        buf[pos + 1] = (i8)0x84;
        buf[pos + 2] = (i8)0xB9;
        pos = pos + 3;
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 32;
        pos = pos + 1;
        pos = Spectre.writeText(buf, pos, message);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }
}

struct SpectreLive {
    mut i32 lineCount;

    public static SpectreLive create() {
        SpectreLive l = { .lineCount = 0 };
        return l;
    }

    private i32 writeCursorUp(i8* buf, i32 pos, i32 n) {
        mut i32 p = pos;
        p = Spectre.escStart(buf, p);
        i32 len = snprintf(buf + p, 8, "%d", n);
        p = p + len;
        buf[p] = 65;
        return p + 1;
    }

    public void update(i8* content) {
        i8* buf = i8[4096];
        mut i32 pos = 0;

        pos = Spectre.writeCursorHide(buf, pos);
        if (this.lineCount > 0) {
            pos = this.writeCursorUp(buf, pos, this.lineCount);
        }

        mut i32 lines = 0;
        mut i32 i = 0;
        i32 contentLen = strlen(content);

        while (i < contentLen) {
            pos = Spectre.writeCursorErase(buf, pos);
            pos = Spectre.writeCursorCol1(buf, pos);

            while (i < contentLen && content[i] != 10) {
                buf[pos] = content[i];
                pos = pos + 1;
                i = i + 1;
            }
            buf[pos] = 10;
            pos = pos + 1;
            lines = lines + 1;

            if (i < contentLen) {
                i = i + 1;
            }

            if (pos >= 3800) {
                write(1, buf, pos);
                pos = 0;
            }
        }

        if (pos > 0) {
            write(1, buf, pos);
        }
        this.lineCount = lines;
    }

    public void clear() {
        if (this.lineCount <= 0) { return; }
        i8* buf = i8[1024];
        mut i32 pos = 0;
        pos = this.writeCursorUp(buf, pos, this.lineCount);
        mut i32 i = 0;
        while (i < this.lineCount) {
            pos = Spectre.writeCursorErase(buf, pos);
            pos = Spectre.writeCursorCol1(buf, pos);
            buf[pos] = 10;
            pos = pos + 1;
            i = i + 1;
        }
        pos = this.writeCursorUp(buf, pos, this.lineCount);
        pos = Spectre.writeCursorShow(buf, pos);
        write(1, buf, pos);
        this.lineCount = 0;
    }
}

struct SpectreSelect {
    const i32 MAX_OPTIONS = 32;
    const i32 OPTION_SIZE = 64;
    const i32 KEY_UP = -1;
    const i32 KEY_DOWN = -2;
    const i32 KEY_ENTER = -3;
    const i32 KEY_SPACE = -4;
    const i32 KEY_ESCAPE = -5;

    i8* options;
    mut i32 count;

    public static SpectreSelect create() {
        i8* o = (i8*)__djinn_malloc(32 * 64);
        memset(o, 0, 32 * 64);
        SpectreSelect s = { .options = o, .count = 0 };
        return s;
    }

    public void addOption(i8* text) {
        i32 idx = this.count;
        if (idx >= MAX_OPTIONS) { return; }
        i32 offset = idx * OPTION_SIZE;
        mut i32 len = strlen(text);
        if (len >= OPTION_SIZE) { len = OPTION_SIZE - 1; }
        memcpy(this.options + offset, text, len);
        this.options[offset + len] = 0;
        this.count = idx + 1;
    }

    private void renderOptions(i8* buf, i8* prompt, i32 selected) {
        mut i32 pos = 0;

        pos = Spectre.writeCursorErase(buf, pos);
        pos = Spectre.writeCursorCol1(buf, pos);
        pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
        pos = Spectre.writeCode(buf, pos, Spectre.FG_CYAN);
        pos = Spectre.writeText(buf, pos, "? ");
        pos = Spectre.writeReset(buf, pos);
        pos = Spectre.writeText(buf, pos, prompt);
        buf[pos] = 10;
        pos = pos + 1;

        mut i32 i = 0;
        while (i < this.count) {
            pos = Spectre.writeCursorErase(buf, pos);
            pos = Spectre.writeCursorCol1(buf, pos);

            if (i == selected) {
                pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
                pos = Spectre.writeText(buf, pos, "  > ");
                pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
            } else {
                pos = Spectre.writeText(buf, pos, "    ");
            }

            pos = Spectre.writeText(buf, pos, this.options + i * OPTION_SIZE);
            pos = Spectre.writeReset(buf, pos);
            buf[pos] = 10;
            pos = pos + 1;
            i = i + 1;
        }

        write(1, buf, pos);
    }

    private void renderMultiOptions(i8* buf, i8* prompt, i32 cursor, i8* selected) {
        mut i32 pos = 0;

        pos = Spectre.writeCursorErase(buf, pos);
        pos = Spectre.writeCursorCol1(buf, pos);
        pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
        pos = Spectre.writeCode(buf, pos, Spectre.FG_CYAN);
        pos = Spectre.writeText(buf, pos, "? ");
        pos = Spectre.writeReset(buf, pos);
        pos = Spectre.writeText(buf, pos, prompt);
        pos = Spectre.writeText(buf, pos, " (space to toggle, enter to confirm)");
        buf[pos] = 10;
        pos = pos + 1;

        mut i32 i = 0;
        while (i < this.count) {
            pos = Spectre.writeCursorErase(buf, pos);
            pos = Spectre.writeCursorCol1(buf, pos);

            if (i == cursor) {
                pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
                pos = Spectre.writeText(buf, pos, "  > ");
            } else {
                pos = Spectre.writeText(buf, pos, "    ");
            }

            if (selected[i] != 0) {
                pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
                pos = Spectre.writeText(buf, pos, "[x] ");
            } else {
                pos = Spectre.writeText(buf, pos, "[ ] ");
            }

            if (i == cursor) {
                pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
            }
            pos = Spectre.writeText(buf, pos, this.options + i * OPTION_SIZE);
            pos = Spectre.writeReset(buf, pos);
            buf[pos] = 10;
            pos = pos + 1;
            i = i + 1;
        }

        write(1, buf, pos);
    }

    public i32 prompt(i8* promptText) {
        Spectre.rawEnable();
        Spectre.setCursorVisible(false);
        i8* buf = i8[4096];
        mut i32 selected = 0;

        this.renderOptions(buf, promptText, selected);

        mut bool done = false;
        while (!done) {
            i32 key = Spectre.readKey();
            if (key == -1 && selected > 0) {
                selected = selected - 1;
            } else if (key == -2 && selected < this.count - 1) {
                selected = selected + 1;
            } else if (key == -3) {
                done = true;
            } else if (key == -5) {
                selected = -1;
                done = true;
            }

            if (!done) {
                i8* up = i8[16];
                mut i32 upos = 0;
                upos = Spectre.escStart(up, upos);
                i32 lines = this.count + 1;
                i32 ulen = snprintf(up + upos, 8, "%d", lines);
                upos = upos + ulen;
                up[upos] = 65;
                upos = upos + 1;
                write(1, up, upos);
                this.renderOptions(buf, promptText, selected);
            }
        }

        Spectre.setCursorVisible(true);
        Spectre.rawDisable();

        i8* clearBuf = i8[512];
        mut i32 cpos = 0;
        cpos = Spectre.escStart(clearBuf, cpos);
        i32 clines = this.count + 1;
        mut i32 clen = snprintf(clearBuf + cpos, 8, "%d", clines);
        cpos = cpos + clen;
        clearBuf[cpos] = 65;
        cpos = cpos + 1;
        mut i32 cl = 0;
        while (cl <= this.count) {
            cpos = Spectre.writeCursorErase(clearBuf, cpos);
            clearBuf[cpos] = 10;
            cpos = cpos + 1;
            cl = cl + 1;
        }
        cpos = Spectre.escStart(clearBuf, cpos);
        clen = snprintf(clearBuf + cpos, 8, "%d", clines);
        cpos = cpos + clen;
        clearBuf[cpos] = 65;
        cpos = cpos + 1;
        write(1, clearBuf, cpos);

        if (selected >= 0) {
            i8* result = i8[256];
            mut i32 rpos = 0;
            rpos = Spectre.writeCode(result, rpos, Spectre.FG_GREEN);
            rpos = Spectre.writeText(result, rpos, "  > ");
            rpos = Spectre.writeText(result, rpos, this.options + selected * OPTION_SIZE);
            rpos = Spectre.writeReset(result, rpos);
            result[rpos] = 10;
            rpos = rpos + 1;
            write(1, result, rpos);
        }

        return selected;
    }

    public void multiPrompt(i8* promptText, i8* results) {
        Spectre.rawEnable();
        Spectre.setCursorVisible(false);
        i8* buf = i8[4096];
        mut i32 cursor = 0;
        i8* selected = i8[32];
        memset(selected, 0, 32);

        this.renderMultiOptions(buf, promptText, cursor, selected);

        mut bool done = false;
        while (!done) {
            i32 key = Spectre.readKey();
            if (key == -1 && cursor > 0) {
                cursor = cursor - 1;
            } else if (key == -2 && cursor < this.count - 1) {
                cursor = cursor + 1;
            } else if (key == -4) {
                if (selected[cursor] == 0) {
                    selected[cursor] = 1;
                } else {
                    selected[cursor] = 0;
                }
            } else if (key == -3) {
                done = true;
            }

            if (!done) {
                i8* up = i8[16];
                mut i32 upos = 0;
                upos = Spectre.escStart(up, upos);
                i32 lines = this.count + 1;
                i32 ulen = snprintf(up + upos, 8, "%d", lines);
                upos = upos + ulen;
                up[upos] = 65;
                upos = upos + 1;
                write(1, up, upos);
                this.renderMultiOptions(buf, promptText, cursor, selected);
            }
        }

        Spectre.setCursorVisible(true);
        Spectre.rawDisable();

        memcpy(results, selected, this.count);

        i8* clearBuf = i8[512];
        mut i32 cpos = 0;
        cpos = Spectre.escStart(clearBuf, cpos);
        i32 clines = this.count + 1;
        mut i32 clen = snprintf(clearBuf + cpos, 8, "%d", clines);
        cpos = cpos + clen;
        clearBuf[cpos] = 65;
        cpos = cpos + 1;
        mut i32 cl = 0;
        while (cl <= this.count) {
            cpos = Spectre.writeCursorErase(clearBuf, cpos);
            clearBuf[cpos] = 10;
            cpos = cpos + 1;
            cl = cl + 1;
        }
        cpos = Spectre.escStart(clearBuf, cpos);
        clen = snprintf(clearBuf + cpos, 8, "%d", clines);
        cpos = cpos + clen;
        clearBuf[cpos] = 65;
        cpos = cpos + 1;
        write(1, clearBuf, cpos);

        mut i32 si = 0;
        while (si < this.count) {
            if (selected[si] != 0) {
                i8* result = i8[256];
                mut i32 rpos = 0;
                rpos = Spectre.writeCode(result, rpos, Spectre.FG_GREEN);
                rpos = Spectre.writeText(result, rpos, "  [x] ");
                rpos = Spectre.writeText(result, rpos, this.options + si * OPTION_SIZE);
                rpos = Spectre.writeReset(result, rpos);
                result[rpos] = 10;
                rpos = rpos + 1;
                write(1, result, rpos);
            }
            si = si + 1;
        }
    }

    public void destroy() {
        __djinn_free(this.options);
    }
}

struct SpectreText {
    const i32 LEFT = 0;
    const i32 CENTER = 1;
    const i32 RIGHT = 2;
    const i32 JUSTIFY = 3;

    private static void emitLine(i8* start, i32 len, i32 width, i32 align, bool last) {
        i8* buf = i8[1024];
        mut i32 pos = 0;

        mut i32 lead = 0;
        if (align == SpectreText.CENTER) { lead = (width - len) / 2; }
        if (align == SpectreText.RIGHT) { lead = width - len; }
        mut i32 i = 0;
        while (i < lead) {
            buf[pos] = 32;
            pos = pos + 1;
            i = i + 1;
        }

        mut i32 gaps = 0;
        i = 0;
        while (i < len) {
            if (start[i] == 32) { gaps = gaps + 1; }
            i = i + 1;
        }

        if (align == SpectreText.JUSTIFY && !last && gaps > 0) {
            i32 extra = width - len;
            i32 perGap = extra / gaps;
            i32 remainder = extra % gaps;
            mut i32 gapIdx = 0;
            i = 0;
            while (i < len) {
                buf[pos] = start[i];
                pos = pos + 1;
                if (start[i] == 32) {
                    mut i32 fill = perGap;
                    if (gapIdx < remainder) { fill = fill + 1; }
                    mut i32 f = 0;
                    while (f < fill) {
                        buf[pos] = 32;
                        pos = pos + 1;
                        f = f + 1;
                    }
                    gapIdx = gapIdx + 1;
                }
                i = i + 1;
            }
        } else {
            memcpy(buf + pos, start, len);
            pos = pos + len;
        }

        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void wrap(i8* text, i32 width, i32 align) {
        mut i32 w = width;
        if (w > 800) { w = 800; }
        i32 textLen = strlen(text);
        mut i32 i = 0;
        mut i32 lineStart = -1;
        mut i32 lineEnd = 0;

        while (i < textLen) {
            if (text[i] == 32) {
                i = i + 1;
            } else {
                i32 wordStart = i;
                while (i < textLen && text[i] != 32) {
                    i = i + 1;
                }
                if (lineStart < 0) {
                    lineStart = wordStart;
                    lineEnd = i;
                } else if (i - lineStart <= w) {
                    lineEnd = i;
                } else {
                    SpectreText.emitLine(text + lineStart, lineEnd - lineStart, w, align, false);
                    lineStart = wordStart;
                    lineEnd = i;
                }
            }
        }

        if (lineStart >= 0) {
            SpectreText.emitLine(text + lineStart, lineEnd - lineStart, w, align, true);
        }
    }
}

struct SpectreBreakdown {
    const i32 MAX_ITEMS = 16;
    const i32 LABEL_SIZE = 32;

    i8* labels;
    i32* values;
    i32* colors;
    mut i32 count;

    public static SpectreBreakdown create() {
        i8* l = (i8*)__djinn_malloc(16 * 32);
        i32* v = (i32*)__djinn_malloc(16 * 4);
        i32* c = (i32*)__djinn_malloc(16 * 4);
        memset(l, 0, 16 * 32);
        SpectreBreakdown b = { .labels = l, .values = v, .colors = c, .count = 0 };
        return b;
    }

    public void add(i8* label, i32 value, i32 color) {
        i32 idx = this.count;
        if (idx >= MAX_ITEMS) { return; }
        mut i32 len = strlen(label);
        if (len >= LABEL_SIZE) { len = LABEL_SIZE - 1; }
        memcpy(this.labels + idx * LABEL_SIZE, label, len);
        this.labels[idx * LABEL_SIZE + len] = 0;
        this.values[idx] = value;
        this.colors[idx] = color;
        this.count = idx + 1;
    }

    public void render(i32 width) {
        mut i32 total = 0;
        mut i32 i = 0;
        while (i < this.count) {
            total = total + this.values[i];
            i = i + 1;
        }
        if (total <= 0) { return; }

        i8* buf = i8[4096];
        mut i32 pos = 0;
        mut i32 used = 0;
        i = 0;
        while (i < this.count) {
            mut i32 w = (this.values[i] * width) / total;
            if (i == this.count - 1) { w = width - used; }
            used = used + w;
            pos = Spectre.writeCode(buf, pos, this.colors[i] + 10);
            mut i32 k = 0;
            while (k < w) {
                buf[pos] = 32;
                pos = pos + 1;
                k = k + 1;
            }
            pos = Spectre.writeReset(buf, pos);
            i = i + 1;
        }
        buf[pos] = 10;
        pos = pos + 1;
        buf[pos] = 10;
        pos = pos + 1;

        i = 0;
        while (i < this.count) {
            pos = Spectre.writeCode(buf, pos, this.colors[i]);
            pos = Spectre.writeBytes(buf, pos, 3, 0xE2, 0x96, 0xA0, 0);
            pos = Spectre.writeReset(buf, pos);
            buf[pos] = 32;
            pos = pos + 1;
            pos = Spectre.writeText(buf, pos, this.labels + i * LABEL_SIZE);
            buf[pos] = 32;
            pos = pos + 1;
            pos = Spectre.writeCode(buf, pos, Spectre.DIM);
            i32 len = snprintf(buf + pos, 16, "%d%%", (this.values[i] * 100) / total);
            pos = pos + len;
            pos = Spectre.writeReset(buf, pos);
            buf[pos] = 32;
            buf[pos + 1] = 32;
            pos = pos + 2;
            i = i + 1;
        }
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public void destroy() {
        __djinn_free(this.labels);
        __djinn_free(this.values);
        __djinn_free(this.colors);
    }
}

struct SpectreCalendar {
    private static bool isLeap(i32 year) {
        return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
    }

    private static i32 daysIn(i32 month, i32 year) {
        if (month == 2) {
            if (SpectreCalendar.isLeap(year)) { return 29; }
            return 28;
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    private static i32 weekday(i32 year, i32 month, i32 day) {
        i8* offsets = "032503514624";
        mut i32 y = year;
        if (month < 3) { y = y - 1; }
        return (y + y / 4 - y / 100 + y / 400 + ((i32)offsets[month - 1] - 48) + day) % 7;
    }

    private static i8* monthName(i32 month) {
        if (month == 1) { return "January"; }
        if (month == 2) { return "February"; }
        if (month == 3) { return "March"; }
        if (month == 4) { return "April"; }
        if (month == 5) { return "May"; }
        if (month == 6) { return "June"; }
        if (month == 7) { return "July"; }
        if (month == 8) { return "August"; }
        if (month == 9) { return "September"; }
        if (month == 10) { return "October"; }
        if (month == 11) { return "November"; }
        return "December";
    }

    public static void render(i32 year, i32 month, i32 highlightDay) {
        i8* buf = i8[1024];
        mut i32 pos = 0;

        i8* title = i8[64];
        i32 titleLen = snprintf(title, 64, "%s %d", SpectreCalendar.monthName(month), year);
        mut i32 pad = (20 - titleLen) / 2;
        while (pad > 0) {
            buf[pos] = 32;
            pos = pos + 1;
            pad = pad - 1;
        }
        pos = Spectre.writeCode(buf, pos, Spectre.BOLD);
        pos = Spectre.writeText(buf, pos, title);
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;

        pos = Spectre.writeCode(buf, pos, Spectre.FG_BLUE);
        pos = Spectre.writeText(buf, pos, "Su Mo Tu We Th Fr Sa");
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;

        i32 first = SpectreCalendar.weekday(year, month, 1);
        mut i32 col = 0;
        while (col < first) {
            buf[pos] = 32;
            buf[pos + 1] = 32;
            buf[pos + 2] = 32;
            pos = pos + 3;
            col = col + 1;
        }

        i32 days = SpectreCalendar.daysIn(month, year);
        mut i32 day = 1;
        while (day <= days) {
            if (day == highlightDay) {
                pos = Spectre.writeCode(buf, pos, 7);
                pos = Spectre.writeCode(buf, pos, Spectre.FG_GREEN);
            }
            i32 len = snprintf(buf + pos, 8, "%2d", day);
            pos = pos + len;
            if (day == highlightDay) {
                pos = Spectre.writeReset(buf, pos);
            }
            col = col + 1;
            if (col == 7) {
                buf[pos] = 10;
                pos = pos + 1;
                col = 0;
            } else {
                buf[pos] = 32;
                pos = pos + 1;
            }
            day = day + 1;
        }
        if (col != 0) {
            buf[pos] = 10;
            pos = pos + 1;
        }
        write(1, buf, pos);
    }
}

struct SpectreFiglet {
    private static i8* glyph(i32 c) {
        if (c == 65) { return ".###.#...#######...##...#"; }
        if (c == 66) { return "####.#...#####.#...#####."; }
        if (c == 67) { return ".#####....#....#.....####"; }
        if (c == 68) { return "####.#...##...##...#####."; }
        if (c == 69) { return "######....####.#....#####"; }
        if (c == 70) { return "######....####.#....#...."; }
        if (c == 71) { return ".#####....#..###...#.###."; }
        if (c == 72) { return "#...##...#######...##...#"; }
        if (c == 73) { return "#####..#....#....#..#####"; }
        if (c == 74) { return "..###...#....#.#..#..##.."; }
        if (c == 75) { return "#...##..#.###..#..#.#...#"; }
        if (c == 76) { return "#....#....#....#....#####"; }
        if (c == 77) { return "#...###.###.#.##...##...#"; }
        if (c == 78) { return "#...###..##.#.##..###...#"; }
        if (c == 79) { return ".###.#...##...##...#.###."; }
        if (c == 80) { return "####.#...#####.#....#...."; }
        if (c == 81) { return ".###.#...##.#.##..#..##.#"; }
        if (c == 82) { return "####.#...#####.#..#.#...#"; }
        if (c == 83) { return ".#####.....###.....#####."; }
        if (c == 84) { return "#####..#....#....#....#.."; }
        if (c == 85) { return "#...##...##...##...#.###."; }
        if (c == 86) { return "#...##...##...#.#.#...#.."; }
        if (c == 87) { return "#...##...##.#.###.###...#"; }
        if (c == 88) { return "#...#.#.#...#...#.#.#...#"; }
        if (c == 89) { return "#...#.#.#...#....#....#.."; }
        if (c == 90) { return "#####...#...#...#...#####"; }
        if (c == 48) { return ".###.#..###.#.###..#.###."; }
        if (c == 49) { return "..#...##....#....#...###."; }
        if (c == 50) { return ".###.#...#..##..#...#####"; }
        if (c == 51) { return "####.....#.###.....#####."; }
        if (c == 52) { return "#..#.#..#.#####...#....#."; }
        if (c == 53) { return "######....####.....#####."; }
        if (c == 54) { return ".###.#....####.#...#.###."; }
        if (c == 55) { return "#####....#...#...#....#.."; }
        if (c == 56) { return ".###.#...#.###.#...#.###."; }
        if (c == 57) { return ".###.#...#.####....#.###."; }
        if (c == 33) { return "..#....#....#.........#.."; }
        if (c == 46) { return "......................#.."; }
        if (c == 45) { return "..........#####.........."; }
        return ".........................";
    }

    public static void render(i8* text, i32 color) {
        i32 len = strlen(text);
        i8* buf = i8[4096];

        mut i32 row = 0;
        while (row < 5) {
            mut i32 pos = 0;
            pos = Spectre.writeCode(buf, pos, color);
            mut i32 i = 0;
            while (i < len && pos < 3800) {
                mut i32 c = (i32)text[i];
                if (c >= 97 && c <= 122) { c = c - 32; }
                i8* g = SpectreFiglet.glyph(c);
                mut i32 col = 0;
                while (col < 5) {
                    if (g[row * 5 + col] == 35) {
                        pos = Spectre.writeBytes(buf, pos, 3, 0xE2, 0x96, 0x88, 0);
                        pos = Spectre.writeBytes(buf, pos, 3, 0xE2, 0x96, 0x88, 0);
                    } else {
                        buf[pos] = 32;
                        buf[pos + 1] = 32;
                        pos = pos + 2;
                    }
                    col = col + 1;
                }
                buf[pos] = 32;
                buf[pos + 1] = 32;
                pos = pos + 2;
                i = i + 1;
            }
            pos = Spectre.writeReset(buf, pos);
            buf[pos] = 10;
            pos = pos + 1;
            write(1, buf, pos);
            row = row + 1;
        }
    }
}

struct SpectreCanvas {
    i8* pixels;
    i32 width;
    i32 height;

    public static SpectreCanvas create(i32 w, i32 h) {
        i32 size = w * h * 3;
        i8* p = (i8*)__djinn_malloc(size);
        memset(p, 0, size);
        SpectreCanvas c = { .pixels = p, .width = w, .height = h };
        return c;
    }

    private static i32 byteAt(i8* data, i32 idx) {
        mut i32 v = (i32)data[idx];
        if (v < 0) { v = v + 256; }
        return v;
    }

    public void setPixel(i32 x, i32 y, i32 r, i32 g, i32 b) {
        if (x < 0 || y < 0 || x >= this.width || y >= this.height) { return; }
        i32 o = (y * this.width + x) * 3;
        this.pixels[o] = (i8)r;
        this.pixels[o + 1] = (i8)g;
        this.pixels[o + 2] = (i8)b;
    }

    public void fillRect(i32 x, i32 y, i32 w, i32 h, i32 r, i32 g, i32 b) {
        mut i32 j = 0;
        while (j < h) {
            mut i32 i = 0;
            while (i < w) {
                this.setPixel(x + i, y + j, r, g, b);
                i = i + 1;
            }
            j = j + 1;
        }
    }

    public void loadRgb(i8* data) {
        memcpy(this.pixels, data, this.width * this.height * 3);
    }

    public void rainbow() {
        mut i32 span = this.height - 1;
        if (span < 1) { span = 1; }

        mut i32 y = 0;
        while (y < this.height) {
            mut i32 x = 0;
            while (x < this.width) {
                i32 h6 = (x * 6 * 256) / this.width;
                i32 seg = h6 / 256;
                i32 f = h6 % 256;
                mut i32 r = 0;
                mut i32 g = 0;
                mut i32 b = 0;
                if (seg == 0) { r = 255; g = f; }
                if (seg == 1) { r = 255 - f; g = 255; }
                if (seg == 2) { g = 255; b = f; }
                if (seg == 3) { g = 255 - f; b = 255; }
                if (seg == 4) { r = f; b = 255; }
                if (seg >= 5) { r = 255; b = 255 - f; }

                i32 t = (y * 511) / span;
                if (t < 256) {
                    r = (r * t) / 256;
                    g = (g * t) / 256;
                    b = (b * t) / 256;
                } else {
                    i32 u = t - 256;
                    r = r + ((255 - r) * u) / 256;
                    g = g + ((255 - g) * u) / 256;
                    b = b + ((255 - b) * u) / 256;
                }
                this.setPixel(x, y, r, g, b);
                x = x + 1;
            }
            y = y + 1;
        }
    }

    public void render() {
        i8* buf = i8[8192];
        mut i32 y = 0;
        while (y < this.height) {
            mut i32 pos = 0;
            mut i32 x = 0;
            while (x < this.width) {
                i32 top = (y * this.width + x) * 3;
                i32 tr = SpectreCanvas.byteAt(this.pixels, top);
                i32 tg = SpectreCanvas.byteAt(this.pixels, top + 1);
                i32 tb = SpectreCanvas.byteAt(this.pixels, top + 2);
                mut i32 br = 0;
                mut i32 bg = 0;
                mut i32 bb = 0;
                if (y + 1 < this.height) {
                    i32 bottom = ((y + 1) * this.width + x) * 3;
                    br = SpectreCanvas.byteAt(this.pixels, bottom);
                    bg = SpectreCanvas.byteAt(this.pixels, bottom + 1);
                    bb = SpectreCanvas.byteAt(this.pixels, bottom + 2);
                }
                pos = Spectre.escStart(buf, pos);
                i32 len = snprintf(buf + pos, 48, "38;2;%d;%d;%d;48;2;%d;%d;%dm", tr, tg, tb, br, bg, bb);
                pos = pos + len;
                pos = Spectre.writeBytes(buf, pos, 3, 0xE2, 0x96, 0x80, 0);
                if (pos >= 8000) {
                    write(1, buf, pos);
                    pos = 0;
                }
                x = x + 1;
            }
            pos = Spectre.writeReset(buf, pos);
            buf[pos] = 10;
            pos = pos + 1;
            write(1, buf, pos);
            y = y + 2;
        }
    }

    public void destroy() {
        __djinn_free(this.pixels);
    }
}

struct SpectreException {
    private static i32 lastIndexOf(i8* text, i32 len, i32 sep1, i32 sep2) {
        mut i32 found = -1;
        mut i32 i = 0;
        while (i < len) {
            if (text[i] == sep1 || text[i] == sep2) { found = i; }
            i = i + 1;
        }
        return found;
    }

    private static i32 writeSplit(i8* buf, i32 pos, i8* text, i32 sep1, i32 sep2, i32 tailStyle) {
        i32 len = strlen(text);
        i32 lastSep = SpectreException.lastIndexOf(text, len, sep1, sep2);
        i32 cut = lastSep + 1;
        mut i32 p = pos;
        mut i32 i = 0;
        while (i < cut) {
            buf[p] = text[i];
            p = p + 1;
            i = i + 1;
        }
        p = Spectre.writeCode(buf, p, tailStyle);
        while (i < len) {
            buf[p] = text[i];
            p = p + 1;
            i = i + 1;
        }
        return Spectre.writeReset(buf, p);
    }

    public static void header(i8* typeName, i8* message) {
        i8* buf = i8[2048];
        mut i32 pos = 0;
        pos = SpectreException.writeSplit(buf, pos, typeName, 46, 46, Spectre.BOLD);
        pos = Spectre.writeText(buf, pos, ": ");
        pos = Spectre.writeCode(buf, pos, Spectre.FG_RED);
        pos = Spectre.writeText(buf, pos, message);
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }

    public static void frame(i8* method, i8* file, i32 line) {
        i8* buf = i8[2048];
        mut i32 pos = 0;
        pos = Spectre.writeText(buf, pos, "  ");
        pos = Spectre.writeCode(buf, pos, Spectre.DIM);
        pos = Spectre.writeText(buf, pos, "at ");
        pos = Spectre.writeReset(buf, pos);
        pos = SpectreException.writeSplit(buf, pos, method, 46, 46, Spectre.FG_YELLOW);
        pos = Spectre.writeText(buf, pos, "()");
        pos = Spectre.writeCode(buf, pos, Spectre.DIM);
        pos = Spectre.writeText(buf, pos, " in ");
        pos = Spectre.writeReset(buf, pos);
        pos = SpectreException.writeSplit(buf, pos, file, 47, 92, Spectre.FG_YELLOW);
        buf[pos] = 58;
        pos = pos + 1;
        pos = Spectre.writeCode(buf, pos, Spectre.FG_BLUE);
        i32 len = snprintf(buf + pos, 16, "%d", line);
        pos = pos + len;
        pos = Spectre.writeReset(buf, pos);
        buf[pos] = 10;
        pos = pos + 1;
        write(1, buf, pos);
    }
}

struct SpectreCli {
    private static i32 nextToken(i8* line, i32 pos, i8* out) {
        i32 len = strlen(line);
        mut i32 p = pos;
        while (p < len && line[p] == 32) {
            p = p + 1;
        }
        if (p >= len) { return -1; }
        mut i32 n = 0;
        while (p < len && line[p] != 32 && n < 255) {
            out[n] = line[p];
            n = n + 1;
            p = p + 1;
        }
        out[n] = 0;
        return p;
    }

    public static bool hasFlag(i8* line, i8* name) {
        i8* tok = i8[256];
        mut i32 p = 0;
        while (p >= 0) {
            p = SpectreCli.nextToken(line, p, tok);
            if (p >= 0) {
                bool match = Spectre.tagMatch(tok, strlen(tok), name);
                if (match) { return true; }
            }
        }
        return false;
    }

    public static bool option(i8* line, i8* name, i8* out) {
        i8* tok = i8[256];
        i32 nameLen = strlen(name);
        mut i32 p = 0;
        while (p >= 0) {
            p = SpectreCli.nextToken(line, p, tok);
            if (p >= 0) {
                i32 tokLen = strlen(tok);
                bool exact = Spectre.tagMatch(tok, tokLen, name);
                if (exact) {
                    i32 next = SpectreCli.nextToken(line, p, out);
                    return next >= 0;
                }
                if (tokLen > nameLen && tok[nameLen] == 61) {
                    bool prefix = Spectre.tagMatch(tok, nameLen, name);
                    if (prefix) {
                        memcpy(out, tok + nameLen + 1, tokLen - nameLen);
                        return true;
                    }
                }
            }
        }
        return false;
    }

    public static bool positional(i8* line, i32 index, i8* out) {
        i8* tok = i8[256];
        mut i32 p = 0;
        mut i32 seen = 0;
        while (p >= 0) {
            p = SpectreCli.nextToken(line, p, tok);
            if (p >= 0 && tok[0] != 45) {
                if (seen == index) {
                    memcpy(out, tok, strlen(tok) + 1);
                    return true;
                }
                seen = seen + 1;
            }
        }
        return false;
    }
}
