import std::types;

namespace std::sys;

extern "C" {
    i32 __djinn_argc();
    i8*? __djinn_argv(i32 index);
    c_result system(i8* command);
    i8*? getenv(i8* name);

    void*? __djinn_process_start(i8* command, i8* input, i32 input_length);
    i32 __djinn_process_wait(void* process, i32 timeout_ms);
    i32 __djinn_process_poll(void* process);
    void __djinn_process_kill(void* process);
    i32 __djinn_process_exit_code(void* process);
    i32 __djinn_process_killed(void* process);
    i8* __djinn_process_stdout_data(void* process);
    i32 __djinn_process_stdout_length(void* process);
    i8* __djinn_process_stderr_data(void* process);
    i32 __djinn_process_stderr_length(void* process);
    void __djinn_process_free(void* process);
}

struct Process {
    public static i32 argc() {
        return __djinn_argc();
    }

    public static i8*? argv(i32 index) {
        return __djinn_argv(index);
    }

    public static i32 run(i8* command) {
        return system(command);
    }

    public static i8*? env(i8* name) {
        return getenv(name);
    }

    public static void*? start(i8* command, i8* input, i32 input_length) {
        return __djinn_process_start(command, input, input_length);
    }

    public static bool wait(void* process, i32 timeout_ms) {
        return __djinn_process_wait(process, timeout_ms) == 1;
    }

    public static async bool wait_async(void* process, i32 timeout_ms) {
        i64 deadline = __djinn_unix_timestamp_ms() + (i64)timeout_ms;
        while (__djinn_process_poll(process) == 0) {
            if (timeout_ms >= 0 && __djinn_unix_timestamp_ms() >= deadline) {
                return false;
            }
            std::builtin::coro.suspend();
        }
        return true;
    }

    public static void kill(void* process) {
        __djinn_process_kill(process);
    }

    public static i32 exit_code(void* process) {
        return __djinn_process_exit_code(process);
    }

    public static bool was_killed(void* process) {
        return __djinn_process_killed(process) == 1;
    }

    public static i8* stdout_text(void* process) {
        return __djinn_process_stdout_data(process);
    }

    public static i32 stdout_length(void* process) {
        return __djinn_process_stdout_length(process);
    }

    public static i8* stderr_text(void* process) {
        return __djinn_process_stderr_data(process);
    }

    public static i32 stderr_length(void* process) {
        return __djinn_process_stderr_length(process);
    }

    public static void release(void* process) {
        __djinn_process_free(process);
    }
}
