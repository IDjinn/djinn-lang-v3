namespace std::sys;

// ============================================================================
// Compile-time platform/architecture intrinsics
// ============================================================================

[intrinsic] constexpr struct Platform {
    bool Windows;
    bool Linux;
    bool MacOs;
}

[intrinsic] constexpr struct Arch {
    bool X64;
    bool X86;
    bool Arm64;
}

[intrinsic] constexpr struct Build {
    bool Debug;
    bool Release;
}

[intrinsic] constexpr struct Runtime {
    i32 PointerSize;
}

// ============================================================================
// Attribute target flags (bitmask)
// ============================================================================

[intrinsic] constexpr struct AttributeTarget {
    const i32 Function = 1;
    const i32 Method = 2;
    const i32 Struct = 4;
    const i32 Field = 8;
    const i32 Parameter = 16;
    const i32 ReturnValue = 32;
    const i32 Variable = 64;
    const i32 All = 127;
}

// ============================================================================
// Attribute declarations
// ============================================================================

attribute ForceInline(AttributeTarget.Function | AttributeTarget.Method);
attribute NoInline(AttributeTarget.Function | AttributeTarget.Method);
attribute NoReturn(AttributeTarget.Function | AttributeTarget.Method);
attribute Hot(AttributeTarget.Function | AttributeTarget.Method);
attribute Cold(AttributeTarget.Function | AttributeTarget.Method);
attribute NoSync(AttributeTarget.Function | AttributeTarget.Method);
attribute NoUnwind(AttributeTarget.Function | AttributeTarget.Method);
attribute WillReturn(AttributeTarget.Function | AttributeTarget.Method);
attribute NoRecurse(AttributeTarget.Function | AttributeTarget.Method);

attribute Align(AttributeTarget.Struct | AttributeTarget.Field | AttributeTarget.Parameter) {
    i32 value;
}

attribute Volatile(AttributeTarget.Field | AttributeTarget.Variable);
attribute Restrict(AttributeTarget.Parameter);
attribute NoCapture(AttributeTarget.Parameter);
attribute ReadOnly(AttributeTarget.Parameter | AttributeTarget.Field);
attribute WriteOnly(AttributeTarget.Parameter);
attribute NonNull(AttributeTarget.Parameter | AttributeTarget.ReturnValue);
attribute NoMangle(AttributeTarget.Function | AttributeTarget.Method | AttributeTarget.Struct);

attribute Deprecated(AttributeTarget.All) {
    i8* message;
}

attribute Llvm(AttributeTarget.Function | AttributeTarget.Method) {
    i8* attr;
}

attribute Location(AttributeTarget.Field | AttributeTarget.Parameter | AttributeTarget.Variable) {
    i8* fileName;
    i32 line;
    i32 column;
}