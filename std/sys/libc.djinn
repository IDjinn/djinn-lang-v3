import std::types;
namespace std::libc;

extern "C" {
  c_result printf(i8* fmt, ...);

  void* malloc(size_long size);
  void* realloc(void* ptr, size_long new_size);
  void* memcpy(void* dest, void* src, size_long n);
  void free(void* ptr);
  c_result strlen(i8* s);
  void abort();
  void exit(i32 code);


  void*  __djinn_malloc    (size_long size);
  void   __djinn_free      (void* pointer);
  void*  __djinn_realloc   (void* pointer, size_long new_size);

  i8* itoa(i32 value, i8* str, i32 base);
}
