import std::types;
import std::debug;

namespace std::sys;

extern "C" {
    i64    __djinn_console_write     (void* str, void* coro_handle);
    i64    __djinn_console_writeln   (void* str, void* coro_handle);
    i64    __djinn_console_error     (void* str, void* coro_handle);
    i64    __djinn_console_read_line (void* str, void* coro_handle);
    i64    __djinn_async_write       (i32 fd, void* buf, i64 count, void* coro_handle);
    i64    __djinn_async_read        (i32 fd, void* buf, i64 count, void* coro_handle);
}

struct Console {
    public static c_result error(i8* message) {
        i32 stderr = 2;
        return write(stderr, message, strlen(message));
    }

    public static c_result printf(i8* format) {
        return printf(format);
    }

   public static async i64 print(i8* message, i64 len) {
        i32 stdout = 1;

        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_write(stdout, message, len, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_write call got invalid return");
        return ret;
    }

    public static async void* readLine() {
        i32 stdin = 0;
        i32 bufferSize = 1024;

        void* buffer = __djinn_malloc(bufferSize);
        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_read(stdin, buffer, bufferSize, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_read call got invalid return");
        return buffer;
    }


  public static void writeSync(str format, ...args) {
      mut size pos = 0u;
      mut size written = 0u;

      while (pos < format.length) {
          if (format.data[pos] == 123) {
              // Flush text before placeholder
              if (pos > written) {
                  size len = pos - written;
                  write(1, format.data + written, len);
              }

              // Parse index
              pos = pos + 1u;
              mut i32 idx = 0;
              while (pos < format.length && format.data[pos] != 125) {
                  idx = idx * 10 + ((i32)format.data[pos] - 48);
                  pos = pos + 1u;
              }
              pos = pos + 1u;
              written = pos;

              if (idx < (i32)args.length) {
                  object arg = args[idx];
                  u8 kind = arg.type.kind;
                  i32 tsize = arg.type.size;

                  if (kind == 0) {
                      i8* buf = __djinn_malloc(32);
                      if (tsize <= 4) {
                          i32* ip = (i32*)arg.data;
                          itoa(*ip, buf, 10);
                      } else {
                          i64* lp = (i64*)arg.data;
                          snprintf(buf, 32, "%lld", *lp);
                      }
                      i32 slen = strlen(buf);
                      write(1, buf, slen);
                      __djinn_free(buf);
                  } else if (kind == 1) {
                      i8* buf = __djinn_malloc(32);
                      mut i32 len = 0;
                      if (tsize <= 4) {
                          f32* fp = (f32*)arg.data;
                          len = snprintf(buf, 32, "%g", *fp);
                      } else {
                          f64* dp = (f64*)arg.data;
                          len = snprintf(buf, 32, "%g", *dp);
                      }
                      write(1, buf, len);
                      __djinn_free(buf);
                  } else if (kind == 2) {
                      i8* s = (i8*)arg.data;
                      i32 slen = strlen(s);
                      write(1, s, slen);
                  }
              }
          } else if (format.data[pos] == 10) {  // '\n' — flush on newline
              pos = pos + 1u;
              if (pos > written) {
                  size len = pos - written;
                  write(1, format.data + written, len);
                  written = pos;
              }
          } else {
              pos = pos + 1u;
          }
      }

      if (written < format.length) {
          size rem = format.length - written;
          write(1, format.data + written, rem);
      }
  }

  public static async i64 write(str format, ...args) {
      i32 stdout = 1;
      array<i8> buffer = array<i8>();
      buffer.reserve(1024 * 8);
      void* handle = std::builtin::coro.handle();

      mut size pos = 0u;
      mut size written = 0u;

      while (pos < format.length) {
          buffer.push(format.data[pos]);
          if (format.data[pos] == 123) {  // '{'
              // Flush text before the placeholder
              if (pos > written) {
                  __djinn_async_write(stdout, format.data + written, (i64)(pos - written), handle);
                  std::builtin::coro.suspend();
              }

              // Parse index: {0}, {1}, etc.
              pos = pos + 1u;
              mut i32 idx = 0;
              while (pos < format.length && format.data[pos] != 125) {  // '}'
                  idx = idx * 10 + ((i32)format.data[pos] - 48);  // '0' = 48
                  pos = pos + 1u;
              }
              pos = pos + 1u;  // skip '}'
              written = pos;

              // Get the arg and write based on type
              if (idx < (i32)args.length) {
                  object arg = args[idx];
                  u8 kind = arg.type.kind;

                  if (kind == 0) {
                      // int: convert with itoa (i32) or snprintf (i64)
                      i8* buf = __djinn_malloc(32);
                      if (arg.type.size <= 4) {
                          i32* ip = (i32*)arg.data;
                          itoa(*ip, buf, 10);
                      } else {
                          i64* lp = (i64*)arg.data;
                          snprintf(buf, 32, "%lld", *lp);
                      }
                      i32 slen = strlen(buf);
                      i64 slen64 = (i64)slen;
                      __djinn_async_write(stdout, buf, slen64, handle);
                      std::builtin::coro.suspend();
                      __djinn_free(buf);
                  } else if (kind == 1) {
                      // float: snprintf
                      i8* buf = __djinn_malloc(32);
                      mut i32 len = 0;
                      if (arg.type.size <= 4) {
                          f32* fp = (f32*)arg.data;
                          len = snprintf(buf, 32, "%g", *fp);
                      } else {
                          f64* dp = (f64*)arg.data;
                          len = snprintf(buf, 32, "%g", *dp);
                      }
                      i64 len64 = (i64)len;
                      __djinn_async_write(stdout, buf, len64, handle);
                      std::builtin::coro.suspend();
                      __djinn_free(buf);
                  } else if (kind == 2) {
                      // pointer (i8*): data is the pointer itself
                      i8* s = (i8*)arg.data;
                      i32 slen = strlen(s);
                      i64 slen64 = (i64)slen;
                      __djinn_async_write(stdout, s, slen64, handle);
                      std::builtin::coro.suspend();
                  }
                  // TODO: kind 5 (str) and kind 6 (string) require cast to str*/string*
                  // which the parser doesn't support yet
              }
          } else if (format.data[pos] == 10) {  // '\n' — flush on newline (line-buffered, like std)
              pos = pos + 1u;
              if (pos > written) {
                  size len = pos - written;
                  i64 len64 = (i64)len;
                  __djinn_async_write(stdout, format.data + written, len64, handle);
                  std::builtin::coro.suspend();
                  written = pos;
              }
          } else {
              pos = pos + 1u;
          }
      }

      // Flush remaining text
      if (written < format.length) {
          size rem = format.length - written;
          i64 rem64 = (i64)rem;
          __djinn_async_write(stdout, format.data + written, rem64, handle);
          std::builtin::coro.suspend();
      }

      return 0;
  }
}
