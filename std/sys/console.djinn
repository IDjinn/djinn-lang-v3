import std::types;
import std::debug;

namespace std::sys;

extern "C" {
    i64    __djinn_console_write       (void* str, void* coro_handle);
    i64    __djinn_console_writeln     (void* str, void* coro_handle);
    i64    __djinn_console_error       (void* str, void* coro_handle);
    i64    __djinn_console_read_line   (void* str, void* coro_handle);
    i64    __djinn_async_write         (i32 fd, void* buf, i64 count, void* coro_handle);
    i64    __djinn_async_read          (i32 fd, void* buf, i64 count, void* coro_handle);
}

struct Console {
    const i32 stdin = 0;
    const i32 stderr = 2;
    const i32 stdout = 1;
    const i32 bufferSize = 1024;

    public static c_result error(i8* message) {
        return write(stderr, message, strlen(message));
    }

    public static c_result printf(i8* format) {
        return printf(format);
    }

   public static async i64 print(i8* message, i64 len) {
        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_write(stdout, message, len, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_write call got invalid return");
        return ret;
    }

    public static async void* readLine() {
        void* buffer = __djinn_malloc(bufferSize);
        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_read(stdin, buffer, bufferSize, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_read call got invalid return");
        return buffer;
    }


  const i32 bufSize = 8192;
  const i32 flushAt = 8100;
  public static void writeSync(str format, ...args) {
      i8* buf = i8[bufSize];
      mut i32 bpos = 0;
      mut size pos = 0u;

      while (pos < format.length) {
          i8 current = format.data[pos];

          if (current == 123) {  // '{' — placeholder
              pos = pos + 1u;
              mut i32 idx = 0;
              while (pos < format.length && format.data[pos] != 125) {
                  idx = idx * 10 + ((i32)format.data[pos] - 48);
                  pos = pos + 1u;
              }
              pos = pos + 1u;  // skip '}'

              if (idx < (i32)args.length) {
                  object arg = args[idx];
                  u8 kind = arg.type.kind;
                  i32 tsize = arg.type.size;

                  if (kind == 0) {
                      // int
                      if (tsize <= 4) {
                          i32* ip = (i32*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%d", *ip);
                          bpos = bpos + len;
                      } else {
                          i64* lp = (i64*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%lld", *lp);
                          bpos = bpos + len;
                      }
                  } else if (kind == 1) {
                      // float
                      if (tsize <= 4) {
                          f32* fp = (f32*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%g", *fp);
                          bpos = bpos + len;
                      } else {
                          f64* dp = (f64*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%g", *dp);
                          bpos = bpos + len;
                      }
                  } else if (kind == 2) {
                      // pointer (i8*)
                      i8* s = (i8*)arg.data;
                      i32 slen = strlen(s);
                      // string maior que o buffer: flush atual + write direto
                      if (slen > flushAt) {
                          if (bpos > 0) {
                              write(1, buf, bpos);
                              bpos = 0;
                          }
                          write(1, s, slen);
                      } else {
                          memcpy(buf + bpos, s, slen);
                          bpos = bpos + slen;
                      }
                  }

                  // flush se buffer esta quase cheio
                  if (bpos >= flushAt) {
                      write(1, buf, bpos);
                      bpos = 0;
                  }
              }
          } else {
              buf[bpos] = current;
              bpos = bpos + 1;
              pos = pos + 1u;

              if (current == 10) {  // '\n' — flush on newline
                  write(1, buf, bpos);
                  bpos = 0;
              }
          }
      }

      // Flush remaining
      if (bpos > 0) {
          write(1, buf, bpos);
      }
  }

  // Builds a formatted string in a heap buffer (same placeholder syntax as
  // writeSync). Interpolated error messages no longer route through here —
  // they format into a fixed thread-local buffer via __djinn_error_format.
  public static str format(str format, ...args) {
      i8* buf = (i8*)__djinn_malloc(bufSize);
      mut i32 bpos = 0;
      mut size pos = 0u;

      while (pos < format.length) {
          i8 current = format.data[pos];

          if (current == 123) {  // '{' — placeholder
              pos = pos + 1u;
              mut i32 idx = 0;
              while (pos < format.length && format.data[pos] != 125) {
                  idx = idx * 10 + ((i32)format.data[pos] - 48);
                  pos = pos + 1u;
              }
              pos = pos + 1u;  // skip '}'

              if (idx < (i32)args.length) {
                  object arg = args[idx];
                  u8 kind = arg.type.kind;
                  i32 tsize = arg.type.size;

                  if (kind == 0) {
                      // int
                      if (tsize <= 4) {
                          i32* ip = (i32*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%d", *ip);
                          bpos = bpos + len;
                      } else {
                          i64* lp = (i64*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%lld", *lp);
                          bpos = bpos + len;
                      }
                  } else if (kind == 1) {
                      // float
                      if (tsize <= 4) {
                          f32* fp = (f32*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%g", *fp);
                          bpos = bpos + len;
                      } else {
                          f64* dp = (f64*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%g", *dp);
                          bpos = bpos + len;
                      }
                  } else if (kind == 2) {
                      // pointer (i8*)
                      i8* s = (i8*)arg.data;
                      mut i32 slen = strlen(s);
                      mut i32 room = bufSize - bpos - 1;
                      if (slen > room) {
                          slen = room;
                      }
                      memcpy(buf + bpos, s, slen);
                      bpos = bpos + slen;
                  }
              }
          } else {
              if (bpos < flushAt) {
                  buf[bpos] = current;
                  bpos = bpos + 1;
              }
              pos = pos + 1u;
          }
      }

      return { .data = buf, .length = (u32)bpos };
  }

  public static async i64 write(str format, ...args) {
      i8* buf = i8[bufSize];
      mut i32 bpos = 0;
      mut size pos = 0u;
      void* handle = std::builtin::coro.handle();

      while (pos < format.length) {
          i8 current = format.data[pos];

          if (current == 123) {  // '{' — placeholder
              pos = pos + 1u;
              mut i32 idx = 0;
              while (pos < format.length && format.data[pos] != 125) {
                  idx = idx * 10 + ((i32)format.data[pos] - 48);
                  pos = pos + 1u;
              }
              pos = pos + 1u;  // skip '}'

              if (idx < (i32)args.length) {
                  object arg = args[idx];
                  u8 kind = arg.type.kind;
                  i32 tsize = arg.type.size;

                  if (kind == 0) {
                      // int
                      if (tsize <= 4) {
                          i32* ip = (i32*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%d", *ip);
                          bpos = bpos + len;
                      } else {
                          i64* lp = (i64*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%lld", *lp);
                          bpos = bpos + len;
                      }
                  } else if (kind == 1) {
                      // float
                      if (tsize <= 4) {
                          f32* fp = (f32*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%g", *fp);
                          bpos = bpos + len;
                      } else {
                          f64* dp = (f64*)arg.data;
                          i32 len = snprintf(buf + bpos, 32, "%g", *dp);
                          bpos = bpos + len;
                      }
                  } else if (kind == 2) {
                      // pointer (i8*)
                      i8* s = (i8*)arg.data;
                      i32 slen = strlen(s);
                      // string maior que o buffer: flush atual + write direto
                      if (slen > flushAt) {
                          if (bpos > 0) {
                              i64 bpos64 = (i64)bpos;
                              __djinn_async_write(stdout, buf, bpos64, handle);
                              std::builtin::coro.suspend();
                              bpos = 0;
                          }
                          i64 slen64 = (i64)slen;
                          __djinn_async_write(stdout, s, slen64, handle);
                          std::builtin::coro.suspend();
                      } else {
                          memcpy(buf + bpos, s, slen);
                          bpos = bpos + slen;
                      }
                  }

                  // flush se buffer esta quase cheio
                  if (bpos >= flushAt) {
                      i64 bpos64 = (i64)bpos;
                      __djinn_async_write(stdout, buf, bpos64, handle);
                      std::builtin::coro.suspend();
                      bpos = 0;
                  }
              }
          } else {
              buf[bpos] = current;
              bpos = bpos + 1;
              pos = pos + 1u;

              if (current == 10) {  // '\n' — async flush on newline
                  i64 bpos64 = (i64)bpos;
                  __djinn_async_write(stdout, buf, bpos64, handle);
                  std::builtin::coro.suspend();
                  bpos = 0;
              }
          }
      }

      // Flush remaining
      if (bpos > 0) {
          i64 bpos64 = (i64)bpos;
          __djinn_async_write(stdout, buf, bpos64, handle);
          std::builtin::coro.suspend();
      }
      return 0;
  }
}
