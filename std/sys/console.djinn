import std::types;
import std::debug;

namespace std::sys;

extern "C" {
    i64    __djinn_console_write     (void* str, void* coro_handle);
    i64    __djinn_console_writeln   (void* str, void* coro_handle);
    i64    __djinn_console_error     (void* str, void* coro_handle);
    i64    __djinn_console_read_line (void* str, void* coro_handle);
    i64    __djinn_async_write       (i32 fd, void* buf, i64 count, void* coro_handle);
    i64    __djinn_async_read        (i32 fd, void* buf, i64 count, void* coro_handle);
}

struct Console {
    public static c_result error(i8* message) {
        i32 stderr = 2;
        return write(stderr, message, strlen(message));
    }

    public static c_result printf(i8* format) {
        return printf(format);
    }

   public static async i64 print(i8* message, i64 len) {
        i32 stdout = 1;

        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_write(stdout, message, len, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_write call got invalid return");
        return ret;
    }

    public static async void* readLine() {
        i32 stdin = 0;
        i32 bufferSize = 1024;

        void* buffer = __djinn_malloc(bufferSize);
        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_read(stdin, buffer, bufferSize, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_read call got invalid return");
        return buffer;
    }


  public static async i64 write(str format, ...args) {
      i32 stdout = 1;
      void* handle = std::builtin::coro.handle();

      mut size pos = 0u;
      mut size written = 0u;

      while (pos < format.length) {
          if (format.data[pos] == 123) {  // '{'
              // Flush text before the placeholder
              if (pos > written) {
                  __djinn_async_write(stdout, format.data + written, (i64)(pos - written), handle);
                  std::builtin::coro.suspend();
              }

              // Parse index: {0}, {1}, etc.
              pos = pos + 1u;
              mut i32 idx = 0;
              while (pos < format.length && format.data[pos] != 125) {  // '}'
                  idx = idx * 10 + ((i32)format.data[pos] - 48);  // '0' = 48
                  pos = pos + 1u;
              }
              pos = pos + 1u;  // skip '}'
              written = pos;

              // Get the arg and write based on type
              if (idx < (i32)args.length) {
                  i8* placeholder = "[arg]";
                  __djinn_async_write(stdout, placeholder, 5, handle);
                  std::builtin::coro.suspend();
              }
          } else {
              pos = pos + 1u;
          }
      }

      // Flush remaining text
      if (written < format.length) {
          __djinn_async_write(stdout, format.data + written, (i64)(format.length - written), handle);
          std::builtin::coro.suspend();
      }

      return 0;
  }
}
