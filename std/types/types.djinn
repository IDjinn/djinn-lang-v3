namespace std::types;

extern "C" {
    u32 __djinn_compare_strings(
        i8* leftData,
        i8* rightData,
        i32 leftLen,
        i32 rightLen
    );
}

struct size : u32;
struct size_long : u64;

struct c_result : i32;

struct bool : i1;

enum optional<T> {
    Empty(),
    Value(T)
}

enum result<T, E> {
    Ok(T),
    Error(E)
}

struct str {
    i8* data;
    size len;

    public bool is_empty() {
        return this.len == 0u;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct arr<T> {
    T* data;
    size len;

    public bool is_empty() {
        return this.len == 0u;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct string {
    i8* data;
    size len;
    size capacity;

    public bool is_empty() {
        return this.len == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    public i32 len() {
        return this.len;
    }
}


impl Hashable, Equatable for str {
    i32 hash() {
        return 0;
    }

    bool equals(str other) {
        return __djinn_compare_strings(this.data, other.data, this.len, other.len) == 1;
    }

    bool equals(string other) {
        return __djinn_compare_strings(this.data, other.data, this.len, other.len) == 1;
    }
}

impl Hashable, Equatable for string {
    i32 hash() {
        return 0;
    }

    bool equals(string other) {
        return __djinn_compare_strings(this.data, other.data, this.len, other.len) == 1;
    }

    bool equals(str other) {
        return __djinn_compare_strings(this.data, other.data, this.len, other.len) == 1;
    }
}

impl Hashable, Equatable for i32 {
    i32 hash() {
        return this;
    }

    bool equals(i32 other) {
        return this == other;
    }
}

impl Hashable, Equatable for i8* {
    i32 hash() {
        return 0;
    }

    bool equals(i8* other) {
        return this == other;
    }
}