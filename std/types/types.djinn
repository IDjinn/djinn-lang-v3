namespace std::types;

extern "C" {
    u32 __djinn_compare_strings(
        i8* leftData,
        i8* rightData,
        i32 leftLen,
        i32 rightLen
    );

    u32 __djinn_hash_string(i8* data, u32 length);
}

struct size : u32;
struct size_long : u64;

struct c_result : i32;

struct bool : i1;

enum optional<T> {
    Empty(),
    Value(T)
}

enum result<T, E> {
    Ok(T),
    Error(E)
}

struct arr<T> {
    T* data;
    size len;

    public bool is_empty() {
        return this.len == 0u;
    }

    public i8* ptr() {
        return this.data;
    }
}

impl Hashable for i8, i16, i32, i64, i128 {
    u32 hash() {
        return this;
    }
}

impl Hashable for u8, u16, u32, u64, u128 {
    u32 hash() {
        return this;
    }
}

impl Equatable for i32 {
    operator ==(i32 left, i32 right) -> bool {
        return left == right;
    }
}

impl Hashable, Equatable for i8* {
    u32 hash() {
        return 0;
    }

    operator ==(i8* left, i8* right) -> bool {
        return left == right;
    }
}

struct str {
    i8* data;
    size len;

    public bool is_empty() {
        return this.len == 0u;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct string {
    i8* data;
    size len;
    size capacity;

    public bool is_empty() {
        return this.len == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    public i32 len() {
        return this.len;
    }

    public i32 capacity() {
        return this.capacity;
    }
}

impl Hashable for str, string {
    u32 hash() {
        return __djinn_hash_string(this.data, this.len);
    }
}

impl Equatable for str {
    operator ==(str left, str right) -> bool {
        return __djinn_compare_strings(left.data, right.data, left.len, right.len) == 1;
    }

    operator +(str left, str right) -> string {
        u32 new_len = left.len + right.len;
        u64 alloc_size = (u64)((f64)new_len * 1.5);
        i8* new_data = __djinn_malloc(alloc_size);
        memcpy(new_data, left.data, left.len);
        memcpy(new_data + left.len, right.data, right.len);
        return { .data = new_data, .len = new_len, .capacity = new_len };
    }
}

impl Equatable for string {
    operator ==(string left, string right) -> bool {
        return __djinn_compare_strings(left.data, right.data, left.len, right.len) == 1;
    }

    operator +(string left, string right) -> string {
        u32 new_len = left.len + right.len;
        u64 alloc_size = (u64)((f64)new_len * 1.5);
        i8* new_data = __djinn_malloc(alloc_size);
        memcpy(new_data, left.data, left.len);
        memcpy(new_data + left.len, right.data, right.len);
        return { .data = new_data, .len = new_len, .capacity = new_len };
    }
}
