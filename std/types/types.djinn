namespace std::types;

struct size : u32;
struct size_long : u64;

struct c_result : i32;

struct bool : i1;

enum optional<T> {
    Empty(),
    Value(T)
}

enum result<T, E> {
    Ok(T),
    Error(E)
}

struct str {
    i8* data;
    size len;

    public bool is_empty() {
        return this.len == 0;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct arr<T> {
    T* data;
    size len;

    public bool is_empty() {
        return this.len == 0;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct string {
    i8* data;
    size len;
    size capacity;

    public bool is_empty() {
        return this.len == 0;
    }

    public i8* ptr() {
        return this.data;
    }
}


impl Hashable, Equatable for i32 {
    i32 hash() {
        return this;
    }

    bool equals(i32 other) {
        return this == other;
    }
}

impl Hashable, Equatable for i8* {
    i32 hash() {
        return this;
    }

    bool equals(i8* other) {
        return this == other;
    }
}