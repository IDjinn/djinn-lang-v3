namespace std::types;

struct size : u32;
struct size_long : u64;

struct c_result : i32;

struct bool : i1;

enum optional<T> {
    Empty(),
    Value(T)
}


enum result<T, E> {
    Ok(T),
    Error(E)
}

struct string {
    i8* data;
    size size;
    i32 flags; // contains metadata like static str, expandable etc.
}