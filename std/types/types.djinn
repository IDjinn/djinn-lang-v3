namespace std::types;

struct size : u32;
struct size_long : u64;

struct c_result : i32;

struct bool : i1;

struct optional<T> {
    T value;
    i1 has_value;

    T value() {
        return this.value;
    }
}

struct result<T, E> {
    T value { get; }
    E error { get; }
    bool has_value { get; }
}

enum Result<T, E> {
    Ok(T),
    Error(E)
}