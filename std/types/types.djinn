namespace std::types;

extern "C" {
    u32 __djinn_compare_strings(
        i8* leftData,
        i8* rightData,
        i32 leftLen,
        i32 rightLen
    );

    u64 __djinn_hash_string(i8* data, u32 length);
}

struct size : u32; // TODO: MAYBE UNIQUE TYPE FOR THAT
struct size_long : u64;

struct c_result : i32;

struct bool : u1;

enum optional<T> {
    Empty(),
    Value(T)
}

enum result<T, E> {
    Ok(T),
    Error(E)
}

impl Hashable, Equatable for arr<T> {
    u64 hash() {
        return 0u;
    }

    operator ==(arr<T> left, arr<T> right) -> bool {
        return left.hash() == right.hash();
    }
}

impl Hashable for i128, u128 {
    [force-inline] u64 hash() {
        u64 hi = this >> 64;
        u64 lo = (u64)this;
        mut u64 x = hi ^ (lo * 0x9e3779b97f4a7c15);

        x = x + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

impl Hashable for i64, u64 {
    [force-inline] u64 hash() {
        mut u64 x = (u64)this + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

impl Hashable for i8, i16, i32, u8, u16, u32 {
     [force-inline] u64 hash() {
        return this;
    }
}

impl Hashable for f32 {
    [force-inline] u64 hash() {
        // Reinterpret f32 bits as u32 via pointer cast, then hash as integer
        f32* p = &this;
        u32* ip = (u32*)p;
        mut u64 x = (u64)*ip + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        return x ^ (x >> 31);
    }
}

impl Hashable for f64 {
    [force-inline] u64 hash() {
        // Reinterpret f64 bits as u64 via pointer cast, then hash
        f64* p = &this;
        u64* ip = (u64*)p;
        mut u64 x = *ip + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        return x ^ (x >> 31);
    }
}

impl Hashable, Equatable for i8* {
    u64 hash() {
        return 0;
    }

    operator ==(i8* left, i8* right) -> bool {
        return left == right;
    }
}

struct TypeInfo {
    i32 id;
    i32 size;
    i8* name;
    u8 kind;

    [force-inline] u64 hash() {
        mut u64 x = (u64)this.id;
        x = x * 31 + (u64)this.size;
        x = x * 31 + (u64)this.kind;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

struct object : Hashable {
    TypeInfo* type;
    void* data;

    [force-inline] u64 hash() {
        return this.type.hash();
    }
}

struct str {
    i8* data;
    size length;

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct arr<T> : Hashable
where T : Hashable {
    T* data;
    size length;

    public u64 hash() {
        mut u64 result = 1;
        for (mut size i = 0; i < this.length; i = i + 1) {
            u64 item_hash = this.data[i].hash();
            result = 31 * result + (u32)(item_hash ^ (item_hash >> 32));
        }
        return result;
    }

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }
}

struct string {
    mut i8* data;
    size length;
    size capacity;

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    public i32 length() {
        return this.length;
    }

    public i32 capacity() {
        return this.capacity;
    }
}

impl Hashable for str, string {
    u64 hash() {
        return __djinn_hash_string(this.data, this.length);
    }

    str slice(size start, size length) {
        Debug.assert(start <= this.length, "start out of bounds");
        Debug.assert(start + length <= this.length, "length out of bounds");

        return { .data = this.data + start, .length = length };
    }

    string substring(size start, size length) {
        Debug.assert(start <= this.length, "start out of bounds");
        Debug.assert(start + length <= this.length, "length out of bounds");

        size new_size = length - start;
        u32 new_capacity = (u32)((f64)new_size * 1.5);
        void* data_buffer = __djinn_malloc(new_capacity);
        memcpy(data_buffer, (this.data + start), length);
        return { .data = data_buffer, .length = new_size, .capacity = new_capacity };
    }

    string concat(string left, string right) {
        return left + right;
    }

    operator +(string left, string right) -> string { // TODO: THIS DOESNT APPEND IF HAS CAPACITY!
        u32 new_len = left.length + right.length;
        u64 alloc_size = (u64)((f64)new_len * 1.5);
        i8* new_data = __djinn_malloc(alloc_size);
        memcpy(new_data, left.data, left.length);
        memcpy(new_data + left.length, right.data, right.length);
        return { .data = new_data, .length = new_len, .capacity = new_len };
    }
}

impl Equatable for str {
    operator ==(str left, str right) -> bool {
        return __djinn_compare_strings(left.data, right.data, left.length, right.length) == 1;
    }
}

impl Equatable for string {
    operator ==(string left, string right) -> bool {
        return __djinn_compare_strings(left.data, right.data, left.length, right.length) == 1;
    }
}

impl i8 {
    const i8 MAX_VALUE = 127;
    const i8 MIN_VALUE = -128;
}

impl i16 {
    const i16 MAX_VALUE = 32767;
    const i16 MIN_VALUE = -32768;
}

impl i32 {
    const i32 MAX_VALUE = 0x7FFFFFFF;
    const i32 MIN_VALUE = 0x80000000;
}

impl i64 {
    const i64 MAX_VALUE = 0x7FFFFFFFFFFFFFFF;
    const i64 MIN_VALUE = 0x8000000000000000;
}

// TODO: i128/u128 const fields disabled — primitive impl for 128-bit types
// triggers LLVM verification error (this passed as ptr instead of i128 value)
// impl i128 { const i128 MAX_VALUE = 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; }

impl u8 {
    const u8 MAX_VALUE = 255;
    const u8 MIN_VALUE = 0;
}

impl u16 {
    const u16 MAX_VALUE = 65535;
    const u16 MIN_VALUE = 0;
}

impl u32 {
    const u32 MAX_VALUE = 0xFFFFFFFF;
    const u32 MIN_VALUE = 0;
}

impl u64 {
    const u64 MAX_VALUE = 0xFFFFFFFFFFFFFFFF;
    const u64 MIN_VALUE = 0;
}

// impl u128 { const u128 MAX_VALUE = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; }

impl f32 {
    const f32 MAX_VALUE = 3.40282347e+38;
    const f32 MIN_VALUE = -3.40282347e+38;
    const f32 MIN_POSITIVE = 1.17549435e-38;
    const f32 EPSILON = 1.19209290e-7;
    // TODO: INFINITY and NAN require intrinsic support (special bit patterns, not literals)
}

impl f64 {
    const f64 MAX_VALUE = 1.7976931348623157e+308;
    const f64 MIN_VALUE = -1.7976931348623157e+308;
    const f64 MIN_POSITIVE = 2.2250738585072014e-308;
    const f64 EPSILON = 2.2204460492503131e-16;
    // TODO: INFINITY and NAN require intrinsic support
}