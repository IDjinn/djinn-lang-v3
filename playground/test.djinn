import std::types;
import std::collections;

namespace playground;

i32 main() {
    array<i32> arr = array<i32>();
    for (auto mut i = 0; i < 1000000000; i = i + 1) {
        arr.push(i);
    }

for (auto mut i = 0; i < 1000000000; i = i + 1) {
    printf("arr = %d\n", arr.get(i));
}
return 0;
}
