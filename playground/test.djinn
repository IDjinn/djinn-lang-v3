
impl i32 {
    public i32 abs() {
        if (this < 0) {
            return 0 - this;
        }
        return this;
    }

    public void hello(){
        printf("world\n");
    }
}

void main() {
    i32 x = -42;
    i32 result = x.abs();
    x.hello();
    printf("abs(-42) = %d\n", result);
}
