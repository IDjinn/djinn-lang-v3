import std::types;
import std::collections;

namespace playground;

i32 main() {
    array<i32> arr = array<i32>();
    for (auto mut i = 0; i < 100; i = i + 1) {
        arr.push(i);
    }
    printf("arr = %d\n", arr.get(69));
    printf("arr = %d\n", arr.get(0));
    printf("arr = %d\n", arr.get(99));
    return 0;
}