import std::types;
import std::builtin;

extern "C" {
    i64 __djinn_async_write(i32 fd, void* buf, i64 count, void* coro_handle);
}

// Async write wrapper — submits to runtime I/O thread, then yields
async i32 async_print(i8* message, i64 len) {
    // TODO: needs coro::handle() to pass our handle to the runtime
    // For now, pass null — I/O thread won't resume us, busy-loop does
    void* null_handle = coro::handle();
    __djinn_async_write(1, message, len, null_handle);
    yield;
    return 0;
}

async i32 main() {
    printf("=== Async I/O Test ===\n");

    // Async write to stdout via runtime I/O thread
    i32 r1 = await async_print("Hello from async I/O!\n", 22);
    printf("async_print returned %d\n", r1);

    i32 r2 = await async_print("Second async write!\n", 20);
    printf("async_print returned %d\n", r2);

    printf("=== Done ===\n");
    return 0;
}
